<Project>
  <PropertyGroup>
    <!-- 仓库内所有项目统一使用 .NET 10 SDK 对应的稳定 C# 14 语法能力。 -->
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('JayTom.Dws.'))">
    <!-- 保留历史未使用成员的兼容抑制；异步和可空性问题继续显示为警告，便于逐步清理。 -->
    <NoWarn>$(NoWarn);CS0067;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629</WarningsNotAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- .NET 10 分层编译和动态 PGO 优先优化长期运行的高频路径。 -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <UseQuickJit>true</UseQuickJit>
    <UseQuickJitForLoops>true</UseQuickJitForLoops>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('JayTom.Dws.')) and '$(Configuration)' == 'Release'">
    <!-- 发布构建始终以执行速度为优化目标。 -->
    <Optimize>true</Optimize>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
  </PropertyGroup>
</Project>
