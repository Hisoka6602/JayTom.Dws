<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Dependency Injection and IoC -->
    <PackageVersion Include="DryIoc.Microsoft.DependencyInjection.Extension" Version="1.0.0.2" />
    <PackageVersion Include="Prism.DryIoc" Version="8.1.97" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    
    <!-- UI Libraries -->
    <PackageVersion Include="gong-wpf-dragdrop" Version="3.2.1" />
    <PackageVersion Include="LottieSharp" Version="2.2.0" />
    <PackageVersion Include="MaterialDesignThemes" Version="4.8.0" />
    <PackageVersion Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageVersion Include="Vlc.DotNet.Wpf" Version="3.1.0" />
    
    <!-- Configuration -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Ini" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
    
    <!-- Data and LINQ -->
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.6.7" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    
    <!-- Entity Framework -->
    <PackageVersion Include="EFCore.BulkExtensions" Version="8.1.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.7" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql.Json.Microsoft" Version="8.0.0" />
    
    <!-- Code Analysis -->
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="4.11.0" />
    <PackageVersion Include="System.Reflection.Emit" Version="4.7.0" />
    
    <!-- Logging -->
    <PackageVersion Include="NLog" Version="5.3.2" />
    <PackageVersion Include="NLog.Web.AspNetCore" Version="5.3.2" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="5.3.11" />
    
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Http.Connections.Common" Version="8.0.0" />
    
    <!-- SignalR -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Common" Version="8.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.0" />
    
    <!-- Resilience and Caching -->
    <PackageVersion Include="Polly" Version="7.2.4" />
    <PackageVersion Include="Polly.Caching.Memory" Version="3.0.2" />
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageVersion Include="Pitcher" Version="2.1.1" />
    
    <!-- Hardware and System -->
    <PackageVersion Include="System.Drawing.Common" Version="8.0.0" />
    <PackageVersion Include="System.Management" Version="8.0.0" />
    <PackageVersion Include="System.IO.Ports" Version="8.0.0" />
    <PackageVersion Include="System.Speech" Version="8.0.0" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.2" />
    
    <!-- Camera and Video -->
    <PackageVersion Include="Accord.Video.FFMPEG" Version="3.8.0" />
    <PackageVersion Include="FFmpeg.AutoGen" Version="6.1.0" />
    
    <!-- Machine Learning and OCR -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.16.3" />
    
    <!-- Device Communication -->
    <PackageVersion Include="HidSharpCore" Version="1.2.1.1" />
    <PackageVersion Include="RawInput.Sharp" Version="0.1.3" />
    <PackageVersion Include="TouchSocket" Version="1.3.6" />
    <PackageVersion Include="S7netplus" Version="0.20.0" />
    
    <!-- File Operations -->
    <PackageVersion Include="FluentFTP" Version="47.1.0" />
    <PackageVersion Include="NPOI" Version="2.6.0" />
    <PackageVersion Include="Aliyun.OSS.SDK.NetCore" Version="2.13.0" />
    
    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
