<Project Sdk="Microsoft.NET.Sdk">
  <!-- 相机契约保持跨平台，不引用 System.Drawing、WPF 或任何厂商 SDK。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JayTom.Dws.Camera.Contracts</AssemblyName>
    <RootNamespace>JayTom.Dws.Camera.Contracts</RootNamespace>
    <Description>跨平台相机、帧租约、条码识别和厂商适配器契约。</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JayTom.Dws.Abstractions\JayTom.Dws.Abstractions.csproj" />
    <ProjectReference Include="..\JayTom.Dws.Domain\JayTom.Dws.Domain.csproj" />
  </ItemGroup>
</Project>
