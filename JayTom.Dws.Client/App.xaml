                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml" />
                <!--  多选框样式  -->

                <ResourceDictionary Source="/JayTom.Dws.Client;component/Styles/CustomCheckBoxStyle.xaml" />
                <!--  系统按钮样式  -->
                <ResourceDictionary Source="/JayTom.Dws.Client;component/Styles/SystemButtonStyle.xaml" />
                <!--  系统按钮图标样式  -->
                <ResourceDictionary Source="/JayTom.Dws.Client;component/Styles/SystemTextBlockStyle.xaml" />
                <!--  通用关闭按钮样式  -->
                <ResourceDictionary Source="/JayTom.Dws.Client;component/Styles/CustomCloseButtonStyle.xaml" />

                <!--  列表头样式  -->
                <ResourceDictionary Source="/JayTom.Dws.Client;component/Styles/CustomDataGridTextColumnStyle.xaml" />
                <!--  列表单元格样式  -->
                <ResourceDictionary Source="/JayTom.Dws.Client;component/Styles/CustomDataGridTextCellStyle.xaml" />
                <!--  列表样式  -->
                <ResourceDictionary Source="/JayTom.Dws.Client;component/Styles/CustomListBoxStyle.xaml" />
                <!--  焦点按钮样式  -->
