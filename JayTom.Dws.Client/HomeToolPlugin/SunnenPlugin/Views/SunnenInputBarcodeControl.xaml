<UserControl
    x:Class="JayTom.Dws.Client.HomeToolPlugin.SunnenPlugin.Views.SunnenInputBarcodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.HomeToolPlugin.SunnenPlugin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="http://prismlibrary.com/"
    xmlns:local="clr-namespace:JayTom.Dws.Client.HomeToolPlugin.SunnenPlugin.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="SunnenInputBarcodeControlView"
    d:DesignHeight="350"
    d:DesignWidth="800"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:PackageTypeToBorderThicknessConverter x:Key="PackageTypeToBorderThicknessConverter" />
        <converters:PackageTypeToColorConverter x:Key="PackageTypeToColorConverter" />
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="SunnenInputBarcodeControlView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <dialogs:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="760" />
            <Setter Property="Height" Value="350" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </dialogs:Dialog.WindowStyle>
    <materialDesign:Card
        Margin="0"
        materialDesign:ElevationAssist.Elevation="Dp2"
        materialDesign:ShadowAssist.Darken="True"
        materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
        Background="#333333"
        UniformCornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  系统按钮  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="Transparent"
                CornerRadius="5,5,0,0">
                <!--  系统按钮  -->
                <StackPanel
                    Margin="10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  关闭  -->
                    <Button
                        Command="{Binding CloseWinCommand}"
                        Style="{StaticResource CustomCloseButtonStyle}"
                        ToolTip="Close">
                        <TextBlock
                            Foreground="White"
                            Style="{StaticResource SystemTextBlockStyle}"
                            Text="&#xe601;" />
                    </Button>
                </StackPanel>
            </Border>
            <!--  内容  -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  扫码条码框  -->
                <Border
                    Grid.Row="0"
                    Margin="50,10,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <Grid>
                        <Border
                            Width="80"
                            Margin="2"
                            HorizontalAlignment="Left"
                            Background="DarkGray"
                            CornerRadius="5">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#2E2E2E"
                                Text="BarCode" />
                        </Border>
                        <TextBox
                            Name="BarCodeTextBox"
                            Width="420"
                            Height="45"
                            MaxWidth="500"
                            Margin="85,0,5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="True"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="25"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding BarcodeInputCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <!--  包裹类型选择托盘或箱子(按钮)  -->

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="200"
                        Height="80"
                        Margin="30,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="40"
                        Background="{Binding PackageType, Converter={StaticResource PackageTypeToColorConverter}, ConverterParameter=Box}"
                        BorderBrush="RoyalBlue"
                        BorderThickness="{Binding PackageType, Converter={StaticResource PackageTypeToBorderThicknessConverter}, ConverterParameter=Box}"
                        Command="{Binding SwitchPackageCommand}"
                        CommandParameter="Box"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="40"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Box" />
                    </Button>

                    <Button
                        Name="PalletButton"
                        Width="200"
                        Height="80"
                        Margin="30,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="40"
                        Background="{Binding PackageType, Converter={StaticResource PackageTypeToColorConverter}, ConverterParameter=Pallet}"
                        BorderBrush="RoyalBlue"
                        BorderThickness="{Binding PackageType, Converter={StaticResource PackageTypeToBorderThicknessConverter}, ConverterParameter=Pallet}"
                        Command="{Binding SwitchPackageCommand}"
                        CommandParameter="Pallet"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="40"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Pallet" />
                    </Button>
                </StackPanel>
                <!--  减去的值  -->
                <StackPanel Grid.Row="2">
                    <StackPanel
                        Margin="10,30"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  减去的内容  -->
                        <TextBlock
                            Margin="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="DeductedValue:" />
                        <!--  长  -->
                        <StackPanel Margin="10,0" Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Length(mm):" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding DeductedLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                        <!--  宽  -->
                        <StackPanel Margin="10,0" Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Width(mm):" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding DeductedWidth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                        <!--  高  -->
                        <StackPanel Margin="10,0" Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Height(mm):" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding DeductedHeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  上传结果  -->
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>