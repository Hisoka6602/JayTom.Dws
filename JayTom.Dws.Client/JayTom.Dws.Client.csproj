  <Target Name="CreateLicenseFolder" AfterTargets="BeforeBuild">
    <!-- 设置要创建的文件夹路径 -->
    <PropertyGroup>
      <LicenseFolder>$(OutDir)License</LicenseFolder>
    </PropertyGroup>

    <!-- 使用 Condition 属性检查文件夹是否存在 -->
    <MakeDir Directories="$(LicenseFolder)" Condition="!Exists('$(LicenseFolder)')" />
  </Target>

  <!-- 代码质量守卫是编译工具，单独构建以避免进入 Client 的运行时发布依赖图。 -->
  <Target Name="BuildCodeQualityGuard"
          Condition="'$(MSBuildProjectName)' == 'JayTom.Dws.Client' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\eng\JayTom.Dws.CodeQualityGuard\JayTom.Dws.CodeQualityGuard.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);NuGetAudit=false"
             RemoveProperties="Platform;TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishProfile;PublishDir;PublishProtocol;_TargetId" />
  </Target>

  <Target Name="RunCodeQualityGuard"
          BeforeTargets="CoreCompile"
          DependsOnTargets="BuildCodeQualityGuard"
          Condition="'$(MSBuildProjectName)' == 'JayTom.Dws.Client' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)\..\eng\JayTom.Dws.CodeQualityGuard\bin\$(Configuration)\net10.0\JayTom.Dws.CodeQualityGuard.dll&quot; &quot;$(MSBuildProjectDirectory)\..&quot; &quot;$(MSBuildProjectDirectory)\..\eng\CodeQualityBaseline.json&quot;" />
  </Target>
