<?xml version="1.0" encoding="utf-8" ?>
<Nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target xsi:type="AsyncWrapper" name="AsyncLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="LogFile" fileName="${basedir}/logs/${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncAppRuntimeLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="AppRuntimeLogFile" fileName="${basedir}/logs/AppRuntime/AppRuntime-${shortdate}.log"
              layout="${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncPackageAggregationLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="PackageAggregationLogFile" fileName="${basedir}/logs/集包器/PackageAggregationLog-${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncTcpLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="TcpLogFile" fileName="${basedir}/logs/Plugin/Tcp/Tcp-${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncAppRuntimeLockLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="AppRuntimeLockLogFile" fileName="${basedir}/logs/AppRuntime/Lock/Lock-${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncApiLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="ApiLogFile" fileName="${basedir}/logs/Api/Api-${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncGraysLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="GraysLogFile" fileName="${basedir}/logs/Grays/Grays-${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="Null" name="blackhole" />
    <target xsi:type="AsyncWrapper" name="AsyncArchiveLogFile" queueLimit="100000" overflowAction="Block">
      <target xsi:type="File" name="ArchiveLogFile" fileName="${basedir}/logs/archive/${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}"
              archiveFileName="${basedir}/logs/archive/${shortdate}.{#}.log"
              archiveEvery="Day"
              maxArchiveFiles="3"
              archiveNumbering="Date"
              archiveOldFileOnStartup="true" />
    </target>
  </targets>

  <rules>
    <logger name="System.Net.Http.*" maxlevel="Info" writeTo="blackhole" final="true" />
    <logger name="JayTom.Dws.Client.Service.BackgroundService.LogProcessingService" maxlevel="Info" minlevel="Info" writeTo="AsyncAppRuntimeLogFile" final="true" />
    <logger name="JayTom.Dws.Client.Service.BackgroundService.LogProcessingService" minlevel="Info" writeTo="AsyncAppRuntimeLockLogFile" final="true" />
    <logger name="JayTom.Dws.Client.Service.BackgroundService.PackageAggregationService" minlevel="Info" writeTo="AsyncPackageAggregationLogFile" final="true" />
    <logger name="JayTom.Dws.Interface.*" minlevel="Info" writeTo="AsyncApiLogFile" final="true" />
    <logger name="JayTom.Dws.Plugin.Device.GrayscaleDevice.*" minlevel="Info" writeTo="AsyncGraysLogFile" final="true" />
    <logger name="JayTom.Dws.Plugin.Tcp.BaseTcpOperations" minlevel="Info" writeTo="AsyncTcpLogFile" final="true" />
    <logger name="*" minlevel="Trace" writeTo="AsyncLogFile" />

    <!-- 添加归档日志的规则 -->
    <logger name="*" minlevel="Trace" writeTo="AsyncArchiveLogFile" />
  </rules>
</Nlog>