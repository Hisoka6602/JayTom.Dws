<?xml version="1.0" encoding="utf-8" ?>
<Nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <!-- 故障证据使用独立容量，正常事件洪峰不能挤占异常文件队列；慢磁盘仍不阻塞分拣。 -->
    <target xsi:type="AsyncWrapper" name="AsyncAnomalyLogFile" queueLimit="4096" overflowAction="Discard" batchSize="128" timeToSleepBetweenBatches="10" fullBatchSizeWriteLimit="1">
      <target xsi:type="File" name="AnomalyLogFile" fileName="${basedir}/logs/Anomalies/Anomalies-${shortdate}-${processid}.jsonl" encoding="utf-8" writeBom="false" keepFileOpen="true" concurrentWrites="false"
              archiveAboveSize="104857600" archiveFileName="${basedir}/logs/Anomalies/Anomalies-${shortdate}-${processid}.jsonl.{#}"
              archiveNumbering="Sequence" maxArchiveFiles="30">
        <layout xsi:type="JsonLayout" includeEventProperties="true" suppressSpaces="true">
          <attribute name="time" layout="${date:format=o}" />
          <attribute name="level" layout="${level}" />
          <attribute name="logger" layout="${logger}" />
          <attribute name="processId" layout="${processid}" />
          <attribute name="message" layout="${message}" />
          <attribute name="exception" layout="${exception:format=tostring}" />
        </layout>
      </target>
    </target>
    <!-- 异步写盘不阻塞设备线程；队列满时丢弃诊断日志，防止慢磁盘导致无限内存增长；包裹业务记录仍由持久化队列保存；每个文件达到 100 MiB 后滚动。 -->
    <target xsi:type="AsyncWrapper" name="AsyncPipelineLogFile" queueLimit="20000" overflowAction="Discard" batchSize="256" timeToSleepBetweenBatches="10" fullBatchSizeWriteLimit="1">
      <target xsi:type="File" name="PipelineLogFile" fileName="${basedir}/logs/Pipeline/Pipeline-${shortdate}-${processid}.jsonl" encoding="utf-8" writeBom="false" keepFileOpen="true" concurrentWrites="false"
              archiveAboveSize="104857600" archiveFileName="${basedir}/logs/Pipeline/Pipeline-${shortdate}-${processid}.jsonl.{#}"
              archiveNumbering="Sequence" maxArchiveFiles="30">
        <layout xsi:type="JsonLayout" includeEventProperties="true" suppressSpaces="true">
          <attribute name="time" layout="${date:format=o}" />
          <attribute name="level" layout="${level}" />
          <attribute name="logger" layout="${logger}" />
          <attribute name="processId" layout="${processid}" />
          <attribute name="message" layout="${message}" />
          <attribute name="exception" layout="${exception:format=tostring}" />
        </layout>
      </target>
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="LogFile" fileName="${basedir}/logs/${shortdate}.log" encoding="utf-8" writeBom="true" keepFileOpen="false" concurrentWrites="true"
               archiveAboveSize="104857600" archiveFileName="${basedir}/logs/${shortdate}.log.{#}"
               archiveNumbering="Sequence" maxArchiveFiles="30"
               layout="${longdate} ${uppercase:${level}} ${message}${onexception:inner=${newline}${exception:format=tostring}}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncAppRuntimeLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="AppRuntimeLogFile" fileName="${basedir}/logs/AppRuntime/AppRuntime-${shortdate}.log" encoding="utf-8" writeBom="true" keepFileOpen="false" concurrentWrites="true"
               archiveAboveSize="104857600" archiveFileName="${basedir}/logs/AppRuntime/AppRuntime-${shortdate}.log.{#}"
               archiveNumbering="Sequence" maxArchiveFiles="30"
               layout="${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncPackageAggregationLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="PackageAggregationLogFile" fileName="${basedir}/logs/集包器/PackageAggregationLog-${shortdate}.log" encoding="utf-8" writeBom="true" keepFileOpen="false" concurrentWrites="true"
               archiveAboveSize="104857600" archiveFileName="${basedir}/logs/集包器/PackageAggregationLog-${shortdate}.log.{#}"
               archiveNumbering="Sequence" maxArchiveFiles="30"
               layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncTcpLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="TcpLogFile" fileName="${basedir}/logs/Plugin/Tcp/Tcp-${shortdate}.log" encoding="utf-8" writeBom="true" keepFileOpen="false" concurrentWrites="true"
               archiveAboveSize="104857600" archiveFileName="${basedir}/logs/Plugin/Tcp/Tcp-${shortdate}.log.{#}"
               archiveNumbering="Sequence" maxArchiveFiles="30"
               layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>

    <!--<target xsi:type="AsyncWrapper" name="AsyncHttpLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="HttpLogFile" fileName="${basedir}/logs/Http/Http-${shortdate}.log"
              layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>-->
    <target xsi:type="AsyncWrapper" name="AsyncAppRuntimeLockLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="AppRuntimeLockLogFile" fileName="${basedir}/logs/AppRuntime/Lock/Lock-${shortdate}.log" encoding="utf-8" writeBom="true" keepFileOpen="false" concurrentWrites="true"
               archiveAboveSize="104857600" archiveFileName="${basedir}/logs/AppRuntime/Lock/Lock-${shortdate}.log.{#}"
               archiveNumbering="Sequence" maxArchiveFiles="30"
               layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncApiLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="ApiLogFile" fileName="${basedir}/logs/Api/Api-${shortdate}.log" encoding="utf-8" writeBom="true" keepFileOpen="false" concurrentWrites="true"
               archiveAboveSize="104857600" archiveFileName="${basedir}/logs/Api/Api-${shortdate}.log.{#}"
               archiveNumbering="Sequence" maxArchiveFiles="30"
               layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="AsyncWrapper" name="AsyncGraysLogFile" queueLimit="20000" overflowAction="Discard">
      <target xsi:type="File" name="GraysLogFile" fileName="${basedir}/logs/Grays/Grays-${shortdate}.log" encoding="utf-8" writeBom="true" keepFileOpen="false" concurrentWrites="true"
               archiveAboveSize="104857600" archiveFileName="${basedir}/logs/Grays/Grays-${shortdate}.log.{#}"
               archiveNumbering="Sequence" maxArchiveFiles="30"
               layout="${longdate} ${uppercase:${level}} ${message}" />
    </target>
    <target xsi:type="Null" name="blackhole" />
  </targets>

  <rules>
    <logger name="System.Net.Http.*" maxlevel="Info" writeTo="blackhole" final="true" />
    <logger name="Dws.Pipeline" minlevel="Warn" writeTo="AsyncAnomalyLogFile" />
    <logger name="JayTom.Dws.*" minlevel="Warn" writeTo="AsyncAnomalyLogFile" />
    <logger name="Dws.Pipeline" minlevel="Trace" writeTo="AsyncPipelineLogFile" final="true" />
    <logger name="JayTom.Dws.*" minlevel="Warn" writeTo="AsyncPipelineLogFile" />
    <logger name="JayTom.Dws.Client.Service.BackgroundService.LogProcessingService" maxlevel="Info" minlevel="Info" writeTo="AsyncAppRuntimeLogFile" final="true" />
    <logger name="JayTom.Dws.Client.Service.BackgroundService.LogProcessingService" minlevel="Info" writeTo="AsyncAppRuntimeLockLogFile" final="true" />
    <logger name="JayTom.Dws.Client.Service.BackgroundService.PackageAggregationService" minlevel="Info" writeTo="AsyncPackageAggregationLogFile" final="true" />
    <logger name="JayTom.Dws.Interface.*" minlevel="Info" writeTo="AsyncApiLogFile" final="true" />
    <logger name="JayTom.Dws.Plugin.Device.GrayscaleDevice.*" minlevel="Info" writeTo="AsyncGraysLogFile" final="true" />
    <logger name="JayTom.Dws.Plugin.Tcp.*" minlevel="Info" writeTo="AsyncTcpLogFile" final="true" />
    <logger name="*" minlevel="Trace" writeTo="AsyncLogFile" />

  </rules>
</Nlog>
