<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 发布目录只作为部署暂存区使用，禁止直接在此目录运行程序或保存现场数据。 -->
    <PublishDir>bin\Release\PublishClean\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 生产包不携带调试符号；只保留应用实际提供的中英文资源。 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SatelliteResourceLanguages>en-US;zh-CN;zh-Hans</SatelliteResourceLanguages>
    <!-- 漏洞审计由常规还原执行；发布只复用已验证的资产，避免重复访问审计源。 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- 构建开始前清空固定暂存目录；即使编译失败，也不会遗留可被误部署的旧发布包。 -->
  <Target Name="CleanPublishStagingDirectory" BeforeTargets="PrepareForBuild">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin\Release\PublishClean" />
  </Target>

</Project>
