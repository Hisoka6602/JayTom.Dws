<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style x:Key="CustomExpanderStyle" TargetType="{x:Type Expander}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <StackPanel Orientation="Vertical">

                        <ContentPresenter
                            x:Name="ExpandSite"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="false"
                            Visibility="Collapsed" />

                        <ToggleButton
                            x:Name="HeaderSite"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#F1F2F8"
                            BorderBrush="#F1F2F8"
                            FocusVisualStyle="{x:Null}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource                             TemplatedParent}}"
                            Style="{StaticResource MaterialDesignActionToggleButton}"
                            ToolTip="展开">
                            <ToggleButton.Content>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="&#xe83e;" />
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="&#xe840;" />
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>
                    </StackPanel>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsExpanded" Value="true">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderSite" Property="ToolTip" Value="收缩" />
                        </Trigger>

                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderSite" Property="ToolTip" Value="展开" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>