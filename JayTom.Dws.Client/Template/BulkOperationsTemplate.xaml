<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        x:Key="BulkOperationsTemplate"
        TargetType="Page">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  内容  -->
            <ContentControl Grid.Row="0" Content="{TemplateBinding Content}" />

            <!--  操作按钮  -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <!--  批量导入  -->
                <Button
                    Margin="8,20"
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource BulkOperationsButtonStyle}"
                    ToolTip="批量导入">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor=""
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="26"
                        Foreground="White"
                        Text="&#xe81b;" />
                </Button>
                <!--  批量导出  -->
                <Button
                    Margin="8,20"
                    Command="{Binding ExportCommand}"
                    Style="{StaticResource BulkOperationsButtonStyle}"
                    ToolTip="批量导出">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor=""
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="26"
                        Foreground="White"
                        Text="&#xe81a;" />
                </Button>
                <!--  添加按钮  -->
                <Button
                    Margin="8,20"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource BulkOperationsButtonStyle}"
                    ToolTip="添加数据">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor=""
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="26"
                        Foreground="White"
                        Text="&#xe820;" />
                </Button>
                <!--  批量添加  -->
                <Button
                    Margin="8,20"
                    Command="{Binding BulkAddCommand}"
                    Style="{StaticResource BulkOperationsButtonStyle}"
                    ToolTip="批量添加">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor=""
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="26"
                        Foreground="White"
                        Text="&#xe95f;" />
                </Button>
                <!--  批量删除  -->
                <Button
                    Margin="8,20"
                    Command="{Binding BulkDeleteCommand}"
                    Style="{StaticResource BulkOperationsButtonStyle}"
                    ToolTip="批量删除">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor=""
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="26"
                        Foreground="White"
                        Text="&#xe95e;" />
                </Button>
                <!--  全部删除  -->
                <Button
                    Margin="8,20"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource BulkOperationsButtonStyle}"
                    ToolTip="全部删除">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor=""
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="26"
                        Foreground="White"
                        Text="&#xe960;" />
                </Button>
            </StackPanel>
            <!--  提示控件  -->
            <materialDesign:Snackbar
                Grid.Row="1"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding MessageQueue}" />
        </Grid>
    </ControlTemplate>
</ResourceDictionary>