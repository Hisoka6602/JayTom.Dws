<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:cameras="clr-namespace:JayTom.Dws.Client.Models.Cameras"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <cameraConverter:BoundCameraTypeConverter x:Key="BoundCameraTypeConverter" />
    <converters:CameraTypeToolTipConverter x:Key="CameraTypeToolTipConverter" />
    <cameraConverter:BoundCameraTypeCornerRadiusConverter x:Key="BoundCameraTypeCornerRadiusConverter" />
    <cameraConverter:BoundCameraTypeVisibilityConverter x:Key="BoundCameraTypeVisibilityConverter" />
    <cameraConverter:CameraHasBindingVisibilityConverter x:Key="CameraHasBindingVisibilityConverter" />

    <DataTemplate x:Key="CameraFinderTemplate" DataType="{x:Type cameras:CameraFinderItemInfoModel}">
        <materialDesign:Card
            Grid.Row="1"
            Margin="15,5"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="#2E2E2E"
            ClipToBounds="False"
            UniformCornerRadius="25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MaxWidth="280" />
                    <ColumnDefinition Width="Auto" MaxWidth="240" />
                    <ColumnDefinition Width="Auto" MaxWidth="230" />
                    <ColumnDefinition Width="Auto" MaxWidth="240" />
                    <ColumnDefinition Width="260" MinWidth="260" />
                </Grid.ColumnDefinitions>
                <!--  相机名称  -->
                <StackPanel
                    Grid.Column="0"
                    MinHeight="50"
                    Margin="8,0"
                    Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe63a;" />
                    <!--  说明  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="相机名称:" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{Binding Name}" />
                </StackPanel>
                <!--  相机序列号  -->
                <StackPanel
                    Grid.Column="1"
                    MinHeight="50"
                    Margin="8,0"
                    Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="&#xe6a0;" />
                    <!--  说明  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="相机序列号:" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{Binding SerialNumber}" />
                </StackPanel>
                <!--  相机型号  -->
                <StackPanel
                    Grid.Column="2"
                    MinHeight="50"
                    Margin="8,0"
                    Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="18"
                        FontWeight="Light"
                        Foreground="DarkGray"
                        Text="&#xe69e;" />
                    <!--  说明  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="相机型号:" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{Binding Model}" />
                </StackPanel>
                <!--  相机 IP 地址  -->
                <StackPanel
                    Grid.Column="3"
                    MinHeight="50"
                    Margin="8,0"
                    Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe6e8;" />
                    <!--  说明  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="IP 地址:" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{Binding IpAddress}" />
                </StackPanel>
                <!--  相机类型  -->
                <StackPanel
                    Grid.Column="4"
                    MinHeight="50"
                    Margin="8,0"
                    Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe6a6;" />
                    <!--  说明  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="相机类型:" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{Binding CameraType, Converter={StaticResource CameraTypeToolTipConverter}}" />
                </StackPanel>
                <!--  绑定/解绑  -->
                <Grid Grid.Column="5">
                    <StackPanel
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasBinding, Converter={StaticResource CameraHasBindingVisibilityConverter}, ConverterParameter=BindButton, UpdateSourceTrigger=PropertyChanged}">
                        <Grid Width="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  绑定到全景相机  -->
                            <Button
                                Grid.Column="0"
                                Width="Auto"
                                Height="45"
                                MinWidth="125"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="{Binding CameraType, Converter={StaticResource BoundCameraTypeCornerRadiusConverter}, ConverterParameter=PanoramaCamera}"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="BlueViolet"
                                Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindPanoramaCameraCommand}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                Visibility="{Binding CameraType, Converter={StaticResource BoundCameraTypeVisibilityConverter}, ConverterParameter=PanoramaCamera}">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="绑定全景相机" />
                            </Button>
                            <!--  绑定到扫码相机  -->
                            <Button
                                Grid.Column="1"
                                Width="Auto"
                                Height="45"
                                MinWidth="125"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="{Binding CameraType, Converter={StaticResource BoundCameraTypeCornerRadiusConverter}, ConverterParameter=BarcodeScannerCamera}"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="RoyalBlue"
                                Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindBarcodeScannerCameraCommand}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                Visibility="{Binding CameraType, Converter={StaticResource BoundCameraTypeVisibilityConverter}, ConverterParameter=BarcodeScannerCamera}">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="绑定扫码相机" />
                            </Button>
                            <!--  绑定到体积相机  -->
                            <Button
                                Grid.Column="2"
                                Width="Auto"
                                Height="45"
                                MinWidth="125"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                materialDesign:ButtonAssist.CornerRadius="{Binding CameraType, Converter={StaticResource BoundCameraTypeCornerRadiusConverter}, ConverterParameter=VolumeCamera}"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="DodgerBlue"
                                Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindVolumeCameraCommand}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                Visibility="{Binding CameraType, Converter={StaticResource BoundCameraTypeVisibilityConverter}, ConverterParameter=VolumeCamera}">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="绑定体积相机" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasBinding, Converter={StaticResource CameraHasBindingVisibilityConverter}, ConverterParameter=UnbindButton, UpdateSourceTrigger=PropertyChanged}">
                        <!--  绑定到扫码相机  -->
                        <Button
                            Width="160"
                            Height="45"
                            Margin="0"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="5,0,0,5"
                            materialDesign:ShadowAssist.ShadowEdges="Right"
                            Background="{Binding BoundType, Converter={StaticResource BoundCameraTypeConverter}, ConverterParameter=Color}"
                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                            ToolTip="NextPage">
                            <TextBlock
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                RenderTransformOrigin=".5,.5">
                                <Run Text="已绑定" /><Run Text="{Binding BoundType, Converter={StaticResource BoundCameraTypeConverter}, ConverterParameter=Text}" />
                            </TextBlock>
                        </Button>
                        <!--  绑定到体积相机  -->
                        <Button
                            Width="90"
                            Height="45"
                            Margin="0"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                            materialDesign:ShadowAssist.ShadowEdges="Right"
                            Background="DarkRed"
                            Command="{Binding ElementName=CameraFinderView, Path=DataContext.UnbindCommand}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                            ToolTip="LastPage">
                            <TextBlock
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                RenderTransformOrigin=".5,.5"
                                Text="解绑" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </DataTemplate>
</ResourceDictionary>