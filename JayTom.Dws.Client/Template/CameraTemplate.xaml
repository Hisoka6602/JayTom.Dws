<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:interactivity="http://prismlibrary.com/"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models">

    <cameraConverter:CameraStatusConverter x:Key="CameraStatusConverter" />
    <cameraConverter:CameraTypeConverter x:Key="CameraTypeConverter" />
    <cameraConverter:CameraConnectionTypeConverter x:Key="CameraConnectionTypeConverter" />
    <converters:RectConverter x:Key="RectConverter" />
    <cameraConverter:CameraGridWidthConverter x:Key="CameraGridWidthConverter" />
    <cameraConverter:CameraGridHeightConverter x:Key="CameraGridHeightConverter" />
    <!--  CameraGridHeightConverter  -->
    <DataTemplate x:Key="CameraTemplate" DataType="{x:Type models:CameraItemInfoModel}">
        <materialDesign:Card
            materialDesign:ElevationAssist.Elevation="Dp0"
            Background="Transparent"
            UniformCornerRadius="15">
            <Grid
                Name="CameraGrid"
                Width="{Binding Items.Count, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}, Converter={StaticResource CameraGridWidthConverter}}"
                Height="{Binding Items.Count, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}, Converter={StaticResource CameraGridHeightConverter}}"
                Margin="10"
                Background="#2E2E2E">
                <Grid.Clip>
                    <RectangleGeometry RadiusX="15" RadiusY="15">
                        <RectangleGeometry.Rect>
                            <MultiBinding Converter="{StaticResource RectConverter}">
                                <Binding
                                    ElementName="CameraGrid"
                                    Path="ActualWidth"
                                    UpdateSourceTrigger="PropertyChanged" />
                                <Binding
                                    ElementName="CameraGrid"
                                    Path="ActualHeight"
                                    UpdateSourceTrigger="PropertyChanged" />
                            </MultiBinding>
                        </RectangleGeometry.Rect>
                    </RectangleGeometry>
                </Grid.Clip>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <!--  图片  -->
                <Grid Grid.Row="0">
                    <!--  默认底图  -->
                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#iconfont"
                        FontSize="150"
                        Foreground="DimGray"
                        IsEnabled="False"
                        Text="&#xe60e;" />
                    <Image
                        Name="PackImage"
                        Grid.Row="0"
                        RenderOptions.BitmapScalingMode="LowQuality"
                        Source="{Binding Image, Mode=OneWay}"
                        Stretch="Fill">
                        <Image.InputBindings>
                            <MouseBinding
                                Command="{Binding ImageClickCommand}"
                                CommandParameter="{Binding}"
                                MouseAction="LeftClick" />
                        </Image.InputBindings>
                    </Image>
                </Grid>

                <!--  状态线  -->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,-7"
                    VerticalAlignment="Bottom">
                    <Border
                        Height="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{Binding Status, Converter={StaticResource CameraStatusConverter}, ConverterParameter=Color}" />
                    <Ellipse
                        Grid.Row="0"
                        Width="15"
                        Height="15"
                        Margin="30,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Fill="{Binding Status, Converter={StaticResource CameraStatusConverter}, ConverterParameter=Color}" />
                </Grid>

                <!--  其他内容  -->
                <Border Name="MessageBorder" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>

                        <!--  相机操作  -->
                        <!--<Button
                            Grid.Row="0"
                            Margin="10,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                            Command="{Binding StatusClickCommand}"
                            CommandParameter="{Binding}"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignIconButton}">
                            <Grid>
                                <TextBlock
                                    Name="StatusBlock"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#iconfont"
                                    FontSize="20"
                                    Foreground="FloralWhite"
                                    Text="{Binding Status, Mode=OneWay, Converter={StaticResource CameraStatusReadyFontConverter}}"
                                    Visibility="Visible" />
                                <ProgressBar
                                    Name="StatusProgressBar"
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True"
                                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                                    Visibility="Hidden"
                                    Value="0" />
                            </Grid>
                        </Button>-->
                        <!--  相机操作-开关实时流、拍照  -->
                        <StackPanel
                            Grid.Row="0"
                            Margin="10,5,10,0"
                            Orientation="Horizontal">
                            <Button
                                Width="40"
                                Height="30"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="15,0,0,15"
                                Background="#3C3C3C"
                                Command="{Binding SwitchRealtimeImageCommand}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="开关实时画面">
                                <TextBlock
                                    Name="SwitchRealtimeImageBlock"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#iconfont"
                                    FontSize="20"
                                    Foreground="FloralWhite"
                                    Opacity="0.6"
                                    Text="&#xea82;"
                                    Visibility="Visible" />
                            </Button>
                            <Border
                                Width="1"
                                Height="20"
                                BorderBrush="Transparent"
                                BorderThickness="1" />
                            <Button
                                Width="40"
                                Height="30"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0,15,15,0"
                                Background="#3C3C3C"
                                Command="{Binding TakePhotoCommand}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="拍照">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    Opacity="0.6"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe772;" />
                            </Button>
                        </StackPanel>
                        <!--  帧率  -->
                        <StackPanel
                            Grid.Row="0"
                            MaxWidth="100"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#iconfont"
                                FontSize="20"
                                Foreground="Orange"
                                Text="&#xe647;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="13"
                                FontWeight="Black"
                                Foreground="DimGray"
                                IsEnabled="False"
                                TextAlignment="Center">
                                <Run Text="帧率:" />
                                <Run Text="{Binding FrameRate, StringFormat={}{0:F1}}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  相机类型  -->
                            <TextBlock
                                Margin="10,2"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#iconfont"
                                FontSize="25"
                                Foreground="DimGray"
                                Text="{Binding Type, Mode=OneWay, Converter={StaticResource CameraTypeConverter}, ConverterParameter=Font}"
                                ToolTip="{Binding Type, Mode=OneWay, Converter={StaticResource CameraTypeConverter}, ConverterParameter=ToolTip}" />
                            <!--  分割线  -->
                            <Rectangle
                                Width="1"
                                Height="18"
                                VerticalAlignment="Stretch"
                                Fill="DimGray"
                                IsEnabled="False" />
                            <!--  连接方式  -->
                            <TextBlock
                                Margin="10,2"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#iconfont"
                                FontSize="20"
                                Foreground="DimGray"
                                Text="{Binding ConnectionType, Mode=OneWay, Converter={StaticResource CameraConnectionTypeConverter}, ConverterParameter=Font}"
                                ToolTip="{Binding ConnectionType, Mode=OneWay, Converter={StaticResource CameraConnectionTypeConverter}, ConverterParameter=ToolTip}" />
                        </StackPanel>
                        <!--  相机名称  -->
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            IsEnabled="False"
                            Text="{Binding CameraName, Mode=OneWay}"
                            TextAlignment="Center" />
                        <!--  隐藏按钮  -->
                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Width="40"
                            Height="30"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#3C3C3C"
                            BorderThickness="0"
                            Command="{Binding HideCommand}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <TextBlock
                                Margin="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#iconfont"
                                FontSize="25"
                                Foreground="FloralWhite"
                                Opacity="0.6"
                                Text="&#xea6b;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRealtimeImageEnabled}" Value="True">
                <Setter TargetName="SwitchRealtimeImageBlock" Property="Text" Value="&#xe774;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRealtimeImageEnabled}" Value="False">
                <Setter TargetName="SwitchRealtimeImageBlock" Property="Text" Value="&#xea82;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSwitchingState}" Value="True">
                <!--<Setter TargetName="StatusBlock" Property="Visibility" Value="Hidden" />
                <Setter TargetName="StatusProgressBar" Property="Visibility" Value="Visible" />-->
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSwitchingState}" Value="False">
                <!--<Setter TargetName="StatusBlock" Property="Visibility" Value="Visible" />
                <Setter TargetName="StatusProgressBar" Property="Visibility" Value="Hidden" />-->
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Disconnected">
                <Setter TargetName="PackImage" Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failure">
                <Setter TargetName="PackImage" Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter TargetName="PackImage" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
