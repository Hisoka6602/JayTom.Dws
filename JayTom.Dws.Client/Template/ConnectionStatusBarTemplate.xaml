<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models.StatusBarModels"
    xmlns:statusBarConverters="clr-namespace:JayTom.Dws.Client.Converters.StatusBarConverters">
    <statusBarConverters:StatusBarConnectionTypeConverter x:Key="StatusBarConnectionTypeConverter" />
    <statusBarConverters:StatusBarConnectionStateConverter x:Key="StatusBarConnectionStateConverter" />
    <DataTemplate x:Key="ConnectionStatusBarTemplate" DataType="{x:Type models:ConnectionItemInfoModel}">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <!--  连接名称  -->
            <TextBlock
                Grid.Column="0"
                MaxWidth="170"
                Margin="10,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                FontSize="13"
                Foreground="DimGray"
                Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Center"
                TextTrimming="WordEllipsis"
                ToolTip="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}" />
            <!--  连接方式  -->
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#iconfont"
                FontSize="25"
                FontWeight="Bold"
                Foreground="DimGray"
                Text="{Binding ConnectionType, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StatusBarConnectionTypeConverter}, ConverterParameter=Font}"
                ToolTip="{Binding ConnectionType, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StatusBarConnectionTypeConverter}, ConverterParameter=Text}" />
            <!--  连接状态  -->
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#iconfont"
                FontSize="30"
                Foreground="{Binding ConnectionState, Converter={StaticResource StatusBarConnectionStateConverter}, ConverterParameter=Color}"
                Text="&#xe7a6;" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>