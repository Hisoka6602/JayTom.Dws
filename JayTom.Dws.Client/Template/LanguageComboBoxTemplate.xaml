<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models">
    <DataTemplate x:Key="LanguageComboBoxTemplate" DataType="{x:Type models:LanguageInfoModel}">
        <StackPanel
            Height="40"
            Margin="0"
            Orientation="Horizontal">
            <!--  国旗图像(圆角)  -->
            <Border
                Width="20"
                Height="20"
                Margin="10,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="2"
                Focusable="False">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding NationalFlag}" />
                </Border.Background>
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding DisplayName}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>