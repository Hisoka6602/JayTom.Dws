<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models">
    <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
    <converters:ByteSizeUnitConverter x:Key="ByteSizeUnitConverter" />
    <converters:NetworkTypeFontConverter x:Key="NetworkTypeFontConverter" />
    <DataTemplate x:Key="NetworkTemplate" DataType="{x:Type models:LocalNetworkConnectionInfoModel}">
        <DataTemplate.Resources>
            <FontFamily x:Key="CustomFontFamily">
                pack://application:,,,/Fonts/#更纱黑体 Mono SC Nerd
            </FontFamily>
            <FontFamily x:Key="IconFontFamily">
                pack://application:,,,/Fonts/#iconfont
            </FontFamily>
        </DataTemplate.Resources>
        <Grid Margin="26,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="120" MaxWidth="130" />
                <ColumnDefinition Width="90" MaxWidth="130" />
                <ColumnDefinition Width="90" MaxWidth="130" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  图标  -->
            <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="25"
                Foreground="DimGray"
                Text="{Binding Type, Converter={StaticResource NetworkTypeFontConverter}}" />
            <!--  名称  -->
            <TextBlock
                Grid.Column="1"
                MinWidth="100"
                MaxWidth="130"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource CustomFontFamily}"
                FontSize="12"
                FontWeight="Bold"
                Foreground="DimGray"
                IsEnabled="False"
                TextAlignment="Justify"
                TextTrimming="WordEllipsis">
                <Run Text="{Binding ConnectionName}" />
            </TextBlock>
            <!--  上传  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <!--  图标  -->
                <TextBlock
                    Margin="2,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="16"
                    Foreground="RoyalBlue"
                    Text="&#xe651;" />
                <!--  信息  -->
                <TextBlock
                    MaxWidth="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CustomFontFamily}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="DimGray"
                    IsEnabled="False"
                    TextAlignment="Left"
                    TextTrimming="WordEllipsis">
                    <Run Text="{Binding UploadSpeed, StringFormat={}{0:F2}, Converter={StaticResource ByteSizeConverter}}" /> <Run FontSize="10" Text="{Binding UploadSpeed, Converter={StaticResource ByteSizeUnitConverter}}" />
                </TextBlock>
            </StackPanel>
            <!--  下载  -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">

                <!--  图标  -->
                <TextBlock
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="16"
                    Foreground="OrangeRed"
                    Text="&#xe650;" />
                <!--  信息  -->
                <TextBlock
                    MaxWidth="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CustomFontFamily}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="DimGray"
                    IsEnabled="False"
                    TextAlignment="Left"
                    TextTrimming="WordEllipsis">
                    <Run Text="{Binding DownloadSpeed, StringFormat={}{0:F2}, Converter={StaticResource ByteSizeConverter}}" /> <Run FontSize="10" Text="{Binding UploadSpeed, Converter={StaticResource ByteSizeUnitConverter}}" />
                </TextBlock>
            </StackPanel>
            <!--  速度  -->
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DimGray"
                    Text="&#xe6ed;" />
                <!--  信息  -->
                <TextBlock
                    MaxWidth="180"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CustomFontFamily}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="DimGray"
                    IsEnabled="False"
                    TextAlignment="Left"
                    TextTrimming="WordEllipsis">
                    <Run Text="速度:" /><Run Text="{Binding Speed, StringFormat={}{0:F2}, Converter={StaticResource ByteSizeConverter}, ConverterParameter=1000}" /> <Run FontSize="10" Text="{Binding Speed, Converter={StaticResource ByteSizeUnitConverter}, ConverterParameter=1000}" />
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnection}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!--  未连接  -->
                <TextBlock
                    MaxWidth="180"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CustomFontFamily}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="DimGray"
                    IsEnabled="False"
                    Text="未连接"
                    TextAlignment="Left"
                    TextTrimming="WordEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>