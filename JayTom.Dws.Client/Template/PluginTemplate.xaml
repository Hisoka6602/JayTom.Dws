<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models">
    <converters:PluginIconFontConverter x:Key="PluginIconFontConverter" />
    <converters:PluginStatusColorConverter x:Key="PluginStatusColorConverter" />
    <converters:PluginStatusIconFontConverter x:Key="PluginStatusIconFontConverter" />
    <DataTemplate x:Key="PluginTemplate" DataType="{x:Type models:PluginItemInfoModel}">
        <!--  选中绿条  -->
        <Button
            MinHeight="70"
            Margin="0,5"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            materialDesign:ButtonAssist.CornerRadius="10"
            Command="{Binding ClickCommand}"
            CommandParameter="{Binding}">
            <Button.Style>
                <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                    <Setter Property="Background" Value="#2E2E2E" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                <TranslateTransform X="0" Y="0" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>

            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  图标、状态  -->
                <Grid Grid.Column="0">
                    <!--  图标  -->
                    <Border
                        Width="50"
                        Height="50"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="../Image/ocr-img.png" />
                        </Border.Background>
                    </Border>
                    <!--  状态  -->
                    <!--<Border
                        Width="26"
                        Height="26"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#2E2E2E"
                        CornerRadius="13">
                    </Border>-->
                    <TextBlock
                        Margin="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontFamily="pack://application:,,,/Fonts/#iconfont"
                        FontSize="18"
                        Foreground="{Binding Status, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PluginStatusColorConverter}}"
                        Text="{Binding Status, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PluginStatusIconFontConverter}}">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="3"
                                Direction="0"
                                Opacity="1"
                                ShadowDepth="0"
                                Color="White" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
                <Border Grid.Column="1">
                    <StackPanel Orientation="Vertical">
                        <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                            <!--  名称、作者  -->
                            <!--  名称  -->
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="20,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="13"
                                FontWeight="Light"
                                Foreground="White">
                                <Run Text="作者:" /><Run Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                            </TextBlock>
                        </StackPanel>
                        <!--  简述  -->
                        <TextBlock
                            MaxWidth="800"
                            Margin="0,5,30,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="12"
                            FontWeight="Light"
                            Foreground="White"
                            Text="{Binding Description}"
                            TextTrimming="WordEllipsis"
                            ToolTip="{Binding Description}" />

                        <!--  发行日期 、版本号  -->
                        <StackPanel
                            Margin="0,2"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <!--  名称、作者  -->
                            <!--  名称  -->
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="10"
                                FontWeight="Light"
                                Foreground="White">
                                <Run Text="发行日期:" /><Run Text="{Binding ReleaseDate, StringFormat={}{0:yyyy-MM-dd}}" />
                            </TextBlock>
                            <TextBlock
                                Margin="20,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="10"
                                FontWeight="Light"
                                Foreground="White">
                                <Run Text="版本号:" /><Run Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!--  类型  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#iconfont"
                    FontSize="16"
                    Foreground="DodgerBlue"
                    Text="{Binding Type, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PluginIconFontConverter}}" />
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>