<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models">

    <converters:SerialPortTypeFontConverter x:Key="SerialPortTypeFontConverter" />
    <converters:SerialPortTypeToolTipConverter x:Key="SerialPortTypeToolTipConverter" />
    <converters:SerialPortStatusColorConverter x:Key="SerialPortStatusColorConverter" />

    <DataTemplate x:Key="SerialPortTemplate" DataType="{x:Type models:SerialPortInfoModel}">

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <!--  串口类型  -->
            <TextBlock
                Grid.Column="0"
                Margin="10,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#iconfont"
                FontSize="25"
                Foreground="DimGray"
                Text="{Binding Type, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SerialPortTypeFontConverter}}"
                ToolTip="{Binding Type, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SerialPortTypeToolTipConverter}}" />
            <!--  相机名称  -->
            <TextBlock
                Grid.Column="1"
                MaxWidth="140"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DimGray"
                IsEnabled="False"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Center"
                TextTrimming="WordEllipsis" />
            <!--  状态  -->
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#iconfont"
                FontSize="30"
                Foreground="{Binding Status, Converter={StaticResource SerialPortStatusColorConverter}}"
                Text="&#xe7a6;" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>