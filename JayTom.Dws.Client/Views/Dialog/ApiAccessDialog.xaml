<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.ApiAccessDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <mvvm:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="800" />
            <Setter Property="Height" Value="600" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </mvvm:Dialog.WindowStyle>
    <materialDesign:Card
        Margin="0"
        materialDesign:ElevationAssist.Elevation="Dp2"
        materialDesign:ShadowAssist.Darken="True"
        materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
        Background="#2E2E2E"
        UniformCornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  系统按钮  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="Transparent"
                CornerRadius="5,5,0,0">
                <!--  系统按钮  -->
                <StackPanel
                    Margin="10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  关闭  -->
                    <Button
                        Command="{Binding CloseWinCommand}"
                        Style="{StaticResource CustomCloseButtonStyle}"
                        ToolTip="Close">
                        <TextBlock
                            Foreground="White"
                            Style="{StaticResource SystemTextBlockStyle}"
                            Text="&#xe601;" />
                    </Button>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  条码、提交状态  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        IsEnabled="False"
                        Text="条码:" />
                    <TextBlock
                        Margin="5,0,20,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        IsEnabled="False"
                        Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        IsEnabled="False"
                        Text="验证状态:" />
                    <!--  图标  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="18"
                        Foreground="{Binding RequestStatus, Converter={StaticResource UploadStatusConverter}, ConverterParameter=Background}"
                        Text="{Binding RequestStatus, Converter={StaticResource UploadStatusConverter}, ConverterParameter=FontText}" />
                    <!--  文字  -->
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        IsEnabled="False"
                        TextAlignment="Justify"
                        TextTrimming="WordEllipsis">
                        <Run Text="{Binding RequestStatus, UpdateSourceTrigger=PropertyChanged}" />
                    </TextBlock>
                </StackPanel>
                <!--  提交时间  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,5"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        IsEnabled="False"
                        Text="请求时间:" />
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        IsEnabled="False"
                        Text="{Binding RequestTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                </StackPanel>
                <!--  提交信息  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,5"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        IsEnabled="False"
                        Text="请求内容:" />
                    <!--  提交内容框  -->
                    <TextBox
                        Height="150"
                        Margin="0,20"
                        materialDesign:HintAssist.Hint="请求内容"
                        materialDesign:HintAssist.IsFloating="False"
                        AcceptsReturn="True"
                        Background="#202020"
                        BorderBrush="Transparent"
                        Foreground="White"
                        IsReadOnly="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding RequestContent, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <!--  响应时间  -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,5"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        IsEnabled="False"
                        Text="响应时间:" />
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        IsEnabled="False"
                        Text="{Binding ResponseTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                </StackPanel>
                <!--  响应信息  -->
                <StackPanel
                    Grid.Row="4"
                    Margin="0,5"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        IsEnabled="False"
                        Text="响应内容:" />
                    <!--  提交内容框  -->
                    <TextBox
                        Height="150"
                        Margin="0,20"
                        materialDesign:HintAssist.Hint="响应内容"
                        materialDesign:HintAssist.IsFloating="False"
                        AcceptsReturn="True"
                        Background="#202020"
                        BorderBrush="Transparent"
                        Foreground="White"
                        IsReadOnly="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding ResponseContent, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>

            </Grid>

        </Grid>
    </materialDesign:Card>
</UserControl>