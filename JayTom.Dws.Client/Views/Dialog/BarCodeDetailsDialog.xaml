<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.BarCodeDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="http://prismlibrary.com/"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="BarCodeDetailsView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    dialogs:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:SortingModeConverter x:Key="SortingModeConverter" />
        <converters:CommunicationMethodConverter x:Key="CommunicationMethodConverter" />
        <converters:SourceTypeConverter x:Key="SourceTypeConverter" />
        <converters:UploadStatusToVisibilityConverter x:Key="UploadStatusToVisibilityConverter" />
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="BarCodeDetailsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <dialogs:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="750" />
            <Setter Property="Height" Value="800" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </dialogs:Dialog.WindowStyle>
    <materialDesign:Card
        Margin="0"
        materialDesign:ElevationAssist.Elevation="Dp2"
        materialDesign:ShadowAssist.Darken="True"
        materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
        Background="#2E2E2E"
        UniformCornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  系统按钮  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="Transparent"
                CornerRadius="5,5,0,0">
                <!--  系统按钮  -->
                <StackPanel
                    Margin="10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  关闭  -->
                    <Button
                        Command="{Binding CloseWinCommand}"
                        Style="{StaticResource CustomCloseButtonStyle}"
                        ToolTip="Close">
                        <TextBlock
                            Foreground="White"
                            Style="{StaticResource SystemTextBlockStyle}"
                            Text="&#xe601;" />
                    </Button>
                </StackPanel>
            </Border>
            <ScrollViewer
                Grid.Row="1"
                Margin="10,5"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <!--  条码  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            IsEnabled="False"
                            Text="{x:Static languages:Language.BarcodeCondition}" />
                        <TextBlock
                            Margin="5,0,20,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            IsEnabled="False"
                            Text="{Binding BarCodeItem.Barcode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <!--  分拣信息  -->
                    <StackPanel
                        Margin="5,10"
                        Orientation="Vertical"
                        Visibility="{Binding BarCodeItem.SortingInfo.IsSortingUsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="10,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="25"
                                Foreground="DimGray"
                                Text="&#xe79f;" />
                            <!--  分拣信息  -->
                            <TextBlock
                                MaxWidth="450"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                IsEnabled="False"
                                Text="分拣信息"
                                TextAlignment="Center"
                                TextTrimming="WordEllipsis" />
                        </StackPanel>
                        <Grid Margin="12,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="100" />
                                <RowDefinition Height="100" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <!--  物流  -->
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    Foreground="DimGray"
                                    Text="&#xe7a9;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    MaxWidth="140"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="物流:" /> <Run Foreground="#BFFFFFFF" Text="韵达" />
                                </TextBlock>
                            </Grid>
                            <!--  分拣模式  -->
                            <Grid
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    Foreground="DimGray"
                                    Text="&#xe7b9;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    MaxWidth="180"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Left"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="分拣模式:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.SortingInfo.SortingMode, Converter={StaticResource SortingModeConverter}}" />
                                </TextBlock>
                            </Grid>
                            <!--  创建包裹时间  -->
                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    FontWeight="Light"
                                    Foreground="DimGray"
                                    Text="&#xe82f;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="创建包裹时间:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.SortingInfo.PackageCreationTime, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" />
                                </TextBlock>
                            </Grid>
                            <!--  是否由下位机创建  -->
                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    Foreground="DimGray"
                                    Text="&#xe79d;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    MaxWidth="200"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Justify"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="是否由下位机创建:" />
                                </TextBlock>
                                <CheckBox
                                    Grid.Column="2"
                                    Margin="5,0"
                                    IsEnabled="False"
                                    Style="{StaticResource CustomCheckBoxStyle}" />
                            </Grid>
                            <!--  通讯方式  -->
                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    FontWeight="Light"
                                    Foreground="DimGray"
                                    Text="&#xe7ce;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="通讯方式:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.SortingInfo.CommunicationMethod, Converter={StaticResource CommunicationMethodConverter}}" />
                                </TextBlock>
                            </Grid>
                            <!--  通讯协议  -->
                            <Grid
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    FontWeight="Light"
                                    Foreground="DimGray"
                                    Text="&#xe7fc;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="通讯协议:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.SortingInfo.ChecksumProtocolName}" />
                                </TextBlock>
                            </Grid>
                            <!--  指令目标  -->
                            <Grid
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    Text="&#xe7d2;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="指令目标:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.SortingInfo.CommandTarget}" />
                                </TextBlock>
                            </Grid>
                            <!--  创建包裹指令  -->
                            <StackPanel
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    Text="创建包裹指令:" />
                                <Border
                                    MinHeight="70"
                                    MaxHeight="100"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#202020"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="580"
                                        MinHeight="70"
                                        MaxWidth="580"
                                        MaxHeight="70"
                                        Margin="5,0"
                                        VerticalContentAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding BarCodeItem.SortingInfo.PackageCreationInstruction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </StackPanel>
                            <!--  发送的格口指令  -->
                            <StackPanel
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    Text="发送的格口指令:" />
                                <Border
                                    MinHeight="70"
                                    MaxHeight="100"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#202020"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="580"
                                        MinHeight="70"
                                        MaxWidth="580"
                                        MaxHeight="70"
                                        Margin="5,0"
                                        VerticalContentAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding BarCodeItem.SortingInfo.SentInstruction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </StackPanel>
                            <!--  接收的回调指令  -->
                            <StackPanel
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    Text="接收的回调指令:" />
                                <Border
                                    MinHeight="70"
                                    MaxHeight="100"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#202020"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="580"
                                        MinHeight="70"
                                        MaxWidth="580"
                                        MaxHeight="70"
                                        Margin="5,0"
                                        VerticalContentAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding BarCodeItem.SortingInfo.ReceivedInstruction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Rectangle
                            Height="1"
                            Opacity="0.15"
                            Stroke="DimGray"
                            StrokeDashArray="8"
                            StrokeThickness="1" />
                    </StackPanel>
                    <!--  称重信息  -->
                    <StackPanel Margin="5,10" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="10,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="23"
                                Foreground="DimGray"
                                Text="&#xe723;" />
                            <!--  称重信息  -->
                            <TextBlock
                                MaxWidth="450"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                IsEnabled="False"
                                Text="称重信息"
                                TextAlignment="Center"
                                TextTrimming="WordEllipsis" />
                        </StackPanel>
                        <Grid Margin="12,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="100" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <!--  来源类型  -->
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    Foreground="DimGray"
                                    Text="&#xed1e;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="来源类型:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.WeightInfo.SourceType, Converter={StaticResource SourceTypeConverter}}" />
                                </TextBlock>
                            </Grid>
                            <!--  连接设备名称  -->
                            <Grid
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    Foreground="DimGray"
                                    Text="&#xe7f7;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="连接设备名称:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.WeightInfo.SerialPortName}" />
                                </TextBlock>
                            </Grid>
                            <!--  源字符  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    Text="源字符内容:" />
                                <Border
                                    MinHeight="70"
                                    MaxHeight="100"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#202020"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="580"
                                        MinHeight="70"
                                        MaxWidth="580"
                                        MaxHeight="70"
                                        Margin="5,0"
                                        VerticalContentAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding BarCodeItem.WeightInfo.OriginalText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </StackPanel>
                            <!--  格式化后重量  -->
                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    Foreground="DimGray"
                                    Text="&#xe722;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="格式化后重量:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.WeightInfo.FormattedWeight, StringFormat={}{0:F3}}" />
                                </TextBlock>
                            </Grid>
