                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    Text="原始内容:" />
                                <Border
                                    MinHeight="70"
                                    MaxHeight="100"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#202020"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="580"
                                        MinHeight="70"
                                        MaxWidth="580"
                                        MaxHeight="70"
                                        Margin="5,0"
                                        VerticalContentAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding BarCodeItem.OcrInfo.OriginalContent}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </StackPanel>
                            <!--  解析后内容  -->
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    Text="原始内容:" />
                                <Border
                                    MinHeight="70"
                                    MaxHeight="100"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#202020"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="580"
                                        MinHeight="70"
                                        MaxWidth="580"
                                        MaxHeight="70"
                                        Margin="5,0"
                                        VerticalContentAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding BarCodeItem.OcrInfo.ParsedContent}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </StackPanel>
                            <!--  创建时间  -->
                            <Grid
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!--  图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="23"
                                    FontWeight="Light"
                                    Foreground="DimGray"
                                    Text="&#xe82f;" />
                                <!--  信息  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="DimGray"
                                    IsEnabled="False"
                                    TextAlignment="Center"
                                    TextTrimming="WordEllipsis">
                                    <Run Text="创建时间:" /> <Run Foreground="#BFFFFFFF" Text="{Binding BarCodeItem.OcrInfo.CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl>