<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.CameraConfiguration.NvrBindingPreviewViewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="http://prismlibrary.com/"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="NvrBindingPreviewView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#202020"
    mc:Ignorable="d">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="NvrBindingPreviewView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <converters:BorderClipMultiConverter x:Key="BorderClipMultiConverter" />
        <Style
            x:Key="MaterialDesignActionButtonStyle"
            BasedOn="{StaticResource MaterialDesignFloatingActionButton}"
            TargetType="Button">
            <Setter Property="materialDesign:ButtonProgressAssist.Value" Value="-1" />
            <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="False" />
            <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="False" />
            <Setter Property="Background" Value="DimGray" />
            <Setter Property="BorderBrush" Value="DimGray" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="5,0" />
            <Style.Triggers>
                <!--  Trigger for when the button is pressed  -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="True" />
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="True" />
                </Trigger>

                <!--  Trigger for when the button is not pressed  -->
                <Trigger Property="IsPressed" Value="False">
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="False" />
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <dialogs:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="449" />
            <Setter Property="Height" Value="253" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </dialogs:Dialog.WindowStyle>
    <UserControl.Clip>
        <MultiBinding Converter="{StaticResource BorderClipMultiConverter}">
            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
            <Binding>
                <Binding.Source>
                    <CornerRadius>8</CornerRadius>
                </Binding.Source>
            </Binding>
        </MultiBinding>
    </UserControl.Clip>
    <Grid>

        <!--  画面  -->

        <Grid>
            <!--  默认底图  -->
            <Border
                Grid.Row="0"
                Width="449"
                Height="253">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#iconfont"
                    FontSize="150"
                    Foreground="DimGray"
                    IsEnabled="False"
                    Text="&#xe8da;"
                    Visibility="{Binding NvrPreviewViewInfo.IsShow, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </Border>

            <!--  画面  -->
            <Image
                Grid.Row="0"
                Width="449"
                Height="253"
                RenderOptions.BitmapScalingMode="LowQuality"
                Source="{Binding NvrPreviewViewInfo.VideoFrame, UpdateSourceTrigger=PropertyChanged}"
                Stretch="Uniform"
                Visibility="{Binding NvrPreviewViewInfo.IsShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  右下角通道  -->
            <TextBlock
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="13"
                FontWeight="Bold"
                Foreground="SpringGreen"
                Text="{Binding NvrPreviewViewInfo.ChannelId, StringFormat='通道{0}'}" />
        </Grid>
        <!--  关闭按钮  -->
        <Border
            Background="Transparent"
            BorderBrush="Transparent"
            CornerRadius="0,10,0,0">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">

                <!--  关闭  -->
                <Button
                    Command="{Binding CloseDialogCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}"
                    Style="{StaticResource CustomCloseButtonStyle}"
                    ToolTip="Close">
                    <TextBlock
                        Foreground="White"
                        Style="{StaticResource SystemTextBlockStyle}"
                        Text="&#xe601;" />
                </Button>
            </StackPanel>
        </Border>
        <!--  工具栏  -->
        <Border
            x:Name="ToolBarContainer"
            Height="90"
            Margin="0"
            Padding="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#88202020"
            CornerRadius="10,10,0,0"
            Visibility="{Binding IsMouseOver, ElementName=NvrBindingPreviewView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!--<Border.Clip>
                <CombinedGeometry>

                    ~1~  第二个 RectangleGeometry 用于裁剪掉左上角和右上角的圆角  @1@
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry
                            RadiusX="10"
                            RadiusY="10"
                            Rect="10,10,150,60" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Border.Clip>-->
            <StackPanel Background="Transparent" Orientation="Horizontal">
                <!--  自动对焦  -->
                <Button
                    Width="40"
                    Height="40"
                    materialDesign:RippleAssist.ClipToBounds="True"
                    materialDesign:RippleAssist.RippleOnTop="True"
                    Background="DimGray"
                    Command="{Binding AutoFocusCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="自动对焦" Cursor="Hand">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="25"
                        Foreground="White"
                        Text="&#xe9e3;" />
                </Button>
                <StackPanel Margin="10,0" Orientation="Vertical">
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  缩放  -->
                        <TextBlock
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Light"
                            Foreground="White"
                            IsEnabled="True"
                            Text="缩放:"
                            TextAlignment="Justify" />
                        <Button
                            Width="25"
                            Height="25"
                            Content="+"
                            Style="{StaticResource MaterialDesignActionButtonStyle}">
                            <b:Interaction.Triggers>
                                <!--  PreviewMouseDown Event  -->
                                <b:EventTrigger EventName="PreviewMouseDown">
                                    <b:InvokeCommandAction Command="{Binding IncreaseZoomCommand}" CommandParameter="Start" />
                                </b:EventTrigger>

                                <!--  PreviewMouseUp Event  -->
                                <b:EventTrigger EventName="PreviewMouseUp">
                                    <b:InvokeCommandAction Command="{Binding IncreaseZoomCommand}" CommandParameter="Stop" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Button>
                        <Button
                            Width="25"
                            Height="25"
                            Content="-"
                            Style="{StaticResource MaterialDesignActionButtonStyle}">
                            <b:Interaction.Triggers>
                                <!--  PreviewMouseDown Event  -->
                                <b:EventTrigger EventName="PreviewMouseDown">
                                    <b:InvokeCommandAction Command="{Binding DecreaseZoomCommand}" CommandParameter="Start" />
                                </b:EventTrigger>

                                <!--  PreviewMouseUp Event  -->
                                <b:EventTrigger EventName="PreviewMouseUp">
                                    <b:InvokeCommandAction Command="{Binding DecreaseZoomCommand}" CommandParameter="Stop" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  焦距  -->
                        <TextBlock
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Light"
                            Foreground="White"
                            IsEnabled="True"
                            Text="焦距:"
                            TextAlignment="Justify" />
                        <Button
                            Width="25"
                            Height="25"
                            Content="+"
                            Style="{StaticResource MaterialDesignActionButtonStyle}">
                            <b:Interaction.Triggers>
                                <!--  PreviewMouseDown Event  -->
                                <b:EventTrigger EventName="PreviewMouseDown">
                                    <b:InvokeCommandAction Command="{Binding IncreaseFocusCommand}" CommandParameter="Start" />
                                </b:EventTrigger>

                                <!--  PreviewMouseUp Event  -->
                                <b:EventTrigger EventName="PreviewMouseUp">
                                    <b:InvokeCommandAction Command="{Binding IncreaseFocusCommand}" CommandParameter="Stop" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Button>
                        <Button
                            Width="25"
                            Height="25"
                            Content="-"
                            Style="{StaticResource MaterialDesignActionButtonStyle}">
                            <b:Interaction.Triggers>
                                <!--  PreviewMouseDown Event  -->
                                <b:EventTrigger EventName="PreviewMouseDown">
                                    <b:InvokeCommandAction Command="{Binding DecreaseFocusCommand}" CommandParameter="Start" />
                                </b:EventTrigger>

                                <!--  PreviewMouseUp Event  -->
                                <b:EventTrigger EventName="PreviewMouseUp">
                                    <b:InvokeCommandAction Command="{Binding DecreaseFocusCommand}" CommandParameter="Stop" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>