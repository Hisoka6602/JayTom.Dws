<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.CameraConfiguration.NvrBindingPreviewViewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="http://prismlibrary.com/"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="NvrBindingPreviewView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="NvrBindingPreviewView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <converters:BorderClipMultiConverter x:Key="BorderClipMultiConverter" />
    </UserControl.Resources>
    <dialogs:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="449" />
            <Setter Property="Height" Value="253" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </dialogs:Dialog.WindowStyle>
    <UserControl.Clip>
        <MultiBinding Converter="{StaticResource BorderClipMultiConverter}">
            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
            <Binding>
                <Binding.Source>
                    <CornerRadius>8</CornerRadius>
                </Binding.Source>
            </Binding>
        </MultiBinding>
    </UserControl.Clip>
    <Grid>

        <!--  画面  -->

        <Grid>
            <!--  默认底图  -->
            <Border
                Grid.Row="0"
                Width="449"
                Height="253">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#iconfont"
                    FontSize="150"
                    Foreground="DimGray"
                    IsEnabled="False"
                    Text="&#xe8da;"
                    Visibility="{Binding NvrPreviewViewInfo.IsShow, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </Border>

            <!--  画面  -->
            <Image
                Grid.Row="0"
                Width="449"
                Height="253"
                RenderOptions.BitmapScalingMode="LowQuality"
                Source="{Binding NvrPreviewViewInfo.VideoFrame, UpdateSourceTrigger=PropertyChanged}"
                Stretch="Uniform"
                Visibility="{Binding NvrPreviewViewInfo.IsShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  右下角通道  -->
            <TextBlock
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="13"
                FontWeight="Bold"
                Foreground="SpringGreen"
                Text="{Binding NvrPreviewViewInfo.ChannelId, StringFormat='通道{0}'}" />
        </Grid>
        <!--  关闭按钮  -->
        <Border
            Background="Transparent"
            BorderBrush="Transparent"
            CornerRadius="0,10,0,0">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">

                <!--  关闭  -->
                <Button
                    Command="{Binding CloseDialogCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}"
                    Style="{StaticResource CustomCloseButtonStyle}"
                    ToolTip="Close">
                    <TextBlock
                        Foreground="White"
                        Style="{StaticResource SystemTextBlockStyle}"
                        Text="&#xe601;" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>