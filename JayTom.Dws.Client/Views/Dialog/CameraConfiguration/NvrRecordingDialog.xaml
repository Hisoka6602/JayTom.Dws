<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.CameraConfiguration.NvrRecordingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attributeConverters="clr-namespace:JayTom.Dws.Client.Converters.AttributeConverters"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cameraConfiguration="clr-namespace:JayTom.Dws.Client.ViewModels.Dialog.CameraConfiguration"
    xmlns:cameraConfiguration1="clr-namespace:JayTom.Dws.Client.Models.Cameras.CameraConfiguration"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editors="clr-namespace:JayTom.Dws.Client.Views.Editors"
    xmlns:extensions="clr-namespace:JayTom.Dws.Client.Extensions"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="NvrRecordingView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="NvrRecordingView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <attributeConverters:EnumAttributeConverter x:Key="EnumAttributeConverter" />
        <converters:DoubleToDateTimeConverter x:Key="DoubleToDateTimeConverter" />
        <converters:BorderClipMultiConverter x:Key="BorderClipMultiConverter" />
        <cameraConverter:VideoPlayerSizeConverter x:Key="VideoPlayerSizeConverter" />
        <converters:EnumToVisibilityInvertedConverter x:Key="EnumToVisibilityInvertedConverter" />
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
    </UserControl.Resources>
    <Border
        MinWidth="1400"
        MinHeight="800"
        Padding="10"
        Background="#2E2E2E"
        CornerRadius="10">
        <Border.Clip>
            <MultiBinding Converter="{StaticResource BorderClipMultiConverter}">
                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Border.Clip>
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  播放列表  -->
            <ListBox
                Grid.Row="0"
                MinWidth="449"
                MinHeight="253"
                MaxWidth="{Binding ElementName=NvrRecordingView, Path=ActualWidth}"
                MaxHeight="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Focusable="False"
                ItemsSource="{Binding VideoPlayerItems, UpdateSourceTrigger=PropertyChanged}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                Style="{StaticResource CustomListBoxStyle}">
                <ListBox.Clip>
                    <MultiBinding Converter="{StaticResource BorderClipMultiConverter}">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                        <Binding>
                            <Binding.Source>
                                <CornerRadius>8</CornerRadius>
                            </Binding.Source>
                        </Binding>
                    </MultiBinding>
                </ListBox.Clip>
                <ListBox.Template>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer Focusable="False">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <WrapPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Focusable="False"
                                IsItemsHost="True"
                                Orientation="Horizontal"
                                ScrollViewer.CanContentScroll="True" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type cameraConfiguration1:VideoPlayerModel}">
                        <Border BorderBrush="Transparent">
                            <Border.Style>

                                <Style TargetType="Border">
                                    <Style.Setters>
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    </Style.Setters>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScreenState}" Value="Maximized">
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid
                                Name="PreviewViewGrid"
                                Background="Transparent"
                                Visibility="{Binding ScreenState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToVisibilityInvertedConverter}, ConverterParameter=Hidden}">
                                <!--  加载进度条  -->
                                <editors:AnimatedRingControl
                                    Width="100"
                                    Height="100"
                                    ControlOpacity="0.8"
                                    IsAnimationEnabled="{Binding IsBuffering, UpdateSourceTrigger=PropertyChanged}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsBuffering, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!--  画面  -->
                                <Image
                                    RenderOptions.BitmapScalingMode="LowQuality"
                                    Source="{Binding VideoFrame, UpdateSourceTrigger=PropertyChanged}"
                                    Stretch="Fill"
                                    Visibility="{Binding IsBuffering, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScreenState}" Value="Maximized">
                                                    <Setter Property="Width" Value="1280" />
                                                    <Setter Property="Height" Value="720" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ScreenState}" Value="Normal">
                                                    <Setter Property="Width">
                                                        <Setter.Value>
                                                            <Binding
                                                                Converter="{StaticResource VideoPlayerSizeConverter}"
                                                                ConverterParameter="Width"
                                                                FallbackValue="200"
                                                                Path="Items.Count"
                                                                RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}"
                                                                UpdateSourceTrigger="PropertyChanged" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Height">
                                                        <Setter.Value>
                                                            <Binding
                                                                Converter="{StaticResource VideoPlayerSizeConverter}"
                                                                ConverterParameter="Height"
                                                                FallbackValue="150"
                                                                Path="Items.Count"
                                                                RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}"
                                                                UpdateSourceTrigger="PropertyChanged" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                    <Image.InputBindings>
                                        <MouseBinding
                                            Command="{Binding ToggleImageSizeCommand}"
                                            CommandParameter="{Binding}"
                                            Gesture="LeftDoubleClick" />
                                    </Image.InputBindings>
                                </Image>

                                <!--  右下角通道  -->
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="SpringGreen"
                                    Text="{Binding Channel, StringFormat='通道{0}'}" />
                                <!--  工具  -->
                                <Border
                                    x:Name="ToolBarContainer"
                                    Height="60"
                                    MinWidth="130"
                                    Margin="0"
                                    Padding="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="#88202020"
                                    CornerRadius="10,10,0,0"
                                    Visibility="{Binding ElementName=PreviewViewGrid, Path=IsMouseOver, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!--  左右分、进度条全遮挡  -->
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <!--  截图  -->
                                        <Button
                                            Width="35"
                                            Height="35"
                                            Margin="10,0"
                                            HorizontalAlignment="Center"
                                            materialDesign:ButtonProgressAssist.IsIndeterminate="False"
                                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="False"
                                            materialDesign:ButtonProgressAssist.Value="-1"
                                            materialDesign:RippleAssist.ClipToBounds="True"
                                            materialDesign:RippleAssist.RippleOnTop="True"
                                            Background="#3D3D3D"
                                            BorderBrush="Transparent"
                                            Command="{Binding VideoScreenShotCommand}"
                                            CommandParameter="{Binding}"
                                            Cursor=""
                                            Focusable="False"
                                            ToolTip="{Binding ScreenshotState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignFloatingActionButton}" TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScreenshotState}" Value="Screenshotting">
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="True" />
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="True" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ScreenshotState}" Value="Ready">
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="False" />
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource IconFontFamily}"
                                                FontSize="20"
                                                Foreground="White"
                                                Text="{Binding ScreenshotState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=FontIcon}" />
                                        </Button>
                                        <!--  下载  -->
                                        <Button
                                            Width="35"
                                            Height="35"
                                            Margin="10,0"
                                            HorizontalAlignment="Center"
                                            materialDesign:ButtonProgressAssist.Maximum="100"
                                            materialDesign:ButtonProgressAssist.Minimum="0"
                                            materialDesign:ButtonProgressAssist.Value="{Binding DownloadProgress, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:RippleAssist.ClipToBounds="True"
                                            materialDesign:RippleAssist.RippleOnTop="True"
                                            Background="RoyalBlue"
                                            BorderBrush="Transparent"
                                            Command="{Binding DownloadCommand}"
                                            CommandParameter="{Binding}"
                                            Cursor=""
                                            Focusable="False"
                                            ToolTip="{Binding DownloadState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignFloatingActionButton}" TargetType="Button">
                                                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="False" />
                                                    <Setter Property="materialDesign:ButtonProgressAssist.IndicatorForeground" Value="GreenYellow" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DownloadState}" Value="Downloading">
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IndicatorForeground" Value="GreenYellow" />
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="True" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DownloadState}" Value="Transcoding">
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IndicatorForeground" Value="GhostWhite" />
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="True" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DownloadState}" Value="Ready">
                                                            <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource IconFontFamily}"
                                                FontSize="20"
                                                Foreground="White"
                                                Text="{Binding DownloadState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=FontIcon}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!--  清晰度  -->
                                <Border
                                    Height="220"
                                    MinWidth="50"
                                    Margin="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#88202020"
                                    CornerRadius="10,0,0,10"
                                    Visibility="{Binding ElementName=PreviewViewGrid, Path=IsMouseOver, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <ListBox
                                        x:Name="RadioButtonGroupChoiceChip"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding VideoQualityItems}"
                                        SelectedItem="{Binding VideoQuality, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding PlaybackError, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=None}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,8">
                                                    <TextBlock
                                                        FontFamily="{StaticResource CustomFontFamily}"
                                                        FontSize="13"
                                                        Text="{Binding Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}" />
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border
                                                                x:Name="Border"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="White" />
                                                                    <Setter Property="Foreground" Value="Black" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="SelectionChanged">
                                                <b:InvokeCommandAction Command="{Binding SwitchQualityCommand}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, AncestorLevel=1}}" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </ListBox>
                                </Border>
                                <!--  异常底图  -->
                                <Border Visibility="{Binding PlaybackError, Converter={StaticResource EnumToVisibilityInvertedConverter}, ConverterParameter=None}">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#iconfont"
                                            FontSize="120"
                                            Foreground="DimGray"
                                            IsEnabled="False"
                                            Text="{Binding PlaybackError, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=FontIcon}"
                                            Visibility="{Binding PlaybackError, Converter={StaticResource EnumToVisibilityInvertedConverter}, ConverterParameter=None}" />
                                        <TextBlock
                                            Margin="5,20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CustomFontFamily}"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="DimGray"
                                            Text="{Binding PlaybackError, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}" />
                                    </StackPanel>
                                </Border>
                                <!--  页面放大缩小  -->
                                <Button
                                    Grid.Row="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Command="{Binding ToggleImageSizeCommand}"
                                    CommandParameter="{Binding}"
                                    Opacity="0.7"
                                    Style="{StaticResource SystemButtonStyle}"
                                    ToolTip="{Binding ScreenState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}"
                                    Visibility="{Binding ElementName=PreviewViewGrid, Path=IsMouseOver, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="22"
                                        Foreground="White"
                                        Style="{StaticResource SystemTextBlockStyle}"
                                        Text="{Binding ScreenState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=FontIcon}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="10"
                    Orientation="Vertical">
                    <!--  播放操作(暂停/播放、快放、慢放、正常、 倒放)  -->
                    <StackPanel Margin="0,10" Orientation="Horizontal">
                        <!--  暂停/播放  -->
                        <Button
                            Height="30"
                            MinWidth="80"
                            Margin="0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="{Binding PlaybackState, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=BackgroundColor}"
                            BorderThickness="0"
                            Command="{Binding PlaybackCommand}"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="{Binding PlaybackState, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=FontIcon}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="White"
                                    Text="{Binding PlaybackState, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=AuxiliaryDescription}" />
                            </StackPanel>
                        </Button>
                        <!--  快进  -->
                        <materialDesign:Badged
                            Badge="{Binding FastForwardSpeed, UpdateSourceTrigger=PropertyChanged}"
                            BadgeBackground="White"
                            Visibility="Collapsed">
                            <Button
                                Height="30"
                                MinWidth="80"
                                Margin="10,0,0,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#3D3D3D"
                                BorderThickness="0"
                                Command="{Binding FastForwardCommand}"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="20"
                                        FontWeight="Light"
                                        Foreground="White"
                                        Text="&#xe9ed;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="13"
                                        FontWeight="Normal"
                                        Foreground="White"
                                        Text="快进" />
                                </StackPanel>
                            </Button>
                        </materialDesign:Badged>
                        <!--  慢放  -->
                        <materialDesign:Badged Badge="{Binding SlowMotionSpeed, UpdateSourceTrigger=PropertyChanged}" BadgeBackground="White">
                            <Button
                                Height="30"
                                MinWidth="80"
                                Margin="10,0,0,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#3D3D3D"
                                BorderThickness="0"
                                Command="{Binding SlowMotionCommand}"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="20"
                                        FontWeight="Light"
                                        Foreground="White"
                                        Text="&#xe9f7;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="13"
                                        FontWeight="Normal"
                                        Foreground="White"
                                        Text="慢放" />
                                </StackPanel>
                            </Button>
                        </materialDesign:Badged>
                        <!--  快进5秒  -->
                        <Button
                            Height="30"
                            MinWidth="80"
                            Margin="10,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="#3D3D3D"
                            BorderThickness="0"
                            Command="{Binding FastForwardBySecondsCommand}"
                            CommandParameter="5"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="&#xea16;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="White"
                                    Text="快进5s" />
                            </StackPanel>
                        </Button>
                        <!--  快进15秒  -->
                        <Button
                            Height="30"
                            MinWidth="85"
                            Margin="10,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="#3D3D3D"
                            BorderThickness="0"
                            Command="{Binding FastForwardBySecondsCommand}"
                            CommandParameter="15"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="&#xe9e5;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="White"
                                    Text="快进15s" />
                            </StackPanel>
                        </Button>
                        <!--  快退5秒  -->
                        <Button
                            Height="30"
                            MinWidth="80"
                            Margin="10,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="#3D3D3D"
                            BorderThickness="0"
                            Command="{Binding RewindBySecondsCommand}"
                            CommandParameter="5"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="&#xea15;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="White"
                                    Text="快退5s" />
                            </StackPanel>
                        </Button>
                        <!--  快退15秒  -->
                        <Button
                            Height="30"
                            MinWidth="85"
                            Margin="10,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="#3D3D3D"
                            BorderThickness="0"
                            Command="{Binding RewindBySecondsCommand}"
                            CommandParameter="15"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="&#xe9e6;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="White"
                                    Text="快退15s" />
                            </StackPanel>
                        </Button>

                        <!--  合并下载  -->
                        <Button
                            Height="30"
                            MinWidth="100"
                            Margin="10,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="#3D3D3D"
                            BorderThickness="0"
                            Command="{Binding RewindBySecondsCommand}"
                            CommandParameter="15"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">

                            <Grid>

                                <!--  显示  -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="20"
                                        FontWeight="Light"
                                        Foreground="White"
                                        Text="&#xea6f;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="13"
                                        FontWeight="Normal"
                                        Foreground="White"
                                        Text="合并下载" />
                                </StackPanel>
                                <!--  下载进度  -->

                            </Grid>

                        </Button>

                    </StackPanel>
                    <!--  进度条(时、分、秒)  -->
                    <Slider
                        MinWidth="600"
                        extensions:SliderTimeToolTip.AutoTickFrequency="True"
                        extensions:SliderTimeToolTip.IsTimeToolTipEnabled="True"
                        AutoToolTipPlacement="None"
                        Focusable="False"
                        Foreground="{Binding PlaybackState, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=LabelColor}"
                        IsSelectionRangeEnabled="True"
                        Maximum="{Binding EndTime, Converter={StaticResource DoubleToDateTimeConverter}}"
                        Minimum="{Binding StartTime, Converter={StaticResource DoubleToDateTimeConverter}}"
                        Orientation="Horizontal"
                        SelectionEnd="{Binding SelectionEndTime, Converter={StaticResource DoubleToDateTimeConverter}}"
                        SelectionStart="{Binding SelectionStartTime, Converter={StaticResource DoubleToDateTimeConverter}}"
                        TickPlacement="BottomRight"
                        Value="{Binding CurrentTime, Mode=TwoWay, Converter={StaticResource DoubleToDateTimeConverter}}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="PreviewMouseUp">
                                <mvvm:InvokeCommandAction Command="{Binding ProgressChangedCommand}" />
                            </b:EventTrigger>
                            <b:EventTrigger EventName="PreviewMouseDown">
                                <mvvm:InvokeCommandAction Command="{Binding ProgressReleaseCommand}" />
                            </b:EventTrigger>
                            <b:EventTrigger EventName="MouseDown">
                                <mvvm:InvokeCommandAction Command="{Binding ProgressReleaseCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </Slider>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Vertical">
                    <!--  选择开始时间  -->
                    <StackPanel
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="开始时间:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">

                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="120"
                                    MaxWidth="170"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="yyyy-MM-dd HH:mm:ss"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    BorderThickness="0"
                                    Focusable="True"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White">
                                    <TextBox.Text>
                                        <Binding
                                            Mode="TwoWay"
                                            Path="StartTime"
                                            StringFormat="{}{0:yyyy-MM-dd HH:mm:ss}"
                                            UpdateSourceTrigger="Explicit">
                                            <Binding.ValidationRules>
                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的日期时间格式：yyyy-MM-dd HH:mm:ss" Pattern="^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <TextBox.InputBindings>
                                        <KeyBinding
                                            Key="Enter"
                                            Command="{Binding ChangedTimeCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button
                                    Width="30"
                                    Margin="0,0,0,0"
                                    Padding="0"
                                    materialDesign:RippleAssist.Feedback="DodgerBlue"
                                    Background="{x:Null}"
                                    BorderBrush="{x:Null}"
                                    FocusVisualStyle="{x:Null}"
                                    Foreground="DodgerBlue"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FocusVisualStyle="{x:Null}"
                                        Foreground="DimGray"
                                        Kind="CalendarClock" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!--  选择结束时间  -->
                    <StackPanel
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="结束时间:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">

                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="120"
                                    MaxWidth="170"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="yyyy-MM-dd HH:mm:ss"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    BorderThickness="0"
                                    Focusable="True"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White">
                                    <TextBox.Text>
                                        <Binding
                                            Mode="TwoWay"
                                            Path="EndTime"
                                            StringFormat="{}{0:yyyy-MM-dd HH:mm:ss}"
                                            UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的日期时间格式：yyyy-MM-dd HH:mm:ss" Pattern="^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <TextBox.InputBindings>
                                        <KeyBinding
                                            Key="Enter"
                                            Command="{Binding ChangedTimeCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button
                                    Width="30"
                                    Margin="0,0,0,0"
                                    Padding="0"
                                    materialDesign:RippleAssist.Feedback="DodgerBlue"
                                    Background="{x:Null}"
                                    BorderBrush="{x:Null}"
                                    FocusVisualStyle="{x:Null}"
                                    Foreground="DodgerBlue"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FocusVisualStyle="{x:Null}"
                                        Foreground="DimGray"
                                        Kind="CalendarClock" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!--  选择码流  -->
                    <StackPanel
                        Margin="5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="码流选择:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Height="30"
                                MinWidth="160"
                                Padding="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                materialDesign:ColorZoneAssist.Mode="Dark"
                                BorderThickness="0"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                ItemsSource="{Binding PlaybackStreamItems, UpdateSourceTrigger=PropertyChanged}"
                                SelectedItem="{Binding SelectPlaybackStream, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type cameraConfiguration:PlaybackStream}">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource IconFontFamily}"
                                                FontSize="22"
                                                FontWeight="Light"
                                                Foreground="White"
                                                Text="{Binding ., Converter={StaticResource EnumAttributeConverter}, ConverterParameter=FontIcon}" />
                                            <!--  文字  -->
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding ., Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel
                Grid.Row="0"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <!--  设置按钮  -->
                <ToggleButton
                    Margin="2,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Focusable="False"
                    IsHitTestVisible="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="设置">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Style="{StaticResource SystemTextBlockStyle}"
                        Text="&#xe84e;" />

                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <ContentPresenter />
                                <Popup
                                    AllowsTransparency="True"
                                    HorizontalOffset="-5"
                                    IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                    Placement="Left"
                                    PopupAnimation="Scroll"
                                    StaysOpen="False"
                                    Style="{StaticResource LazyUpdatePopupStyle}"
                                    VerticalOffset="10">

                                    <Grid
                                        Width="260"
                                        Height="200"
                                        MaxHeight="800"
                                        Margin="20"
                                        Background="#CF202020">
                                        <Grid.Clip>
                                            <MultiBinding Converter="{StaticResource BorderClipMultiConverter}">
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                <Binding>
                                                    <Binding.Source>
                                                        <CornerRadius>8</CornerRadius>
                                                    </Binding.Source>
                                                </Binding>
                                            </MultiBinding>
                                        </Grid.Clip>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!--  视频推移时间  -->
                                        <StackPanel
                                            Grid.Row="0"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="DimGray"
                                                Text="视频前移时间(s):" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="110"
                                                    Height="30"
                                                    MaxWidth="110"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="15"
                                                    Foreground="White"
                                                    Text="{Binding VideoPlaybackSettingsInfo.SecondsToSubtract, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </Border>
                                        </StackPanel>
                                        <!--  视频段长度  -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="DimGray"
                                                Text="视频段长度(s):" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="110"
                                                    Height="30"
                                                    MaxWidth="110"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="15"
                                                    Foreground="White"
                                                    Text="{Binding VideoPlaybackSettingsInfo.VideoLengthInSeconds, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </Border>
                                        </StackPanel>
                                        <!--  是否标记水印时间  -->
                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">

                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="DimGray"
                                                Text="是否标记水印时间:" />
                                            <ToggleButton
                                                Margin="5"
                                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="Azure"
                                                Focusable="False"
                                                IsChecked="{Binding VideoPlaybackSettingsInfo.IsWatermarkTimeMarked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                        </StackPanel>
                                        <!--  应用  -->
                                        <Button
                                            Grid.Row="3"
                                            Width="90"
                                            Height="30"
                                            Margin="0,20"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            Command="{Binding SaveVideoPlaybackSettingsCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Popup}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="应用/保存">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource IconFontFamily}"
                                                    FontSize="16"
                                                    FontWeight="Light"
                                                    Foreground="White"
                                                    Text="&#xe66e;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource CustomFontFamily}"
                                                    FontSize="13"
                                                    FontWeight="Normal"
                                                    Foreground="White"
                                                    Text="应用" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!--  关闭按钮  -->
                <Button
                    Command="{Binding CloseDialogCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}"
                    Style="{StaticResource CustomCloseButtonStyle}"
                    ToolTip="Close">
                    <TextBlock
                        Foreground="White"
                        Style="{StaticResource SystemTextBlockStyle}"
                        Text="&#xe601;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>