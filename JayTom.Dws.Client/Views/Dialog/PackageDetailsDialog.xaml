<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.PackageDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModels="clr-namespace:JayTom.Dws.Client.Models.DataModels"
    xmlns:dialogs="http://prismlibrary.com/"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:packageSortingConfiguration="clr-namespace:JayTom.Dws.Client.Converters.PackageSortingConfiguration"
    Name="PackageDetailsView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    dialogs:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ListBackgroundVisibleConverter x:Key="ListBackgroundVisibleConverter" />
        <converters:SortingModeConverter x:Key="SortingModeConverter" />
        <converters:CommunicationMethodConverter x:Key="CommunicationMethodConverter" />
        <converters:SourceTypeConverter x:Key="SourceTypeConverter" />
        <converters:UploadStatusToVisibilityConverter x:Key="UploadStatusToVisibilityConverter" />
        <converters:BooleanNegatedToVisibilityConverter x:Key="BooleanNegatedToVisibilityConverter" />
        <converters:UploadStatusNegatedToVisibilityConverter x:Key="UploadStatusNegatedToVisibilityConverter" />
        <packageSortingConfiguration:AbnormalSortingTypeConverter x:Key="AbnormalSortingTypeConverter" />
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="PackageDetailsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <dialogs:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="750" />
            <Setter Property="Height" Value="800" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </dialogs:Dialog.WindowStyle>
    <materialDesign:Card
        Margin="0"
        materialDesign:ElevationAssist.Elevation="Dp2"
        materialDesign:ShadowAssist.Darken="True"
        Background="#2E2E2E"
        UniformCornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  系统按钮  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="Transparent"
                CornerRadius="5,5,0,0">
                <!--  系统按钮  -->
                <StackPanel
                    Margin="10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  关闭  -->
                    <Button
                        Command="{Binding CloseWinCommand}"
                        Style="{StaticResource CustomCloseButtonStyle}"
                        ToolTip="Close">
                        <TextBlock
                            Foreground="White"
                            Style="{StaticResource SystemTextBlockStyle}"
                            Text="&#xe601;" />
                    </Button>
                </StackPanel>
            </Border>
            <ScrollViewer
                Grid.Row="1"
                Margin="10,5"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <!--  条码  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            IsEnabled="False"
                            Text="{x:Static languages:Language.BarcodeCondition}" />
                        <TextBlock
                            Margin="5,0,20,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            IsEnabled="False"
                            Text="{Binding PackageItem.Barcode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <!--  分拣信息  -->
                    <StackPanel Margin="5,10" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="10,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="25"
                                Foreground="DimGray"
                                Text="&#xe79f;" />
                            <!--  分拣信息  -->
                            <TextBlock
                                MaxWidth="450"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                IsEnabled="False"
                                Text="分拣信息"
                                TextAlignment="Center"
                                TextTrimming="WordEllipsis" />
                        </StackPanel>
                        <Grid>
                            <!--  空数据底图  -->
                            <Border Visibility="{Binding SortingItem.IsSortingUsed, Converter={StaticResource BooleanNegatedToVisibilityConverter}}">
                                <StackPanel
                                    Margin="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="50"
                                        Foreground="White"
                                        Text="&#xe63d;" />
                                    <TextBlock
                                        Margin="0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="16"
                                        Foreground="White"
                                        Text="{x:Static languages:Language.NoData}" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="12,5,0,0" Visibility="{Binding SortingItem.IsSortingUsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="80" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <!--  连接  -->
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        Foreground="DimGray"
                                        Text="&#xe7f6;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        MaxWidth="140"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="连接:" /> <Run Foreground="#BFFFFFFF" Text="{Binding SortingItem.ConnectionName, Converter={StaticResource SortingModeConverter}}" />
                                    </TextBlock>
                                </Grid>
                                <!--  分拣模式  -->
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        Foreground="DimGray"
                                        Text="&#xe7b9;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        MaxWidth="180"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Left"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="分拣模式:" /> <Run Foreground="#BFFFFFFF" Text="{Binding SortingItem.SortingMode, Converter={StaticResource SortingModeConverter}}" />
                                    </TextBlock>
                                </Grid>
                                <!--  分拣编码  -->
                                <Grid
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        FontWeight="Light"
                                        Foreground="DimGray"
                                        Text="&#xe92b;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="分拣编码:" /> <Run Foreground="#BFFFFFFF" Text="{Binding SortingItem.SortingCode}" />
                                    </TextBlock>
                                </Grid>
                                <!--  是否由下位机创建  -->
                                <Grid
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        Foreground="DimGray"
                                        Text="&#xe79d;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        MaxWidth="200"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Justify"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="是否由下位机创建:" />
                                    </TextBlock>
                                    <CheckBox
                                        Grid.Column="2"
                                        Margin="5,0"
                                        BorderBrush="DodgerBlue"
                                        BorderThickness="2"
                                        IsChecked="{Binding SortingItem.IsCreatedByLowerMachine}"
                                        IsEnabled="True"
                                        Style="{StaticResource CustomCheckBoxStyle}" />
                                </Grid>
                                <!--  通讯方式  -->
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        FontWeight="Light"
                                        Foreground="DimGray"
                                        Text="&#xe7ce;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="通讯方式:" /> <Run Foreground="#BFFFFFFF" Text="{Binding SortingItem.CommunicationMethod, Converter={StaticResource CommunicationMethodConverter}}" />
                                    </TextBlock>
                                </Grid>
                                <!--  通讯协议  -->
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        FontWeight="Light"
                                        Foreground="DimGray"
                                        Text="&#xe7fc;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="通讯协议:" /> <Run Foreground="#BFFFFFFF" Text="{Binding SortingItem.ChecksumProtocolName}" />
                                    </TextBlock>
                                </Grid>
                                <!--  创建包裹指令  -->
                                <StackPanel
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="创建包裹指令:" />
                                    <Border
                                        MinHeight="70"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="70"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding PackageCreationInstruction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  发送的格口指令  -->
                                <StackPanel
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="发送的格口指令:" />
                                    <Border
                                        MinHeight="70"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="70"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding SentInstruction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  接收的回调指令  -->
                                <StackPanel
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="接收的回调指令:" />
                                    <Border
                                        MinHeight="70"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="70"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding ReceivedInstruction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  异常指令  -->
                                <StackPanel
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="异常指令:" />
                                    <Border
                                        MinHeight="70"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="70"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding ExceptionInstruction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  异常分拣原因  -->
                                <StackPanel
                                    Grid.Row="8"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="异常分拣原因:" />
                                    <Border
                                        MinHeight="70"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="70"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding SortingItem.AbnormalSortingType, Converter={StaticResource AbnormalSortingTypeConverter}}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  格口  -->
                                <StackPanel
                                    Grid.Row="9"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="格口:" />
                                    <Border
                                        MinHeight="50"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="50"
                                            MaxWidth="580"
                                            MaxHeight="60"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding PackageItem.ExitInfo.PhysicalExit}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Rectangle
                            Height="1"
                            Opacity="0.15"
                            Stroke="DimGray"
                            StrokeDashArray="8"
                            StrokeThickness="1" />
                    </StackPanel>
                    <!--  节点信息  -->
                    <StackPanel Margin="5,10" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="10,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="23"
                                Foreground="DimGray"
                                Text="&#xeb6c;" />
                            <!--  节点信息  -->
                            <TextBlock
                                MaxWidth="450"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                IsEnabled="False"
                                Text="节点信息"
                                TextAlignment="Center"
                                TextTrimming="WordEllipsis" />
                        </StackPanel>
                        <!--  列表  -->
                        <Border
                            MinHeight="70"
                            Margin="20,5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="#202020"
                            CornerRadius="5">
                            <ListBox
                                Name="ScanNodeListBox"
                                MinHeight="160"
                                MaxHeight="250"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                ItemsSource="{Binding NodeInfoItems, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource CustomListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dataModels:NodeInfoItemModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  节点名称  -->
                                            <TextBox
                                                Grid.Column="0"
                                                MaxWidth="90"
                                                Margin="5,0"
                                                VerticalContentAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                IsReadOnly="True"
                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" />
                                            <!--  扫码时间  -->
                                            <TextBox
                                                Grid.Column="1"
                                                Margin="5,0"
                                                VerticalContentAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FocusVisualStyle="{x:Null}"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                IsReadOnly="True"
                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                Text="{Binding ScanTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" />
                                            <!--  节点内容  -->
                                            <TextBox
                                                Grid.Column="2"
                                                Margin="5,0"
                                                VerticalContentAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FocusVisualStyle="{x:Null}"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                IsReadOnly="True"
                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                Text="{Binding OriginalText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Rectangle
                            Height="1"
                            Opacity="0.15"
                            Stroke="DimGray"
                            StrokeDashArray="8"
                            StrokeThickness="1" />
                    </StackPanel>
                    <!--  上传信息  -->
                    <StackPanel Margin="5,10" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="10,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="23"
                                Foreground="DimGray"
                                Text="&#xe664;" />
                            <!--  Api信息  -->
                            <TextBlock
                                MaxWidth="450"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                IsEnabled="False"
                                Text="Api信息"
                                TextAlignment="Center"
                                TextTrimming="WordEllipsis" />
                        </StackPanel>
                        <Grid>
                            <!--  空数据底图  -->
                            <Border Visibility="{Binding PackageItem.RequestStatus, Converter={StaticResource UploadStatusNegatedToVisibilityConverter}}">
                                <StackPanel
                                    Margin="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="50"
                                        Foreground="White"
                                        Text="&#xe63d;" />
                                    <TextBlock
                                        Margin="0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="16"
                                        Foreground="White"
                                        Text="{x:Static languages:Language.NoData}" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="12,5,0,0" Visibility="{Binding PackageItem.RequestStatus, Converter={StaticResource UploadStatusToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <!--  是否判定成功  -->
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        Foreground="DimGray"
                                        Text="&#xe76b;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        MaxWidth="200"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Justify"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="是否判定成功:" />
                                    </TextBlock>
                                    <CheckBox
                                        Grid.Column="2"
                                        Margin="5,0"
                                        BorderBrush="DodgerBlue"
                                        BorderThickness="2"
                                        IsChecked="{Binding PackageItem.UploadInfo.IsSuccess}"
                                        IsEnabled="True"
                                        Style="{StaticResource CustomCheckBoxStyle}" />
                                </Grid>
                                <!--  耗时(毫秒)  -->
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        Foreground="DimGray"
                                        Text="&#xe711;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="耗时(毫秒):" /> <Run Foreground="#BFFFFFFF" Text="{Binding PackageItem.UploadInfo.DurationInSeconds, StringFormat={}{0:F1}, Converter={StaticResource MathMultiplyConverter}, ConverterParameter=1000}" />
                                    </TextBlock>
                                </Grid>
                                <!--  请求时间  -->
                                <Grid
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        FontWeight="Light"
                                        Foreground="DimGray"
                                        Text="&#xe82f;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="请求时间:" /> <Run Foreground="#BFFFFFFF" Text="{Binding PackageItem.UploadInfo.RequestTime, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" />
                                    </TextBlock>
                                </Grid>
                                <!--  上传内容  -->
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="上传内容:" />
                                    <Border
                                        MinHeight="70"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="200"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding PackageItem.UploadInfo.RequestContent}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  响应时间  -->
                                <Grid
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <!--  图标  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="23"
                                        FontWeight="Light"
                                        Foreground="DimGray"
                                        Text="&#xe82f;" />
                                    <!--  信息  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        IsEnabled="False"
                                        TextAlignment="Center"
                                        TextTrimming="WordEllipsis">
                                        <Run Text="响应时间:" /> <Run Foreground="#BFFFFFFF" Text="{Binding PackageItem.UploadInfo.ResponseTime, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" />
                                    </TextBlock>
                                </Grid>
                                <!--  响应内容  -->
                                <StackPanel
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="响应内容:" />
                                    <Border
                                        MinHeight="70"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="200"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding PackageItem.UploadInfo.ResponseContent}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  接口参数  -->
                                <StackPanel
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="接口参数:" />
                                    <Border
                                        MinHeight="70"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="200"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding PackageItem.UploadInfo.InterfaceParameters}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  请求地址  -->
                                <StackPanel
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="请求地址:" />
                                    <Border
                                        MinHeight="70"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="70"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding PackageItem.UploadInfo.RequestUrl}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                                <!--  异常信息  -->
                                <StackPanel
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DimGray"
                                        Text="异常信息:" />
                                    <Border
                                        MinHeight="70"
                                        MaxHeight="100"
                                        Margin="0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="580"
                                            MinHeight="70"
                                            MaxWidth="580"
                                            MaxHeight="70"
                                            Margin="5,0"
                                            VerticalContentAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding PackageItem.UploadInfo.ExceptionMessage}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Rectangle
                            Height="1"
                            Opacity="0.15"
                            Stroke="DimGray"
                            StrokeDashArray="8"
                            StrokeThickness="1" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl>