<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.PasswordValidationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="PasswordValidationView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding ElementName=PasswordValidationView, Path=Name}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Border Background="#2E2E2E" CornerRadius="20">
        <Grid
            Width="600"
            Height="Auto"
            MinHeight="600"
            Margin="10"
            VerticalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="70*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30*" />
            </Grid.RowDefinitions>
            <!--  图标  -->
            <TextBlock
                Grid.Row="0"
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="200"
                Foreground="DimGray"
                Text="&#xe994;" />
            <!--  密码  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <!--  密码  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe99b;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="输入密码:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <PasswordBox
                            Width="260"
                            Height="30"
                            Margin="5,0"
                            materialDesign:HintAssist.Hint="按回车键确认密码,Esc键退出"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Style="{StaticResource MaterialDesignRevealPasswordBox}">
                            <materialDesign:PasswordBoxAssist.Password>
                                <Binding
                                    Mode="TwoWay"
                                    Path="Password"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:RegexValidationRule ErrorMessage="包含非法字符" Pattern="^[^\u4e00-\u9fa5\s\n]+$" />
                                    </Binding.ValidationRules>
                                </Binding>

                            </materialDesign:PasswordBoxAssist.Password>
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PasswordValidationCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ExitValidationCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                    </Border>
                </StackPanel>
                <!--  密码提示  -->
                <StackPanel Margin="0,20" Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe982;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="密码提示:" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{Binding PasswordHint, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
            <!--  提示  -->
            <materialDesign:Snackbar
                Grid.Row="2"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                Cursor=""
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding PasswordValidationMessageQueue}" />
        </Grid>
    </Border>
</UserControl>