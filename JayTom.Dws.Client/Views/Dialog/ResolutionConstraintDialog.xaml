<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.ResolutionConstraintDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Width="500"
    Height="450"
    MaxWidth="700"
    MaxHeight="648"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Border
        Padding="20"
        Background="#333333"
        CornerRadius="20">

        <StackPanel Orientation="Vertical">
            <!--  图标  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#iconfont"
                FontSize="180"
                Foreground="Red"
                Opacity="0.6"
                Text="&#xe79e;"
                Visibility="Visible" />
            <!--  提示  -->
            <TextBlock
                Margin="5,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkGray">
                <Run Text="检查到系统分辨率不适配,最低分辨率要求为:" /> <Run Text="{Binding MinimumWidth, UpdateSourceTrigger=PropertyChanged}" /><Run Text="x" /><Run Text="{Binding MinimumHeight, UpdateSourceTrigger=PropertyChanged}" />
            </TextBlock>
            <TextBlock
                Margin="5,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Opacity="0.6"
                Text="Tips:如果您设置了Dpi缩放，请尝试调整" />
            <TextBlock
                Margin="5,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Opacity="0.8"
                Text="如果继续运行可能UI布局错乱" />
            <!--  按钮  -->
            <TextBlock
                Margin="5,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="30"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="是否继续运行?" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="120"
                    Height="50"
                    Margin="30,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="25"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding ContinueCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <TextBlock
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="运行" />
                </Button>
                <Button
                    Width="120"
                    Height="50"
                    Margin="30,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="25"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding ExitCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <TextBlock
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="退出" />
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>