<UserControl
    x:Class="JayTom.Dws.Client.Views.Dialog.SaveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:wpf="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FocusVisualStyle="{x:Null}"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <materialDesign:Card
        Width="550"
        Height="550"
        MinWidth="100"
        MinHeight="100"
        MaxWidth="700"
        MaxHeight="700"
        Margin="2"
        Padding="5"
        materialDesign:ElevationAssist.Elevation="Dp1"
        materialDesign:ShadowAssist.Darken="True"
        Background="Transparent"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        UniformCornerRadius="15">
        <Grid>
            <wpf:LottieAnimationView
                Width="500"
                Height="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutoPlay="True"
                RepeatCount="-1"
                ResourcePath="pack://application:,,,/Lotties/HbilMZjmmc.json" />
        </Grid>
    </materialDesign:Card>
</UserControl>