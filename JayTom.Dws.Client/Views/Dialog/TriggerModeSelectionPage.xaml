<Page
    x:Class="JayTom.Dws.Client.Views.Dialog.TriggerModeSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="TriggerModeSelectionPage"
    Height="Auto"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="ToolBarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2AFFFFFF" />
                                <!--  修改选中项的背景颜色  -->
                                <Setter Property="Foreground" Value="White" />
                                <!--  修改选中项的前景颜色  -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <mvvm:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="350" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MaxHeight" Value="300" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </mvvm:Dialog.WindowStyle>

    <WrapPanel>
        <materialDesign:Card
            MinHeight="200"
            Margin="0"
            materialDesign:ElevationAssist.Elevation="Dp2"
            materialDesign:ShadowAssist.Darken="True"
            Background="#2E2E2E"
            UniformCornerRadius="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  系统按钮  -->
                <Border
                    Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CornerRadius="5,5,0,0">
                    <!--  系统按钮  -->
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  关闭  -->
                        <Button
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource CustomCloseButtonStyle}"
                            ToolTip="Close">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe601;" />
                        </Button>
                    </StackPanel>
                </Border>
                <!--  内容  -->
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            Margin="30,0,0,20"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.SanTriggerMode}" />
                        <!--  左右分  -->
                        <StackPanel
                            Margin="10,5,10,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Height="50"
                                MinWidth="120"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="25,0,0,25"
                                Background="RoyalBlue"
                                Command="{Binding TriggerSelectionCommand}"
                                CommandParameter="SoftTrigger"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="{x:Static languages:Language.SoftTrigger}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#iconfont"
                                        FontSize="30"
                                        Foreground="FloralWhite"
                                        Opacity="0.6"
                                        Text="&#xe795;"
                                        Visibility="Visible" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.SoftTrigger}" />
                                </StackPanel>
                            </Button>
                            <Border
                                Width="1"
                                Height="20"
                                BorderBrush="Transparent"
                                BorderThickness="1" />
                            <Button
                                Height="50"
                                MinWidth="120"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0,25,25,0"
                                Background="DarkRed"
                                Command="{Binding TriggerSelectionCommand}"
                                CommandParameter="HardTrigger"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="{x:Static languages:Language.HardTrigger}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#iconfont"
                                        FontSize="30"
                                        Foreground="FloralWhite"
                                        Opacity="0.6"
                                        Text="&#xe78a;"
                                        Visibility="Visible" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.HardTrigger}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!--  管道、仅海康  -->
                        <StackPanel
                            Margin="0,10"
                            Orientation="Vertical"
                            Visibility="{Binding IsShowSourceLine, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="30,0,0,20"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="触发源:" />
                            <ToolBarTray
                                Height="60"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                IsLocked="True">
                                <ToolBar Background="Transparent">
                                    <ListBox Background="#202020" SelectedIndex="{Binding SourceLine, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <ListBox.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="2,0" />
                                                <Setter Property="Background" Value="#202020" />
                                                <Setter Property="FontSize" Value="18" />
                                                <Setter Property="FontFamily" Value="{StaticResource CustomFontFamily}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBoxItem ToolTip="管脚0">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="0" />
                                        </ListBoxItem>
                                        <ListBoxItem ToolTip="管脚1">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="1" />
                                        </ListBoxItem>
                                        <ListBoxItem ToolTip="管脚2">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="2" />
                                        </ListBoxItem>
                                        <ListBoxItem ToolTip="管脚3">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="3" />
                                        </ListBoxItem>
                                        <ListBoxItem ToolTip="管脚4">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="4" />
                                        </ListBoxItem>
                                    </ListBox>
                                </ToolBar>
                            </ToolBarTray>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </WrapPanel>
</Page>