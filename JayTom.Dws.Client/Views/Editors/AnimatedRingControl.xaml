<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.AnimatedRingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    IsHitTestVisible="False"
    Opacity="{Binding Path=Opacity, RelativeSource={RelativeSource AncestorType=UserControl}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="OpacityAnimation">
            <DoubleAnimation
                AutoReverse="True"
                RepeatBehavior="Forever"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="0.6"
                Duration="0:0:1" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!--  Canvas 尺寸绑定到 UserControl  -->
        <Canvas
            x:Name="MainCanvas"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>