<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.CameraConfiguration.NvrCameraMappingEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attributeConverters="clr-namespace:JayTom.Dws.Client.Converters.AttributeConverters"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="NvrCameraMappingEditorView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="NvrCameraMappingEditorView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <attributeConverters:EnumAttributeConverter x:Key="EnumAttributeConverter" />
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <converters:EnumToVisibilityInvertedConverter x:Key="EnumToVisibilityInvertedConverter" />
    </UserControl.Resources>
    <Border
        MinWidth="700"
        MinHeight="500"
        MaxWidth="700"
        Background="#2E2E2E"
        CornerRadius="20">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Clip>
                <RectangleGeometry
                    RadiusX="20"
                    RadiusY="20"
                    Rect="0,0,700,500" />
            </Grid.Clip>
            <!--  关闭按钮  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Height="40"
                Background="Transparent"
                BorderBrush="Transparent"
                CornerRadius="20,20,0,0">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">

                    <!--  关闭  -->
                    <Button
                        Command="{Binding CloseDialogCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}"
                        Style="{StaticResource CustomCloseButtonStyle}"
                        ToolTip="Close">
                        <TextBlock
                            Foreground="White"
                            Style="{StaticResource SystemTextBlockStyle}"
                            Text="&#xe601;" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  列表  -->
            <DataGrid
                Grid.Row="1"
                MaxHeight="430"
                Padding="10,0"
                materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                AlternatingRowBackground="#101E90FF"
                AutoGenerateColumns="False"
                Background="Transparent"
                CanUserAddRows="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
                Foreground="White"
                FrozenColumnCount="2"
                GridLinesVisibility="None"
                HorizontalScrollBarVisibility="Auto"
                ItemsSource="{Binding NvrCameraMappingItemInfos, UpdateSourceTrigger=PropertyChanged}"
                RowBackground="#061E90FF"
                Style="{StaticResource VirtualizingDataGridStyle}">
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                        <Setter Property="Height" Value="35" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="45"
                        MinWidth="45"
                        Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                        IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!--  相机名称  -->
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="100"
                        Binding="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                        EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="相机名称" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!--  序列号  -->
                    <DataGridTextColumn
                        Width="130"
                        MinWidth="130"
                        Binding="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                        EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="序列号" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!--  型号  -->
                    <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                        EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="型号" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!--  IP地址  -->
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="120"
                        Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                        EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderIPAddress}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!--  取流通道  -->
                    <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding Channel, UpdateSourceTrigger=PropertyChanged}"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                        EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="取流通道" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <!--  操作  -->
                    <DataGridTemplateColumn
                        MinWidth="100"
                        MaxWidth="600"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  定位按钮  -->
                                <StackPanel
                                    MinWidth="90"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="80"
                                        Height="30"
                                        MinWidth="60"
                                        Margin="2,0"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="DarkRed"
                                        Command="{Binding ElementName=NvrCameraMappingEditorView, Path=DataContext.UnbindCameraCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        Foreground="Red"
                                        Style="{StaticResource MaterialDesignFlatLightButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource IconFontFamily}"
                                                FontSize="13"
                                                Foreground="White"
                                                Text="&#xe9c6;" />
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                FontSize="13"
                                                FontWeight="Light"
                                                Foreground="White"
                                                IsEnabled="True"
                                                Text="解绑"
                                                TextAlignment="Justify" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>