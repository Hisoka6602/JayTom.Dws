<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.CameraConfiguration.NvrWatermarkConfigEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attributeConverters="clr-namespace:JayTom.Dws.Client.Converters.AttributeConverters"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="NvrWatermarkConfigView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="NvrWatermarkConfigView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <attributeConverters:EnumAttributeConverter x:Key="EnumAttributeConverter" />
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <converters:EnumToVisibilityInvertedConverter x:Key="EnumToVisibilityInvertedConverter" />
    </UserControl.Resources>
    <Border
        MinWidth="280"
        MinHeight="130"
        Background="#2E2E2E"
        CornerRadius="20">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  设备序列号、通道数  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,10"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <!--  模式  -->
                <TextBlock
                    Margin="2,2,0,0"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />
                <!--  类型  -->
            </StackPanel>
            <!--  是否使用水印  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否使用视频水印:" />
                <ToggleButton
                    Name="IsUseWatermarkToggleButton"
                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                    Focusable="False"
                    IsChecked="{Binding IsUseWatermark, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
            <!--  选择通道  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,10"
                IsEnabled="{Binding ElementName=IsUseWatermarkToggleButton, Path=IsChecked}"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="取流通道:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <ComboBox
                        Height="30"
                        MinWidth="160"
                        Padding="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        materialDesign:ColorZoneAssist.Mode="Dark"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        ItemsSource="{Binding ChannelIdItems, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedChannelNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignComboBox}" />
                </Border>
            </StackPanel>
            <StackPanel
                Grid.Row="2"
                Margin="0,10"
                IsEnabled="{Binding ElementName=IsUseWatermarkToggleButton, Path=IsChecked}"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否应用全部通道" />
                <CheckBox
                    BorderBrush="DodgerBlue"
                    BorderThickness="2"
                    IsChecked="{Binding IsAllChannel, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource CustomCheckBoxStyle}" />
            </StackPanel>
            <!--  水印颜色  -->
            <StackPanel
                Grid.Row="3"
                VerticalAlignment="Center"
                IsEnabled="{Binding ElementName=IsUseWatermarkToggleButton, Path=IsChecked}"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.WatermarkColor}" />
                <Border CornerRadius="15">
                    <materialDesign:ColorPicker
                        Width="300"
                        Height="80"
                        Focusable="False"
                        HueSliderPosition="Bottom"
                        Color="{Binding WatermarkColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  持续时间  -->
            <StackPanel
                Grid.Row="4"
                IsEnabled="{Binding ElementName=IsUseWatermarkToggleButton, Path=IsChecked}"
                Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="水印持续时间:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="120"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  显示方式(叠加、单条)  -->
            <StackPanel
                Grid.Row="5"
                IsEnabled="{Binding ElementName=IsUseWatermarkToggleButton, Path=IsChecked}"
                Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="显示方式:" />
                <Border
                    MinWidth="200"
                    MinHeight="30"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Margin="10,0"
                            Content="叠加"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding IsOverlay, UpdateSourceTrigger=PropertyChanged}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <RadioButton
                            Margin="10,0"
                            Content="单条"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding IsOverlay, Converter={StaticResource InvertBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <!--  确定、取消按钮  -->
            <StackPanel
                Grid.Row="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="15"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe66e;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static languages:Language.Save}" />
                    </StackPanel>
                </Button>
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="16"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe636;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="关闭" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <materialDesign:Snackbar
                Grid.Row="6"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding NvrWatermarkConfigEditorMessageQueue}" />
        </Grid>
    </Border>
</UserControl>