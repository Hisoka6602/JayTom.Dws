<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.CameraConfiguration.ScanNodeConfigEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="ScanNodeConfigView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="ScanNodeConfigView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Border
        MinWidth="280"
        MinHeight="130"
        Padding="20"
        Background="#2E2E2E"
        CornerRadius="20">
        <StackPanel Orientation="Vertical">
            <!--  IP地址  -->
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.IPAddress}" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="210"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False">
                        <TextBox.Text>
                            <Binding
                                Mode="TwoWay"
                                Path="ScanNodeItemInfo.IpAddress"
                                UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </Border>
            </StackPanel>
            <!--  端口  -->
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.Port}" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="225"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding ScanNodeItemInfo.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  节点名称  -->
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="节点名称:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="200"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding ScanNodeItemInfo.NodeName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  节点序号  -->
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="节点序号:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="200"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding ScanNodeItemInfo.NodeNum, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  等待赋值超时  -->
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="赋值超时时间:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="175"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding ScanNodeItemInfo.Timeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  存图路径  -->
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="存图路径:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="200"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding ScanNodeItemInfo.ImagePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
                <Button
                    Width="70"
                    MinHeight="30"
                    Margin="0"
                    HorizontalAlignment="Left"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    Background="#202020"
                    BorderThickness="0"
                    Command="{Binding BrowseDirectoryCommand}"
                    FocusVisualStyle="{x:Null}"
                    Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                    <TextBlock
                        Margin="2,1,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="浏览" />
                </Button>
            </StackPanel>
            <!--  确定、取消按钮  -->
            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="15"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe66e;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static languages:Language.Save}" />
                    </StackPanel>
                </Button>
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="16"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe636;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>