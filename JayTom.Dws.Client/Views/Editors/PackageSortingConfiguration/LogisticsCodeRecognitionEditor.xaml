<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration.LogisticsCodeRecognitionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    Name="LogisticsCodeRecognitionView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <settingsConverter:CharacterTypeToBooleanConverter x:Key="CharacterTypeToBooleanConverter" />
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="LogisticsCodeRecognitionView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Border Background="#2E2E2E" CornerRadius="20">
        <Grid
            Width="1000"
            Height="700"
            Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  线  -->
            <!--<Border
                Grid.Row="0"
                Grid.Column="1"
                Width="0.5"
                Margin="0,70"
                Background="White"
                Opacity="1" />-->
            <Rectangle
                Grid.Row="0"
                Grid.Column="1"
                Width="0.6"
                Height="600"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Opacity="0.7"
                Stroke="White"
                StrokeDashArray="10"
                StrokeThickness="1" />
            <!--  左边物流信息  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <!--  物流代码  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="物流代码:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="230"
                            Height="30"
                            MaxWidth="300"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding LogisticsCodeRecognitionItemInfo.LogisticsCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  物流名称  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="物流名称:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="230"
                            Height="30"
                            MaxWidth="300"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding LogisticsCodeRecognitionItemInfo.LogisticsName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>

                <!--  物流图标  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="物流图标:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <Image
                            Width="40"
                            Height="40"
                            MaxWidth="300"
                            Margin="5"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Source="{Binding LogisticsCodeRecognitionItemInfo.Icon}">
                            <!--  图标  -->
                        </Image>
                    </Border>
                    <Button
                        Width="60"
                        MinHeight="30"
                        Margin="0"
                        HorizontalAlignment="Left"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Background="#202020"
                        BorderThickness="0"
                        Command="{Binding LoadImageCommand}"
                        FocusVisualStyle="{x:Null}"
                        Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="..." />
                    </Button>
                </StackPanel>
                <!--  物流声音  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="物流声音:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="160"
                            Height="30"
                            MaxWidth="300"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            IsReadOnly="True"
                            Text="{Binding SoundFilePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                    <Button
                        Width="60"
                        MinHeight="30"
                        Margin="0"
                        HorizontalAlignment="Left"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Background="#202020"
                        BorderThickness="0"
                        Command="{Binding LoadSoundCommand}"
                        FocusVisualStyle="{x:Null}"
                        Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="..." />
                    </Button>
                </StackPanel>
                <!--  备注  -->
                <StackPanel Margin="5" Orientation="Vertical">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="备注:" />
                    <Border
                        MinHeight="80"
                        MaxHeight="200"
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="380"
                            MinHeight="150"
                            MaxWidth="380"
                            MaxHeight="190"
                            Margin="5,0"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding LogisticsCodeRecognitionItemInfo.Remarks, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  右边正则  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                Orientation="Vertical">
                <!--  正则列表  -->
                <DataGrid
                    Height="300"
                    MinWidth="500"
                    Margin="20"
                    Padding="10,0"
                    VerticalAlignment="Stretch"
                    materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                    AlternatingRowBackground="#101E90FF"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
                    Focusable="False"
                    Foreground="White"
                    FrozenColumnCount="2"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Auto"
                    ItemsSource="{Binding LogisticsRegexItems, UpdateSourceTrigger=PropertyChanged}"
                    RowBackground="#061E90FF"
                    Style="{StaticResource VirtualizingDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                            <Setter Property="Height" Value="35" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="45"
                            MinWidth="45"
                            Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  表达式  -->
                        <DataGridTextColumn
                            MinWidth="230"
                            MaxWidth="380"
                            Binding="{Binding RegexPattern, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="表达式" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  操作  -->
                        <DataGridTemplateColumn
                            Width="100"
                            MinWidth="100"
                            MaxWidth="100"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Width="80"
                                                Height="30"
                                                MinWidth="60"
                                                Margin="5,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="DarkRed"
                                                Command="{Binding ElementName=LogisticsCodeRecognitionView, Path=DataContext.DeleteRegexCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="Red"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        FontSize="10"
                                                        Foreground="White"
                                                        Text="&#xe601;" />
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Light"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="{x:Static languages:Language.Delete}"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!--  条码长度  -->
                <StackPanel
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe6cc;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.BarcodeLength}" />
                    </StackPanel>
                    <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.MinBarcodeLength}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="80"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding MinimumLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.MaxBarcodeLength}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="80"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding MaximumLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!--  字符限制  -->
                <StackPanel
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xeaed;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.CharacterLimitation}" />
                    </StackPanel>
                    <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.CharacterLimitation}" />
                                <Border
                                    MinWidth="200"
                                    MinHeight="30"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            Margin="10,0"
                                            Content="{x:Static languages:Language.LettersOrNumbers}"
                                            Focusable="False"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            IsChecked="{Binding CharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Alphanumeric}"
                                            Template="{StaticResource CustomRadioButtonTemplate}" />
                                        <RadioButton
                                            Margin="10,0"
                                            Content="{x:Static languages:Language.Letters}"
                                            Focusable="False"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            IsChecked="{Binding CharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Letter}"
                                            Template="{StaticResource CustomRadioButtonTemplate}" />
                                        <RadioButton
                                            Margin="10,0"
                                            Content="{x:Static languages:Language.Numbers}"
                                            Focusable="False"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            IsChecked="{Binding CharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Number}"
                                            Template="{StaticResource CustomRadioButtonTemplate}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.CannotContain}" />
                                <Border
                                    Width="310"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="310"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding DisallowedCharacters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.MustContain}" />
                                <Border
                                    Width="310"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="310"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding RequiredCharacters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.StartCharacter}" />
                                <Border
                                    Width="310"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="310"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding StartCharacter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.EndCharacter}" />
                                <Border
                                    Width="310"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="310"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding EndCharacter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!--  保存规则、效验规则、清空条件  -->
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="RoyalBlue"
                        BorderThickness="0"
                        Command="{Binding SaveRuleCommand}"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="15"
                                FontWeight="Light"
                                Foreground="White"
                                Text="&#xe66e;" />
                            <TextBlock
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="保存规则" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkRed"
                        BorderThickness="0"
                        Command="{Binding ClearConditionsCommand}"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="16"
                                FontWeight="Light"
                                Foreground="White"
                                Text="&#xe78d;" />
                            <TextBlock
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="清空条件" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--  确定、取消按钮  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="15"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe66e;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static languages:Language.Save}" />
                    </StackPanel>
                </Button>
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="16"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe636;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>