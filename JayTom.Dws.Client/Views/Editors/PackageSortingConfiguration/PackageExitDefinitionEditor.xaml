<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration.PackageExitDefinitionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="PackageExitDefinitionView"
    MaxWidth="700"
    MaxHeight="648"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="PackageExitDefinitionView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Border Background="#2E2E2E" CornerRadius="20">
        <Grid
            Width="400"
            Height="400"
            Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  格口Id(不可变)  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkGray">
                <Run Text="格口Id:" /><Run Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
            </TextBlock>
            <!--  格口名称  -->
            <StackPanel
                Grid.Row="1"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="格口名称:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="300"
                        Height="30"
                        MaxWidth="300"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding ExitName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  格口类型  -->
            <StackPanel
                Grid.Row="2"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="格口类型:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <ComboBox
                        Height="30"
                        MinWidth="190"
                        Padding="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        materialDesign:ColorZoneAssist.Mode="Dark"
                        BorderThickness="0"
                        DisplayMemberPath="Name"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        ItemsSource="{Binding ExitTypeItems, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectExitType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        Style="{StaticResource MaterialDesignComboBox}" />
                </Border>
            </StackPanel>
            <!--  是否生效  -->
            <StackPanel
                Grid.Row="3"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否生效:" />
                <ToggleButton
                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                    Focusable="False"
                    IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
            <!--  备注  -->
            <StackPanel
                Grid.Row="4"
                Margin="5"
                Orientation="Vertical">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="备注:" />
                <Border
                    MinHeight="80"
                    MaxHeight="200"
                    Margin="0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="380"
                        MinHeight="150"
                        MaxWidth="380"
                        MaxHeight="190"
                        Margin="5,0"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </StackPanel>
            <!--  确定、取消按钮  -->
            <StackPanel
                Grid.Row="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="15"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe66e;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static languages:Language.Save}" />
                    </StackPanel>
                </Button>
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="16"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe636;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>