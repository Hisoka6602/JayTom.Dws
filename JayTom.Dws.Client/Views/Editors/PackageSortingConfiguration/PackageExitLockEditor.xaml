<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration.PackageExitLockEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="PackageExitLockEditorView"
    MaxWidth="700"
    MaxHeight="648"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="PackageExitLockEditorView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Border Background="#2E2E2E" CornerRadius="20">
        <Grid
            Width="300"
            Height="400"
            Margin="30,10"
            HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  格口  -->
            <StackPanel
                Grid.Row="0"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="格口:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <ComboBox
                        Width="100"
                        Height="30"
                        MinWidth="190"
                        Padding="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        materialDesign:ColorZoneAssist.Mode="Dark"
                        BorderThickness="0"
                        DisplayMemberPath="ConnectionName"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        ItemsSource="{Binding PackageExitDefinitionItems, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectExitDefinitionInfo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        SelectedValuePath="Id"
                        Style="{StaticResource MaterialDesignComboBox}" />
                </Border>
            </StackPanel>
            <!--  地址  -->
            <StackPanel
                Grid.Row="1"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="地址:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="180"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  长度  -->
            <StackPanel
                Grid.Row="2"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="长度:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="180"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding Length, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  锁格标识  -->
            <StackPanel
                Grid.Row="3"
                Margin="5"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="锁格标识:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="150"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding LockingFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  解锁标识  -->
            <StackPanel
                Grid.Row="4"
                Margin="5"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="解锁标识:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#202020"
                    CornerRadius="5">
                    <TextBox
                        Width="150"
                        Height="30"
                        MaxWidth="500"
                        Margin="5,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        InputMethod.IsInputMethodEnabled="False"
                        Text="{Binding UnlockingFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Border>
            </StackPanel>
            <!--  确定、取消按钮  -->
            <StackPanel
                Grid.Row="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="15"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe66e;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static languages:Language.Save}" />
                    </StackPanel>
                </Button>
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="16"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe636;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>