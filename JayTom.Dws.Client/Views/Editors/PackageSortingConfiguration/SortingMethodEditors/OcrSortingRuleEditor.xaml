<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration.SortingMethodEditors.OcrSortingRuleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration.SortingMethodEditors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    Name="OcrSortingRuleView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="OcrSortingRuleView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <settingsConverter:CharacterTypeToBooleanConverter x:Key="CharacterTypeToBooleanConverter" />
    </UserControl.Resources>
    <Border Background="#2E2E2E" CornerRadius="20">
        <Grid
            Width="900"
            Height="600"
            Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle
                Grid.Row="0"
                Grid.Column="1"
                Width="0.6"
                Height="500"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Opacity="0.7"
                Stroke="White"
                StrokeDashArray="10"
                StrokeThickness="1" />
            <!--  左边物流信息  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <!--  绑定格口  -->
                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="绑定格口:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <ComboBox
                            Height="30"
                            MinWidth="235"
                            Padding="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            materialDesign:ColorZoneAssist.Mode="Dark"
                            BorderThickness="0"
                            DisplayMemberPath="ExitName"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding PackageExitDefinitionItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectPackageExitDefinitionInfo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Id"
                            Style="{StaticResource MaterialDesignComboBox}" />
                    </Border>
                </StackPanel>
                <!--  规则名称  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="规则名称:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="225"
                            Height="30"
                            MaxWidth="300"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding OcrSortingItemInfo.SortingName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  备注  -->
                <StackPanel Margin="5" Orientation="Vertical">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="备注:" />
                    <Border
                        MinHeight="80"
                        MaxHeight="200"
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="380"
                            MinHeight="150"
                            MaxWidth="380"
                            MaxHeight="190"
                            Margin="5,0"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding OcrSortingItemInfo.Remarks, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  右边正则  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                Orientation="Vertical">
                <!--  正则列表  -->
                <DataGrid
                    Height="300"
                    MinWidth="500"
                    Margin="20"
                    Padding="10,0"
                    VerticalAlignment="Stretch"
                    materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                    AlternatingRowBackground="#101E90FF"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
                    Focusable="False"
                    Foreground="White"
                    FrozenColumnCount="2"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Auto"
                    ItemsSource="{Binding OcrRuleItems, UpdateSourceTrigger=PropertyChanged}"
                    RowBackground="#061E90FF"
                    Style="{StaticResource VirtualizingDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                            <Setter Property="Height" Value="35" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="45"
                            MinWidth="45"
                            Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  表达式  -->
                        <DataGridTextColumn
                            MinWidth="230"
                            MaxWidth="380"
                            Binding="{Binding RegexPattern, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="表达式" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  操作  -->
                        <DataGridTemplateColumn
                            Width="100"
                            MinWidth="100"
                            MaxWidth="100"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Width="80"
                                                Height="30"
                                                MinWidth="60"
                                                Margin="5,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="DarkRed"
                                                Command="{Binding ElementName=OcrSortingRuleView, Path=DataContext.DeleteRegexCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="Red"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        FontSize="10"
                                                        Foreground="White"
                                                        Text="&#xe601;" />
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Light"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="{x:Static languages:Language.Delete}"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  规则  -->
                <StackPanel
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <RadioButton
                        Name="RuleRadioButton"
                        Content="规则设置:"
                        Focusable="False"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        IsChecked="{Binding IsUseRules, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignRadioButton}" />

                    <StackPanel
                        Margin="50,5,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding UpdateSourceTrigger=PropertyChanged, ElementName=RuleRadioButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="字符开始位置:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding StartPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                            <b:Interaction.Triggers>
                                                <b:EventTrigger EventName="TextChanged">
                                                    <mvvm:InvokeCommandAction Command="{Binding StartPositionChangedCommand}" />
                                                </b:EventTrigger>
                                            </b:Interaction.Triggers>
                                        </TextBox>
                                    </Border>
                                </StackPanel>
                                <StackPanel IsEnabled="False" Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="字符结束位置:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#202020"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding EndPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="字符内容:" />
                                <Border
                                    Width="310"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#202020"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="310"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding Content, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="TextChanged">
                                                <mvvm:InvokeCommandAction Command="{Binding ContentChangedCommand}" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </TextBox>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <RadioButton
                        Name="RegularExpressionRadioButton"
                        Content="{x:Static languages:Language.RegularExpression}"
                        Focusable="False"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        IsChecked="{Binding IsUseRegex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignRadioButton}" />
                    <Border
                        MinHeight="60"
                        MaxHeight="200"
                        Margin="50,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5"
                        Visibility="{Binding ElementName=RegularExpressionRadioButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox
                            Width="380"
                            MinHeight="100"
                            MaxWidth="380"
                            MaxHeight="190"
                            Margin="5,0"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding RegexPattern, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
                <!--  保存规则、效验规则、清空条件  -->
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="RoyalBlue"
                        BorderThickness="0"
                        Command="{Binding AddRegexCommand}"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="15"
                                FontWeight="Light"
                                Foreground="White"
                                Text="&#xe66e;" />
                            <TextBlock
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="保存规则" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkRed"
                        BorderThickness="0"
                        Command="{Binding ClearConditionsCommand}"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="16"
                                FontWeight="Light"
                                Foreground="White"
                                Text="&#xe78d;" />
                            <TextBlock
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="清空条件" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--  确定、取消按钮  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="15"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe66e;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static languages:Language.Save}" />
                    </StackPanel>
                </Button>
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="16"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe636;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>