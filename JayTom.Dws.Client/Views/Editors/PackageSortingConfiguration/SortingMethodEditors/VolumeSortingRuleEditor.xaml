<UserControl
    x:Class="JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration.SortingMethodEditors.VolumeSortingRuleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataTemplateSelectors="clr-namespace:JayTom.Dws.Client.DataTemplateSelectors"
    xmlns:imageSettingModels="clr-namespace:JayTom.Dws.Client.Models.ImageSettingModels"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Editors.PackageSortingConfiguration.SortingMethodEditors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    Name="VolumeSortingRuleView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="VolumeSortingRuleView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <settingsConverter:ShortcutMacroConverter x:Key="ShortcutMacroConverter" />
        <DataTemplate x:Key="ImageSettingButtonTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="DodgerBlue"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSortingRuleView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content, Converter={StaticResource ShortcutMacroConverter}}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="BlueViolet"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSortingRuleView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="CustomTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="ForestGreen"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSortingRuleView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="OperatorTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="OrangeRed"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSortingRuleView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ReferenceValueTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="ForestGreen"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSortingRuleView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="StitchingTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="DarkOrchid"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSortingRuleView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>
        <dataTemplateSelectors:ImageSettingItemDataTemplateSelectors
            x:Key="FormulaDataTemplateSelectors"
            ButtonTemplate="{StaticResource ImageSettingButtonTemplate}"
            CustomTemplate="{StaticResource CustomTemplate}"
            OperatorTemplate="{StaticResource OperatorTemplate}"
            ReferenceValueTemplate="{StaticResource ReferenceValueTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}"
            StitchingTemplate="{StaticResource StitchingTemplate}" />
    </UserControl.Resources>
    <Border Background="#2E2E2E" CornerRadius="20">
        <Grid
            Width="1020"
            Height="650"
            Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle
                Grid.Row="0"
                Grid.Column="1"
                Width="0.6"
                Height="500"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Opacity="0.7"
                Stroke="White"
                StrokeDashArray="10"
                StrokeThickness="1" />
            <!--  左边物流信息  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <!--  绑定格口  -->
                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="绑定格口:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <ComboBox
                            Height="30"
                            MinWidth="235"
                            Padding="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            materialDesign:ColorZoneAssist.Mode="Dark"
                            BorderThickness="0"
                            DisplayMemberPath="ExitName"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding PackageExitDefinitionItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectPackageExitDefinitionInfo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Id"
                            Style="{StaticResource MaterialDesignComboBox}" />
                    </Border>
                </StackPanel>
                <!--  规则名称  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="规则名称:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="225"
                            Height="30"
                            MaxWidth="300"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding VolumeSortingItemInfo.SortingName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  备注  -->
                <StackPanel Margin="5" Orientation="Vertical">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="备注:" />
                    <Border
                        MinHeight="80"
                        MaxHeight="200"
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5">
                        <TextBox
                            Width="380"
                            MinHeight="150"
                            MaxWidth="380"
                            MaxHeight="190"
                            Margin="5,0"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding VolumeSortingItemInfo.Remarks, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  右边正则  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                Orientation="Vertical">
                <!--  正则列表  -->
                <DataGrid
                    Height="230"
                    MinWidth="500"
                    Margin="20"
                    Padding="10,0"
                    VerticalAlignment="Stretch"
                    materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                    AlternatingRowBackground="#101E90FF"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
                    Focusable="False"
                    Foreground="White"
                    FrozenColumnCount="2"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Auto"
                    ItemsSource="{Binding VolumeRuleItems, UpdateSourceTrigger=PropertyChanged}"
                    RowBackground="#061E90FF"
                    Style="{StaticResource VirtualizingDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                            <Setter Property="Height" Value="35" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="45"
                            MinWidth="45"
                            Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  表达式  -->
                        <DataGridTextColumn
                            MinWidth="400"
                            MaxWidth="400"
                            Binding="{Binding Formula, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="逻辑公式" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  操作  -->
                        <DataGridTemplateColumn
                            Width="100"
                            MinWidth="100"
                            MaxWidth="100"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Width="80"
                                                Height="30"
                                                MinWidth="60"
                                                Margin="5,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="DarkRed"
                                                Command="{Binding ElementName=VolumeSortingRuleView, Path=DataContext.DeleteFormulaCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="Red"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        FontSize="10"
                                                        Foreground="White"
                                                        Text="&#xe601;" />
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Light"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="{x:Static languages:Language.Delete}"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  规则  -->
                <StackPanel
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <RadioButton
                        Name="RuleRadioButton"
                        Content="规则设置:"
                        Focusable="False"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        IsChecked="{Binding IsUseTemplateFormula, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Template="{StaticResource CustomRadioButtonTemplate}" />

                    <StackPanel
                        Margin="50,5,0,0"
                        Orientation="Vertical"
                        Visibility="{Binding UpdateSourceTrigger=PropertyChanged, ElementName=RuleRadioButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!--  变量  -->
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DodgerBlue"
                                BorderThickness="0"
                                Command="{Binding AddDataItemCommand}"
                                CommandParameter="'{Length}'"
                                Focusable="False"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderLength}" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DodgerBlue"
                                BorderThickness="0"
                                Command="{Binding AddDataItemCommand}"
                                CommandParameter="'{Width}'"
                                Focusable="False"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderWidth}" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DodgerBlue"
                                BorderThickness="0"
                                Command="{Binding AddDataItemCommand}"
                                CommandParameter="'{Height}'"
                                Focusable="False"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderHeight}" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DodgerBlue"
                                BorderThickness="0"
                                Command="{Binding AddDataItemCommand}"
                                CommandParameter="'{Volume}'"
                                Focusable="False"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderVolume}" />
                            </Button>
                        </StackPanel>
                        <!--  逻辑运算符(按钮)  -->
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOperatorCommand}"
                                CommandParameter="'&gt;'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="&gt;" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOperatorCommand}"
                                CommandParameter="'&lt;'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="&lt;" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOperatorCommand}"
                                CommandParameter="'='"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="=" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOperatorCommand}"
                                CommandParameter="'&lt;&gt;'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="&lt;&gt;" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkOrchid"
                                BorderThickness="0"
                                Command="{Binding AddStitchingCommand}"
                                CommandParameter="'and'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="and" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkOrchid"
                                BorderThickness="0"
                                Command="{Binding AddStitchingCommand}"
                                CommandParameter="'or'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="or" />
                            </Button>
                            <Border
                                Margin="5,0"
                                Background="ForestGreen"
                                CornerRadius="15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox
                                        Name="CustomContentTextBox"
                                        Width="40"
                                        Height="30"
                                        MaxWidth="40"
                                        Margin="15,0,0,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        TextAlignment="Center" />
                                    <Border
                                        Width="1"
                                        Height="20"
                                        BorderBrush="White"
                                        BorderThickness="1" />
                                    <Button
                                        Width="70"
                                        Height="30"
                                        Margin="0,0"
                                        Padding="0"
                                        materialDesign:ButtonAssist.CornerRadius="0,15,15,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding AddReferenceValueCommand}"
                                        CommandParameter="{Binding ElementName=CustomContentTextBox, Path=Text}"
                                        Focusable="False"
                                        Foreground="White"
                                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="参照值" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!--  列表  -->
                        <Border
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#202020"
                            CornerRadius="5">
                            <ListView
                                Width="530"
                                Height="90"
                                MaxWidth="530"
                                Margin="5"
                                Focusable="False"
                                ItemTemplateSelector="{StaticResource FormulaDataTemplateSelectors}"
                                ItemsSource="{Binding FormulaTemplate, UpdateSourceTrigger=PropertyChanged}"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                SelectionMode="Extended">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border
                                                        x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListView}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <WrapPanel
                                                IsItemsHost="True"
                                                Orientation="Horizontal"
                                                ScrollViewer.CanContentScroll="True" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListView>
                        </Border>
                        <!--  公式  -->
                        <Border
                            MinHeight="50"
                            MaxHeight="200"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#202020"
                            CornerRadius="5">
                            <TextBox
                                Width="530"
                                MinHeight="50"
                                MaxWidth="530"
                                MaxHeight="60"
                                Margin="5,0"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>
                    <RadioButton
                        Name="RegularExpressionRadioButton"
                        Content="逻辑公式:"
                        Focusable="False"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        IsChecked="{Binding IsUseCustomFormula, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Template="{StaticResource CustomRadioButtonTemplate}" />
                    <Border
                        MinHeight="60"
                        MaxHeight="200"
                        Margin="50,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#202020"
                        CornerRadius="5"
                        Visibility="{Binding ElementName=RegularExpressionRadioButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox
                            Width="530"
                            MinHeight="350"
                            MaxWidth="530"
                            MaxHeight="350"
                            Margin="5,0"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding CustomFormula, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
                <!--  保存规则、效验规则、清空条件  -->
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="RoyalBlue"
                        BorderThickness="0"
                        Command="{Binding SaveRuleCommand}"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="15"
                                FontWeight="Light"
                                Foreground="White"
                                Text="&#xe66e;" />
                            <TextBlock
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="保存规则" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkRed"
                        BorderThickness="0"
                        Command="{Binding ClearConditionsCommand}"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="16"
                                FontWeight="Light"
                                Foreground="White"
                                Text="&#xe78d;" />
                            <TextBlock
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="清空条件" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--  确定、取消按钮  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="RoyalBlue"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="15"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe66e;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static languages:Language.Save}" />
                    </StackPanel>
                </Button>
                <Button
                    Height="30"
                    MinWidth="80"
                    Margin="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="15"
                    Background="DarkRed"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Focusable="False"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="16"
                            FontWeight="Light"
                            Foreground="White"
                            Text="&#xe636;" />
                        <TextBlock
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>