<Window
    x:Class="JayTom.Dws.Client.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="MainWin"
    Width="1820"
    Height="980"
    MinWidth="800"
    MinHeight="750"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
        </b:EventTrigger>
        <!--<b:EventTrigger EventName="SizeChanged" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding SizeChangedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
        </b:EventTrigger>-->
    </b:Interaction.Triggers>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="70"
            CornerRadius="10"
            GlassFrameThickness="-1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:ImageConverter x:Key="ImageConverter" />
        <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Storyboard x:Key="ShowFrameStoryboard">
            <ObjectAnimationUsingKeyFrames
                BeginTime="0:0:0.8"
                FillBehavior="HoldEnd"
                Storyboard.TargetProperty="(Frame.Visibility)"
                Duration="0:0:0.2">
                <DiscreteObjectKeyFrame KeyTime="0">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Visible</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <BitmapImage
            x:Key="DefaultImage"
            DecodePixelHeight="148"
            DecodePixelWidth="148"
            UriSource="pack://application:,,,/Image/Logo/logobw.png" />
    </Window.Resources>
    <!--  任务栏  -->
    <!--<Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="taskBarItem">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Description="Play" ImageSource="pack://application:,,,/Image/Logo/logobw.png" />
                <ThumbButtonInfo Description="Pause" ImageSource="pack://application:,,,/Image/Logo/icon logo.png" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>-->
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="MainDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <materialDesign:Card
            Margin="0"
            materialDesign:ElevationAssist.Elevation="Dp2"
            materialDesign:ShadowAssist.Darken="True"
            materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
            Background="#202020"
            UniformCornerRadius="{Binding UniformCornerRadius, UpdateSourceTrigger=PropertyChanged}">
            <!--  切换-过渡动画  -->
            <materialDesign:Transitioner
                Margin="0"
                Padding="0"
                AutoApplyTransitionOrigins="True"
                Focusable="False"
                SelectedIndex="0">
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <materialDesign:SlideWipe Direction="Right" Duration="0:0:0.5" />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <materialDesign:SlideWipe Direction="Left" Duration="0:0:0.5" />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <!--  标题栏、工具条  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            CornerRadius="5,5,0,0">
                            <!--  系统按钮  -->
                            <StackPanel
                                Margin="10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <!--  软件名 、SUNNEN、无限创科DWS分拣控制系统  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding ProgramTitle, UpdateSourceTrigger=PropertyChanged}" />
                                <!--  工具  Visibility="Collapsed"  -->
                                <ComboBox
                                    Name="HomeToolComboBox"
                                    MinWidth="50"
                                    Margin="15,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    materialDesign:ComboBoxAssist.ShowSelectedItem="False"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    IsReadOnly="True"
                                    IsSelected="False"
                                    ItemTemplate="{StaticResource HomeToolTemplate}"
                                    ItemsSource="{Binding HomeToolItems}"
                                    MaxDropDownHeight="800"
                                    SelectedIndex="0"
                                    StaysOpenOnEdit="True"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    Visibility="Visible"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="SelectionChanged">
                                            <mvvm:InvokeCommandAction Command="{Binding HomeToolSelectionChangedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                    <ComboBox.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignComboBoxItemSelectedCollapsedStyle}" TargetType="ComboBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!--  语言切换  -->
                                <ComboBox
                                    MinWidth="50"
                                    Margin="15,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    IsTextSearchEnabled="True"
                                    ItemTemplate="{StaticResource LanguageComboBoxTemplate}"
                                    ItemsSource="{StaticResource LanguageInfoArray}"
                                    MaxDropDownHeight="800"
                                    SelectedIndex="0"
                                    SelectedItem="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="SelectionChanged">
                                            <mvvm:InvokeCommandAction Command="{Binding LanguageSwitchCommand}" CommandParameter="{Binding SelectedLanguage}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                    <ComboBox.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}" TargetType="ComboBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!--  最小化  -->
                                <Button
                                    Command="{Binding MinWinCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                    Style="{StaticResource SystemButtonStyle}"
                                    ToolTip="Minimize">
                                    <TextBlock
                                        Foreground="White"
                                        Style="{StaticResource SystemTextBlockStyle}"
                                        Text="&#xe626;" />
                                </Button>
                                <!--  最大化  -->
                                <Button
                                    x:Name="MaxButton"
                                    Command="{Binding MaxWinCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                    Style="{StaticResource SystemButtonStyle}"
                                    ToolTip="{Binding MaxBtnToolTip, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock
                                        x:Name="MaxBlock"
                                        Foreground="White"
                                        Style="{StaticResource SystemTextBlockStyle}"
                                        Text="{Binding MaxBtnIcon, UpdateSourceTrigger=PropertyChanged}" />
                                </Button>
                                <!--  关闭  -->
                                <Button
                                    Command="{Binding CloseWinCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                    Style="{StaticResource CustomCloseButtonStyle}"
                                    ToolTip="Close">
                                    <TextBlock
                                        Foreground="White"
                                        Style="{StaticResource SystemTextBlockStyle}"
                                        Text="&#xe601;" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!--  内容  -->
                        <Grid Grid.Row="0" Grid.RowSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="70" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <!--  大按钮  -->
                            <Button
                                Name="MenuButton"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Width="300"
                                Height="300"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                materialDesign:ButtonProgressAssist.IndicatorForeground="White"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{x:Static materialDesign:Transitioner.MoveNextCommand}"
                                Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform X="{Binding ButtonTranslateTransform.X, UpdateSourceTrigger=PropertyChanged}" Y="{Binding ButtonTranslateTransform.Y, UpdateSourceTrigger=PropertyChanged}" />
                                        <ScaleTransform CenterX="0" CenterY="0" ScaleX="1" ScaleY="1" />
                                    </TransformGroup>
                                </Button.RenderTransform>
                                <Button.Style>

                                    <Style BasedOn="{StaticResource MaterialDesignFloatingActionButton}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="True" />
                                        <Setter Property="materialDesign:ButtonProgressAssist.Value" Value="-1" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True" />
                                                <Setter Property="Opacity" Value="0.8" />
                                                <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="False" />
                                                <Setter Property="materialDesign:ButtonProgressAssist.Value" Value="0" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)"
                                                                To="10"
                                                                Duration="0:0:0.5" />
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                                                                To="10"
                                                                Duration="0:0:0.5" />
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)"
                                                                To="0.16"
                                                                Duration="0:0:0.5" />
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)"
                                                                To="0.16"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Border
                                    Width="296"
                                    Height="296"
                                    CornerRadius="148"
                                    Opacity="0.9">
                                    <Border.Background>
                                        <ImageBrush>
                                            <ImageBrush.ImageSource>
                                                <MultiBinding Converter="{StaticResource ImageConverter}">
                                                    <Binding Path="LogoSource" UpdateSourceTrigger="PropertyChanged" />
                                                    <Binding Source="{StaticResource DefaultImage}" />
                                                </MultiBinding>
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                            </Button>
                            <!--  背景图标  -->
                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Width="300"
                                Height="300"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="150">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <ImageBrush Opacity="0.1">
                                        <ImageBrush.ImageSource>
                                            <MultiBinding Converter="{StaticResource ImageConverter}">
                                                <Binding Path="LogoSource" UpdateSourceTrigger="PropertyChanged" />
                                                <Binding Source="{StaticResource DefaultImage}" />
                                            </MultiBinding>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Border.Background>
                            </Border>
                            <!--  进度说明  -->
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="40"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Loading...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!--  主页面 跨2列  -->
                            <Frame
                                Name="PagesFrame"
                                Grid.Row="1"
                                Grid.RowSpan="2"
                                Focusable="False"
                                NavigationUIVisibility="Hidden"
                                Source="Pages/HomePage.xaml">
                                <Frame.Style>
                                    <Style TargetType="Frame">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoaded, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource ShowFrameStoryboard}" />
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Frame.Style>
                            </Frame>
                        </Grid>
                        <!--  状态栏  -->
                        <Frame
                            Grid.Row="2"
                            Margin="0"
                            Padding="0"
                            Focusable="False"
                            NavigationUIVisibility="Hidden"
                            Source="StatusBarPage.xaml" />
                        <!--  提示框  -->
                        <materialDesign:Snackbar
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Width="Auto"
                            Height="Auto"
                            VerticalAlignment="Bottom"
                            Background="BlueViolet"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontWeight="Bold"
                            MessageQueue="{Binding MainMessageQueue}" />
                    </Grid>
                </materialDesign:TransitionerSlide>
                <!--  内页  -->
                <materialDesign:TransitionerSlide Margin="0">
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <materialDesign:SlideWipe Direction="Right" Duration="0:0:0.5" />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <materialDesign:SlideWipe Direction="Left" Duration="0:0:0.5" />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  返回按钮  -->
                        <Border
                            Grid.Row="0"
                            Width="210"
                            HorizontalAlignment="Left"
                            Background="#2E2E2E">
                            <Button
                                Width="42"
                                Height="42"
                                Margin="20,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{x:Static materialDesign:Transitioner.MoveFirstCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                                <TextBlock
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="40"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="&#xe636;" />
                            </Button>
                        </Border>
                        <!--  页面内容  -->
                        <Frame
                            Grid.Row="1"
                            Margin="0"
                            Padding="0"
                            Focusable="False"
                            NavigationUIVisibility="Hidden"
                            Source="Pages/SettingsPage.xaml" />
                    </Grid>
                </materialDesign:TransitionerSlide>
            </materialDesign:Transitioner>
        </materialDesign:Card>
    </materialDesign:DialogHost>
</Window>