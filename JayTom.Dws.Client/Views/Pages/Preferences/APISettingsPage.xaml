<!--  API接口设置  -->
<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.APISettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:JayTom.Dws.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="ApiSettingsView"
    Title="APISettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="ApiTabNavigationButtonStyle"
            BasedOn="{StaticResource MaterialDesignFlatButton}"
            TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.82" />
            <Setter Property="ToolTipService.ShowDuration" Value="5000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#267B7B7B" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3D7B7B7B" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.28" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="ApiSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="APISettingsDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  当前使用接口  -->
            <StackPanel
                Grid.Row="0"
                Margin="20,5,0,0"
                Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe664;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.SelectedApi}" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <ComboBox
                        Height="30"
                        MinWidth="160"
                        Padding="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        materialDesign:ColorZoneAssist.Mode="Dark"
                        BorderThickness="0"
                        DisplayMemberPath="Name"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        ItemsSource="{Binding ApiTypeItems, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectApiType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        Style="{StaticResource MaterialDesignComboBox}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <mvvm:InvokeCommandAction Command="{Binding OptionSelectionChangedCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ComboBox>
                </Border>
            </StackPanel>
            <!--  内容  -->
            <TabControl
                x:Name="ApiTabs"
                Grid.Row="1"
                HorizontalContentAlignment="Left"
                materialDesign:ColorZoneAssist.Foreground="White"
                materialDesign:ColorZoneAssist.Mode="Custom"
                materialDesign:TabAssist.HasFilledTab="True"
                materialDesign:TabAssist.HasUniformTabWidth="False"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{StaticResource MaterialDesignTabControl}"
                TabStripPlacement="Top">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            KeyboardNavigation.TabNavigation="Local"
                            SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  单行页签导航：左右翻页、滚轮横移和全部页签菜单。  -->
                            <Border
                                Grid.Row="0"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="0,0,0,1">
                                <Grid x:Name="HeaderNavigationBar" MinHeight="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="PART_ScrollLeftButton"
                                        Grid.Column="0"
                                        Width="36"
                                        AutomationProperties.Name="向左浏览接口选项卡"
                                        Style="{StaticResource ApiTabNavigationButtonStyle}"
                                        ToolTip="向左浏览接口">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="ChevronLeft" />
                                    </Button>

                                    <ScrollViewer
                                        x:Name="PART_HeaderScrollViewer"
                                        Grid.Column="1"
                                        Margin="2,0"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Disabled"
                                        CanContentScroll="False"
                                        Focusable="False"
                                        PanningMode="HorizontalOnly">
                                        <TabPanel
                                            HorizontalAlignment="Left"
                                            IsItemsHost="True"
                                            KeyboardNavigation.TabIndex="1"
                                            Panel.ZIndex="1" />
                                    </ScrollViewer>

                                    <Button
                                        x:Name="PART_ScrollRightButton"
                                        Grid.Column="2"
                                        Width="36"
                                        AutomationProperties.Name="向右浏览接口选项卡"
                                        Style="{StaticResource ApiTabNavigationButtonStyle}"
                                        ToolTip="向右浏览接口">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="ChevronRight" />
                                    </Button>

                                    <Border
                                        Grid.Column="3"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1,0,0,0">
                                        <Button
                                            x:Name="PART_OverflowButton"
                                            MinWidth="68"
                                            AutomationProperties.Name="打开全部接口选项卡菜单"
                                            Style="{StaticResource ApiTabNavigationButtonStyle}"
                                            ToolTip="查看全部接口">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,4,0"
                                                    Kind="DotsHorizontal" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="更多" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>

                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Grid.Row="1"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                ContentSource="SelectedContent"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderNavigationBar" Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Foreground="White" Header="{x:Static languages:Language.DefaultApi}">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/DefaultApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="旺店通WMS">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/WdtWmsApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="旺店通ERP">
                    <TextBlock
                        Margin="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="内容开发中..." />
                </TabItem>
                <TabItem Header="旺店通ERP旗舰版">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/WdtFlagshipApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="神州集运后台">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/SzjyApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="极兔Api">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/JtExpressApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="极兔极昼Api">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/JtPolarDayApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="络道科技Api">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/RoutDataApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="菜鸟Api">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/CaiNiaoApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="海通智运Api">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/EshippingitApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="聚水潭Erp">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/JushuitanApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="周艺Api">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="ApiConfiguration/ZhouYiApiPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
            </TabControl>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="1"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding ApiSettingsMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>
