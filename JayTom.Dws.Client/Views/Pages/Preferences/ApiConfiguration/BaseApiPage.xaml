<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.ApiConfiguration.BaseApiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.ApiConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="BaseApiPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">

    <Grid Margin="10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <!--  数据模板  -->
            <StackPanel
                Margin="5,0"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <!--  数据模板  -->
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="&#xe6b6;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="数据模板:" />
                </StackPanel>
                <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="输出数据:" />
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{BarCode}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="条码" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{Weight}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="重量" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{ScanTime}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="扫码时间" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{TimestampedGuid}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="扫码时间戳" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{Length}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="长" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{Width}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="宽" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{Height}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="高" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{Volume}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="体积" />
                        </Button>
                        <Button
                            Height="30"
                            Margin="5,0"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="DarkGray"
                            BorderThickness="0"
                            Command="{Binding AddOutputItemCommand}"
                            CommandParameter="'{CameraSerialNumber}'"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="相机序列号" />
                        </Button>
                        <Border Background="BlueViolet" CornerRadius="15">
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="40"
                                    Height="30"
                                    MaxWidth="40"
                                    Margin="15,0,0,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding VolumeSettingsInfo.Separator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    TextAlignment="Center" />
                                <Border
                                    Width="1"
                                    Height="20"
                                    BorderBrush="White"
                                    BorderThickness="1" />
                                <Button
                                    Width="70"
                                    Height="30"
                                    Margin="0,0"
                                    Padding="0"
                                    materialDesign:ButtonAssist.CornerRadius="0,15,15,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding AddSeparatorItemCommand}"
                                    CommandParameter="{Binding VolumeSettingsInfo.Separator}"
                                    Focusable="False"
                                    Foreground="White"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="分隔符" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Border
                    Margin="50,10,0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <Grid>
                        <Border
                            Width="40"
                            Margin="2"
                            HorizontalAlignment="Left"
                            Background="DarkGray"
                            CornerRadius="5">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#2E2E2E"
                                Text="内容" />
                        </Border>
                        <ListView
                            Width="845"
                            Height="30"
                            MaxWidth="900"
                            Margin="50,0,0,0"
                            Focusable="False"
                            ItemsSource="{Binding VolumeSettingsInfo.DataTemplate, UpdateSourceTrigger=PropertyChanged}"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            SelectionMode="Extended">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border
                                                    x:Name="Border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                    <ContentPresenter
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Background="Transparent" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
            <!--  是否使用Json格式上传  -->
            <StackPanel Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe7bd;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用Json格式上传:" />
                    <ToggleButton
                        Name="TcpToggleButton"
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding IsUseTcpInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <!--  支持的内容格式  -->
                <StackPanel Margin="50,10,0,0" Orientation="Vertical">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="Json模板内容:" />
                    <Border
                        Height="170"
                        MinHeight="80"
                        MaxHeight="200"
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="330"
                            MinHeight="150"
                            MaxWidth="500"
                            Margin="5,0"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding ExampleJson, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  接口参数  -->
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe645;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="接口参数:" />
                </StackPanel>
                <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="Url:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="280"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding HttpUploadSettingsInfo.Url, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="请求超时时间:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="60"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:HintAssist.Hint="ms"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding HttpUploadSettingsInfo.Timeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  成功返回验证(包含、完全匹配、正则验证)  -->
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="&#xe76d;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="返回成功验证:" />
                </StackPanel>
                <!--  包含内容  -->
                <StackPanel Orientation="Vertical" />

                <!--  完全匹配  -->
                <!--  正则验证  -->
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>