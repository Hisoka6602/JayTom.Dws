<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.ApiConfiguration.WdtFlagshipApiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.ApiConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="WdtFlagshipApiPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <!--  旺店通旗舰版  -->
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid Margin="0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe645;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.InterfaceParameters}" />
            </StackPanel>
            <StackPanel Margin="50,0,0,0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="Url:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="280"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding WdtFlagshipApiInfo.Url, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="Sid:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="280"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.Sid, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="Key:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="280"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.Key, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="appsecret:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="240"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.Appsecret, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="method:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="260"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.Method, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="v(版本号):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="240"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.V, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="salt(加密):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="235"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.Salt, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="packagerId(打包员Id):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="170"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.PackagerId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="packagerNo(打包员编号):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="158"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.PackagerNo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="operateTableName(打包台):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="145"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding WdtFlagshipApiInfo.OperateTableName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="force(是否强制上传):" />
                    <ToggleButton
                        Name="IsForceToggleButton"
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding WdtFlagshipApiInfo.Force, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.RequestTimeout}" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="60"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:HintAssist.Hint="ms"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding WdtFlagshipApiInfo.TimeOut, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  测试提交  -->
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe812;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="测试上传:" />
                </StackPanel>
                <StackPanel Margin="50,0,0,0" Orientation="Vertical">
                    <!--  条码  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.BarcodeCondition}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="250"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <!--  重量  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Weight}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="250"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <!--  上传测试  -->
                    <Button
                        MinHeight="30"
                        Margin="0,10"
                        HorizontalAlignment="Left"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Background="#2E2E2E"
                        BorderThickness="0"
                        Command="{Binding UploadCommand}"
                        FocusVisualStyle="{x:Null}"
                        Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="18"
                                    Foreground="DarkGray"
                                    Text="&#xe6d4;" />
                                <TextBlock
                                    Margin="2,1,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="上传测试" />
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUploading}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUploading}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            </StackPanel>
                            <ProgressBar
                                Width="25"
                                Height="25"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsIndeterminate="True"
                                Value="0">
                                <ProgressBar.Style>
                                    <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUploading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUploading}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>