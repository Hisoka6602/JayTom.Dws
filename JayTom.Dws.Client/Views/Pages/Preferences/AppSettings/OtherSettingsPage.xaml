<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.AppSettings.OtherSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.AppSettings"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="OtherSettingsView"
    Title="OtherSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="OtherSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="OtherSettingsDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="20,0"
                Orientation="Vertical">
                <!--  启动最大化  -->
                <StackPanel
                    Margin="5,5"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="-3,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="25"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="&#xe855;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否自动最大化:" />
                        <CheckBox
                            BorderBrush="DodgerBlue"
                            BorderThickness="2"
                            Foreground="#2E2E2E"
                            IsChecked="{Binding OtherSettingsInfo.IsAutoMaximize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource CustomCheckBoxStyle}" />
                    </StackPanel>
                </StackPanel>
                <!--  自动启动  -->
                <StackPanel
                    Margin="5,5"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="-3,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="25"
                            Foreground="DarkGray"
                            Text="&#xe851;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否自动启动:" />
                        <CheckBox
                            BorderBrush="DodgerBlue"
                            BorderThickness="2"
                            Foreground="#2E2E2E"
                            IsChecked="{Binding OtherSettingsInfo.IsAutoStart, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource CustomCheckBoxStyle}" />
                    </StackPanel>
                </StackPanel>
                <!--  自动启动  -->
                <StackPanel
                    Margin="5,5"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="-3,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="25"
                            Foreground="DarkGray"
                            Text="&#xe85c;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否开机自动运行:" />
                        <CheckBox
                            BorderBrush="DodgerBlue"
                            BorderThickness="2"
                            Foreground="#2E2E2E"
                            IsChecked="{Binding OtherSettingsInfo.IsAutoRunEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource CustomCheckBoxStyle}" />
                    </StackPanel>
                </StackPanel>
                <!--  程序标题  -->
                <StackPanel
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe85b;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="程序标题:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="200"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            MaxLength="12"
                            Text="{Binding OtherSettingsInfo.ProgramTitle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  程序Logo  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe856;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="程序Logo:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#2E2E2E"
                        CornerRadius="5">
                        <Image
                            Width="40"
                            Height="40"
                            MaxWidth="300"
                            Margin="5"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Source="{Binding Icon}">
                            <!--  图标  -->
                        </Image>
                    </Border>
                    <Button
                        Width="40"
                        MinHeight="30"
                        Margin="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Background="#2E2E2E"
                        BorderThickness="0"
                        Command="{Binding LoadImageCommand}"
                        FocusVisualStyle="{x:Null}"
                        Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="..." />
                    </Button>
                </StackPanel>
            </StackPanel>
            <!--  保存按钮  -->
            <Button
                Grid.Row="2"
                MinHeight="30"
                Margin="30,0"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding SaveSettingsCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe66e;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.SaveSettings}" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                    <ProgressBar
                        Name="StatusProgressBar"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Value="0">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Button>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="1"
                Grid.RowSpan="2"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding OtherSettingsMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>