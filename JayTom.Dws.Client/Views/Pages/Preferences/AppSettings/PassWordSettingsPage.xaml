<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.AppSettings.PassWordSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.AppSettings"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="PassWordSettingsView"
    Title="PassWordSetting"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>

        <!--  是否使用密码保护  -->
        <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
            <TextBlock
                Margin="0,0,0,1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="20"
                Foreground="DarkGray"
                Text="&#xe990;" />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="是否使用密码保护:" />
            <ToggleButton
                Name="IsPasswordProtectedToggleButton"
                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                Focusable="False"
                IsChecked="{Binding PassWordSettingsInfo.IsUsePasswordProtection, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
        </StackPanel>
        <StackPanel
            Margin="20,20,0,0"
            Orientation="Vertical"
            Visibility="{Binding ElementName=IsPasswordProtectedToggleButton, Path=IsChecked, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!--  选择保护模块  -->
            <StackPanel Margin="20,10,0,0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe989;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="需要密码保护的模块:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <ListBox
                        Width="1000"
                        ItemsSource="{Binding PassWordSettingsInfo.PasswordProtectionModuleItems}"
                        Style="{StaticResource CustomListBoxStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,5" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{Binding Description}" />
                                    <CheckBox
                                        BorderBrush="DodgerBlue"
                                        BorderThickness="2"
                                        Focusable="False"
                                        IsChecked="{Binding IsProtected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource CustomCheckBoxStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Template>
                            <ControlTemplate TargetType="{x:Type ListBox}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel
                                        IsItemsHost="True"
                                        Orientation="Horizontal"
                                        ScrollViewer.CanContentScroll="True" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                    </ListBox>
                </StackPanel>
            </StackPanel>
            <!--  密码  -->
            <StackPanel Margin="20,10,0,0" Orientation="Vertical">
                <!--  密码  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe988;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="输入密码:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <PasswordBox
                            Width="260"
                            Height="30"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Style="{StaticResource MaterialDesignRevealPasswordBox}">
                            <materialDesign:PasswordBoxAssist.Password>

                                <Binding
                                    Mode="TwoWay"
                                    Path="PassWordSettingsInfo.Password"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:RegexValidationRule ErrorMessage="包含非法字符" Pattern="^[^\u4e00-\u9fa5\s\n]+$" />
                                    </Binding.ValidationRules>
                                </Binding>

                            </materialDesign:PasswordBoxAssist.Password>
                        </PasswordBox>
                    </Border>
                </StackPanel>
                <!--  确认密码  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe98b;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="确认密码:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <PasswordBox
                            Width="260"
                            Height="30"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Style="{StaticResource MaterialDesignRevealPasswordBox}">
                            <materialDesign:PasswordBoxAssist.Password>

                                <Binding
                                    Mode="TwoWay"
                                    Path="PassWordSettingsInfo.ConfirmPassword"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:RegexValidationRule ErrorMessage="包含非法字符" Pattern="^[^\u4e00-\u9fa5\s\n]+$" />
                                    </Binding.ValidationRules>
                                </Binding>

                            </materialDesign:PasswordBoxAssist.Password>
                        </PasswordBox>
                    </Border>
                </StackPanel>
                <!--  密码提示  -->
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe982;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="密码提示:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="260"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            MaxLength="30"
                            Text="{Binding PassWordSettingsInfo.PasswordHint, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  是否验证密码后本次启动其他操作不重复验证  -->
            <StackPanel Margin="20,20,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe932;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否验证密码后本次启动的其他操作不重复验证:" />
                <CheckBox
                    BorderBrush="DodgerBlue"
                    BorderThickness="2"
                    Foreground="#2E2E2E"
                    IsChecked="{Binding PassWordSettingsInfo.SkipPasswordValidationForThisSession, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource CustomCheckBoxStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>