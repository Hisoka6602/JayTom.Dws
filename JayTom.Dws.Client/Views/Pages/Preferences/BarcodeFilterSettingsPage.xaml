                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding BarcodeFilterSettingsInfo.ScanInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="ms" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.BarcodeIntervalLimit}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="80"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding BarcodeFilterSettingsInfo.DuplicateBarcodeFilterCount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  过滤输出  -->
        <StackPanel
            Grid.Row="4"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe962;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="过滤输出:" />
            </StackPanel>
            <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="输出内容:" />
                        <Border
                            MinWidth="200"
                            MinHeight="30"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="10,0"
                                    Content="不输出"
                                    Focusable="False"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    IsChecked="{Binding BarcodeFilterSettingsInfo.FilterOutputType, Converter={StaticResource FilterOutputTypeToBooleanConverter}, ConverterParameter=NotOutput}"
                                    Template="{StaticResource CustomRadioButtonTemplate}" />
                                <RadioButton
                                    Margin="10,0"
                                    Command="{Binding StartCharacterTypeChangedCommand}"
                                    Content="Filtered"
                                    Focusable="False"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    IsChecked="{Binding BarcodeFilterSettingsInfo.FilterOutputType, Converter={StaticResource FilterOutputTypeToBooleanConverter}, ConverterParameter=Filtered}"
                                    Template="{StaticResource CustomRadioButtonTemplate}" />
                                <RadioButton
                                    Margin="10,0"
                                    Command="{Binding StartCharacterTypeChangedCommand}"
                                    Content="NoRead"
                                    Focusable="False"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    IsChecked="{Binding BarcodeFilterSettingsInfo.FilterOutputType, Converter={StaticResource FilterOutputTypeToBooleanConverter}, ConverterParameter=NoRead}"
                                    Template="{StaticResource CustomRadioButtonTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  条码融合  -->
        <StackPanel
            Grid.Row="5"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe969;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="条码融合:" />
            </StackPanel>
            <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="融合超时时间:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="80"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding BarcodeFilterSettingsInfo.MergeTimeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="ms" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="多条码分隔符:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="80"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding BarcodeFilterSettingsInfo.MultiBarcodeDelimiter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>