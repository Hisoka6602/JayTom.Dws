<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.BarcodeFilterSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    Name="BarcodeFilterSettingsView"
    Title="BarcodeFilterSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <Page.Resources>
        <settingsConverter:CharacterTypeToBooleanConverter x:Key="CharacterTypeToBooleanConverter" />
        <settingsConverter:FilterOutputTypeToBooleanConverter x:Key="FilterOutputTypeToBooleanConverter" />
        <settingsConverter:BarCodeFilterOptionsToBooleanConverter x:Key="BarCodeFilterOptionsToBooleanConverter" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--<lottie:LottieAnimationView
         Width="300"
         Height="500"
         HorizontalAlignment="Center"
         VerticalAlignment="Center"
         AutoPlay="True"
         RepeatCount="-1"
         ResourcePath="pack://application:,,,/Lotties/TextLoading.json" />-->
        <TabControl
            Grid.Row="0"
            Height="570"
            HorizontalContentAlignment="Left"
            materialDesign:ColorZoneAssist.Foreground="DarkGray"
            materialDesign:ColorZoneAssist.Mode="Custom"
            materialDesign:TabAssist.HasFilledTab="True"
            materialDesign:TabAssist.HasUniformTabWidth="True"
            Focusable="False"
            FontFamily="{StaticResource CustomFontFamily}"
            FontSize="25"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedIndex="{Binding FilterTypeSelectedIndex}"
            Style="{StaticResource MaterialDesignUniformTabControl}"
            TabStripPlacement="Top">
            <!--  常规过滤  -->
            <TabItem
                FocusVisualStyle="{x:Null}"
                FontFamily="{StaticResource CustomFontFamily}"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Header="常规过滤">
                <ScrollViewer
                    MaxWidth="900"
                    MaxHeight="550"
                    Margin="0,15"
                    HorizontalAlignment="Left"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <!--  是否使用常规过滤  -->
                        <StackPanel
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="是否使用常规过滤:" />
                            <ToggleButton
                                Name="IsUseBasicFilterToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
                                IsChecked="{Binding BarcodeFilterSettingsInfo.BarCodeFilterOptions, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource BarCodeFilterOptionsToBooleanConverter}, ConverterParameter=BasicFilter}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                        <StackPanel
                            Margin="20,0"
                            Orientation="Vertical"
                            Visibility="{Binding ElementName=IsUseBasicFilterToggleButton, Path=IsChecked, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!--  条码长度限制  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="&#xe6cc;" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.BarcodeLength}" />
                                </StackPanel>
                                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.MinBarcodeLength}" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="80"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.MinimumLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="TextChanged">
                                                            <mvvm:InvokeCommandAction Command="{Binding MinimumLengthChangedCommand}" />
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.MaxBarcodeLength}" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="80"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.MaximumLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="TextChanged">
                                                            <mvvm:InvokeCommandAction Command="{Binding MaximumLengthChangedCommand}" />
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <!--  字符限制  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="20"
                                        Foreground="DarkGray"
                                        Text="&#xeaed;" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.CharacterLimitation}" />
                                </StackPanel>
                                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <!--  开头字符  -->
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.StartCharacter}" />
                                            <Border
                                                MinWidth="200"
                                                MinHeight="30"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding StartCharacterTypeChangedCommand}"
                                                        Content="{x:Static languages:Language.LettersOrNumbers}"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.StartCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Alphanumeric}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding StartCharacterTypeChangedCommand}"
                                                        Content="{x:Static languages:Language.Letters}"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.StartCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Letter}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding StartCharacterTypeChangedCommand}"
                                                        Content="{x:Static languages:Language.Numbers}"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.StartCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Number}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding StartCharacterTypeChangedCommand}"
                                                        Content="任意"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.StartCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Any}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <!--  结尾字符  -->
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.EndCharacter}" />
                                            <Border
                                                MinWidth="200"
                                                MinHeight="30"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding EndCharacterTypeChangedCommand}"
                                                        Content="{x:Static languages:Language.LettersOrNumbers}"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.EndCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Alphanumeric}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding EndCharacterTypeChangedCommand}"
                                                        Content="{x:Static languages:Language.Letters}"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.EndCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Letter}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding EndCharacterTypeChangedCommand}"
                                                        Content="{x:Static languages:Language.Numbers}"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.EndCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Number}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                    <RadioButton
                                                        Margin="10,0"
                                                        Command="{Binding EndCharacterTypeChangedCommand}"
                                                        Content="任意"
                                                        Focusable="False"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsChecked="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.EndCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Any}"
                                                        Template="{StaticResource CustomRadioButtonTemplate}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <!--  不能包含  -->
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.CannotContain}" />
                                            <Border
                                                Width="310"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="310"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.DisallowedCharacters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="TextChanged">
                                                            <mvvm:InvokeCommandAction Command="{Binding DisallowedCharactersChangedCommand}" />
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>
                                        <!--  必须包含  -->
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.MustContain}" />
                                            <Border
                                                Width="310"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="310"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.RequiredCharacters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="TextChanged">
                                                            <mvvm:InvokeCommandAction Command="{Binding RequiredCharactersChangedCommand}" />
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>
                                        <!--  包含任意  -->
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="包含任意:" />
                                            <Border
                                                Width="310"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="310"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.AnyCharacters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="TextChanged">
                                                            <mvvm:InvokeCommandAction Command="{Binding AnyCharactersChangedCommand}" />
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>
                                        <!--  条码开头  -->
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="条码开头:" />
                                            <Border
                                                Width="310"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="310"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:HintAssist.Hint="{x:Static languages:Language.ConditionSeparationInstruction}"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.AnyStartCodes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="TextChanged">
                                                            <mvvm:InvokeCommandAction Command="{Binding AnyStartCodesChangedCommand}" />
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <!--  正则表达式  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="20"
                                        Foreground="DarkGray"
                                        Text="&#xe758;" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.RegularExpression}" />
                                </StackPanel>
                                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.RegularExpression}" />
                                            <Border
                                                MinHeight="80"
                                                MaxHeight="200"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="310"
                                                    MinHeight="80"
                                                    MaxWidth="310"
                                                    Margin="5,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    IsReadOnly="True"
                                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                    Text="{Binding BarcodeFilterSettingsInfo.BasicFilterInfo.RegularExpression, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap"
                                                    VerticalScrollBarVisibility="Auto" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!--  添加到自定义正则列表  -->
                                <Button
                                    MinHeight="30"
                                    Margin="50,5"
                                    HorizontalAlignment="Left"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="#2E2E2E"
                                    BorderThickness="0"
                                    Command="{Binding AddToRegexFilterListCommand}"
                                    FocusVisualStyle="{x:Null}"
                                    Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="18"
                                            Foreground="DarkGray"
                                            Text="&#xe7de;" />
                                        <TextBlock
                                            Margin="2,1,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CustomFontFamily}"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="添加到正则过滤列表" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!--  验证字符  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="20"
                                        Foreground="DarkGray"
                                        Text="&#xe715;" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.BarcodeValidation}" />
                                </StackPanel>
                                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="{x:Static languages:Language.BarCode}" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="235"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding TestBarcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </Border>
                                            <Button
                                                MinHeight="30"
                                                Margin="5,0"
                                                HorizontalAlignment="Left"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="#2E2E2E"
                                                BorderThickness="0"
                                                Command="{Binding TestCommand}"
                                                FocusVisualStyle="{x:Null}"
                                                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        FontSize="18"
                                                        Foreground="DarkGray"
