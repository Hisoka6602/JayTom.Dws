<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.BarcodeFilterSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    Name="BarcodeFilterSettingsView"
    Title="BarcodeFilterSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <settingsConverter:CharacterTypeToBooleanConverter x:Key="CharacterTypeToBooleanConverter" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="BarcodeFilterSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="BarcodeFilterSettingsDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--<lottie:LottieAnimationView
                Width="300"
                Height="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutoPlay="True"
                RepeatCount="-1"
                ResourcePath="pack://application:,,,/Lotties/TextLoading.json" />-->
            <!--  条码限制  -->
            <StackPanel
                Grid.Row="0"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe6cc;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="条码长度:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="最小条码位数:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding MinimumLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="TextChanged">
                                            <mvvm:InvokeCommandAction Command="{Binding MinimumLengthChangedCommand}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </TextBox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="最大条码位数:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding MaximumLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="TextChanged">
                                            <mvvm:InvokeCommandAction Command="{Binding MaximumLengthChangedCommand}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </TextBox>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  字符限制  -->
            <StackPanel
                Grid.Row="1"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xeaed;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="字符限制:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="开头字符:" />
                            <Border
                                MinWidth="200"
                                MinHeight="30"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Margin="10,0"
                                        Command="{Binding StartCharacterTypeChangedCommand}"
                                        Content="字母或数字"
                                        Focusable="False"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsChecked="{Binding StartCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Alphanumeric}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                    <RadioButton
                                        Margin="10,0"
                                        Command="{Binding StartCharacterTypeChangedCommand}"
                                        Content="字母"
                                        Focusable="False"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsChecked="{Binding StartCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Letter}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                    <RadioButton
                                        Margin="10,0"
                                        Command="{Binding StartCharacterTypeChangedCommand}"
                                        Content="数字"
                                        Focusable="False"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsChecked="{Binding StartCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Number}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="结尾字符:" />
                            <Border
                                MinWidth="200"
                                MinHeight="30"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Margin="10,0"
                                        Command="{Binding EndCharacterTypeChangedCommand}"
                                        Content="字母或数字"
                                        Focusable="False"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsChecked="{Binding EndCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Alphanumeric}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                    <RadioButton
                                        Margin="10,0"
                                        Command="{Binding EndCharacterTypeChangedCommand}"
                                        Content="字母"
                                        Focusable="False"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsChecked="{Binding EndCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Letter}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                    <RadioButton
                                        Margin="10,0"
                                        Command="{Binding EndCharacterTypeChangedCommand}"
                                        Content="数字"
                                        Focusable="False"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsChecked="{Binding EndCharacterType, Converter={StaticResource CharacterTypeToBooleanConverter}, ConverterParameter=Number}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="不能包含:" />
                            <Border
                                Width="235"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="230"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:HintAssist.Hint="多个条件请用英文;号分割"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding DisallowedCharacters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="TextChanged">
                                            <mvvm:InvokeCommandAction Command="{Binding DisallowedCharactersChangedCommand}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </TextBox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="必须包含:" />
                            <Border
                                Width="235"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="230"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:HintAssist.Hint="多个条件请用英文;号分割"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding RequiredCharacters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="TextChanged">
                                            <mvvm:InvokeCommandAction Command="{Binding RequiredCharactersChangedCommand}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </TextBox>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  扫描时间间隔  -->
            <StackPanel
                Grid.Row="2"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe635;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="扫码间隔:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="单码扫码时间间隔:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding ScanInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="ms" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="允许条码重复数量:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding DuplicateBarcodeFilterCount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  正则表达式  -->
            <StackPanel
                Grid.Row="3"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe758;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="正则表达式:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="表达式:" />
                            <Border
                                MinHeight="80"
                                MaxHeight="200"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="310"
                                    MinHeight="80"
                                    MaxWidth="310"
                                    Margin="5,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    IsReadOnly="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding RegularExpression, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  验证字符  -->
            <StackPanel
                Grid.Row="4"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe715;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="条码验证:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="条码:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="235"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding TestBarcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                            <Button
                                Width="80"
                                MinHeight="30"
                                Margin="5,0"
                                HorizontalAlignment="Left"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Background="#2E2E2E"
                                BorderThickness="0"
                                Command="{Binding TestCommand}"
                                FocusVisualStyle="{x:Null}"
                                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="DarkGray"
                                        Text="&#xe70b;" />
                                    <TextBlock
                                        Margin="2,1,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="测试" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  保存设置  -->
            <Button
                Grid.Row="5"
                Grid.Column="0"
                Width="110"
                MinHeight="30"
                Margin="30,10"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding SaveSettingsCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe66e;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="保存设置" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                    <ProgressBar
                        Name="StatusProgressBar"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Value="0">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Button>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="6"
                Grid.Column="0"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding BarcodeFilterSettingsMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>