<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CacheClearSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="CacheClearSettingsView"
    Title="CacheClearSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="CacheClearSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical">

            <!--  磁盘空间  -->
            <StackPanel
                Margin="0,5"
                Orientation="Horizontal"
                Visibility="{Binding IsSameDiskStorage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe615;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.DiskSpace}" />
                <StackPanel
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <ProgressBar
                        Width="500"
                        Height="15"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#2E2E2E"
                        Maximum="100"
                        Minimum="0"
                        Style="{StaticResource CustomProgressBarStyle}"
                        Value="{Binding LocalDiskUsageInfo.DiskUsagePercentage}">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="MediumSeaGreen" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.DataUsagePercentage}" Color="MediumSeaGreen" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.DataUsagePercentage}" Color="RoyalBlue" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.ScanImageUsagePercentage}" Color="RoyalBlue" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.ScanImageUsagePercentage}" Color="DarkOrange" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.PanoramaImageUsagePercentage}" Color="DarkOrange" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.PanoramaImageUsagePercentage}" Color="IndianRed" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.LogFileUsagePercentage}" Color="IndianRed" />
                                <GradientStop Offset="{Binding LocalDiskUsageInfo.LogFileUsagePercentage}" Color="DimGray" />

                                <GradientStop Offset="1" Color="DimGray" />
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <StackPanel Orientation="Horizontal">
                        <!--  数据  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.Data}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="MediumSeaGreen"
                                Text="&#xe7a6;" />
                        </StackPanel>
                        <!--  扫码图片  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.ScannedImages}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="RoyalBlue"
                                Text="&#xe7a6;" />
                        </StackPanel>
                        <!--  扫码图片  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.PanoramicImages}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="DarkOrange"
                                Text="&#xe7a6;" />
                        </StackPanel>
                        <!--  日志  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.LogInformation}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="IndianRed"
                                Text="&#xe7a6;" />
                        </StackPanel>
                        <!--  非程序占用  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.Non_ProgramUsage}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="DimGray"
                                Text="&#xe7a6;" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  FTP空间  -->
            <StackPanel
                Margin="0,5"
                Orientation="Horizontal"
                Visibility="{Binding IsShowingFtpSpaceInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe6c9;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.FTPSpace}" />
                <StackPanel
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <ProgressBar
                        Width="500"
                        Height="15"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#2E2E2E"
                        Maximum="100"
                        Minimum="0"
                        Style="{StaticResource CustomProgressBarStyle}"
                        Value="70">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="MediumSeaGreen" />
                                <GradientStop Offset="0.33" Color="MediumSeaGreen" />
                                <GradientStop Offset="0.33" Color="RoyalBlue" />
                                <GradientStop Offset="0.66" Color="RoyalBlue" />
                                <GradientStop Offset="0.66" Color="DarkOrange" />
                                <GradientStop Offset="0.88" Color="DarkOrange" />
                                <GradientStop Offset="0.88" Color="DimGray" />
                                <GradientStop Offset="1" Color="DimGray" />
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <StackPanel Orientation="Horizontal">
                        <!--  数据  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.Data}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="MediumSeaGreen"
                                Text="&#xe7a6;" />
                        </StackPanel>
                        <!--  扫码图片  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.ScannedImages}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="RoyalBlue"
                                Text="&#xe7a6;" />
                        </StackPanel>
                        <!--  扫码图片  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.PanoramicImages}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="DarkOrange"
                                Text="&#xe7a6;" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CustomFontFamily}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Text="{x:Static languages:Language.Non_ProgramUsage}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="30"
                                Foreground="DimGray"
                                Text="&#xe7a6;" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  手动清理  -->
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe77d;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.ManualCleanup}" />
                </StackPanel>
                <StackPanel Margin="50,0,0,0" Orientation="Vertical">
                    <!--  删除 N天之前的数据  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Delete}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="50"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding ManualCleanupParams.BarcodeDataAgoDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.BarcodeDataDaysAgo}" />
                        <Button
                            Height="Auto"
                            MinHeight="30"
                            Margin="30,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#2E2E2E"
                            BorderThickness="0"
                            Command="{Binding ManualCleanupCommand}"
                            CommandParameter="BarcodeData"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="DarkGray"
                                        Text="&#xe77d;" />
                                    <TextBlock
                                        Margin="2,1,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Delete}" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <ProgressBar
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True"
                                    Value="0">
                                    <ProgressBar.Style>
                                        <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <!--  删除 N天之前的扫码图片  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Delete}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="50"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding ManualCleanupParams.ScanImageAgoDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.ScannedImageDaysAgo}" />
                        <Button
                            Height="Auto"
                            MinHeight="30"
                            Margin="30,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#2E2E2E"
                            BorderThickness="0"
                            Command="{Binding ManualCleanupCommand}"
                            CommandParameter="ScanImage"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="DarkGray"
                                        Text="&#xe77d;" />
                                    <TextBlock
                                        Margin="2,1,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Delete}" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <ProgressBar
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True"
                                    Value="0">
                                    <ProgressBar.Style>
                                        <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <!--  删除 N天之前的全景图片  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Delete}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="50"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding ManualCleanupParams.PanoramaImageAgoDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.PanoramicImageDaysAgo}" />
                        <Button
                            Height="Auto"
                            MinHeight="30"
                            Margin="30,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#2E2E2E"
                            BorderThickness="0"
                            Command="{Binding ManualCleanupCommand}"
                            CommandParameter="PanoramaImage"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="DarkGray"
                                        Text="&#xe77d;" />
                                    <TextBlock
                                        Margin="2,1,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Delete}" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <ProgressBar
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True"
                                    Value="0">
                                    <ProgressBar.Style>
                                        <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <!--  删除 N天之前的FTP图片  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Delete}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="50"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding ManualCleanupParams.FtpImageAgoDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.FTPImageDaysAgo}" />
                        <Button
                            Height="Auto"
                            MinHeight="30"
                            Margin="30,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="#2E2E2E"
                            BorderThickness="0"
                            Command="{Binding ManualCleanupCommand}"
                            CommandParameter="FtpImage"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="DarkGray"
                                        Text="&#xe77d;" />
                                    <TextBlock
                                        Margin="2,1,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Delete}" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeletingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <ProgressBar
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True"
                                    Value="0">
                                    <ProgressBar.Style>
                                        <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
