<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration.AlgorithmSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="AlgorithmSettingsView"
    Title="AlgorithmSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <!--  算法配置页面  -->
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                <!--  条码类型  -->
                <StackPanel Orientation="Horizontal">
                    <TreeView MinWidth="220">
                        <TreeView.Resources>
                            <Style BasedOn="{StaticResource MaterialDesignTreeViewItem}" TargetType="TreeViewItem">
                                <Setter Property="materialDesign:TreeViewAssist.ExpanderSize" Value="32" />
                                <Setter Property="materialDesign:TreeViewAssist.ShowSelection" Value="False" />
                            </Style>
                        </TreeView.Resources>
                        <TreeViewItem
                            Background="Transparent"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Header="条码类型">
                            <!--  ORCode(二维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseOrCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="ORCode(二维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  MicroQR(二维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseMicroQr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="MicroQR(二维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  Code39(一维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseCode39, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="Code39(一维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  Code93(一维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseCode93, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="Code93(一维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  Code128(一维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseCode128, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="Code128(一维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  CodeBar(一维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseCodeBar, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="CodeBar(一维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  ITF(一维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseItf, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="ITF(一维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  Ean13(一维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseEan13, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="Ean13(一维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <!--  Ean8(一维码)  -->
                            <TreeViewItem Margin="-40,0,0,0" Background="Transparent">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <CheckBox
                                                BorderBrush="DodgerBlue"
                                                BorderThickness="2"
                                                IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseEan8, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                Style="{StaticResource CustomCheckBoxStyle}" />
                                        </Border>
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="Ean8(一维码)" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeView>
                </StackPanel>
                <!--  本地化模式  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="本地化模式:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Width="Auto"
                            Height="30"
                            MinWidth="100"
                            MaxWidth="170"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ThemeAssist.Theme="Dark"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            SelectedIndex="{Binding BarcodeReaderSettingsInfo.LocalizationMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">

                            <ComboBoxItem>
                                默认
                                <!--  Default  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                连通块
                                <!--  ConnectedBlocks  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                统计
                                <!--  Statistics  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                线条
                                <!--  Lines  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                直接扫描
                                <!--  ScanDirectly  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                连通块 + 直接扫描
                                <!--  ConnectedBlocksAndScanDirectly  -->
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                </StackPanel>
                <!--  去模糊级别  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="去模糊级别:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Width="Auto"
                            Height="30"
                            MinWidth="100"
                            MaxWidth="170"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ThemeAssist.Theme="Dark"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding DeblurLevelItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedIndex="{Binding BarcodeReaderSettingsInfo.DeblurLevel, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  期望的条形码数量  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="条形码数量:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="120"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False">

                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    Path="BarcodeReaderSettingsInfo.ExpectedBarcodesCount"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:RegexValidationRule ErrorMessage="请输入有效的正整数" Pattern="^[1-9]\d*$" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Border>
                </StackPanel>
                <!--  缩放阈值  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="缩放阈值:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="120"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False">

                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    Path="BarcodeReaderSettingsInfo.ScaleDownThreshold"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:RegexValidationRule ErrorMessage="请输入有效的正整数" Pattern="^[1-9]\d*$" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Border>
                </StackPanel>
                <!--  是否使用文本过滤模式  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用文本过滤模式:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <CheckBox
                            BorderBrush="DodgerBlue"
                            BorderThickness="2"
                            IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseTextFilterMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource CustomCheckBoxStyle}" />
                    </Border>
                </StackPanel>
                <!--  是否使用区域预检测模式  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用区域预检测模式:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <CheckBox
                            BorderBrush="DodgerBlue"
                            BorderThickness="2"
                            IsChecked="{Binding BarcodeReaderSettingsInfo.IsUseRegionPredetectionMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource CustomCheckBoxStyle}" />
                    </Border>
                </StackPanel>
                <!--  灰度转换模式  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="灰度转换模式:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Width="Auto"
                            Height="30"
                            MinWidth="100"
                            MaxWidth="170"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ThemeAssist.Theme="Dark"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            SelectedIndex="{Binding BarcodeReaderSettingsInfo.GrayscaleTransformationMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">

                            <ComboBoxItem>
                                原图
                                <!--  Original  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                反色
                                <!--  Inverted  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                原图+反色
                                <!--  OriginalAndInverted  -->
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                </StackPanel>
                <!--  图像预处理模式  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="图像预处理模式:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Width="Auto"
                            Height="30"
                            MinWidth="100"
                            MaxWidth="170"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ThemeAssist.Theme="Dark"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            SelectedIndex="{Binding BarcodeReaderSettingsInfo.ImagePreprocessingMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">

                            <ComboBoxItem>
                                通用
                                <!--  General  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                灰度均衡化
                                <!--  GrayEqualization  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                灰度平滑
                                <!--  GraySmoothing  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                锐化和平滑
                                <!--  SharpeningAndSmoothing  -->
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                </StackPanel>
                <!--  最小结果置信度  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="最小结果置信度:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Width="Auto"
                            Height="30"
                            MinWidth="100"
                            MaxWidth="170"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ThemeAssist.Theme="Dark"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            SelectedIndex="{Binding BarcodeReaderSettingsInfo.MinResultConfidence, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">

                            <ComboBoxItem>
                                0-不限制
                                <!--  0-No Limitation  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                10
                            </ComboBoxItem>
                            <ComboBoxItem>
                                20
                            </ComboBoxItem>
                            <ComboBoxItem>
                                30
                            </ComboBoxItem>
                            <ComboBoxItem>
                                40
                            </ComboBoxItem>
                            <ComboBoxItem>
                                50
                            </ComboBoxItem>
                            <ComboBoxItem>
                                60
                            </ComboBoxItem>
                            <ComboBoxItem>
                                70
                            </ComboBoxItem>
                            <ComboBoxItem>
                                80
                            </ComboBoxItem>
                            <ComboBoxItem>
                                90
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                </StackPanel>
                <!--  纹理检测敏感度  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="纹理检测敏感度:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Width="Auto"
                            Height="30"
                            MinWidth="100"
                            MaxWidth="170"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ThemeAssist.Theme="Dark"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding TextureDetectionSensitivityItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedIndex="{Binding BarcodeReaderSettingsInfo.TextureDetectionSensitivity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  二值化块大小  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="二值化块大小:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="120"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False">

                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    Path="BarcodeReaderSettingsInfo.BinarizationBlockSize"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:RegexValidationRule ErrorMessage="请输入有效的正整数" Pattern="^[1-9]\d*$" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Border>
                </StackPanel>
                <!--  识别跳过的帧数  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="识别跳过的帧数:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="120"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False">

                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    Path="BarcodeReaderSettingsInfo.RecognitionSkipFrames"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:RegexValidationRule ErrorMessage="请输入有效的正整数" Pattern="^[0-9]\d*$" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Border>
                </StackPanel>
                <!--  图片缩放百分比  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="图片缩放百分比:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Width="Auto"
                            Height="30"
                            MinWidth="100"
                            MaxWidth="170"
                            Margin="5,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ThemeAssist.Theme="Dark"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            SelectedIndex="{Binding BarcodeReaderSettingsInfo.ScalePercentage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">

                            <ComboBoxItem>
                                0-不缩放
                                <!--  0-No Limitation  -->
                            </ComboBoxItem>
                            <ComboBoxItem>
                                10
                            </ComboBoxItem>
                            <ComboBoxItem>
                                20
                            </ComboBoxItem>
                            <ComboBoxItem>
                                30
                            </ComboBoxItem>
                            <ComboBoxItem>
                                40
                            </ComboBoxItem>
                            <ComboBoxItem>
                                50
                            </ComboBoxItem>
                            <ComboBoxItem>
                                60
                            </ComboBoxItem>
                            <ComboBoxItem>
                                70
                            </ComboBoxItem>
                            <ComboBoxItem>
                                80
                            </ComboBoxItem>
                            <ComboBoxItem>
                                90
                            </ComboBoxItem>
                        </ComboBox>
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  识别模式  -->
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="识别模式:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <ComboBox
                        Width="Auto"
                        Height="30"
                        MinWidth="100"
                        MaxWidth="170"
                        Margin="5,0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ThemeAssist.Theme="Dark"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        SelectedIndex="{Binding BarcodeReaderSettingsInfo.RecognitionMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">

                        <ComboBoxItem>
                            快速
                            <!--  Speed  -->
                        </ComboBoxItem>
                        <ComboBoxItem>
                            均衡
                            <!--  Balance  -->
                        </ComboBoxItem>
                        <ComboBoxItem>
                            全局
                            <!--  Coverage  -->
                        </ComboBoxItem>
                        <ComboBoxItem>
                            自定义
                            <!--  Custom  -->
                        </ComboBoxItem>
                    </ComboBox>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>