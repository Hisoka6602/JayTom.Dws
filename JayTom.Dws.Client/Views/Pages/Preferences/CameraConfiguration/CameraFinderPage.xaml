<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration.CameraFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attributeConverters="clr-namespace:JayTom.Dws.Client.Converters.AttributeConverters"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="CameraFinderView"
    Title="CameraFinderPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <cameraConverter:SupportedBindingTypeVisibilityConverter x:Key="SupportedBindingTypeVisibilityConverter" />
        <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <attributeConverters:EnumAttributeConverter x:Key="EnumAttributeConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="CameraFinderView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded" SourceName="CameraFinderView">
            <b:InvokeCommandAction Command="{Binding UnloadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  刷新按钮  -->
        <Button
            Grid.Row="0"
            MinHeight="30"
            Margin="30,0"
            HorizontalAlignment="Left"
            materialDesign:ButtonAssist.CornerRadius="5"
            BorderThickness="0"
            Command="{Binding RefreshCommand}">
            <Button.Style>
                <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                    <Setter Property="Background" Value="#2E2E2E" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                <TranslateTransform X="0" Y="0" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <!--  说明  -->
                <Grid>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanNegationConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            FontWeight="Light"
                            Foreground="DarkGray"
                            Text="&#xe699;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Refresh}" />
                    </StackPanel>
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Light"
                        Foreground="DarkGray"
                        RenderTransformOrigin=".5,.5"
                        Text="&#xe699;"
                        Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="RotationTransform" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Button>

        <!--  Sdk选择  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="50,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  类型图标  -->
            <TextBlock
                Margin="0,0,0,1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="25"
                Foreground="DarkGray"
                Text="&#xe882;" />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="SDK选择:" />
            <ListBox SelectionMode="Multiple" Style="{StaticResource MaterialDesignFilterChipPrimaryListBox}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <mvvm:InvokeCommandAction Command="{Binding SdkSelectionChangedCommand}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseHikvisionSmartCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseHikvisionSmartCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="海康智能相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseHikvisionIndustrialCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseHikvisionIndustrialCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="海康工业相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseDaHuaSmartCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseDaHuaSmartCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="大华智能相机" />
                </ListBoxItem>
                <!--<b:Interaction.Triggers>
                    <b:EventTrigger EventName="Selected">
                        <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseDaHuaSecurityCameraSdk" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>-->
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseDaHuaSecurityCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseDaHuaSecurityCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="大华安防相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseWayzimSmartCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseWayzimSmartCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="中科微至智能相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseWayzimIndustrialCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseWayzimIndustrialCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="中科微至工业相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseHikvisionVolumeCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseHikvisionVolumeCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="海康体积相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseDaHuaVolumeCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseDaHuaVolumeCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="大华体积相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseDimensionVolumeCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseDimensionVolumeCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="量方体积相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUsbCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUsbCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="USB相机" />
                </ListBoxItem>
            </ListBox>
        </StackPanel>
        <!--  用数据表代替  -->
        <DataGrid
            Grid.Row="1"
            MinWidth="500"
            MinHeight="300"
            Margin="20,10,10,0"
            Padding="10,0"
            materialDesign:DataGridAssist.CellPadding="4 2 2 2"
            materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
            AlternatingRowBackground="#101E90FF"
            AutoGenerateColumns="False"
            Background="Transparent"
            CanUserAddRows="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
            ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
            Focusable="False"
            Foreground="White"
            FrozenColumnCount="2"
            GridLinesVisibility="None"
            HorizontalScrollBarVisibility="Auto"
            ItemsSource="{Binding CameraFinderItems, UpdateSourceTrigger=PropertyChanged}"
            RowBackground="#061E90FF"
            Style="{StaticResource VirtualizingDataGridStyle}">
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                    <Setter Property="Height" Value="35" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="45"
                    MinWidth="45"
                    Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  名称  -->
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraName}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  自定义名称  -->
                <DataGridTemplateColumn Width="80" MinWidth="80">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="自定义名称" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox
                                MinWidth="80"
                                BorderBrush="Transparent"
                                Style="{StaticResource MaterialDesignTextBox}">
                                <TextBox.Text>
                                    <Binding
                                        Mode="TwoWay"
                                        Path="CustomName"
                                        UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validationRules:RegexValidationRule ErrorMessage="请输入有的字符串,长度大于1" Pattern="^[^ &lt;&gt;:/\\|?*%&quot;&apos;`]{2,}$" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.InputBindings>
                                    <KeyBinding
                                        Key="Enter"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.EditedCustomNameCommand}"
                                        CommandParameter="{Binding}" />
                                </TextBox.InputBindings>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="LostFocus">
                                        <b:InvokeCommandAction Command="{Binding ElementName=CameraFinderView, Path=DataContext.EditedCustomNameCommand}" CommandParameter="{Binding}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  品牌  -->
                <DataGridTextColumn
                    Width="150"
                    MinWidth="100"
                    Binding="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraBrand}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  序列号  -->
                <DataGridTextColumn
                    Width="160"
                    MinWidth="160"
                    Binding="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderSerialNumber}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  型号  -->
                <DataGridTextColumn
                    Width="120"
                    MinWidth="120"
                    Binding="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraModel}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  IP地址  -->
                <DataGridTextColumn
                    Width="120"
                    MinWidth="120"
                    Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderIPAddress}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  相机类型  -->
                <DataGridTextColumn
                    Width="130"
                    MinWidth="130"
                    Binding="{Binding CameraType, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CameraTypeConverter}, ConverterParameter=ToolTip}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraType}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  绑定  -->
                <DataGridTemplateColumn
                    Width="120"
                    MinWidth="120"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="绑定模式" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <!--  文字  -->
                                <TextBlock
                                    Margin="2,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="{Binding BoundType, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=description}"
                                    Visibility="{Binding HasBinding, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Margin="2,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="--"
                                    Visibility="{Binding HasBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  操作  -->
                <DataGridTemplateColumn
                    Width="Auto"
                    MinWidth="120"
                    MaxWidth="320"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--  按钮  -->
                            <StackPanel Margin="0" Orientation="Horizontal">

                                <!--  绑定前  -->
                                <StackPanel
                                    MinWidth="280"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                    <!--  绑定扫码  -->
                                    <Button
                                        Height="30"
                                        MinWidth="60"
                                        Margin="2,0"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="RoyalBlue"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindBarcodeScannerCameraCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        Foreground="RoyalBlue"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Visibility="{Binding SupportedBindingType, Converter={StaticResource SupportedBindingTypeVisibilityConverter}, ConverterParameter=BarcodeScannerCamera}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                IsEnabled="True"
                                                Text="绑定扫码"
                                                TextAlignment="Justify" />
                                        </StackPanel>
                                    </Button>
                                    <!--  绑定全景  -->
                                    <Button
                                        Height="30"
                                        MinWidth="60"
                                        Margin="2,0"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="BlueViolet"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindPanoramaCameraCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        Foreground="BlueViolet"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Visibility="{Binding SupportedBindingType, Converter={StaticResource SupportedBindingTypeVisibilityConverter}, ConverterParameter=PanoramaCamera}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                IsEnabled="True"
                                                Text="绑定全景"
                                                TextAlignment="Justify" />
                                        </StackPanel>
                                    </Button>
                                    <!--  绑定体积  -->
                                    <Button
                                        Height="30"
                                        MinWidth="60"
                                        Margin="2,0"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="DodgerBlue"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindVolumeCameraCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        Foreground="DodgerBlue"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Visibility="{Binding SupportedBindingType, Converter={StaticResource SupportedBindingTypeVisibilityConverter}, ConverterParameter=VolumeCamera}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                IsEnabled="True"
                                                Text="绑定体积"
                                                TextAlignment="Justify" />
                                        </StackPanel>
                                    </Button>
                                    <!--  Ocr扫码  -->
                                    <Button
                                        Height="30"
                                        MinWidth="60"
                                        Margin="2,0"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="DarkOrange"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindOcrScannerCameraCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        Foreground="DarkOrange"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Visibility="{Binding IsOcrSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                IsEnabled="True"
                                                Text="Ocr扫码"
                                                TextAlignment="Justify" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!--  绑定后  -->
                                <StackPanel
                                    MinWidth="280"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasBinding, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                    <!--  NVR配置  -->
                                    <Button
                                        Height="30"
                                        MinWidth="60"
                                        Margin="2,0"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="ForestGreen"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindNvrCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        Foreground="ForestGreen"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Visibility="{Binding BoundType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ScannerCamera|OcrCamera}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                IsEnabled="True"
                                                Text="NVR配置"
                                                TextAlignment="Justify" />
                                        </StackPanel>
                                    </Button>
                                    <!--  解绑相机  -->
                                    <Button
                                        Height="30"
                                        MinWidth="60"
                                        Margin="2,0"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="DarkRed"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.UnbindCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        Foreground="DarkRed"
                                        Style="{StaticResource MaterialDesignFlatLightButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                IsEnabled="True"
                                                Text="解绑相机"
                                                TextAlignment="Justify" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <materialDesign:Snackbar
            Grid.Row="1"
            Width="Auto"
            Height="Auto"
            VerticalAlignment="Bottom"
            Background="BlueViolet"
            FontFamily="LoadFiraCode"
            FontWeight="Bold"
            MessageQueue="{Binding CameraFinderMessageQueue}" />
    </Grid>
</Page>
