<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration.CameraFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="CameraFinderView"
    Title="CameraFinderPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />

        <cameraConverter:BoundCameraTypeLocationConverter x:Key="BoundCameraTypeLocationConverter" />
        <cameraConverter:BoundCameraTypeCornerRadiusConverter x:Key="BoundCameraTypeCornerRadiusConverter" />
        <cameraConverter:BoundCameraTypeVisibilityConverter x:Key="BoundCameraTypeVisibilityConverter" />
        <cameraConverter:CameraHasBindingVisibilityConverter x:Key="CameraHasBindingVisibilityConverter" />
        <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="CameraFinderView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  刷新按钮  -->
        <Button
            Grid.Row="0"
            MinHeight="30"
            Margin="30,0"
            HorizontalAlignment="Left"
            materialDesign:ButtonAssist.CornerRadius="5"
            BorderThickness="0"
            Command="{Binding RefreshCommand}">
            <Button.Style>
                <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                    <Setter Property="Background" Value="#2E2E2E" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                <TranslateTransform X="0" Y="0" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <!--  图标  -->
                <!--  说明  -->
                <Grid>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanNegationConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            FontWeight="Light"
                            Foreground="DarkGray"
                            Text="&#xe699;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Refresh}" />
                    </StackPanel>
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Light"
                        Foreground="DarkGray"
                        RenderTransformOrigin=".5,.5"
                        Text="&#xe699;"
                        Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="RotationTransform" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Button>

        <!--  Sdk选择  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="50,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  类型图标  -->
            <TextBlock
                Margin="0,0,0,1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="25"
                Foreground="DarkGray"
                Text="&#xe882;" />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="SDK选择:" />
            <ListBox SelectionMode="Multiple" Style="{StaticResource MaterialDesignFilterChipPrimaryListBox}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <mvvm:InvokeCommandAction Command="{Binding SdkSelectionChangedCommand}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseHikvisionSmartCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Selected">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseHikvisionSmartCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="海康智能相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseHikvisionIndustrialCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Selected">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseHikvisionIndustrialCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="海康工业相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseDaHuaSmartCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Selected">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseDaHuaSmartCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="大华智能相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseDaHuaSecurityCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Selected">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseDaHuaSecurityCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="大华安防相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseWayzimSmartCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Selected">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseWayzimSmartCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="中科微至智能相机" />
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding CameraSdkSelectorInfo.IsUseWayzimIndustrialCameraSdk, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Selected">
                            <mvvm:InvokeCommandAction Command="{Binding SdkSelectedCommand}" CommandParameter="IsUseWayzimIndustrialCameraSdk" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="中科微至工业相机" />
                </ListBoxItem>
            </ListBox>
        </StackPanel>
        <!--  列表  -->
        <!--<ListBox
            Grid.Row="1"
            MinWidth="500"
            MinHeight="300"
            Margin="20,10,20,0"
            Padding="10,0"
            Focusable="False"
            ItemTemplate="{StaticResource CameraFinderTemplate}"
            ItemsSource="{Binding CameraFinderItems, UpdateSourceTrigger=PropertyChanged}"
            RenderTransformOrigin=".5,.5"
            Style="{StaticResource CustomListBoxStyle}"
            Visibility="Hidden">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsSelected" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="Transparent" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    ~1~  去掉焦点框  @1@
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>-->
        <!--  用数据表代替  -->
        <DataGrid
            Grid.Row="1"
            MinWidth="500"
            MinHeight="300"
            Margin="20,10,20,0"
            Padding="10,0"
            materialDesign:DataGridAssist.CellPadding="4 2 2 2"
            materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
            AlternatingRowBackground="#101E90FF"
            AutoGenerateColumns="False"
            Background="Transparent"
            CanUserAddRows="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
            ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
            Focusable="False"
            Foreground="White"
            FrozenColumnCount="2"
            GridLinesVisibility="None"
            HorizontalScrollBarVisibility="Auto"
            ItemsSource="{Binding CameraFinderItems, UpdateSourceTrigger=PropertyChanged}"
            RowBackground="#061E90FF"
            Style="{StaticResource VirtualizingDataGridStyle}">
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                    <Setter Property="Height" Value="35" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="45"
                    MinWidth="45"
                    Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  名称  -->
                <DataGridTextColumn
                    Width="100"
                    MinWidth="100"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraName}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  品牌  -->
                <DataGridTextColumn
                    Width="150"
                    MinWidth="150"
                    Binding="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraBrand}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  序列号  -->
                <DataGridTextColumn
                    Width="180"
                    MinWidth="180"
                    Binding="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderSerialNumber}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  型号  -->
                <DataGridTextColumn
                    Width="180"
                    MinWidth="180"
                    Binding="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraModel}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  IP地址  -->
                <DataGridTextColumn
                    Width="120"
                    MinWidth="120"
                    Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderIPAddress}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  相机类型  -->
                <DataGridTextColumn
                    Width="130"
                    MinWidth="130"
                    Binding="{Binding CameraType, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CameraTypeToolTipConverter}}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraType}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  操作  -->
                <DataGridTemplateColumn
                    Width="320"
                    MinWidth="320"
                    MaxWidth="600"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--  按钮  -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasBinding, Converter={StaticResource CameraHasBindingVisibilityConverter}, ConverterParameter=BindButton, UpdateSourceTrigger=PropertyChanged}">
                                    <Grid Width="290" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MaxWidth="265" />
                                            <ColumnDefinition Width="Auto" MaxWidth="265" />
                                            <ColumnDefinition Width="*" MaxWidth="265" />
                                        </Grid.ColumnDefinitions>
                                        <!--  绑定到全景相机  -->
                                        <Button
                                            Grid.Column="{Binding CameraType, Converter={StaticResource BoundCameraTypeLocationConverter}, ConverterParameter=PanoramicCamera}"
                                            Width="Auto"
                                            Height="30"
                                            MinWidth="125"
                                            Margin="0"
                                            Padding="0"
                                            materialDesign:ButtonAssist.CornerRadius="{Binding CameraType, Converter={StaticResource BoundCameraTypeCornerRadiusConverter}, ConverterParameter=PanoramicCamera}"
                                            materialDesign:ShadowAssist.ShadowEdges="Right"
                                            Background="BlueViolet"
                                            Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindPanoramaCameraCommand}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                                            Visibility="{Binding CameraType, Converter={StaticResource BoundCameraTypeVisibilityConverter}, ConverterParameter=PanoramicCamera}">
                                            <TextBlock
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                RenderTransformOrigin=".5,.5"
                                                Text="{x:Static languages:Language.BindToPanoramicCamera}" />
                                        </Button>
                                        <!--  绑定到扫码相机  -->
                                        <Button
                                            Grid.Column="{Binding CameraType, Converter={StaticResource BoundCameraTypeLocationConverter}, ConverterParameter=BarcodeScannerCamera}"
                                            Width="Auto"
                                            Height="30"
                                            MinWidth="125"
                                            Margin="0"
                                            Padding="0"
                                            materialDesign:ButtonAssist.CornerRadius="{Binding CameraType, Converter={StaticResource BoundCameraTypeCornerRadiusConverter}, ConverterParameter=BarcodeScannerCamera}"
                                            materialDesign:ShadowAssist.ShadowEdges="Right"
                                            Background="RoyalBlue"
                                            Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindBarcodeScannerCameraCommand}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                                            Visibility="{Binding CameraType, Converter={StaticResource BoundCameraTypeVisibilityConverter}, ConverterParameter=BarcodeScannerCamera}">
                                            <TextBlock
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                RenderTransformOrigin=".5,.5"
                                                Text="{x:Static languages:Language.BindToScannerCamera}" />
                                        </Button>
                                        <!--  绑定到体积相机  -->
                                        <Button
                                            Grid.Column="{Binding CameraType, Converter={StaticResource BoundCameraTypeLocationConverter}, ConverterParameter=VolumeCamera}"
                                            Width="Auto"
                                            Height="30"
                                            MinWidth="125"
                                            Margin="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            materialDesign:ButtonAssist.CornerRadius="{Binding CameraType, Converter={StaticResource BoundCameraTypeCornerRadiusConverter}, ConverterParameter=VolumeCamera}"
                                            materialDesign:ShadowAssist.ShadowEdges="Right"
                                            Background="DodgerBlue"
                                            Command="{Binding ElementName=CameraFinderView, Path=DataContext.BindVolumeCameraCommand}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                                            Visibility="{Binding CameraType, Converter={StaticResource BoundCameraTypeVisibilityConverter}, ConverterParameter=VolumeCamera}">
                                            <TextBlock
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                RenderTransformOrigin=".5,.5"
                                                Text="{x:Static languages:Language.BindToCompactCamera}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasBinding, Converter={StaticResource CameraHasBindingVisibilityConverter}, ConverterParameter=UnbindButton, UpdateSourceTrigger=PropertyChanged}">
                                    <!--  绑定到扫码相机  -->
                                    <Button
                                        Width="160"
                                        Height="30"
                                        Margin="0"
                                        Padding="0"
                                        materialDesign:ButtonAssist.CornerRadius="5,0,0,5"
                                        materialDesign:ShadowAssist.ShadowEdges="Right"
                                        Background="{Binding BoundType, Converter={StaticResource BoundCameraTypeConverter}, ConverterParameter=Color}"
                                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                                        ToolTip="NextPage">
                                        <TextBlock
                                            Margin="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CustomFontFamily}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            RenderTransformOrigin=".5,.5">
                                            <Run Text="{Binding BoundType, Converter={StaticResource BoundCameraTypeConverter}, ConverterParameter=Text}" />
                                        </TextBlock>
                                    </Button>
                                    <!--  绑定到体积相机  -->
                                    <Button
                                        Width="90"
                                        Height="30"
                                        Margin="0"
                                        Padding="0"
                                        materialDesign:ButtonAssist.CornerRadius="0,5,5,0"
                                        materialDesign:ShadowAssist.ShadowEdges="Right"
                                        Background="DarkRed"
                                        Command="{Binding ElementName=CameraFinderView, Path=DataContext.UnbindCommand}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                                        ToolTip="LastPage">
                                        <TextBlock
                                            Margin="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CustomFontFamily}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            RenderTransformOrigin=".5,.5"
                                            Text="{x:Static languages:Language.Unbind}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <materialDesign:Snackbar
            Grid.Row="1"
            Width="Auto"
            Height="Auto"
            VerticalAlignment="Bottom"
            Background="BlueViolet"
            FontFamily="LoadFiraCode"
            FontWeight="Bold"
            MessageQueue="{Binding CameraFinderMessageQueue}" />
    </Grid>
</Page>