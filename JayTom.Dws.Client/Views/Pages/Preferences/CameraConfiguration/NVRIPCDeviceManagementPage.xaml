<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration.NVRIPCDeviceManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:attributeConverters="clr-namespace:JayTom.Dws.Client.Converters.AttributeConverters"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    Name="NvripcDeviceManagementView"
    Title="NVRIPCDeviceManagementPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="NvripcDeviceManagementView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Page.Resources>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <attributeConverters:EnumAttributeConverter x:Key="EnumAttributeConverter" />
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  操作按钮  -->
        <StackPanel
            Grid.Row="0"
            Margin="30,0,0,0"
            Orientation="Horizontal">
            <!--  刷新按钮  -->
            <Button
                MinHeight="30"
                Margin="5,0"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                BorderThickness="0"
                Command="{Binding RefreshCommand}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                        <Setter Property="Background" Value="#2E2E2E" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <!--  说明  -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanNegationConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="18"
                                FontWeight="Light"
                                Foreground="DarkGray"
                                Text="&#xe699;" />
                            <TextBlock
                                Margin="2,1,0,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.Refresh}" />
                        </StackPanel>
                        <TextBlock
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            FontWeight="Light"
                            Foreground="DarkGray"
                            RenderTransformOrigin=".5,.5"
                            Text="&#xe699;"
                            Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RotationTransform" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                From="0"
                                                To="360"
                                                Duration="0:0:2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Button>
            <!--  添加  -->
            <Button
                x:Name="MenuButton"
                MinHeight="30"
                Margin="5,0"
                materialDesign:ButtonAssist.CornerRadius="5"
                BorderThickness="0"
                Command="{Binding AddCommand}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                        <Setter Property="Background" Value="#2E2E2E" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <!--  说明  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            FontWeight="Light"
                            Foreground="DarkGray"
                            Text="&#xe820;" />
                        <TextBlock
                            Margin="2,2,0,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="添加" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <!--  批量改密  -->
            <Button
                MinHeight="30"
                Margin="5,0"
                materialDesign:ButtonAssist.CornerRadius="5"
                BorderThickness="0"
                Command="{Binding BatchChangePasswordCommand}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                        <Setter Property="Background" Value="#2E2E2E" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <!--  说明  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            FontWeight="Light"
                            Foreground="DarkGray"
                            Text="&#xe933;" />
                        <TextBlock
                            Margin="2,2,0,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="批量改密" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </StackPanel>
        <!--  列表  -->
        <DataGrid
            Grid.Row="1"
            Margin="20,10,20,0"
            Padding="10,0"
            materialDesign:DataGridAssist.CellPadding="4 2 2 2"
            materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
            AlternatingRowBackground="#101E90FF"
            AutoGenerateColumns="False"
            Background="Transparent"
            CanUserAddRows="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
            ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
            Foreground="White"
            FrozenColumnCount="2"
            GridLinesVisibility="None"
            HorizontalScrollBarVisibility="Auto"
            ItemsSource="{Binding IpcNvrItemInfos, UpdateSourceTrigger=PropertyChanged}"
            RowBackground="#061E90FF"
            Style="{StaticResource VirtualizingDataGridStyle}">
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                    <Setter Property="Height" Value="35" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelect, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style BasedOn="{StaticResource CustomCheckBoxStyle}" TargetType="{x:Type CheckBox}" />
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style BasedOn="{StaticResource CustomCheckBoxStyle}" TargetType="{x:Type CheckBox}" />
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn
                    Width="45"
                    MinWidth="45"
                    Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  类型  -->
                <DataGridTextColumn
                    Width="100"
                    MinWidth="100"
                    Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=description}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="类型" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  名称  -->
                <DataGridTextColumn
                    Width="100"
                    MinWidth="100"
                    Binding="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="设备名称" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  序列号  -->
                <DataGridTextColumn
                    Width="130"
                    MinWidth="130"
                    Binding="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="序列号" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  型号  -->
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="设备型号" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!--  IP地址  -->
                <DataGridTextColumn
                    Width="120"
                    MinWidth="120"
                    Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderIPAddress}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  端口  -->
                <DataGridTextColumn
                    Width="60"
                    MinWidth="60"
                    Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="端口" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  通道数  -->
                <DataGridTextColumn
                    Width="60"
                    MinWidth="60"
                    Binding="{Binding ChannelCount, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="通道数" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  登录名  -->
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="登录名" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  在线状态  -->
                <DataGridTemplateColumn
                    MinWidth="80"
                    MaxWidth="120"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="状态" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <!--  点  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="30"
                                    Foreground="{Binding Status, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=BackgroundColor}"
                                    Text="&#xe7a6;" />
                                <!--  文字  -->
                                <TextBlock
                                    Margin="2,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="13"
                                    FontWeight="Light"
                                    Foreground="White"
                                    Text="{Binding Status, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--  操作  -->
                <DataGridTemplateColumn
                    MinWidth="100"
                    MaxWidth="600"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--  定位按钮  -->
                            <StackPanel
                                MinWidth="340"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    Margin="2,0"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="DarkViolet"
                                    Command="{Binding ElementName=NvripcDeviceManagementView, Path=DataContext.PreviewCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="DarkViolet"
                                    Style="{StaticResource MaterialDesignFlatLightButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="18"
                                            Foreground="White"
                                            Text="&#xe773;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="预览"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    Margin="2,0"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="Green"
                                    Command="{Binding ElementName=NvripcDeviceManagementView, Path=DataContext.BindCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="Green"
                                    Style="{StaticResource MaterialDesignFlatLightButton}"
                                    Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=NVR, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="18"
                                            Foreground="White"
                                            Text="&#xe6fa;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="绑定"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    Margin="2,0"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="RoyalBlue"
                                    Command="{Binding ElementName=NvripcDeviceManagementView, Path=DataContext.EditCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="RoyalBlue"
                                    Style="{StaticResource MaterialDesignFlatLightButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="15"
                                            Foreground="White"
                                            Text="&#xe7c8;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="编辑"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    Margin="2,0"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="DarkRed"
                                    Command="{Binding ElementName=NvripcDeviceManagementView, Path=DataContext.DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="Red"
                                    Style="{StaticResource MaterialDesignFlatLightButton}"
                                    Visibility="{Binding IsConfigured, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="10"
                                            Foreground="White"
                                            Text="&#xe601;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="删除"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!--  提示框  -->
        <materialDesign:Snackbar
            Grid.Row="1"
            Width="Auto"
            Height="Auto"
            VerticalAlignment="Bottom"
            Background="BlueViolet"
            FontFamily="LoadFiraCode"
            FontWeight="Bold"
            MessageQueue="{Binding NvrIpcDeviceManagemenMessageQueue}" />
    </Grid>
</Page>