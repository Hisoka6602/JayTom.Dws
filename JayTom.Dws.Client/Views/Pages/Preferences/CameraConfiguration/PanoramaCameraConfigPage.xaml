<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration.PanoramaCameraConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="PanoramaCameraConfigView"
    Title="PanoramaCameraConfigPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="PanoramaCameraConfigView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded" SourceName="PanoramaCameraConfigView">
            <b:InvokeCommandAction Command="{Binding UnloadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Page.Resources>
        <cameraConverter:CameraTypeConverter x:Key="CameraTypeConverter" />
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  延迟  -->
        <StackPanel
            Grid.Row="0"
            Margin="30,0,0,0"
            Orientation="Horizontal">
            <!--  图标  -->
            <TextBlock
                x:Name="IconBlock"
                Margin="5,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="18"
                FontWeight="Light"
                Foreground="DarkGray"
                Text="&#xe635;" />
            <!--  说明  -->
            <TextBlock
                x:Name="DescriptionBlock"
                Margin="5,0"
                VerticalAlignment="Center"
                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                FontSize="14"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="{x:Static languages:Language.DelayTriggerTime}" />
            <!--  输入框  -->
            <Border
                Margin="5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A696969"
                CornerRadius="5">
                <TextBox
                    Width="90"
                    Height="30"
                    MaxWidth="170"
                    Margin="5,0"
                    materialDesign:TextFieldAssist.HasClearButton="False"
                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding CaptureDelayTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </Border>
            <!--  应用全部按钮  -->
            <Button
                x:Name="MenuButton"
                MinHeight="30"
                Margin="15,0"
                materialDesign:ButtonAssist.CornerRadius="5"
                BorderThickness="0"
                Command="{Binding ApplyAllChangesCommand}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                        <Setter Property="Background" Value="#2E2E2E" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <!--  说明  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            FontWeight="Light"
                            Foreground="DarkGray"
                            Text="&#xe679;" />
                        <TextBlock
                            Margin="2,2,0,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.ApplyAll}" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </StackPanel>
        <!--  列表  -->
        <DataGrid
            Grid.Row="1"
            Margin="20,10,20,0"
            Padding="10,0"
            materialDesign:DataGridAssist.CellPadding="4 2 2 2"
            materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
            AlternatingRowBackground="#101E90FF"
            AutoGenerateColumns="False"
            Background="Transparent"
            CanUserAddRows="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
            ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
            Foreground="White"
            FrozenColumnCount="2"
            GridLinesVisibility="None"
            HorizontalScrollBarVisibility="Auto"
            ItemsSource="{Binding PanoramaCameraItems, UpdateSourceTrigger=PropertyChanged}"
            RowBackground="#061E90FF"
            Style="{StaticResource VirtualizingDataGridStyle}">
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                    <Setter Property="Height" Value="35" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="45"
                    MinWidth="45"
                    Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  名称  -->
                <DataGridTextColumn
                    Width="100"
                    MinWidth="100"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraName}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  序列号  -->
                <DataGridTextColumn
                    Width="180"
                    MinWidth="180"
                    Binding="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderSerialNumber}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  型号  -->
                <DataGridTextColumn
                    Width="180"
                    MinWidth="180"
                    Binding="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraModel}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  版本  -->
                <DataGridTextColumn
                    Width="180"
                    MinWidth="180"
                    Binding="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderVersionNumber}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  IP地址  -->
                <DataGridTextColumn
                    Width="120"
                    MinWidth="120"
                    Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderIPAddress}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  相机类型  -->
                <DataGridTextColumn
                    Width="100"
                    MinWidth="100"
                    Binding="{Binding CameraType, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CameraTypeConverter}, ConverterParameter=ToolTip}"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderCameraType}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--  延迟时间  -->
                <materialDesign:DataGridTextColumn
                    Width="150"
                    MinWidth="150"
                    Binding="{Binding CaptureDelayTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderDelayTriggerTime}" />
                    </DataGridTextColumn.Header>
                </materialDesign:DataGridTextColumn>
                <!--  操作  -->
                <DataGridTemplateColumn
                    Width="190"
                    MinWidth="40"
                    MaxWidth="600"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--  定位按钮  -->
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="RoyalBlue"
                                    Command="{Binding ElementName=PanoramaCameraConfigView, Path=DataContext.ApplyChangesCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="RoyalBlue"
                                    Style="{StaticResource MaterialDesignFlatLightButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="15"
                                            Foreground="White"
                                            Text="&#xe66e;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="{x:Static languages:Language.Save}"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="DarkRed"
                                    Command="{Binding ElementName=PanoramaCameraConfigView, Path=DataContext.UnbindCameraCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="Red"
                                    Style="{StaticResource MaterialDesignFlatLightButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="10"
                                            Foreground="White"
                                            Text="&#xe601;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="{x:Static languages:Language.Unbind}"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

