                </ControlTemplate>
            </ListBox.Template>
        </ListBox>-->
        <!--  提示框  -->
        <materialDesign:Snackbar
            Grid.Row="1"
            Width="Auto"
            Height="Auto"
            VerticalAlignment="Bottom"
            Background="BlueViolet"
            FontFamily="LoadFiraCode"
            FontWeight="Bold"
            MessageQueue="{Binding PanoramaCameraMessageQueue}" />
    </Grid>
</Page>
