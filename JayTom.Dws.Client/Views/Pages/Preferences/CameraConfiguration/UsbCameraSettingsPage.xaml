                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                    <!--  灰度转换模式  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="灰度转换模式:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Width="Auto"
                                Height="30"
                                MinWidth="100"
                                MaxWidth="170"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Dark"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                SelectedIndex="{Binding BarcodeReaderSettingsInfo.GrayscaleTransformationMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>

                                <ComboBoxItem>
                                    原图
                                    <!--  Original  -->
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    反色
                                    <!--  Inverted  -->
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    原图+反色
                                    <!--  OriginalAndInverted  -->
                                </ComboBoxItem>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <!--  图像预处理模式  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="图像预处理模式:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Width="Auto"
                                Height="30"
                                MinWidth="100"
                                MaxWidth="170"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Dark"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                SelectedIndex="{Binding BarcodeReaderSettingsInfo.ImagePreprocessingMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>

                                <ComboBoxItem>
                                    通用
                                    <!--  General  -->
                                </ComboBoxItem>
