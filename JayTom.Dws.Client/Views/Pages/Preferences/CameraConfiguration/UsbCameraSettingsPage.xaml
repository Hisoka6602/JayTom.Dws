                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
