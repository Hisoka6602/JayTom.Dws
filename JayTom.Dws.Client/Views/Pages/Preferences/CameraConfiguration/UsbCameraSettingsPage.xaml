                                    灰度均衡化
                                    <!--  GrayEqualization  -->
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    灰度平滑
                                    <!--  GraySmoothing  -->
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    锐化和平滑
                                    <!--  SharpeningAndSmoothing  -->
                                </ComboBoxItem>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <!--  最小结果置信度  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="最小结果置信度:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Width="Auto"
                                Height="30"
                                MinWidth="100"
                                MaxWidth="170"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Dark"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                SelectedIndex="{Binding BarcodeReaderSettingsInfo.MinResultConfidence, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>

                                <ComboBoxItem>
                                    0-不限制
                                    <!--  0-No Limitation  -->
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    10
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    20
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    30
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    40
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    50
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    60
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    70
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    80
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    90
                                </ComboBoxItem>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <!--  纹理检测敏感度  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="纹理检测敏感度:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Width="Auto"
                                Height="30"
                                MinWidth="100"
                                MaxWidth="170"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Dark"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                ItemsSource="{Binding TextureDetectionSensitivityItems, UpdateSourceTrigger=PropertyChanged}"
                                SelectedIndex="{Binding BarcodeReaderSettingsInfo.TextureDetectionSensitivity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <!--  二值化块大小  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="二值化块大小:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="120"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <TextBox.Text>
                                    <Binding
                                        Mode="TwoWay"
                                        Path="BarcodeReaderSettingsInfo.BinarizationBlockSize"
                                        UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validationRules:RegexValidationRule ErrorMessage="请输入有效的正整数" Pattern="^[1-9]\d*$" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Border>
                    </StackPanel>
                    <!--  识别跳过的帧数  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="识别跳过的帧数:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="120"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <TextBox.Text>
                                    <Binding
                                        Mode="TwoWay"
                                        Path="BarcodeReaderSettingsInfo.RecognitionSkipFrames"
                                        UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validationRules:RegexValidationRule ErrorMessage="请输入有效的正整数" Pattern="^[0-9]\d*$" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Border>
                    </StackPanel>
                    <!--  图片缩放百分比  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="图片缩放百分比:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Width="Auto"
                                Height="30"
                                MinWidth="100"
                                MaxWidth="170"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Dark"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                SelectedIndex="{Binding BarcodeReaderSettingsInfo.ScalePercentage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>

                                <ComboBoxItem>
                                    0-不缩放
                                    <!--  0-No Limitation  -->
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    10
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    20
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    30
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    40
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    50
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    60
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    70
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    80
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    90
                                </ComboBoxItem>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!--  识别模式  -->
            <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="识别模式:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <ComboBox
                        Width="Auto"
                        Height="30"
                        MinWidth="100"
                        MaxWidth="170"
                        Margin="5,0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ThemeAssist.Theme="Dark"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        SelectedIndex="{Binding BarcodeReaderSettingsInfo.RecognitionMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="PreviewMouseUp">
                                <mvvm:InvokeCommandAction Command="{Binding UpdateBarcodeReaderCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <ComboBoxItem>
                            快速
                            <!--  Speed  -->
                        </ComboBoxItem>
                        <ComboBoxItem>
                            均衡
                            <!--  Balance  -->
                        </ComboBoxItem>
                        <ComboBoxItem>
                            全局
                            <!--  Coverage  -->
                        </ComboBoxItem>
                        <ComboBoxItem>
                            自定义
                            <!--  Custom  -->
                        </ComboBoxItem>
                    </ComboBox>
                </Border>
            </StackPanel>

            <!--  保存按钮  -->
            <Button
                MinHeight="30"
                Margin="30,10"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding SaveSettingsCommand}"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe66e;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.SaveSettings}" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                    <ProgressBar
                        Name="StatusProgressBar"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Value="0">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Button>
        </StackPanel>

        <!--  预览画面  -->
        <StackPanel Grid.Column="1">
            <Border
                MaxWidth="640"
                MaxHeight="640"
                Margin="10,50"
                Padding="10"
                Background="#2E2E2E"
                CornerRadius="15">
                <StackPanel Orientation="Vertical">
                    <!--  视频框  -->
                    <Grid>
                        <Image
                            Width="640"
                            MinHeight="640"
                            Source="{Binding Image, UpdateSourceTrigger=PropertyChanged}"
                            Stretch="Fill">
                            <Image.Clip>
                                <RectangleGeometry
                                    RadiusX="15"
                                    RadiusY="15"
                                    Rect="0,0,620,620" />
                            </Image.Clip>
                        </Image>
                        <Border
                            Width="640"
                            MinHeight="640"
                            CornerRadius="15"
                            Visibility="Collapsed">
                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="160"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="&#xe772;" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <!--  提示框  -->
        <materialDesign:Snackbar
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Width="Auto"
            Height="Auto"
            VerticalAlignment="Bottom"
            Background="BlueViolet"
            FontFamily="LoadFiraCode"
            FontWeight="Bold"
            MessageQueue="{Binding UsbCameraSettingsMessageQueue}" />
    </Grid>
</Page>