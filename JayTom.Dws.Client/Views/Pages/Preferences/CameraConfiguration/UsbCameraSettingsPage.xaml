<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration.UsbCameraSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.CameraConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="UsbCameraSettingsView"
    Title="UsbCameraSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="UsbCameraSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*" />
            <ColumnDefinition Width="60*" />
            <!--  左边参数  -->
            <!--  右边实时预览  -->
        </Grid.ColumnDefinitions>
        <!--  参数  -->
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe63a;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="相机:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <ComboBox
                        Width="Auto"
                        Height="30"
                        MinWidth="150"
                        MaxWidth="170"
                        Margin="5,0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ThemeAssist.Theme="Dark"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="CameraName"
                        Focusable="False"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        ItemsSource="{Binding CameraItems, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectCameraInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <mvvm:InvokeCommandAction Command="{Binding SwitchCameraCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ComboBox>
                </Border>
                <Button
                    Width="50"
                    MinHeight="30"
                    Margin="5,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    Background="#2E2E2E"
                    BorderThickness="0"
                    Command="{Binding CameraUpdateCommand}"
                    FocusVisualStyle="{x:Null}"
                    Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe69a;" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe645;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="相机参数:" />
            </StackPanel>
            <ScrollViewer
                MaxHeight="300"
                Margin="0,10"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">

                    <!--  分辨率  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="分辨率:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Width="Auto"
                                Height="30"
                                MinWidth="100"
                                MaxWidth="170"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Dark"
                                Background="Transparent"
                                BorderThickness="0"
                                DisplayMemberPath="Display"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                ItemsSource="{Binding CameraResolutions, UpdateSourceTrigger=PropertyChanged}"
                                SelectedItem="{Binding CameraResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <mvvm:InvokeCommandAction Command="{Binding SwitchCameraResolutionCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <!--  曝光度  -->
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="曝光度:" />
                        <ToggleButton
                            Name="IsCustomExposureEnabledToggleButton"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Command="{Binding UpdateCameraParametersCommand}"
                            Focusable="False"
                            IsChecked="{Binding UsbCameraSettingsInfo.IsCustomExposureEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        <Slider
                            Width="150"
                            Margin="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsEnabled="{Binding ElementName=IsCustomExposureEnabledToggleButton, Path=IsChecked}"
                            IsMoveToPointEnabled="True"
                            IsSelectionRangeEnabled="True"
                            Maximum="0"
                            Minimum="-8"
                            Value="{Binding UsbCameraSettingsInfo.Exposure, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="PreviewMouseUp">
                                    <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Slider>
                        <TextBlock
                            Margin="5,0,0,6"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            IsEnabled="{Binding ElementName=IsCustomExposureEnabledToggleButton, Path=IsEnabled}"
                            Text="{Binding UsbCameraSettingsInfo.Exposure, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <!--  亮度  -->
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="亮  度:" />
                        <ToggleButton
                            Name="IsCustomBrightnessEnabledToggleButton"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Command="{Binding UpdateCameraParametersCommand}"
                            Focusable="False"
                            IsChecked="{Binding UsbCameraSettingsInfo.IsCustomBrightnessEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        <Slider
                            Width="150"
                            Margin="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsEnabled="{Binding ElementName=IsCustomBrightnessEnabledToggleButton, Path=IsChecked}"
                            IsMoveToPointEnabled="True"
                            IsSelectionRangeEnabled="True"
                            Maximum="64"
                            Minimum="-64"
                            Value="{Binding UsbCameraSettingsInfo.Brightness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="PreviewMouseUp">
                                    <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Slider>
                        <TextBlock
                            Margin="5,0,0,6"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            IsEnabled="{Binding ElementName=IsCustomBrightnessEnabledToggleButton, Path=IsChecked}"
                            Text="{Binding UsbCameraSettingsInfo.Brightness, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <!--  暂时隐藏的属性  -->
                    <StackPanel Orientation="Vertical" Visibility="Collapsed">
                        <!--  对比度  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="对比度:" />
                            <ToggleButton
                                Name="IsCustomContrastEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomContrastEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="150"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomContrastEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding UsbCameraSettingsInfo.Contrast, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Slider>
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomContrastEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.Contrast, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  色调  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="色  调:" />
                            <ToggleButton
                                Name="IsCustomHueEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomHueEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="150"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomHueEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="180"
                                Minimum="-180"
                                Value="{Binding UsbCameraSettingsInfo.Hue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Slider>
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomHueEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.Hue, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  饱和度  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="饱和度:" />
                            <ToggleButton
                                Name="IsCustomSaturationEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomSaturationEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="150"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomSaturationEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding UsbCameraSettingsInfo.Saturation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Slider>
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomSaturationEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.Saturation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  锐度  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="锐  度:" />
                            <ToggleButton
                                Name="IsCustomSharpnessEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomSharpnessEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="150"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomSharpnessEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding UsbCameraSettingsInfo.Sharpness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Slider>
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomSharpnessEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.Sharpness, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  伽马值  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="伽马值:" />
                            <ToggleButton
                                Name="IsCustomGammaEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomGammaEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="150"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomGammaEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="500"
                                Minimum="100"
                                Value="{Binding UsbCameraSettingsInfo.Gamma, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomGammaEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.Gamma, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBlock>
                        </StackPanel>
                        <!--  白平衡  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="白平衡:" />
                            <ToggleButton
                                Name="IsCustomWhiteBalanceEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomWhiteBalanceEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="150"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomWhiteBalanceEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="6500"
                                Minimum="2800"
                                Value="{Binding UsbCameraSettingsInfo.WhiteBalance, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Slider>
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomWhiteBalanceEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.WhiteBalance, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  背光补偿  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="背光补偿:" />
                            <ToggleButton
                                Name="IsCustomBacklightCompensationEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomBacklightCompensationEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="135"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomBacklightCompensationEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="2"
                                Minimum="0"
                                Value="{Binding UsbCameraSettingsInfo.BklightComp, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Slider>
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomBacklightCompensationEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.BklightComp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  增益  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="增  益:" />
                            <ToggleButton
                                Name="IsCustomGainEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Command="{Binding UpdateCameraParametersCommand}"
                                Focusable="False"
                                IsChecked="{Binding UsbCameraSettingsInfo.IsCustomGainEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <Slider
                                Width="150"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsEnabled="{Binding ElementName=IsCustomGainEnabledToggleButton, Path=IsChecked}"
                                IsMoveToPointEnabled="True"
                                IsSelectionRangeEnabled="True"
                                Maximum="128"
                                Minimum="0"
                                Value="{Binding UsbCameraSettingsInfo.Gain, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseUp">
                                        <mvvm:InvokeCommandAction Command="{Binding UpdateCameraParametersCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Slider>
                            <TextBlock
                                Margin="5,0,0,6"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsEnabled="{Binding ElementName=IsCustomGainEnabledToggleButton, Path=IsChecked}"
                                Text="{Binding UsbCameraSettingsInfo.Gain, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  变焦  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="变  焦:" />
                            <ToggleButton
                                Name="IsCustomZoomEnabledToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
