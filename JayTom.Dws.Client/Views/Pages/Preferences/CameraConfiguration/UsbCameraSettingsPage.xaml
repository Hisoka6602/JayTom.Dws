                                            <validationRules:RegexValidationRule ErrorMessage="请输入有效的正整数" Pattern="^[1-9]\d*$" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Border>
                    </StackPanel>
                    <!--  是否使用文本过滤模式  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
