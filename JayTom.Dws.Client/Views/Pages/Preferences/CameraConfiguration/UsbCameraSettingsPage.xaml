                Padding="10"
                Background="#2E2E2E"
                CornerRadius="15">
                <StackPanel Orientation="Vertical">
                    <!--  视频框  -->
                    <Grid>
                        <Image
                            Width="640"
                            MinHeight="640"
                            Source="{Binding Image, UpdateSourceTrigger=PropertyChanged}"
                            Stretch="Fill">
                            <Image.Clip>
                                <RectangleGeometry
                                    RadiusX="15"
                                    RadiusY="15"
                                    Rect="0,0,620,620" />
                            </Image.Clip>
                        </Image>
                        <Border
                            Width="640"
                            MinHeight="640"
                            CornerRadius="15"
                            Visibility="Collapsed">
                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Center"
