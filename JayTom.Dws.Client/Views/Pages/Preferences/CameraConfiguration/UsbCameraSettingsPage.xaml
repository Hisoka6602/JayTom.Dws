                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="条形码数量:" />
