<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.ContentInputSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataTemplateSelectors="clr-namespace:JayTom.Dws.Client.DataTemplateSelectors"
    xmlns:imageSettingModels="clr-namespace:JayTom.Dws.Client.Models.ImageSettingModels"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="ContentInputSettingsView"
    Title="ContentInputSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <Page.Resources>
        <settingsConverter:TcpConnectionModeToBooleanConverter x:Key="TcpConnectionModeToBooleanConverter" />
        <settingsConverter:ShortcutMacroConverter x:Key="ShortcutMacroConverter" />
        <DataTemplate x:Key="ImageSettingButtonTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="DodgerBlue"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=ContentInputSettingsView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content, Converter={StaticResource ShortcutMacroConverter}}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="BlueViolet"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=ContentInputSettingsView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>
        <dataTemplateSelectors:ImageSettingItemDataTemplateSelectors
            x:Key="ContentInputDataTemplateSelectors"
            ButtonTemplate="{StaticResource ImageSettingButtonTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  使用Tcp输入  -->
        <StackPanel
            Grid.Row="0"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe62f;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.IsUseTCPInput}" />
                <ToggleButton
                    Name="TcpToggleButton"
                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                    Focusable="False"
                    IsChecked="{Binding IsUseTcpInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
            <StackPanel
                Margin="50,5,0,0"
                IsEnabled="{Binding ElementName=TcpToggleButton, Path=IsChecked}"
                Orientation="Horizontal"
                Visibility="{Binding ElementName=TcpToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel Orientation="Vertical">
                    <!--  使用Tcp服务端  -->
                    <RadioButton
                        Content="{x:Static languages:Language.IsUseTCPServer}"
                        Focusable="False"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        IsChecked="{Binding TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Server}"
                        Template="{StaticResource CustomRadioButtonTemplate}" />
                    <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.IPAddress}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="100"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    IsReadOnly="True"
                                    Text="{Binding TcpSettingsInfo.ServerConfig.IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.Port}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding TcpSettingsInfo.ServerConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <!--  使用Tcp客户端  -->
                    <RadioButton
                        Content="{x:Static languages:Language.IsUseTCPClient}"
                        Focusable="False"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        IsChecked="{Binding TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Client}"
                        Template="{StaticResource CustomRadioButtonTemplate}" />
                    <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.IPAddress}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="100"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False">
                                    <TextBox.Text>
                                        <Binding
                                            Mode="TwoWay"
                                            Path="TcpSettingsInfo.ClientConfig.IpAddress"
                                            UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.Port}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding TcpSettingsInfo.ClientConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <!--  支持的内容格式  -->
                    <!--<TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.ContentFormat}" />
                    <Border
                        Height="170"
                        MinHeight="80"
                        MaxHeight="200"
                        Margin="0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="330"
                            MinHeight="150"
                            MaxWidth="500"
                            Margin="5,0"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding ExampleJson, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>-->

                    <!--  输入模板  -->
                    <StackPanel
                        Margin="5,0"
                        VerticalAlignment="Top"
                        Orientation="Vertical">
                        <!--  输入模板  -->
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,0,1"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="20"
                                Foreground="DarkGray"
                                Text="&#xe6cd;" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.InputTemplate}" />
                        </StackPanel>
                        <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.InputData}" />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Height="30"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Command="{Binding AddInputItemCommand}"
                                    CommandParameter="'{BarCode}'"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderBarCode}" />
                                </Button>
                                <Button
                                    Height="30"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Command="{Binding AddInputItemCommand}"
                                    CommandParameter="'{Weight}'"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderWeight}" />
                                </Button>
                                <Button
                                    Height="30"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Command="{Binding AddInputItemCommand}"
                                    CommandParameter="'{Length}'"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderLength}" />
                                </Button>
                                <Button
                                    Height="30"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Command="{Binding AddInputItemCommand}"
                                    CommandParameter="'{Width}'"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderWidth}" />
                                </Button>
                                <Button
                                    Height="30"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Command="{Binding AddInputItemCommand}"
                                    CommandParameter="'{Height}'"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderHeight}" />
                                </Button>
                                <Button
                                    Height="30"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Command="{Binding AddInputItemCommand}"
                                    CommandParameter="'{Volume}'"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.TableHeaderVolume}" />
                                </Button>
                                <Border Background="BlueViolet" CornerRadius="15">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox
                                            Width="40"
                                            Height="30"
                                            MaxWidth="40"
                                            Margin="15,0,0,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            TextAlignment="Center" />
                                        <Border
                                            Width="1"
                                            Height="20"
                                            BorderBrush="White"
                                            BorderThickness="1" />
                                        <Button
                                            Width="70"
                                            Height="30"
                                            Margin="0,0"
                                            Padding="4,0"
                                            materialDesign:ButtonAssist.CornerRadius="0,15,15,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding AddSeparatorItemCommand}"
                                            CommandParameter="{Binding Separator}"
                                            Focusable="False"
                                            Foreground="White"
                                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                            <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.Separator}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Button
                                    Height="30"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Command="{Binding AddInputItemCommand}"
                                    CommandParameter="'{null}'"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{x:Static languages:Language.PaddingVariable}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Margin="50,10,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <Grid>
                                <Border
                                    Width="50"
                                    Margin="2"
                                    HorizontalAlignment="Left"
                                    Background="DarkGray"
                                    CornerRadius="5">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#2E2E2E"
                                        Text="{x:Static languages:Language.Content}" />
                                </Border>
                                <ListView
                                    Width="710"
                                    Height="30"
                                    MaxWidth="900"
                                    Margin="60,0,0,0"
                                    Focusable="False"
                                    ItemTemplateSelector="{StaticResource ContentInputDataTemplateSelectors}"
                                    ItemsSource="{Binding DataTemplate, UpdateSourceTrigger=PropertyChanged}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                    SelectionMode="Extended">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border
                                                            x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            SnapsToDevicePixels="True">
                                                            <ContentPresenter
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                                <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Background="Transparent" Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  使用控件输入  -->
        <StackPanel
            Grid.Row="1"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe6dd;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.IsUseControlInput}" />
                <ToggleButton
                    Name="ControlToggleButton"
                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                    Focusable="False"
                    IsChecked="{Binding IsUseControlInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
            <StackPanel
                Margin="50,5,0,5"
                IsEnabled="{Binding ElementName=ControlToggleButton, Path=IsChecked}"
                Orientation="Horizontal"
                Visibility="{Binding ElementName=ControlToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!--  条码  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveBarcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.TableHeaderBarCode}" />
                </StackPanel>
                <!--  重量  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.TableHeaderWeight}" />
                </StackPanel>
                <!--  长度  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.TableHeaderLength}" />
                </StackPanel>
                <!--  宽度  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveWidth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.TableHeaderWidth}" />
                </StackPanel>
                <!--  高度  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveHeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.TableHeaderHeight}" />
                </StackPanel>
                <!--  体积  -->
                <StackPanel
                    Margin="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveVolume, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.TableHeaderVolume}" />
                </StackPanel>
            </StackPanel>
            <!--  说明  -->
            <TextBlock
                Width="390"
                Margin="50,5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="勾选需要输入的元素后可在主页对应的元素框上输入内容,任意输入框按回车键(Enter)提交,Tab键切换下一个输入控件"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>