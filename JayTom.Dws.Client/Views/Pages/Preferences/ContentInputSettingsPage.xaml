<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.ContentInputSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attributeConverters="clr-namespace:JayTom.Dws.Client.Converters.AttributeConverters"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataTemplateSelectors="clr-namespace:JayTom.Dws.Client.DataTemplateSelectors"
    xmlns:imageSettingModels="clr-namespace:JayTom.Dws.Client.Models.ImageSettingModels"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="ContentInputSettingsView"
    Title="ContentInputSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <settingsConverter:TcpConnectionModeToBooleanConverter x:Key="TcpConnectionModeToBooleanConverter" />
        <settingsConverter:ShortcutMacroConverter x:Key="ShortcutMacroConverter" />
        <attributeConverters:EnumAttributeConverter x:Key="EnumAttributeConverter" />
        <DataTemplate x:Key="ImageSettingButtonTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="DodgerBlue"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=ContentInputSettingsView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content, Converter={StaticResource ShortcutMacroConverter}}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="BlueViolet"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=ContentInputSettingsView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>
        <dataTemplateSelectors:ImageSettingItemDataTemplateSelectors
            x:Key="ContentInputDataTemplateSelectors"
            ButtonTemplate="{StaticResource ImageSettingButtonTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  使用Tcp输入  -->
        <StackPanel
            Grid.Row="0"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe62f;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.IsUseTCPInput}" />
                <ToggleButton
                    Name="TcpToggleButton"
                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                    Focusable="False"
                    IsChecked="{Binding IsUseTcpInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
            <StackPanel
                MinHeight="210"
                Margin="50,5,0,10"
                IsEnabled="{Binding ElementName=TcpToggleButton, Path=IsChecked}"
                Orientation="Vertical"
                Visibility="{Binding ElementName=TcpToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!--  搜索、添加  -->
                <StackPanel
                    Margin="0,10"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <!--  起始IP  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="起始IP地址:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="120"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False">
                                <TextBox.Text>
                                    <Binding
                                        Mode="TwoWay"
                                        Path="StartIpAddress"
                                        UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="~" />
                    <!--  结束IP  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="结束IP地址:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="120"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False">
                                <TextBox.Text>
                                    <Binding
                                        Mode="TwoWay"
                                        Path="EndIpAddress"
                                        UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Border>
                    </StackPanel>
                    <!--  端口  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.Port}" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="80"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <!--  添加  -->
                    <Button
                        Width="90"
                        MinHeight="30"
                        Margin="10,0,0,0"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Background="#2E2E2E"
                        BorderThickness="0"
                        Command="{Binding AddTcpConnectionCommand}"
                        Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <!--  说明  -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="18"
                                    FontWeight="Light"
                                    Foreground="DarkGray"
                                    Text="&#xe820;" />
                                <TextBlock
                                    Margin="2,2,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="添加" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <!--  全部删除  -->
                    <Button
                        Width="110"
                        MinHeight="30"
                        Margin="10,0,0,0"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Background="#2E2E2E"
                        BorderThickness="0"
                        Command="{Binding TcpDeleteAllCommand}"
                        Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <!--  说明  -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="18"
                                    FontWeight="Light"
                                    Foreground="DarkGray"
                                    Text="&#xe960;" />
                                <TextBlock
                                    Margin="2,2,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="全部删除" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <!--  刷新、全部重连按钮  -->
                    <Button
                        MinHeight="30"
                        Margin="30,0"
                        HorizontalAlignment="Left"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderThickness="0"
                        Command="{Binding ReconnectAllTcpCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="Button">

                                <Setter Property="Background" Value="#2E2E2E" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform X="0" Y="0" />
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <!--  说明  -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTcpReconnecting, Converter={StaticResource BooleanNegationConverter}, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        FontWeight="Light"
                                        Foreground="DarkGray"
                                        Text="&#xe699;" />
                                    <TextBlock
                                        Margin="2,1,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="全部重连" />
                                </StackPanel>
                                <TextBlock
                                    Margin="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="20"
                                    FontWeight="Light"
                                    Foreground="DarkGray"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe699;"
                                    Visibility="{Binding IsTcpReconnecting, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="RotationTransform" />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!--  列表  -->
                <DataGrid
                    MinWidth="500"
                    MinHeight="300"
                    MaxHeight="300"
                    Margin="0,10,10,0"
                    Padding="10,0"
                    materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                    AlternatingRowBackground="#101E90FF"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
                    Focusable="False"
                    Foreground="White"
                    FrozenColumnCount="2"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Auto"
                    ItemsSource="{Binding TcpInputBindingInfos, UpdateSourceTrigger=PropertyChanged}"
                    RowBackground="#061E90FF"
                    Style="{StaticResource VirtualizingDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                            <Setter Property="Height" Value="35" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="45"
                            MinWidth="45"
                            Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  Ip  -->
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="80"
                            Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="Ip" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!--  端口  -->
                        <DataGridTextColumn
                            Width="150"
                            MinWidth="100"
                            Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="端口" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  连接状态  -->
                        <DataGridTemplateColumn
                            MinWidth="80"
                            MaxWidth="120"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="连接状态" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <!--  点  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="30"
                                            Foreground="{Binding ConnectionStatus, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=BackgroundColor}"
                                            Text="&#xe7a6;" />
                                        <!--  文字  -->
                                        <TextBlock
                                            Margin="2,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CustomFontFamily}"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            Text="{Binding ConnectionStatus, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumAttributeConverter}, ConverterParameter=Description}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  操作  -->
                        <DataGridTemplateColumn
                            Width="Auto"
                            MinWidth="120"
                            MaxWidth="900"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--  按钮  -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--  重新连接  -->
                                        <Button
                                            Grid.Column="0"
                                            Height="30"
                                            Margin="2,0"
                                            HorizontalAlignment="Left"
                                            materialDesign:ButtonAssist.CornerRadius="5"
                                            Background="DarkViolet"
                                            Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.ReconnectTcpCommand}"
                                            CommandParameter="{Binding}"
                                            Focusable="False"
                                            Foreground="DarkViolet"
                                            Style="{StaticResource MaterialDesignFlatLightButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    IsEnabled="True"
                                                    Text="重新连接"
                                                    TextAlignment="Justify" />
                                            </StackPanel>
                                        </Button>
                                        <!--  绑定前  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsBound, Converter={StaticResource InverseBooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                            <!--  绑定IP  -->
                                            <Button
                                                Height="30"
                                                MinWidth="60"
                                                Margin="2,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="RoyalBlue"
                                                Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.BindTcpCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="RoyalBlue"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="绑定输入源"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                            <!--  删除  -->
                                            <Button
                                                Height="30"
                                                MinWidth="60"
                                                Margin="2,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="DarkRed"
                                                Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.DeleteTcpCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="DarkRed"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="删除"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <!--  绑定后  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsBound, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                            <!--  NVR配置  -->
                                            <Button
                                                Height="30"
                                                MinWidth="60"
                                                Margin="2,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="ForestGreen"
                                                Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.NvrSettingsCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="ForestGreen"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="NVR配置"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                            <!--  解绑相机  -->
                                            <Button
                                                Height="30"
                                                MinWidth="60"
                                                Margin="2,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="DarkRed"
                                                Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.UnbindTcpCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="DarkRed"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="解绑扫码枪"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </StackPanel>
        <!--  监测扫码枪输入  -->
        <StackPanel
            Grid.Row="1"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe9cc;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否监听扫码枪输入" />
                <ToggleButton
                    Name="IsUseBarcodeScannerToggleButton"
                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                    Command="{Binding SwitchUseBarcodeScannerCommand}"
                    Focusable="False"
                    IsChecked="{Binding IsUseBarcodeScannerInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
            <StackPanel
                Margin="50,5,0,20"
                IsEnabled="{Binding ElementName=IsUseBarcodeScannerToggleButton, Path=IsChecked}"
                Orientation="Vertical"
                Visibility="{Binding ElementName=IsUseBarcodeScannerToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!--  扫码枪列表  -->

                <DataGrid
                    MinWidth="500"
                    MinHeight="300"
                    Margin="0,10,10,0"
                    Padding="10,0"
                    materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                    AlternatingRowBackground="#101E90FF"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                    ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
                    Focusable="False"
                    Foreground="White"
                    FrozenColumnCount="2"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Auto"
                    ItemsSource="{Binding KeyboardDeviceItemInfo, UpdateSourceTrigger=PropertyChanged}"
                    RowBackground="#061E90FF"
                    Style="{StaticResource VirtualizingDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                            <Setter Property="Height" Value="35" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNewlyAdded}" Value="True">
                                    <Setter Property="BorderBrush" Value="DarkGray" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Height" Value="40" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="45"
                            MinWidth="45"
                            Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  名称  -->
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="80"
                            Binding="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="名称" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!--  VendorId  -->
                        <DataGridTextColumn
                            Width="150"
                            MinWidth="100"
                            Binding="{Binding VendorId, UpdateSourceTrigger=PropertyChanged, StringFormat=0x{0:X1}}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="VendorId" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  ProductId  -->
                        <DataGridTextColumn
                            Width="150"
                            MinWidth="100"
                            Binding="{Binding ProductId, UpdateSourceTrigger=PropertyChanged, StringFormat=0x{0:X1}}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="ProductId" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!--  制造商名称  -->
                        <DataGridTextColumn
                            Width="100"
                            MinWidth="100"
                            Binding="{Binding ManufacturerName, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                            EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="制造商名称" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!--  操作  -->
                        <DataGridTemplateColumn
                            Width="Auto"
                            MinWidth="120"
                            MaxWidth="300"
                            CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--  按钮  -->
                                    <StackPanel
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <!--  绑定前  -->
                                        <StackPanel
                                            MinWidth="80"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding HasBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                            <!--  绑定扫码枪  -->
                                            <Button
                                                Height="30"
                                                MinWidth="60"
                                                Margin="2,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="RoyalBlue"
                                                Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.BindScannerCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="RoyalBlue"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="绑定扫码枪"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <!--  绑定后  -->
                                        <StackPanel
                                            MinWidth="280"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding HasBinding, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                            <!--  NVR配置  -->
                                            <Button
                                                Height="30"
                                                MinWidth="60"
                                                Margin="2,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="ForestGreen"
                                                Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.NvrSettingsCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="ForestGreen"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="NVR配置"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                            <!--  解绑相机  -->
                                            <Button
                                                Height="30"
                                                MinWidth="60"
                                                Margin="2,0"
                                                materialDesign:ButtonAssist.CornerRadius="5"
                                                Background="DarkRed"
                                                Command="{Binding ElementName=ContentInputSettingsView, Path=DataContext.UnbindScannerCommand}"
                                                CommandParameter="{Binding}"
                                                Focusable="False"
                                                Foreground="DarkRed"
                                                Style="{StaticResource MaterialDesignFlatLightButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="5,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        IsEnabled="True"
                                                        Text="解绑扫码枪"
                                                        TextAlignment="Justify" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            <!--  说明  -->
            <TextBlock
                Width="390"
                Margin="50,5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="勾选需要输入的元素后可在主页对应的元素框上输入内容,任意输入框按回车键(Enter)提交,Tab键切换下一个输入控件"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
        <!--  使用控件输入  -->
        <StackPanel
            Grid.Row="2"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe6dd;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{x:Static languages:Language.IsUseControlInput}" />
                <ToggleButton
                    Name="ControlToggleButton"
                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                    Focusable="False"
                    IsChecked="{Binding IsUseControlInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
            <StackPanel
                Margin="50,5,0,5"
                IsEnabled="{Binding ElementName=ControlToggleButton, Path=IsChecked}"
                Orientation="Vertical"
                Visibility="{Binding ElementName=ControlToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <!--  条码  -->
                    <StackPanel
                        Margin="5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveBarcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.TableHeaderBarCode}" />
                    </StackPanel>
                    <!--  重量  -->
                    <StackPanel
                        Margin="5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.TableHeaderWeight}" />
                    </StackPanel>
                    <!--  长度  -->
                    <StackPanel
                        Margin="5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.TableHeaderLength}" />
                    </StackPanel>
                    <!--  宽度  -->
                    <StackPanel
                        Margin="5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveWidth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.TableHeaderWidth}" />
                    </StackPanel>
                    <!--  高度  -->
                    <StackPanel
                        Margin="5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveHeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.TableHeaderHeight}" />
                    </StackPanel>
                    <!--  体积  -->
                    <StackPanel
                        Margin="5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding ControlInputInfo.IsReceiveVolume, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.TableHeaderVolume}" />
                    </StackPanel>
                </StackPanel>
                <!--  绑定NVR  -->
                <Button
                    Width="80"
                    Height="30"
                    MinWidth="100"
                    Margin="10,5"
                    HorizontalAlignment="Left"
                    materialDesign:ButtonAssist.CornerRadius="5"
                    Background="ForestGreen"
                    Command="{Binding ControlInputNvrSettingsCommand}"
                    CommandParameter="{Binding}"
                    Focusable="False"
                    Foreground="ForestGreen"
                    Style="{StaticResource MaterialDesignFlatLightButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="White"
                            Text="&#xe9bc;" />
                        <TextBlock
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            IsEnabled="True"
                            Text="NVR配置"
                            TextAlignment="Justify" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  说明  -->
            <TextBlock
                Width="390"
                Margin="50,5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="勾选需要输入的元素后可在主页对应的元素框上输入内容,任意输入框按回车键(Enter)提交,Tab键切换下一个输入控件"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
        <!--  是否过滤内容  -->
        <StackPanel
            Grid.Row="3"
            Margin="5,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,0,1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="20"
                Foreground="DarkGray"
                Text="&#xe698;" />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="是否使用常规过滤验证输入内容" />
            <ToggleButton
                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                Focusable="False"
                IsChecked="{Binding IsUseRegularFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
        </StackPanel>
    </Grid>
</Page>