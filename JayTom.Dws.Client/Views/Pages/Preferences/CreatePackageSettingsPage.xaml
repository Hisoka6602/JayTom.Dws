                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="下位机创建" />
                                <CheckBox
                                    BorderBrush="DodgerBlue"
                                    BorderThickness="2"
                                    IsChecked="{Binding CreatePackageSettingsInfo.PackageCreationMethods, Converter={StaticResource PackageCreationMethodsConverter}, ConverterParameter=LowerMachineCreation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource CustomCheckBoxStyle}" />
                            </StackPanel>
                            ~1~  Tcp内容输入  @1@
                            <StackPanel Margin="10,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="Tcp内容输入" />
                                <CheckBox
                                    BorderBrush="DodgerBlue"
                                    BorderThickness="2"
                                    IsChecked="{Binding CreatePackageSettingsInfo.PackageCreationMethods, Converter={StaticResource PackageCreationMethodsConverter}, ConverterParameter=TcpInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource CustomCheckBoxStyle}" />
                            </StackPanel>
                            ~1~  Ocr信息  @1@
                            <StackPanel Margin="10,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="Ocr信息" />
                                <CheckBox
                                    BorderBrush="DodgerBlue"
                                    BorderThickness="2"
                                    IsChecked="{Binding CreatePackageSettingsInfo.PackageCreationMethods, Converter={StaticResource PackageCreationMethodsConverter}, ConverterParameter=OcrInfo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource CustomCheckBoxStyle}" />
                            </StackPanel>
                        </StackPanel>-->
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  移除包裹方式  -->
            <StackPanel
                Grid.Row="5"
                Margin="5,10"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe920;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="移除包裹方式:" />
                </StackPanel>
                <!--  内容  -->
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                    <Border
                        MinWidth="200"
                        MinHeight="40"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                Margin="10,0"
                                Content="填充完整信息"
                                Focusable="False"
                                FontWeight="Bold"
                                Foreground="White"
                                IsChecked="{Binding CreatePackageSettingsInfo.PackageRemoveMethods, Converter={StaticResource PackageRemoveMethodsConverter}, ConverterParameter=FillInformation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Template="{StaticResource CustomRadioButtonTemplate}" />
                            <RadioButton
                                Margin="10,0"
                                Content="下位机移除"
                                Focusable="False"
                                FontWeight="Bold"
                                Foreground="White"
                                IsChecked="{Binding CreatePackageSettingsInfo.PackageRemoveMethods, Converter={StaticResource PackageRemoveMethodsConverter}, ConverterParameter=LowerMachineRemoval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Template="{StaticResource CustomRadioButtonTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  是否使用NoRead  -->
            <StackPanel
                Grid.Row="6"
                Margin="5,10"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe92d;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="NoRead(空条码):" />
                </StackPanel>
                <!--  内容  -->
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否使用NoRead:" />
                        <ToggleButton
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Focusable="False"
                            IsChecked="{Binding CreatePackageSettingsInfo.IsUseNoRead, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  填充条码队列  -->
            <StackPanel
                Grid.Row="7"
                Margin="5,10"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe92c;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="填充条码队列:" />
                </StackPanel>
                <!--  内容  -->
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                    <Border
                        MinWidth="200"
                        MinHeight="40"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                Margin="10,0"
                                Content="时间正序"
                                Focusable="False"
                                FontWeight="Bold"
                                Foreground="White"
                                IsChecked="{Binding CreatePackageSettingsInfo.BarcodeQueueOrder, Converter={StaticResource BarcodeQueueOrderConverter}, ConverterParameter=TimeAscending, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Template="{StaticResource CustomRadioButtonTemplate}" />
                            <RadioButton
                                Margin="10,0"
                                Content="时间倒序"
                                Focusable="False"
                                FontWeight="Bold"
                                Foreground="White"
                                IsChecked="{Binding CreatePackageSettingsInfo.BarcodeQueueOrder, Converter={StaticResource BarcodeQueueOrderConverter}, ConverterParameter=TimeDescending, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Template="{StaticResource CustomRadioButtonTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  停止时是否清空包裹  -->
            <StackPanel
                Grid.Row="8"
                Margin="5,10"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe925;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="清空包裹:" />
                </StackPanel>
                <!--  内容  -->
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="停止时是否清空包裹队列:" />
                        <ToggleButton
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Focusable="False"
                            IsChecked="{Binding CreatePackageSettingsInfo.ClearPackageQueueOnStop, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  保存设置  -->
            <Button
                Grid.Row="9"
                Grid.Column="0"
                MinHeight="30"
                Margin="30,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding SaveSettingsCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe66e;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.SaveSettings}" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                    <ProgressBar
                        Name="StatusProgressBar"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Value="0">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Button>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="9"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                Cursor=""
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding CreatePackageSettingsMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>