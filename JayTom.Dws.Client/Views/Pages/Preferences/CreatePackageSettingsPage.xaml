                                    IsChecked="{Binding CreatePackageSettingsInfo.PackageCreationMethods, Converter={StaticResource PackageCreationMethodsConverter}, ConverterParameter=StableWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource CustomCheckBoxStyle}" />
                            </StackPanel>
                            ~1~  控件输入  @1@
                            <StackPanel Margin="10,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
