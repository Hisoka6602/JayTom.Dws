<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.CreatePackageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:createPackageSettingConverters="clr-namespace:JayTom.Dws.Client.Converters.CreatePackageSettingConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="CreatePackageSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <Page.Resources>
        <createPackageSettingConverters:BarcodeHandlingMethodConverter x:Key="BarcodeHandlingMethodConverter" />
        <createPackageSettingConverters:BarcodeQueueOrderConverter x:Key="BarcodeQueueOrderConverter" />
        <createPackageSettingConverters:PackageRemoveMethodsConverter x:Key="PackageRemoveMethodsConverter" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  是否使用包裹过期、包裹过期时间  -->
        <StackPanel
            Grid.Row="0"
            Margin="5,10"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe71d;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="包裹超时:" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用包裹生存周期:" />
                    <ToggleButton
                        Name="IsUsePackageExpiryToggleButton"
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding CreatePackageSettingsInfo.IsUsePackageExpiry, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <StackPanel IsEnabled="{Binding ElementName=IsUsePackageExpiryToggleButton, Path=IsChecked}" Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="有效时间(ms):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="130"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding CreatePackageSettingsInfo.PackageExpiryTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  是否使用空包裹过期、空包裹有效时间  -->
        <StackPanel
            Grid.Row="1"
            Margin="5,10"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe71d;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="空包裹过期:" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用空包裹过期:" />
                    <ToggleButton
                        Name="IsUseEmptyPackageExpiryToggleButton"
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding CreatePackageSettingsInfo.IsUseEmptyPackageExpiry, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <StackPanel IsEnabled="{Binding ElementName=IsUseEmptyPackageExpiryToggleButton, Path=IsChecked}" Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="空包裹有效时间(ms):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="130"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding CreatePackageSettingsInfo.EmptyPackageExpiryTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  是否使用空包裹过滤  -->
        <StackPanel
            Grid.Row="2"
            Margin="5,10"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe6af;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="包裹过滤:" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用NoRead过滤:" />
                    <ToggleButton
                        Name="IsUseNoReadFilterToggleButton"
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding CreatePackageSettingsInfo.IsUseNoReadFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <StackPanel IsEnabled="{Binding ElementName=IsUseNoReadFilterToggleButton, Path=IsChecked}" Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="过滤间隔时间(ms):" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="130"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding CreatePackageSettingsInfo.FilterInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否多相机组码:" />
                    <ToggleButton
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding CreatePackageSettingsInfo.IsGroupBarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="最小创建包裹间隔时间(ms):" />
                    <Border
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="130"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding CreatePackageSettingsInfo.PackageCreationInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  多条码返回处理方式  -->
        <StackPanel
            Grid.Row="3"
            Margin="5,10"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe744;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="多条码返回处理方式:" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <Border
                    MinWidth="200"
                    MinHeight="40"
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Margin="10,0"
                            Content="使用一个"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding CreatePackageSettingsInfo.BarcodeHandlingMethod, Converter={StaticResource BarcodeHandlingMethodConverter}, ConverterParameter=UseOneBarcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <RadioButton
                            Margin="10,0"
                            Content="使用多个"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding CreatePackageSettingsInfo.BarcodeHandlingMethod, Converter={StaticResource BarcodeHandlingMethodConverter}, ConverterParameter=UseMultipleBarcodes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <RadioButton
                            Margin="10,0"
                            Content="合并条码"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding CreatePackageSettingsInfo.BarcodeHandlingMethod, Converter={StaticResource BarcodeHandlingMethodConverter}, ConverterParameter=MergeBarcodes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        <!--  创建包裹方式  -->
        <StackPanel
            Grid.Row="4"
            Margin="5,5"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe91e;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="创建包裹方式:" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <Border
                    MinWidth="200"
                    MinHeight="40"
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <ListBox ItemsSource="{Binding CreatePackageSettingsInfo.PackageCreationMethodItems}" Style="{StaticResource CustomListBoxStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,0" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{Binding DisplayName}" />
                                    <CheckBox
                                        BorderBrush="DodgerBlue"
                                        BorderThickness="2"
                                        Focusable="False"
                                        IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource CustomCheckBoxStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--<StackPanel Visibility="Hidden" Orientation="Horizontal">
                     ~1~  扫码相机  @1@
                     <StackPanel Margin="10,0" Orientation="Horizontal">
                         <TextBlock
