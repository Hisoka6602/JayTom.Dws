                 </StackPanel>-->
                </Border>
            </StackPanel>
        </StackPanel>
        <!--  移除包裹方式  -->
        <StackPanel
            Grid.Row="5"
            Margin="5,5"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe920;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="移除包裹方式:" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <Border
                    MinWidth="200"
                    MinHeight="40"
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Margin="10,0"
                            Content="填充完整信息"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding CreatePackageSettingsInfo.PackageRemoveMethods, Converter={StaticResource PackageRemoveMethodsConverter}, ConverterParameter=FillInformation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <RadioButton
                            Margin="10,0"
                            Content="下位机移除"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding CreatePackageSettingsInfo.PackageRemoveMethods, Converter={StaticResource PackageRemoveMethodsConverter}, ConverterParameter=LowerMachineRemoval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        <!--  是否使用NoRead  -->
        <StackPanel
            Grid.Row="6"
            Margin="5,10"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe92d;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="NoRead(空条码):" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用NoRead:" />
                    <ToggleButton
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding CreatePackageSettingsInfo.IsUseNoRead, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  填充条码队列  -->
        <StackPanel
            Grid.Row="7"
            Margin="5,10"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe92c;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="填充条码队列:" />
            </StackPanel>
            <!--  内容  -->
            <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                <Border
                    MinWidth="200"
                    MinHeight="40"
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Margin="10,0"
                            Content="时间正序"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding CreatePackageSettingsInfo.BarcodeQueueOrder, Converter={StaticResource BarcodeQueueOrderConverter}, ConverterParameter=TimeAscending, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <RadioButton
                            Margin="10,0"
                            Content="时间倒序"
                            Focusable="False"
                            FontWeight="Bold"
                            Foreground="White"
                            IsChecked="{Binding CreatePackageSettingsInfo.BarcodeQueueOrder, Converter={StaticResource BarcodeQueueOrderConverter}, ConverterParameter=TimeDescending, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        <!--  停止时是否清空包裹  -->
        <StackPanel
            Grid.Row="8"
            Margin="5,10"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
