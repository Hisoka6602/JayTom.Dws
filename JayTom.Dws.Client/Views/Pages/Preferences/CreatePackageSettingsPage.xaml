                                    BorderBrush="DodgerBlue"
                                    BorderThickness="2"
                                    IsChecked="{Binding CreatePackageSettingsInfo.PackageCreationMethods, Converter={StaticResource PackageCreationMethodsConverter}, ConverterParameter=VolumeInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource CustomCheckBoxStyle}" />
                            </StackPanel>
