                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="控件输入" />
                                <CheckBox
                                    BorderBrush="DodgerBlue"
                                    BorderThickness="2"
                                    IsChecked="{Binding CreatePackageSettingsInfo.PackageCreationMethods, Converter={StaticResource PackageCreationMethodsConverter}, ConverterParameter=ControlInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource CustomCheckBoxStyle}" />
