                             IsChecked="{Binding CreatePackageSettingsInfo.PackageCreationMethods, Converter={StaticResource PackageCreationMethodsConverter}, ConverterParameter=ScanBarcodeCamera, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
