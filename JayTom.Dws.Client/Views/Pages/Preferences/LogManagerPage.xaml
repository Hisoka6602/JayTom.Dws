<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.LogManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="LogManagerPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="BarcodeFilterSettingsDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <TabControl
            Margin="20,0"
            HorizontalContentAlignment="Left"
            materialDesign:ColorZoneAssist.Foreground="White"
            materialDesign:ColorZoneAssist.Mode="Custom"
            materialDesign:TabAssist.HasFilledTab="True"
            materialDesign:TabAssist.HasUniformTabWidth="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Style="{StaticResource MaterialDesignUniformTabControl}"
            TabStripPlacement="Top">
            <TabItem Foreground="White" Header="程序运行日志">
                <Frame
                    Margin="0"
                    Padding="0"
                    Focusable="False"
                    NavigationUIVisibility="Hidden"
                    Source="LogsViews/AppLogPage.xaml" />
            </TabItem>
            <TabItem Foreground="White" Header="相机日志">
                <Frame
                    Margin="0"
                    Padding="0"
                    Focusable="False"
                    NavigationUIVisibility="Hidden"
                    Source="LogsViews/CameraLogPage.xaml" />
            </TabItem>
            <TabItem Foreground="White" Header="分拣日志">
                <Frame
                    Margin="0"
                    Padding="0"
                    Focusable="False"
                    NavigationUIVisibility="Hidden"
                    Source="LogsViews/SortingLogPage.xaml" />
            </TabItem>
            <TabItem Foreground="White" Header="称重日志">
                <Frame
                    Margin="0"
                    Padding="0"
                    Focusable="False"
                    NavigationUIVisibility="Hidden"
                    Source="LogsViews/WeighingLogPage.xaml" />
            </TabItem>
            <TabItem Foreground="White" Header="体积日志">
                <Frame
                    Margin="0"
                    Padding="0"
                    Focusable="False"
                    NavigationUIVisibility="Hidden"
                    Source="LogsViews/VolumeLogPage.xaml" />
            </TabItem>
            <TabItem Foreground="White" Header="Api日志">
                <Frame
                    Margin="0"
                    Padding="0"
                    Focusable="False"
                    NavigationUIVisibility="Hidden"
                    Source="LogsViews/APILogPage.xaml" />
            </TabItem>
            <TabItem Foreground="White" Header="输出日志" />
            <TabItem Foreground="White" Header="输入日志" />
            <TabItem Foreground="White" Header="Ocr日志" />
            <TabItem Foreground="White" Header="Ftp日志" />
            <TabItem Foreground="White" Header="清理记录" />
            <TabItem Foreground="White" Header="异常日志" />
        </TabControl>
    </materialDesign:DialogHost>
</Page>