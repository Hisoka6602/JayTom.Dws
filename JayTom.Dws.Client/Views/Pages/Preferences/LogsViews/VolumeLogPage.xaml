<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.LogsViews.VolumeLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.LogsViews"
    xmlns:logConverters="clr-namespace:JayTom.Dws.Client.Converters.LogConverters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="VolumeLogView"
    Title="VolumeLogPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <logConverters:LogTypeConverter x:Key="LogTypeConverter" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="VolumeLogView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="VolumeLogDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  搜索条(详细信息关键词搜索、类型、时间)  -->
            <Border
                Grid.Row="0"
                Padding="10,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#10808080"
                CornerRadius="30">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <!--  扫码时间范围选择  -->
                    <StackPanel
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="WhiteSmoke"
                            Text="日志时间:" />
                        <!--  时间选择器  -->
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="120"
                                    MaxWidth="170"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    BorderThickness="0"
                                    Focusable="False"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    IsReadOnly="True"
                                    Text="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                <Button
                                    Width="30"
                                    Margin="0,0,0,0"
                                    Padding="0"
                                    materialDesign:RippleAssist.Feedback="DodgerBlue"
                                    Background="{x:Null}"
                                    BorderBrush="{x:Null}"
                                    Command="{Binding OpenDateTimeDialogCommand}"
                                    CommandParameter="StartTime"
                                    FocusVisualStyle="{x:Null}"
                                    Foreground="DodgerBlue"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FocusVisualStyle="{x:Null}"
                                        Foreground="DimGray"
                                        Kind="CalendarClock" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="~" />
                        <!--  时间选择器  -->
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="120"
                                    MaxWidth="170"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    BorderThickness="0"
                                    Focusable="False"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    IsReadOnly="True"
                                    Text="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                <Button
                                    Width="30"
                                    Margin="0,0,0,0"
                                    Padding="0"
                                    materialDesign:RippleAssist.Feedback="DodgerBlue"
                                    Background="{x:Null}"
                                    BorderBrush="{x:Null}"
                                    Command="{Binding OpenDateTimeDialogCommand}"
                                    CommandParameter="EndTime"
                                    FocusVisualStyle="{x:Null}"
                                    Foreground="DodgerBlue"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FocusVisualStyle="{x:Null}"
                                        Foreground="DimGray"
                                        Kind="CalendarClock" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!--  类型  -->
                    <StackPanel
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="WhiteSmoke"
                            Text="类型:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Width="110"
                                Height="30"
                                MaxWidth="170"
                                Margin="5,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Dark"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                ItemsSource="{Binding LogTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                SelectedItem="{Binding SelectLogType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Grid
                                                Width="80"
                                                MinWidth="60"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--  图标  -->
                                                <TextBlock
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource IconFontFamily}"
                                                    FontSize="16"
                                                    Foreground="{Binding Converter={StaticResource LogTypeConverter}, ConverterParameter=Color}"
                                                    Text="&#xe7a6;" />
                                                <!--  文字  -->
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    IsEnabled="False"
                                                    Text="{Binding Converter={StaticResource LogTypeConverter}, ConverterParameter=Text}"
                                                    TextAlignment="Justify"
                                                    TextTrimming="WordEllipsis" />
                                            </Grid>

                                            <!--  点击后弹出对应的信息框  -->
                                        </Border>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <!--  详细内容  -->
                    <StackPanel
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="WhiteSmoke"
                            Text="信息:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="150"
                                Height="30"
                                MaxWidth="170"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Message, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <!--  按钮  -->
                    <StackPanel
                        Margin="5,0,-6,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  清理按钮  -->
                        <Button
                            Width="50"
                            Height="40"
                            Margin="0"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                            materialDesign:ShadowAssist.ShadowEdges="Right"
                            Background="#3C3C3C"
                            Command="{Binding ClearSearchCriteriaCommand}"
                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                            ToolTip="{x:Static languages:Language.Clear}">
                            <TextBlock
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#IconFont"
                                FontSize="20"
                                FontWeight="UltraLight"
                                Foreground="White"
                                RenderTransformOrigin=".5,.5"
                                Text="&#xe601;" />
                        </Button>
                        <!--  搜索按钮  -->
                        <Button
                            Width="40"
                            Height="40"
                            Margin="0"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="0"
                            materialDesign:ShadowAssist.ShadowEdges="Right"
                            Background="#3C3C3C"
                            Command="{Binding SearchDataCommand}"
                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                            ToolTip="{x:Static languages:Language.Search}">
                            <TextBlock
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#IconFont"
                                FontSize="20"
                                FontWeight="UltraLight"
                                Foreground="White"
                                RenderTransformOrigin=".5,.5"
                                Text="&#xe60b;" />
                        </Button>
                        <Button
                            Width="50"
                            Height="40"
                            Margin="0"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                            materialDesign:ShadowAssist.ShadowEdges="Right"
                            Background="#3C3C3C"
                            Command="{Binding ClearMessageCommand}"
                            Cursor="Hand"
                            Style="{StaticResource ButtonFocusEnlargeStyle}"
                            ToolTip="清空日志">
                            <TextBlock
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="pack://application:,,,/Fonts/#IconFont"
                                FontSize="22"
                                FontWeight="UltraLight"
                                Foreground="White"
                                RenderTransformOrigin=".5,.5"
                                Text="&#xe831;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--  列表、详细页  -->
            <Border Grid.Row="1" Margin="0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="65*" />
                        <RowDefinition Height="35*" />
                    </Grid.RowDefinitions>
                    <!--  列表  -->
                    <ListBox
                        Grid.Row="0"
                        MinHeight="100"
                        Margin="0,5"
                        ItemTemplate="{StaticResource VolumeLogItemTemplate}"
                        ItemsSource="{Binding VolumeLogItems, UpdateSourceTrigger=PropertyChanged}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="Auto" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsSelected" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="Transparent" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <!--  去掉焦点框  -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!--  详细信息  -->
                    <Border
                        Grid.Row="1"
                        MinHeight="70"
                        Margin="0,10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#2E2E2E"
                        CornerRadius="5">
                        <TextBox
                            MinHeight="70"
                            Margin="5,0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            InputMethod.IsInputMethodEnabled="False"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>
            <!--  翻页控件  -->
            <Border
                Grid.Row="2"
                MinWidth="200"
                MinHeight="40"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#2A808080"
                CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" MinWidth="50" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <!--  首页  -->
                    <Button
                        Grid.Column="0"
                        Height="40"
                        Margin="0"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                        materialDesign:ShadowAssist.ShadowEdges="Right"
                        Background="#3C3C3C"
                        Command="{Binding FirstPageCommand}"
                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                        ToolTip="{x:Static languages:Language.FirstPage}">
                        <TextBlock
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#IconFont"
                            FontSize="20"
                            FontWeight="UltraLight"
                            Foreground="White"
                            RenderTransformOrigin=".5,.5"
                            Text="&#xe68c;">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="180" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <!--  上一页  -->
                    <Button
                        Grid.Column="1"
                        Height="40"
                        Margin="0"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ShadowAssist.ShadowEdges="Right"
                        Background="#3C3C3C"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                        ToolTip="{x:Static languages:Language.PreviousPage}">
                        <TextBlock
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#IconFont"
                            FontSize="20"
                            FontWeight="UltraLight"
                            Foreground="White"
                            RenderTransformOrigin=".5,.5"
                            Text="&#xe7a5;" />
                    </Button>
                    <!--  页码  -->
                    <StackPanel
                        Grid.Column="2"
                        Margin="10,0"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                        <TextBox
                            MinWidth="20"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Foreground="DimGray"
                            materialDesign:HintAssist.HintOpacity="0.4"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding JumpPageCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="White">
                            <Run Text="/" /><Run Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" />
                        </TextBlock>
                    </StackPanel>
                    <!--  下一页  -->
                    <Button
                        Grid.Column="3"
                        Height="40"
                        Margin="0"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        materialDesign:ShadowAssist.ShadowEdges="Right"
                        Background="#3C3C3C"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                        ToolTip="{x:Static languages:Language.NextPage}">
                        <TextBlock
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#IconFont"
                            FontSize="20"
                            FontWeight="UltraLight"
                            Foreground="White"
                            RenderTransformOrigin=".5,.5"
                            Text="&#xe798;" />
                    </Button>
                    <!--  尾页  -->
                    <Button
                        Grid.Column="4"
                        Height="40"
                        Margin="0"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                        materialDesign:ShadowAssist.ShadowEdges="Right"
                        Background="#3C3C3C"
                        Command="{Binding LastPageCommand}"
                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                        ToolTip="{x:Static languages:Language.LastPage}">
                        <TextBlock
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#IconFont"
                            FontSize="20"
                            FontWeight="UltraLight"
                            Foreground="White"
                            RenderTransformOrigin=".5,.5"
                            Text="&#xe68c;" />
                    </Button>
                </Grid>
            </Border>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="1"
                Grid.RowSpan="2"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding VolumeLogMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>