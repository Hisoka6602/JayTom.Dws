<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration.CommunicationsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:packageSortingConfiguration="clr-namespace:JayTom.Dws.Client.Converters.PackageSortingConfiguration"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="CommunicationsSettingsView"
    Title="CommunicationsSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <settingsConverter:TcpConnectionModeToBooleanConverter x:Key="TcpConnectionModeToBooleanConverter" />
        <packageSortingConfiguration:CommunicationsTypeToVisibilityConverter x:Key="CommunicationsTypeToVisibilityConverter" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="CommunicationsSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="LogisticsCodeRecognitionDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  通讯类型  -->
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="&#xe7e5;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯类型:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯类型:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Name="CommunicationsTypeComboBox"
                            Height="30"
                            MinWidth="160"
                            Padding="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            materialDesign:ColorZoneAssist.Mode="Dark"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding CommunicationsTypeItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectCommunicationsType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Value"
                            Style="{StaticResource MaterialDesignComboBox}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  基础连接参数  -->
            <StackPanel
                Grid.Row="1"
                Orientation="Vertical"
                Visibility="{Binding SelectCommunicationsType, Converter={StaticResource CommunicationsTypeToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe645;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯参数:" />
                </StackPanel>

                <TabControl HorizontalAlignment="Left" SelectedIndex="{Binding ElementName=CommunicationsTypeComboBox, Path=SelectedIndex}">
                    <TabItem Header="无分拣" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="None" />
                    </TabItem>
                    <TabItem Header="串口通讯" Visibility="Collapsed">
                        <!--  串口  -->
                        <StackPanel Margin="50,5,0,0" Orientation="Vertical">

                            <!--  串口名、刷新按钮  -->
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.SerialPortName}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="130"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding PortItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding CommunicationsSettingsInfo.SerialPortSettingsInfo.PortName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                                <Button
                                    Width="50"
                                    MinHeight="30"
                                    Margin="5,0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="#2E2E2E"
                                    BorderThickness="0"
                                    Command="{Binding PortUpdateCommand}"
                                    FocusVisualStyle="{x:Null}"
                                    Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="18"
                                            Foreground="DarkGray"
                                            Text="&#xe69a;" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!--  波特率  -->
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.BaudRate}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding BaudRateItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding CommunicationsSettingsInfo.SerialPortSettingsInfo.BaudRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            <!--  数据位  -->
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.DataBits}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding DataBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding CommunicationsSettingsInfo.SerialPortSettingsInfo.DataBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            <!--  效验位  -->
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.ParityBit}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        DisplayMemberPath="Name"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding ParityItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding SelectParity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            <!--  停止位  -->
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.StopBits}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        DisplayMemberPath="Name"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding StopBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding SelectStopBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            <!--  数据格式  -->
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.DataFormat}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        DisplayMemberPath="Name"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding DataFormatTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding SelectDataFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="TCP通讯" Visibility="Collapsed">
                        <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                            <!--  使用Tcp服务端  -->
                            <RadioButton
                                Name="IsUseServerRadioButton"
                                Content="{x:Static languages:Language.IsUseTCPServer}"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Server}"
                                Style="{StaticResource MaterialDesignRadioButton}" />
                            <StackPanel
                                Margin="50,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseServerRadioButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.IPAddress}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Text="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ServerConfig.IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Port}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ServerConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <!--  使用Tcp客户端  -->
                            <RadioButton
                                Name="IsUseClientRadioButton"
                                Content="{x:Static languages:Language.IsUseTCPClient}"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Client}"
                                Style="{StaticResource MaterialDesignRadioButton}" />
                            <StackPanel
                                Margin="50,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseClientRadioButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.IPAddress}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False">
                                            <TextBox.Text>
                                                <Binding
                                                    Mode="TwoWay"
                                                    Path="CommunicationsSettingsInfo.TcpSettingsInfo.ClientConfig.IpAddress"
                                                    UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Port}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ClientConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="USB通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="USB通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="CAN总线通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="CAN总线通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="Ethernet通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="Ethernet通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="SPI通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="SPI通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="I2C通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="I2C通讯(内容开发中..)" />
                    </TabItem>
                </TabControl>
            </StackPanel>
            <!--  通讯协议  -->
            <StackPanel
                Grid.Row="2"
                Orientation="Vertical"
                Visibility="{Binding SelectCommunicationsType, Converter={StaticResource CommunicationsTypeToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe7f8;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯协议:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <!--  通讯协议  -->
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯协议:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Height="30"
                            MinWidth="160"
                            Padding="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            materialDesign:ColorZoneAssist.Mode="Dark"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding CommunicationProtocolItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectCommunicationProtocol, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Value"
                            Style="{StaticResource MaterialDesignComboBox}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <!--  包裹超时设置  -->
            <StackPanel
                Grid.Row="3"
                Margin="5,0"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe71d;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="包裹超时:" />
                </StackPanel>
                <!--  内容  -->
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否使用包裹有效周期:" />
                        <ToggleButton
                            Name="IsUsePackageExpiryToggleButton"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Focusable="False"
                            IsChecked="{Binding CommunicationsSettingsInfo.IsUsePackageExpiry, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel IsEnabled="{Binding ElementName=IsUsePackageExpiryToggleButton, Path=IsChecked}" Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="有效时间:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="130"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding CommunicationsSettingsInfo.PackageExpiryTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  下位机设置  -->
            <StackPanel
                Grid.Row="4"
                Margin="5,0"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe805;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="下位机设置:" />
                </StackPanel>
                <!--  内容  -->
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="是否由下位机创建包裹:" />
                            <ToggleButton
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
                                IsChecked="{Binding CommunicationsSettingsInfo.DeviceControlSettingsInfo.IsUseCreatePackageByDevice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="是否由下位机移除包裹:" />
                            <ToggleButton
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
                                IsChecked="{Binding CommunicationsSettingsInfo.DeviceControlSettingsInfo.IsUseRemovePackageByDevice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="是否由下位机启动运行:" />
                            <ToggleButton
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
                                IsChecked="{Binding CommunicationsSettingsInfo.DeviceControlSettingsInfo.IsUseStartDeviceByDevice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="是否由下位机停止运行:" />
                            <ToggleButton
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
                                IsChecked="{Binding CommunicationsSettingsInfo.DeviceControlSettingsInfo.IsUseStopDeviceByDevice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
            <!--  下位机应答  -->
            <StackPanel
                Grid.Row="5"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Visibility="{Binding SelectCommunicationsType, Converter={StaticResource CommunicationsTypeToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="&#xe803;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否验证下位机应答:" />
                    <ToggleButton
                        Name="IsReceiptValidationEnabledToggleButton"
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding CommunicationsSettingsInfo.MachineReplyInfo.IsVerificationEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <StackPanel
                    Margin="50,5,0,0"
                    IsEnabled="{Binding ElementName=IsReceiptValidationEnabledToggleButton, Path=IsChecked}"
                    Orientation="Vertical"
                    Visibility="{Binding ElementName=IsReceiptValidationEnabledToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!--  验证超时时间  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="验证超时时间:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="120"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding CommunicationsSettingsInfo.MachineReplyInfo.Timeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <!--  最大重试次数  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="最大重试次数:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="120"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding CommunicationsSettingsInfo.MachineReplyInfo.MaxRetryCount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  心跳包  -->
            <StackPanel
                Grid.Row="6"
                Margin="5,0"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Visibility="{Binding SelectCommunicationsType, Converter={StaticResource CommunicationsTypeToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Light"
                        Foreground="DarkGray"
                        Text="&#xe800;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="是否使用心跳包:" />
                    <ToggleButton
                        Name="IsHeartbeatEnabledToggleButton"
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Focusable="False"
                        IsChecked="{Binding CommunicationsSettingsInfo.HeartbeatInfo.IsHeartbeatEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
                <StackPanel
                    Margin="50,5,0,0"
                    IsEnabled="{Binding ElementName=IsHeartbeatEnabledToggleButton, Path=IsChecked}"
                    Orientation="Vertical"
                    Visibility="{Binding ElementName=IsHeartbeatEnabledToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!--  是否主动发送心跳包  -->
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否主动发送心跳包:" />
                        <ToggleButton
                            Name="IsHeartbeatActiveToggleButton"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Focusable="False"
                            IsChecked="{Binding CommunicationsSettingsInfo.HeartbeatInfo.IsHeartbeatActive, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <!--  心跳包内容  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=IsHeartbeatActiveToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="心跳包内容:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="130"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding CommunicationsSettingsInfo.HeartbeatInfo.HeartbeatData, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <!--  心跳包间隔  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ElementName=IsHeartbeatActiveToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="心跳包间隔:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="130"
                                Height="30"
                                MaxWidth="500"
                                Margin="5,0"
                                materialDesign:TextFieldAssist.HasClearButton="False"
                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                InputMethod.IsInputMethodEnabled="False"
                                Text="{Binding CommunicationsSettingsInfo.HeartbeatInfo.HeartbeatInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  保存设置  -->
            <Button
                Grid.Row="7"
                Grid.Column="0"
                MinHeight="30"
                Margin="30,10"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding SaveSettingsCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe66e;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="{x:Static languages:Language.SaveSettings}" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                    <ProgressBar
                        Name="StatusProgressBar"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Value="0">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Button>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="7"
                Grid.RowSpan="2"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding CommunicationsSettingsMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>