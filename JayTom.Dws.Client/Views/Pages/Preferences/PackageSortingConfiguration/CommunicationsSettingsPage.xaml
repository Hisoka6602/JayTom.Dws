<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration.CommunicationsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:packageSortingConfiguration="clr-namespace:JayTom.Dws.Client.Converters.PackageSortingConfiguration"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="CommunicationsSettingsView"
    Title="CommunicationsSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <settingsConverter:TcpConnectionModeToBooleanConverter x:Key="TcpConnectionModeToBooleanConverter" />
        <packageSortingConfiguration:CommunicationsTypeToVisibilityConverter x:Key="CommunicationsTypeToVisibilityConverter" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="CommunicationsSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="CommunicationsSettingsDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,0">
            <!--<Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            ~1~  通讯类型  @1@
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="&#xe7e5;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯类型:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    ~1~  图标  @1@
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯类型:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Name="CommunicationsTypeComboBox"
                            Height="30"
                            MinWidth="160"
                            Padding="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            materialDesign:ColorZoneAssist.Mode="Dark"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding CommunicationsTypeItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectCommunicationsType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Value"
                            Style="{StaticResource MaterialDesignComboBox}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            ~1~  基础连接参数  @1@
            <StackPanel
                Grid.Row="1"
                Orientation="Vertical"
                Visibility="{Binding SelectCommunicationsType, Converter={StaticResource CommunicationsTypeToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe645;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯参数:" />
                </StackPanel>

                <TabControl HorizontalAlignment="Left" SelectedIndex="{Binding ElementName=CommunicationsTypeComboBox, Path=SelectedIndex}">
                    <TabItem Header="无分拣" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="None" />
                    </TabItem>
                    <TabItem Header="串口通讯" Visibility="Collapsed">
                        ~1~  串口  @1@
                        <StackPanel Margin="50,5,0,0" Orientation="Vertical">

                            ~1~  串口名、刷新按钮  @1@
                            <StackPanel Orientation="Horizontal">
                                ~1~  图标  @1@
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.SerialPortName}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="130"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding PortItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding CommunicationsSettingsInfo.SerialPortSettingsInfo.PortName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                                <Button
                                    Width="50"
                                    MinHeight="30"
                                    Margin="5,0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="#2E2E2E"
                                    BorderThickness="0"
                                    Command="{Binding PortUpdateCommand}"
                                    FocusVisualStyle="{x:Null}"
                                    Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="18"
                                            Foreground="DarkGray"
                                            Text="&#xe69a;" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            ~1~  波特率  @1@
                            <StackPanel Orientation="Horizontal">
                                ~1~  图标  @1@
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.BaudRate}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding BaudRateItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding CommunicationsSettingsInfo.SerialPortSettingsInfo.BaudRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            ~1~  数据位  @1@
                            <StackPanel Orientation="Horizontal">
                                ~1~  图标  @1@
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.DataBits}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding DataBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding CommunicationsSettingsInfo.SerialPortSettingsInfo.DataBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            ~1~  效验位  @1@
                            <StackPanel Orientation="Horizontal">
                                ~1~  图标  @1@
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.ParityBit}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        DisplayMemberPath="Name"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding ParityItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding SelectParity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            ~1~  停止位  @1@
                            <StackPanel Orientation="Horizontal">
                                ~1~  图标  @1@
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.StopBits}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        DisplayMemberPath="Name"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding StopBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding SelectStopBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                            ~1~  数据格式  @1@
                            <StackPanel Orientation="Horizontal">
                                ~1~  图标  @1@
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.DataFormat}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <ComboBox
                                        Height="30"
                                        MinWidth="190"
                                        Padding="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        materialDesign:ColorZoneAssist.Mode="Dark"
                                        BorderThickness="0"
                                        DisplayMemberPath="Name"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        ItemsSource="{Binding DataFormatTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding SelectDataFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource MaterialDesignComboBox}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="TCP通讯" Visibility="Collapsed">
                        <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                            ~1~  使用Tcp服务端  @1@
                            <RadioButton
                                Name="IsUseServerRadioButton"
                                Content="{x:Static languages:Language.IsUseTCPServer}"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Server}"
                                Template="{StaticResource CustomRadioButtonTemplate}" />
                            <StackPanel
                                Margin="50,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseServerRadioButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    ~1~  图标  @1@
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.IPAddress}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Text="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ServerConfig.IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    ~1~  图标  @1@
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Port}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ServerConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            ~1~  使用Tcp客户端  @1@
                            <RadioButton
                                Name="IsUseClientRadioButton"
                                Content="{x:Static languages:Language.IsUseTCPClient}"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Client}"
                                Template="{StaticResource CustomRadioButtonTemplate}" />
                            <StackPanel
                                Margin="50,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseClientRadioButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    ~1~  图标  @1@
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.IPAddress}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="100"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False">
                                            <TextBox.Text>
                                                <Binding
                                                    Mode="TwoWay"
                                                    Path="CommunicationsSettingsInfo.TcpSettingsInfo.ClientConfig.IpAddress"
                                                    UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    ~1~  图标  @1@
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="{x:Static languages:Language.Port}" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding CommunicationsSettingsInfo.TcpSettingsInfo.ClientConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="USB通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="USB通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="CAN总线通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="CAN总线通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="Ethernet通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="Ethernet通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="SPI通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="SPI通讯(内容开发中..)" />
                    </TabItem>
                    <TabItem Header="I2C通讯" Visibility="Collapsed">
                        <TextBlock
                            Margin="20"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="DimGray"
                            Text="I2C通讯(内容开发中..)" />
                    </TabItem>
                </TabControl>
            </StackPanel>
            ~1~  通讯协议  @1@
            <StackPanel
                Grid.Row="2"
                Orientation="Vertical"
                Visibility="{Binding SelectCommunicationsType, Converter={StaticResource CommunicationsTypeToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe7f8;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯协议:" />
                </StackPanel>
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    ~1~  通讯协议  @1@
                    ~1~  图标  @1@
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="通讯协议:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Height="30"
                            MinWidth="160"
                            Padding="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            materialDesign:ColorZoneAssist.Mode="Dark"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding CommunicationProtocolItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectCommunicationProtocol, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Value"
                            Style="{StaticResource MaterialDesignComboBox}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            ~1~  包裹超时设置  @1@
            <StackPanel
                Grid.Row="3"
                Margin="5,0"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe71d;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="包裹超时:" />
                </StackPanel>
                ~1~  内容  @1@
                <StackPanel Margin="50,5,0,0" Orientation="Vertical">
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否使用包裹有效周期:" />
                        <ToggleButton
                            Name="IsUsePackageExpiryToggleButton"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Focusable="False"
                            IsChecked="{Binding CommunicationsSettingsInfo.IsUsePackageExpiry, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel IsEnabled="{Binding ElementName=IsUsePackageExpiryToggleButton, Path=IsChecked}" Orientation="Horizontal">
                        ~1~  图标  @1@
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="有效时间:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <TextBox
                                Width="130"
                                Height="30"
