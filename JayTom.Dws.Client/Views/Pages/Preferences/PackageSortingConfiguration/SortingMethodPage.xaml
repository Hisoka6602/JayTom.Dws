<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration.SortingMethodPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:JayTom.Dws.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="SortingMethodView"
    Title="SortingMethodPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">

    <!--  分拣方式  -->
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="SortingMethodView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="SortingMethodDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,0">
            <!--  方式选择  -->
            <!--  选项卡内容  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  模式选择  -->
            <StackPanel
                Grid.Row="0"
                Margin="20,5,0,0"
                Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe7b9;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="分拣模式:" />
                <Border
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <ComboBox
                        Height="30"
                        MinWidth="160"
                        Padding="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        materialDesign:ColorZoneAssist.Mode="Dark"
                        BorderThickness="0"
                        DisplayMemberPath="Name"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        ItemsSource="{Binding SortModeItems, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectSortMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        Style="{StaticResource MaterialDesignComboBox}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <mvvm:InvokeCommandAction Command="{Binding OptionSelectionChangedCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ComboBox>
                </Border>
            </StackPanel>
            <!--  选项卡  -->
            <TabControl
                Grid.Row="1"
                HorizontalContentAlignment="Left"
                materialDesign:ColorZoneAssist.Foreground="White"
                materialDesign:ColorZoneAssist.Mode="Custom"
                materialDesign:TabAssist.HasFilledTab="True"
                materialDesign:TabAssist.HasUniformTabWidth="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{StaticResource MaterialDesignUniformTabControl}"
                TabStripPlacement="Top">
                <TabItem Foreground="White" Header="条码分拣">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="SortingMethodPages/BarcodeSortingPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Foreground="White" Header="重量分拣">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="SortingMethodPages/WeightSortingPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Foreground="White" Header="体积分拣">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="SortingMethodPages/VolumeSortingPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="物流分拣">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="SortingMethodPages/LogisticsSortingPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="Ocr分拣">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="SortingMethodPages/OcrSortingPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <TabItem Header="Api响应内容分拣">
                    <controls:DeferredFrame
                        Margin="0"
                        Padding="0"
                        DeferredSource="SortingMethodPages/ApiResponseSortingPage.xaml"
                        Focusable="False"
                        NavigationUIVisibility="Hidden" />
                </TabItem>
                <!--<TabItem Header="组合工作流分拣">
                    <Frame
                        Margin="0"
                        Padding="0"
                        Focusable="False"
                        NavigationUIVisibility="Hidden"
                        Source="SortingMethodPages/CombinedWorkflowSortingPage.xaml" />
                </TabItem>-->
            </TabControl>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="1"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding SortingMethodMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>
