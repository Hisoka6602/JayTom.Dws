<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration.SortingMethodPages.ApiResponseSortingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration.SortingMethodPages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="ApiResponseSortingView"
    Title="ApiResponseSortingPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    Tag="ApiResponseSortingDialogHost"
    Template="{StaticResource BulkOperationsTemplate}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <!--  列表  -->
    <DataGrid
        Grid.Row="0"
        MinWidth="500"
        MinHeight="300"
        Margin="20,20,20,0"
        Padding="10,0"
        materialDesign:DataGridAssist.CellPadding="4 2 2 2"
        materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
        AlternatingRowBackground="#101E90FF"
        AutoGenerateColumns="False"
        Background="Transparent"
        CanUserAddRows="False"
        CanUserResizeColumns="True"
        CanUserSortColumns="False"
        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
        ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
        Focusable="False"
        Foreground="White"
        FrozenColumnCount="2"
        GridLinesVisibility="None"
        HorizontalScrollBarVisibility="Auto"
        ItemsSource="{Binding ApiSortingItems, UpdateSourceTrigger=PropertyChanged}"
        RowBackground="#061E90FF"
        Style="{StaticResource VirtualizingDataGridStyle}">
        <DataGrid.RowStyle>
            <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                <Setter Property="Height" Value="35" />
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <DataGridCheckBoxColumn Binding="{Binding IsSelect, UpdateSourceTrigger=PropertyChanged}">
                <DataGridCheckBoxColumn.ElementStyle>
                    <Style BasedOn="{StaticResource CustomCheckBoxStyle}" TargetType="{x:Type CheckBox}" />
                </DataGridCheckBoxColumn.ElementStyle>
                <DataGridCheckBoxColumn.EditingElementStyle>
                    <Style BasedOn="{StaticResource CustomCheckBoxStyle}" TargetType="{x:Type CheckBox}" />
                </DataGridCheckBoxColumn.EditingElementStyle>
            </DataGridCheckBoxColumn>
            <DataGridTextColumn
                Width="45"
                MinWidth="45"
                Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                IsReadOnly="True">
                <DataGridTextColumn.Header>
                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!--  绑定格口  -->
            <DataGridTextColumn
                Width="100"
                MinWidth="100"
                Binding="{Binding ExitName, UpdateSourceTrigger=PropertyChanged}"
                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                <DataGridTextColumn.Header>
                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="绑定格口" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!--  规则名称  -->
            <DataGridTextColumn
                Width="100"
                MinWidth="100"
                Binding="{Binding SortingName, UpdateSourceTrigger=PropertyChanged}"
                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                <DataGridTextColumn.Header>
                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="规则名称" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>

            <!--  规则  -->
            <DataGridTextColumn
                Width="500"
                MinWidth="500"
                Binding="{Binding SortingRuleGroup, UpdateSourceTrigger=PropertyChanged}"
                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                <DataGridTextColumn.Header>
                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="规则" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!--  备注  -->
            <DataGridTextColumn
                Width="180"
                MinWidth="180"
                Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                <DataGridTextColumn.Header>
                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="备注" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!--  操作  -->
            <DataGridTemplateColumn
                Width="300"
                MinWidth="300"
                MaxWidth="600"
                CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                <DataGridTemplateColumn.Header>
                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="{x:Static languages:Language.TableHeaderOperation}" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="RoyalBlue"
                                    Command="{Binding ElementName=ApiResponseSortingView, Path=DataContext.ModifyCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="RoyalBlue"
                                    Style="{StaticResource MaterialDesignFlatLightButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="13"
                                            Foreground="White"
                                            Text="&#xe7ca;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="修改"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="80"
                                    Height="30"
                                    MinWidth="60"
                                    Margin="5,0"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Background="DarkRed"
                                    Command="{Binding ElementName=ApiResponseSortingView, Path=DataContext.DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    Foreground="Red"
                                    Style="{StaticResource MaterialDesignFlatLightButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="10"
                                            Foreground="White"
                                            Text="&#xe601;" />
                                        <TextBlock
                                            Margin="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                            FontSize="13"
                                            FontWeight="Light"
                                            Foreground="White"
                                            IsEnabled="True"
                                            Text="{x:Static languages:Language.Delete}"
                                            TextAlignment="Justify" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</Page>