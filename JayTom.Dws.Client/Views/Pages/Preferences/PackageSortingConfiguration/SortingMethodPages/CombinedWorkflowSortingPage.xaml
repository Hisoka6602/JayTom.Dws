<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration.SortingMethodPages.CombinedWorkflowSortingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataTemplateSelectors="clr-namespace:JayTom.Dws.Client.DataTemplateSelectors"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:extensions="clr-namespace:JayTom.Dws.Client.Extensions"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.PackageSortingConfiguration.SortingMethodPages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:packageSorting="clr-namespace:JayTom.Dws.Client.Models.PackageSorting"
    Name="CombinedWorkflowSortingView"
    Title="CombinedWorkflowSortingPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  出口模板  -->
        <DataTemplate x:Key="ExitNodeTemplate" DataType="{x:Type packageSorting:CombinedWorkflowNodeModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Background="BlueViolet"
                    BorderThickness="0"
                    Command="{Binding InstructionCommand}"
                    CommandParameter="{Binding}"
                    Focusable="False"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <!--  内容  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        Text="{Binding Name}" />
                </Button>
                <!--  肯定连接点  -->
                <Ellipse
                    Grid.Column="0"
                    Width="8"
                    Height="8"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5, 0.5">
                            <GradientStop Offset="0" Color="LimeGreen" />
                            <GradientStop Offset="0.5" Color="LightGreen" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!--  否定连接点  -->
                <Ellipse
                    Grid.Column="1"
                    Width="8"
                    Height="8"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5, 0.5">
                            <GradientStop Offset="0" Color="OrangeRed" />
                            <GradientStop Offset="0.5" Color="LightSalmon" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!--  右上角取消按钮  -->
            </Grid>
        </DataTemplate>
        <!--  条码判断节点  -->
        <DataTemplate x:Key="BarcodeNodeTemplate" DataType="{x:Type packageSorting:CombinedWorkflowNodeModel}">
            <Button
                Height="50"
                MinWidth="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="DodgerBlue"
                BorderThickness="0"
                Command="{Binding InstructionCommand}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Name}" />
            </Button>
        </DataTemplate>
        <dataTemplateSelectors:CombinedWorkflowNodeDataTemplateSelector
            x:Key="CombinedWorkflowNodeDataTemplateSelector"
            BarcodeRuleTemplate="{StaticResource BarcodeNodeTemplate}"
            ExitTemplate="{StaticResource ExitNodeTemplate}" />
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10">
            <!--  左边画布  -->
            <!--  右边拖动控件  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <!--  画布  -->
            <Border
                Grid.Column="0"
                Background="#2E2E2E"
                CornerRadius="10">
                <ItemsControl
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    dd:DragDrop.CanDragWithMouseRightButton="False"
                    dd:DragDrop.DefaultDragAdornerOpacity="0.7"
                    dd:DragDrop.DragMouseAnchorPoint="0,0"
                    dd:DragDrop.DropHandler="{Binding}"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    dd:DragDrop.ShowAlwaysDropTargetAdorner="False"
                    dd:DragDrop.UseDefaultDragAdorner="True"
                    dd:DragDrop.UseDefaultEffectDataTemplate="False"
                    dd:DragDrop.UseVisualSourceItemSizeForDragAdorner="False"
                    Background="Transparent"
                    Focusable="False"
                    ItemTemplateSelector="{StaticResource CombinedWorkflowNodeDataTemplateSelector}"
                    ItemsSource="{Binding CanvasNodes, UpdateSourceTrigger=PropertyChanged}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Focusable="False" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Border>
            <!--  列表  -->
            <Border
                Grid.Column="1"
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="#2E2E2E"
                CornerRadius="10">
                <!--
                    ItemTemplateSelector="{StaticResource FormulaDataTemplateSelectors}"
                    ItemsSource="{Binding FormulaTemplate, UpdateSourceTrigger=PropertyChanged}"
                -->
                <ListView
                    Width="270"
                    MaxWidth="530"
                    MaxHeight="850"
                    Margin="5"
                    VerticalAlignment="Top"
                    dd:DragDrop.CanDragWithMouseRightButton="False"
                    dd:DragDrop.DefaultDragAdornerOpacity="0.7"
                    dd:DragDrop.DragMouseAnchorPoint="0,0"
                    dd:DragDrop.DropHandler="{Binding}"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    dd:DragDrop.ShowAlwaysDropTargetAdorner="False"
                    dd:DragDrop.UseDefaultDragAdorner="True"
                    dd:DragDrop.UseDefaultEffectDataTemplate="False"
                    dd:DragDrop.UseVisualSourceItemSizeForDragAdorner="False"
                    Focusable="False"
                    ItemTemplateSelector="{StaticResource CombinedWorkflowNodeDataTemplateSelector}"
                    ItemsSource="{Binding CombinedWorkflowNodes, UpdateSourceTrigger=PropertyChanged}"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border
                                            x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListBox.Template>
                        <ControlTemplate TargetType="{x:Type ListView}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <WrapPanel
                                    IsItemsHost="True"
                                    Orientation="Horizontal"
                                    ScrollViewer.CanContentScroll="True" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListView>
            </Border>
        </Grid>
        <!--  保存设置  -->
        <Button
            Grid.Row="1"
            Grid.Column="0"
            MinHeight="30"
            Margin="30,10"
            HorizontalAlignment="Left"
            materialDesign:ButtonAssist.CornerRadius="5"
            Background="#2E2E2E"
            BorderThickness="0"
            Command="{Binding SaveSettingsCommand}"
            FocusVisualStyle="{x:Null}"
            Style="{StaticResource MaterialDesignFlatAccentBgButton}">

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="18"
                        Foreground="DarkGray"
                        Text="&#xe66e;" />
                    <TextBlock
                        Margin="2,1,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.SaveSettings}" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
                <ProgressBar
                    Name="StatusProgressBar"
                    Width="25"
                    Height="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Value="0">
                    <ProgressBar.Style>
                        <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Button>
        <!--  提示框  -->
        <materialDesign:Snackbar
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="Auto"
            Height="Auto"
            VerticalAlignment="Bottom"
            Background="BlueViolet"
            FontFamily="LoadFiraCode"
            FontWeight="Bold"
            MessageQueue="{Binding CommunicationsSettingsMessageQueue}" />

        <!--<Path
            Grid.Row="0"
            Stroke="Black"
            StrokeThickness="1">
            <Path.Data>
                <GeometryGroup>
                    <LineGeometry StartPoint="50,50" EndPoint="50,100" />
                    <LineGeometry StartPoint="50,100" EndPoint="100,100" />
                </GeometryGroup>
            </Path.Data>
        </Path>-->

        <Path
            Grid.Row="0"
            Stroke="LimeGreen"
            StrokeThickness="2">
            <Path.Data>
                <GeometryGroup>
                    <LineGeometry StartPoint="50,50" EndPoint="50,75" />
                    <LineGeometry StartPoint="50,75" EndPoint="75,75" />
                    <LineGeometry StartPoint="75,75" EndPoint="75,100" />
                </GeometryGroup>
            </Path.Data>
        </Path>
        <Path
            Grid.Row="0"
            Stroke="LimeGreen"
            StrokeThickness="2">
            <Path.Data>
                <GeometryGroup>
                    <LineGeometry StartPoint="100,100" EndPoint="100,150" />
                    <LineGeometry StartPoint="100,150" EndPoint="150,150" />
                    <LineGeometry StartPoint="150,150" EndPoint="150,200" />
                </GeometryGroup>
            </Path.Data>
        </Path>
    </Grid>
</Page>