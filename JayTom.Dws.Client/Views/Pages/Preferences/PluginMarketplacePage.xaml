<!--  插件商城  -->
<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.PluginMarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="PluginMarketplace"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="40*" />
        </Grid.ColumnDefinitions>
        <Border
            Name="SelectedFlag"
            Grid.Column="1"
            Width="1"
            Margin="0,0,0,70"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="LawnGreen" />
        <TextBlock
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="30"
            FontWeight="Bold"
            Foreground="White">
            PluginMarketplacePage
        </TextBlock>
        <!--  左边列表、搜索工具  -->
        <StackPanel Grid.Column="0" Margin="15,0">
            <!--  搜索工具  -->
            <!--  列表  -->
            <ListBox
                MinHeight="100"
                ItemTemplate="{StaticResource PluginTemplate}"
                ItemsSource="{Binding PluginItems, UpdateSourceTrigger=PropertyChanged}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsSelected" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="Transparent" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <!--  去掉焦点框  -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <!--  右边属性  -->
    </Grid>
</Page>