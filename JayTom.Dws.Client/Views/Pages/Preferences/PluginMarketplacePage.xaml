<!--  插件商城  -->
<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.PluginMarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="PluginMarketplace"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:PluginIconFontConverter x:Key="PluginIconFontConverter" />
        <converters:PluginStatusColorConverter x:Key="PluginStatusColorConverter" />
        <converters:PluginStatusIconFontConverter x:Key="PluginStatusIconFontConverter" />
    </Page.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="600" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border
            Name="SelectedFlag"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="1"
            Margin="0,0,0,70"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="LawnGreen" />
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="30"
            FontWeight="Bold"
            Foreground="White">
            PluginMarketplacePage
        </TextBlock>
        <!--  左边列表、搜索工具  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="15,0">
            <!--  搜索工具  -->
            <Border
                Width="120"
                MinWidth="800"
                MinHeight="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#2A808080"
                CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <!--  快捷搜索  -->
                    <Border
                        Grid.Column="0"
                        Height="30"
                        Margin="5,0"
                        Padding="10,0"
                        Background="DimGray"
                        CornerRadius="15">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Foreground="White"
                            Text="快捷搜索" />
                    </Border>
                    <!--  输入框  -->
                    <Grid Grid.Column="1">
                        <!--  正常输入框  -->
                        <TextBox
                            MaxHeight="38"
                            Padding="0,0,20,0"
                            VerticalContentAlignment="Center"
                            materialDesign:HintAssist.Foreground="DimGray"
                            materialDesign:HintAssist.Hint="请输入查找的插件名称"
                            materialDesign:HintAssist.HintOpacity="0.4"
                            AcceptsReturn="False"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="DemiBold"
                            Foreground="White"
                            TextAlignment="Justify"
                            TextWrapping="NoWrap" />
                    </Grid>
                    <!--  搜索按钮  -->
                    <Button
                        Grid.Column="2"
                        Height="40"
                        Margin="5,0,0,0"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                        Background="DodgerBlue"
                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                        ToolTip="点击搜索">
                        <TextBlock
                            Margin="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#IconFont"
                            FontSize="20"
                            FontWeight="UltraLight"
                            Foreground="White"
                            Text="&#xe60b;" />
                    </Button>
                </Grid>
            </Border>
            <!--  类型列表  -->
            <ListBox
                Margin="0,10"
                ItemsSource="{Binding PluginTypeItems, UpdateSourceTrigger=PropertyChanged}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PluginTypeItemInfoModel}">
                        <Button
                            Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                            Command="{Binding ClickCommand}"
                            CommandParameter="{Binding}"
                            Focusable="False"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{Binding ToolTip}">
                            <TextBlock
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="20"
                                Text="{Binding FontIcon}" />
                        </Button>
                    </DataTemplate>
                    <!--  图标按钮  -->
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsSelected" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="Transparent" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <!--  去掉焦点框  -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <!--  列表  -->
            <ListBox
                MinHeight="100"
                ItemTemplate="{StaticResource PluginTemplate}"
                ItemsSource="{Binding PluginItems, UpdateSourceTrigger=PropertyChanged}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsSelected" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="Transparent" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <!--  去掉焦点框  -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <!--  翻页控件  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            MinWidth="200"
            MinHeight="40"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#2A808080"
            CornerRadius="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" MinWidth="50" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <!--  首页  -->
                <Button
                    Grid.Column="0"
                    Height="40"
                    Margin="0"
                    Padding="0"
                    materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                    Background="#1A696969"
                    Command="{Binding FirstPageCommand}"
                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                    ToolTip="FirstPage">
                    <TextBlock
                        Margin="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                        FontSize="20"
                        FontWeight="UltraLight"
                        Foreground="White"
                        RenderTransformOrigin=".5,.5"
                        Text="&#xe68c;">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="180" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <!--  上一页  -->
                <Button
                    Grid.Column="1"
                    Height="40"
                    Margin="0"
                    Padding="0"
                    materialDesign:ButtonAssist.CornerRadius="0"
                    Background="#1A696969"
                    Command="{Binding PreviousPageCommand}"
                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                    ToolTip="PreviousPage">
                    <TextBlock
                        Margin="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                        FontSize="20"
                        FontWeight="UltraLight"
                        Foreground="White"
                        RenderTransformOrigin=".5,.5"
                        Text="&#xe7a5;" />
                </Button>
                <!--  页码  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="10,0"
                    HorizontalAlignment="Stretch"
                    Orientation="Horizontal">
                    <TextBox
                        MinWidth="20"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Foreground="DimGray"
                        materialDesign:HintAssist.HintOpacity="0.4"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding JumpPageCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="White">
                        <Run Text="/" /><Run Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" />
                    </TextBlock>
                </StackPanel>
                <!--  下一页  -->
                <Button
                    Grid.Column="3"
                    Height="40"
                    Margin="0"
                    Padding="0"
                    materialDesign:ButtonAssist.CornerRadius="0"
                    Background="#1A696969"
                    Command="{Binding NextPageCommand}"
                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                    ToolTip="NextPage">
                    <TextBlock
                        Margin="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                        FontSize="20"
                        FontWeight="UltraLight"
                        Foreground="White"
                        RenderTransformOrigin=".5,.5"
                        Text="&#xe798;" />
                </Button>
                <!--  尾页  -->
                <Button
                    Grid.Column="4"
                    Height="40"
                    Margin="0"
                    Padding="0"
                    materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                    Background="#1A696969"
                    Command="{Binding LastPageCommand}"
                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                    ToolTip="LastPage">
                    <TextBlock
                        Margin="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                        FontSize="20"
                        FontWeight="UltraLight"
                        Foreground="White"
                        RenderTransformOrigin=".5,.5"
                        Text="&#xe68c;" />
                </Button>
            </Grid>
        </Border>
        <!--  右边属性  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="20,0"
            Background="#363636"
            CornerRadius="20">
            <StackPanel Orientation="Vertical">
                <!--  图标、名称  -->
                <StackPanel
                    Margin="20,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Border
                        Width="50"
                        Height="50"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="/Image/ocr-img.png" />
                        </Border.Background>
                    </Border>
                    <TextBlock
                        Margin="30,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding SelectPluginItem.Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <!--  插件类型  -->
                <StackPanel Margin="20,10" Orientation="Horizontal">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="插件类型:" />
                    <TextBlock
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="pack://application:,,,/Fonts/#iconfont"
                        FontSize="23"
                        Foreground="DodgerBlue"
                        Text="{Binding SelectPluginItem.Type, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PluginIconFontConverter}}" />
                    <!--  安装、卸载按钮  -->
                    <Button
                        Width="100"
                        Margin="60,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="#202020"
                        BorderBrush="#202020"
                        Content="安装"
                        Focusable="False"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="20,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontFamily="pack://application:,,,/Fonts/#iconfont"
                        FontSize="18"
                        Foreground="{Binding SelectPluginItem.Status, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PluginStatusColorConverter}}"
                        Text="{Binding SelectPluginItem.Status, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PluginStatusIconFontConverter}}" />
                    <!--  提示  -->
                </StackPanel>
                <Separator Margin="20,10" />
                <!--  插件描述  -->
                <StackPanel Margin="20,10" Orientation="Vertical">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="White"
                        Text="描述:" />

                    <TextBlock
                        Margin="0,10"
                        Foreground="White"
                        Text="{Binding SelectPluginItem.Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
                <StackPanel Margin="20,10" Orientation="Vertical">
                    <!--  发行日期  -->
                    <StackPanel Margin="0,10" Orientation="Horizontal">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="发行日期:" />
                        <TextBlock
                            Margin="20,0"
                            Foreground="White"
                            Text="{Binding SelectPluginItem.ReleaseDate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd}}"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                    <!--  客户端依赖版本  -->
                    <StackPanel Margin="0,10" Orientation="Horizontal">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="客户端依赖版本:" />
                        <TextBlock
                            Margin="20,0"
                            Foreground="White"
                            Text="{Binding SelectPluginItem.ClientVersionDependency, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                    <!--  作者  -->
                    <StackPanel Margin="0,10" Orientation="Horizontal">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="作者:" />
                        <TextBlock
                            Margin="20,0"
                            Foreground="White"
                            Text="{Binding SelectPluginItem.Author, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                    <!--  Bug描述(编辑框)  -->
                    <StackPanel Margin="0,10" Orientation="Vertical">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Bug反馈:" />

                        <TextBox
                            Height="150"
                            Margin="0,20"
                            materialDesign:HintAssist.Hint="请详细描述Bug现象"
                            materialDesign:HintAssist.IsFloating="False"
                            AcceptsReturn="True"
                            BorderBrush="White"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  安装、卸载按钮  -->
                        <Button
                            Width="100"
                            Margin="60,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            Background="#202020"
                            BorderBrush="#202020"
                            Content="提交"
                            Focusable="False"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedLightButton}" />
                    </StackPanel>
                    <!--  Bug提交按钮  -->
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>