<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.SaveImageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="SaveImageSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">

    <Grid Margin="20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="900" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  图片存储根目录  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  图标  -->
            <TextBlock
                Margin="0,0,0,1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="20"
                Foreground="DarkGray"
                Text="&#xe65f;" />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="存图根目录:" />
            <Border
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A696969"
                CornerRadius="5">
                <TextBox
                    Width="300"
                    Height="30"
                    MaxWidth="500"
                    Margin="5,0"
                    materialDesign:TextFieldAssist.HasClearButton="False"
                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="White"
                    IsReadOnly="True"
                    Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </Border>
            <Button
                Width="90"
                MinHeight="30"
                Margin="30,0"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding RefreshCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                <TextBlock
                    Margin="2,1,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CustomFontFamily}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="浏览目录" />
            </Button>
        </StackPanel>
        <!--  存图选项(扫码图、全景图、体积图)  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  类型图标  -->
            <TextBlock
                Margin="0,0,0,1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="20"
                Foreground="DarkGray"
                Text="&#xe865;" />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="存图类型:" />
            <ListBox Style="{StaticResource MaterialDesignFilterChipPrimaryListBox}">
                <ListBoxItem>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="扫码图" />
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="全景图" />
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="WhiteSmoke"
                        Text="体积图" />
                </ListBoxItem>
            </ListBox>
        </StackPanel>
        <!--  是否原图  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Margin="5,5"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="-3,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="25"
                    Foreground="DarkGray"
                    Text="&#xe6cf;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否存原图:" />
                <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="True" />
            </StackPanel>
        </StackPanel>
        <!--  图片质量  -->
        <!--  水印(水印内容[条码、时间、时间戳、重量、长宽高、体积、相机序列号]、水印X位置、水印Y位置、水印大小、水印颜色、水印应用[原图、全景图])  -->
        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Margin="5,5"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="22"
                    Foreground="DarkGray"
                    Text="&#xe6c8;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="水印:" />
            </StackPanel>
            <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否使用水印:" />
                <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="{Binding IsUseWatermark, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseUp">
                            <mvvm:InvokeCommandAction Command="{Binding CheckBoxValueChangedCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </CheckBox>
            </StackPanel>
            <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="水印内容:" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="条码" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="重量" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="扫码时间" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="扫码时间戳" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="长" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="宽" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="高" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="体积" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="相机序列号" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Border
                Margin="50,10,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#1A696969"
                CornerRadius="5">
                <Grid>
                    <Border
                        Width="40"
                        Margin="2"
                        HorizontalAlignment="Left"
                        Background="DarkGray"
                        CornerRadius="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#2E2E2E"
                            Text="内容" />
                    </Border>
                    <ListView
                        Width="680"
                        Height="30"
                        MaxWidth="900"
                        Margin="50,0,0,0"
                        Focusable="False"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectionMode="Extended">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border
                                                x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Background="Transparent" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.Items>

                            <ListViewItem>
                                <Button
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="12"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="相机序列号" />
                                </Button>
                            </ListViewItem>
                            <ListViewItem>
                                <Button
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="12"
                                    Background="DarkGray"
                                    BorderThickness="0"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                    <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="条码" />
                                </Button>
                            </ListViewItem>
                            <ListViewItem>
                                <TextBox
                                    Width="Auto"
                                    Height="18"
                                    MinWidth="20"
                                    MaxWidth="900"
                                    Margin="5,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.IncludeSpellingSuggestions="False"
                                    materialDesign:TextFieldAssist.RippleOnFocusEnabled="False"
                                    materialDesign:TextFieldAssist.TextBoxViewMargin="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </ListViewItem>
                        </ListView.Items>
                    </ListView>
                    <!--  需要使用一个横向List来实现  -->
                    <!--<TextBox
                        Width="680"
                        Height="30"
                        MaxWidth="900"
                        Margin="5,0"
                        Padding="40,0,0,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />-->
                </Grid>
            </Border>
            <!--  水印颜色  -->
            <StackPanel
                Margin="50,10,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="水印颜色:" />
                <Border CornerRadius="15">
                    <materialDesign:ColorPicker
                        Width="300"
                        Height="80"
                        Focusable="False"
                        HueSliderPosition="Bottom"
                        Color="{Binding WatermarkColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="PreviewMouseUp">
                                <mvvm:InvokeCommandAction Command="{Binding ColorPickerValueChangedCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </materialDesign:ColorPicker>
                </Border>
            </StackPanel>
            <!--  水印大小  -->
            <StackPanel
                Margin="50,10,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="水印大小:" />
                <Slider
                    Width="300"
                    Focusable="False"
                    IsMoveToPointEnabled="True"
                    IsSelectionRangeEnabled="True"
                    Maximum="1000"
                    Minimum="20"
                    Value="{Binding WatermarkFontSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseUp">
                            <mvvm:InvokeCommandAction Command="{Binding SliderValueChangedCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Slider>
                <TextBlock
                    Margin="30,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{Binding WatermarkFontSize, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <!--  水印位置  -->
            <StackPanel
                Margin="50,10,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="水印位置:" />
                <ToolBarTray Height="60" Background="Transparent">
                    <ToolBar Background="Transparent">
                        <ListBox SelectedIndex="{Binding WatermarkPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="PreviewMouseUp">
                                    <mvvm:InvokeCommandAction Command="{Binding WatermarkPositionCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                            <ListBoxItem ToolTip="左上角">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="18"
                                    Foreground="#2E2E2E"
                                    Text="&#xe74e;" />
                            </ListBoxItem>
                            <ListBoxItem ToolTip="左下角">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="18"
                                    Foreground="#2E2E2E"
                                    Text="&#xe750;" />
                            </ListBoxItem>
                            <ListBoxItem ToolTip="右上角">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="18"
                                    Foreground="#2E2E2E"
                                    Text="&#xe74d;" />
                            </ListBoxItem>
                            <ListBoxItem ToolTip="右下角">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="18"
                                    Foreground="#2E2E2E"
                                    Text="&#xe74f;" />
                            </ListBoxItem>
                        </ListBox>
                    </ToolBar>
                </ToolBarTray>
            </StackPanel>
        </StackPanel>
        <!--  文件夹模板  -->
        <StackPanel
            Grid.Row="4"
            Grid.Column="0"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="18"
                    Foreground="DarkGray"
                    Text="&#xe89f;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="子路径:" />
            </StackPanel>
            <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="子路径:" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="存图类型" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="年份" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="月份" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="日期" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="小时" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="相机序列号" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Border
                Margin="50,10,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#1A696969"
                CornerRadius="5">
                <Grid>
                    <Border
                        Width="40"
                        Margin="2"
                        HorizontalAlignment="Left"
                        Background="DarkGray"
                        CornerRadius="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#2E2E2E"
                            Text="根目录" />
                    </Border>
                    <TextBox
                        Width="680"
                        Height="30"
                        MaxWidth="900"
                        Margin="5,0"
                        Padding="40,0,0,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Grid>
            </Border>
        </StackPanel>
        <!--  图片名模板  -->
        <StackPanel
            Grid.Row="5"
            Grid.Column="0"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="18"
                    Foreground="DarkGray"
                    Text="&#xe705;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="图片命名:" />
            </StackPanel>
            <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="命名包含:" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="条码" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="重量" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="扫码时间" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="扫码时间戳" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="长" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="宽" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="高" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="体积" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="5,0"
                        materialDesign:ButtonAssist.CornerRadius="15"
                        Background="DarkGray"
                        BorderThickness="0"
                        Focusable="False"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="相机序列号" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Border
                Margin="50,10,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#1A696969"
                CornerRadius="5">
                <Grid>
                    <Border
                        Width="40"
                        Margin="2"
                        HorizontalAlignment="Left"
                        Background="DarkGray"
                        CornerRadius="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#2E2E2E"
                            Text="图片名" />
                    </Border>
                    <TextBox
                        Width="680"
                        Height="30"
                        MaxWidth="900"
                        Margin="5,0"
                        Padding="40,0,0,0"
                        materialDesign:TextFieldAssist.HasClearButton="False"
                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Grid>
            </Border>
        </StackPanel>
        <!--  FTP上传  -->
        <StackPanel
            Grid.Row="6"
            Grid.Column="0"
            Margin="5,0"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="20"
                    Foreground="DarkGray"
                    Text="&#xe6c9;" />
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="FTP上传:" />
            </StackPanel>
            <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="是否开启上传:" />
                <CheckBox materialDesign:CheckBoxAssist.CheckBoxSize="20" IsChecked="True" />
            </StackPanel>
            <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                <!--  IP地址  -->
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="IP地址:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="150"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  端口号  -->
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="端口号:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="60"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  用户名  -->
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="用户名:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="80"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  密码  -->
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="密码:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="80"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
                <!--  超时时间  -->
                <StackPanel Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="超时时间:" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="60"
                            Height="30"
                            MaxWidth="500"
                            Margin="5,0"
                            materialDesign:HintAssist.Hint="(毫秒)ms"
                            materialDesign:TextFieldAssist.HasClearButton="False"
                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <!--  保存按钮  -->
        <Button
            Grid.Row="7"
            Grid.Column="0"
            Width="90"
            MinHeight="30"
            Margin="30,0"
            HorizontalAlignment="Left"
            materialDesign:ButtonAssist.CornerRadius="5"
            Background="#2E2E2E"
            BorderThickness="0"
            Command="{Binding RefreshCommand}"
            FocusVisualStyle="{x:Null}"
            Style="{StaticResource MaterialDesignFlatAccentBgButton}">
            <TextBlock
                Margin="2,1,0,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource CustomFontFamily}"
                FontSize="14"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="保存设置" />
        </Button>

        <!--  右边图片  -->
        <Border
            Name="ImageBorder"
            Grid.Row="0"
            Grid.RowSpan="6"
            Grid.Column="1"
            MaxHeight="650"
            CornerRadius="10">
            <Border.Clip>
                <RectangleGeometry RadiusX="10" RadiusY="10">
                    <RectangleGeometry.Rect>
                        <MultiBinding Converter="{StaticResource RectConverter}">
                            <Binding
                                ElementName="ImageBorder"
                                Path="ActualWidth"
                                UpdateSourceTrigger="PropertyChanged" />
                            <Binding
                                ElementName="ImageBorder"
                                Path="ActualHeight"
                                UpdateSourceTrigger="PropertyChanged" />
                        </MultiBinding>
                    </RectangleGeometry.Rect>
                </RectangleGeometry>
            </Border.Clip>
            <Image Source="{Binding ImageSource, UpdateSourceTrigger=PropertyChanged}" />
        </Border>
        <!--  加载图片  -->
        <StackPanel
            Grid.Row="6"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  图标  -->
            <TextBlock
                Margin="0,0,0,1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="20"
                Foreground="DarkGray"
                Text="&#xe65f;" />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="测试图片路径:" />
            <Border
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A696969"
                CornerRadius="5">
                <TextBox
                    Width="230"
                    Height="30"
                    MaxWidth="500"
                    Margin="5,0"
                    materialDesign:TextFieldAssist.HasClearButton="False"
                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="White"
                    IsReadOnly="True"
                    Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </Border>
            <Button
                Width="90"
                MinHeight="30"
                Margin="5,0"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding RefreshCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                <TextBlock
                    Margin="2,1,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CustomFontFamily}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="加载图片" />
            </Button>
            <Button
                Width="90"
                MinHeight="30"
                Margin="5,0"
                HorizontalAlignment="Left"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding RefreshCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">
                <TextBlock
                    Margin="2,1,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CustomFontFamily}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="预览水印" />
            </Button>
        </StackPanel>
        <!--  预览水印  -->
    </Grid>
</Page>