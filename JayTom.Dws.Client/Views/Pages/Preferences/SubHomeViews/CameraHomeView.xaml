<UserControl
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.SubHomeViews.CameraHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.SubHomeViews"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:JayTom.Dws.Client.Models"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="CameraHomeControlView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="CameraHomeControlView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <cameraConverter:CameraTypeConverter x:Key="CameraTypeConverter" />
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">

        <!--  隐藏的列表  -->
        <ListBox
            Width="Auto"
            MaxWidth="50"
            Margin="0,10"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Focusable="False"
            ItemsSource="{Binding HiddenCameraItems, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            Style="{StaticResource CustomListBoxStyle}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:CameraItemInfoModel}">

                    <Button
                        Width="40"
                        Height="40"
                        Margin="0,5"
                        Padding="0"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Background="#2E2E2E"
                        BorderThickness="0"
                        Command="{Binding ShowCommand}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#iconfont"
                            FontSize="25"
                            Foreground="White"
                            Opacity="0.8"
                            Text="{Binding Type, Mode=OneWay, Converter={StaticResource CameraTypeConverter}, ConverterParameter=Font}">
                            <TextBlock.ToolTip>
                                <TextBlock>
                                    <Run Text="{Binding Type, Mode=OneWay, Converter={StaticResource CameraTypeConverter}, ConverterParameter=ToolTip}" />
                                    <Run Text="{Binding SerialNumber, Mode=OneWay}" />
                                </TextBlock>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--  显示的列表  -->
        <ListBox
            Name="CameraListBox"
            Width="860"
            MinWidth="600"
            MaxWidth="900"
            Margin="0,10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Focusable="False"
            ItemTemplate="{StaticResource CameraTemplate}"
            ItemsSource="{Binding CameraItems, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            Style="{StaticResource CustomListBoxStyle}">
            <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <ScrollViewer Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="False">
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <WrapPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Focusable="False"
                            IsItemsHost="True"
                            Orientation="Horizontal"
                            ScrollViewer.CanContentScroll="True" />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>
    </StackPanel>
</UserControl>
