<UserControl
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.SubHomeViews.NvrPreviewHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cameraConfiguration="clr-namespace:JayTom.Dws.Client.Models.Cameras.CameraConfiguration"
    xmlns:cameraConverter="clr-namespace:JayTom.Dws.Client.Converters.CameraConverter"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.SubHomeViews"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BorderClipMultiConverter x:Key="BorderClipMultiConverter" />
        <Style
            x:Key="MaterialDesignActionButtonStyle"
            BasedOn="{StaticResource MaterialDesignFloatingActionButton}"
            TargetType="Button">
            <Setter Property="materialDesign:ButtonProgressAssist.Value" Value="-1" />
            <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="False" />
            <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="False" />
            <Setter Property="Background" Value="DimGray" />
            <Setter Property="BorderBrush" Value="DimGray" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="5,0" />
            <Style.Triggers>
                <!--  Trigger for when the button is pressed  -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="True" />
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="True" />
                </Trigger>

                <!--  Trigger for when the button is not pressed  -->
                <Trigger Property="IsPressed" Value="False">
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndeterminate" Value="False" />
                    <Setter Property="materialDesign:ButtonProgressAssist.IsIndicatorVisible" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <cameraConverter:NvrPreviewViewSizeConverter x:Key="NvrPreviewViewSizeConverter" />
        <converters:EnumToVisibilityInvertedConverter x:Key="EnumToVisibilityInvertedConverter" />
    </UserControl.Resources>
    <ListBox
        MinWidth="449"
        MinHeight="253"
        MaxWidth="1122"
        MaxHeight="760"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Focusable="False"
        ItemsSource="{Binding NvrPreviewViewItems, UpdateSourceTrigger=PropertyChanged}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        Style="{StaticResource CustomListBoxStyle}">
        <ListBox.Clip>
            <MultiBinding Converter="{StaticResource BorderClipMultiConverter}">
                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                <Binding>
                    <Binding.Source>
                        <CornerRadius>8</CornerRadius>
                    </Binding.Source>
                </Binding>
            </MultiBinding>
        </ListBox.Clip>

        <ListBox.Template>
            <ControlTemplate TargetType="{x:Type ListBox}">
                <ScrollViewer Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <WrapPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Focusable="False"
                        IsItemsHost="True"
                        Orientation="Horizontal"
                        ScrollViewer.CanContentScroll="True" />
                </ScrollViewer>
            </ControlTemplate>
        </ListBox.Template>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type cameraConfiguration:NvrPreviewViewItemInfo}">

                <Grid Name="PreviewViewGrid" Visibility="{Binding ScreenState, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToVisibilityInvertedConverter}, ConverterParameter=Hidden}">
                    <!--  默认底图  -->
                    <Border
                        Grid.Row="0"
                        Width="449"
                        Height="253">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#iconfont"
                            FontSize="150"
                            Foreground="DimGray"
                            IsEnabled="False"
                            Text="&#xe8da;"
                            Visibility="{Binding IsShow, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Border>
                    <!--  画面  -->
                    <Image
                        Grid.Row="0"
                        RenderOptions.BitmapScalingMode="LowQuality"
                        Source="{Binding VideoFrame, UpdateSourceTrigger=PropertyChanged}"
                        Stretch="Uniform"
                        Visibility="{Binding IsShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScreenState}" Value="Maximized">
                                        <Setter Property="Width" Value="{Binding MaxSize.Width, UpdateSourceTrigger=PropertyChanged}" />
                                        <Setter Property="Height" Value="{Binding MaxSize.Height, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScreenState}" Value="Normal">
                                        <Setter Property="Width">
                                            <Setter.Value>
                                                <Binding
                                                    Converter="{StaticResource NvrPreviewViewSizeConverter}"
                                                    ConverterParameter="Width"
                                                    FallbackValue="200"
                                                    Path="Items.Count"
                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}"
                                                    UpdateSourceTrigger="PropertyChanged" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Height">
                                            <Setter.Value>
                                                <Binding
                                                    Converter="{StaticResource NvrPreviewViewSizeConverter}"
                                                    ConverterParameter="Height"
                                                    FallbackValue="150"
                                                    Path="Items.Count"
                                                    RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}"
                                                    UpdateSourceTrigger="PropertyChanged" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                        <Image.InputBindings>
                            <MouseBinding
                                Command="{Binding ToggleImageSizeCommand}"
                                CommandParameter="{Binding}"
                                Gesture="LeftDoubleClick" />
                        </Image.InputBindings>
                    </Image>
                    <!--  右下角通道  -->
                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="SpringGreen"
                        Text="{Binding ChannelNumber, StringFormat='通道{0}'}" />

                    <!--  工具栏  -->
                    <Border
                        x:Name="ToolBarContainer"
                        Height="90"
                        Margin="0"
                        Padding="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#88202020"
                        CornerRadius="10,10,0,0"
                        Visibility="{Binding ElementName=PreviewViewGrid, Path=IsMouseOver, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                            <!--  自动对焦  -->
                            <Button
                                Width="40"
                                Height="40"
                                materialDesign:RippleAssist.ClipToBounds="True"
                                materialDesign:RippleAssist.RippleOnTop="True"
                                Background="DimGray"
                                Command="{Binding AutoFocusCommand}"
                                Cursor="Hand"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="自动对焦">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="25"
                                    Foreground="White"
                                    Text="&#xe9e3;" />
                            </Button>
                            <StackPanel Margin="10,0" Orientation="Vertical">
                                <StackPanel Margin="0,5" Orientation="Horizontal">
                                    <!--  缩放  -->
                                    <TextBlock
                                        Margin="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="13"
                                        FontWeight="Light"
                                        Foreground="White"
                                        IsEnabled="True"
                                        Text="缩放:"
                                        TextAlignment="Justify" />
                                    <Button
                                        Width="25"
                                        Height="25"
                                        Content="+"
                                        Style="{StaticResource MaterialDesignActionButtonStyle}">
                                        <b:Interaction.Triggers>
                                            <!--  PreviewMouseDown Event  -->
                                            <b:EventTrigger EventName="PreviewMouseDown">
                                                <b:InvokeCommandAction Command="{Binding IncreaseZoomCommand}" CommandParameter="Start" />
                                            </b:EventTrigger>

                                            <!--  PreviewMouseUp Event  -->
                                            <b:EventTrigger EventName="PreviewMouseUp">
                                                <b:InvokeCommandAction Command="{Binding IncreaseZoomCommand}" CommandParameter="Stop" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </Button>
                                    <Button
                                        Width="25"
                                        Height="25"
                                        Content="-"
                                        Style="{StaticResource MaterialDesignActionButtonStyle}">
                                        <b:Interaction.Triggers>
                                            <!--  PreviewMouseDown Event  -->
                                            <b:EventTrigger EventName="PreviewMouseDown">
                                                <b:InvokeCommandAction Command="{Binding DecreaseZoomCommand}" CommandParameter="Start" />
                                            </b:EventTrigger>

                                            <!--  PreviewMouseUp Event  -->
                                            <b:EventTrigger EventName="PreviewMouseUp">
                                                <b:InvokeCommandAction Command="{Binding DecreaseZoomCommand}" CommandParameter="Stop" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </Button>
                                </StackPanel>
                                <StackPanel Margin="0,5" Orientation="Horizontal">
                                    <!--  焦距  -->
                                    <TextBlock
                                        Margin="5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="13"
                                        FontWeight="Light"
                                        Foreground="White"
                                        IsEnabled="True"
                                        Text="焦距:"
                                        TextAlignment="Justify" />
                                    <Button
                                        Width="25"
                                        Height="25"
                                        Content="+"
                                        Style="{StaticResource MaterialDesignActionButtonStyle}">
                                        <b:Interaction.Triggers>
                                            <!--  PreviewMouseDown Event  -->
                                            <b:EventTrigger EventName="PreviewMouseDown">
                                                <b:InvokeCommandAction Command="{Binding IncreaseFocusCommand}" CommandParameter="Start" />
                                            </b:EventTrigger>

                                            <!--  PreviewMouseUp Event  -->
                                            <b:EventTrigger EventName="PreviewMouseUp">
                                                <b:InvokeCommandAction Command="{Binding IncreaseFocusCommand}" CommandParameter="Stop" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </Button>
                                    <Button
                                        Width="25"
                                        Height="25"
                                        Content="-"
                                        Style="{StaticResource MaterialDesignActionButtonStyle}">
                                        <b:Interaction.Triggers>
                                            <!--  PreviewMouseDown Event  -->
                                            <b:EventTrigger EventName="PreviewMouseDown">
                                                <b:InvokeCommandAction Command="{Binding DecreaseFocusCommand}" CommandParameter="Start" />
                                            </b:EventTrigger>

                                            <!--  PreviewMouseUp Event  -->
                                            <b:EventTrigger EventName="PreviewMouseUp">
                                                <b:InvokeCommandAction Command="{Binding DecreaseFocusCommand}" CommandParameter="Stop" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>