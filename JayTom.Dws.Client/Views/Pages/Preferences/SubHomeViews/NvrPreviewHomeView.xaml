<UserControl
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.SubHomeViews.NvrPreviewHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cameraConfiguration="clr-namespace:JayTom.Dws.Client.Models.Cameras.CameraConfiguration"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences.SubHomeViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BorderClipMultiConverter x:Key="BorderClipMultiConverter" />
    </UserControl.Resources>
    <ListBox
        MinWidth="449"
        MinHeight="253"
        MaxWidth="1122"
        MaxHeight="760"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Background="DarkViolet"
        Focusable="False"
        ItemsSource="{Binding NvrPreviewViewItems, UpdateSourceTrigger=PropertyChanged}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        Style="{StaticResource CustomListBoxStyle}">
        <ListBox.Clip>
            <MultiBinding Converter="{StaticResource BorderClipMultiConverter}">
                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                <Binding>
                    <Binding.Source>
                        <CornerRadius>8</CornerRadius>
                    </Binding.Source>
                </Binding>
            </MultiBinding>
        </ListBox.Clip>

        <ListBox.Template>
            <ControlTemplate TargetType="{x:Type ListBox}">
                <ScrollViewer Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <WrapPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Focusable="False"
                        IsItemsHost="True"
                        Orientation="Horizontal"
                        ScrollViewer.CanContentScroll="True" />
                </ScrollViewer>
            </ControlTemplate>
        </ListBox.Template>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type cameraConfiguration:NvrPreviewViewItemInfo}">

                <Grid>
                    <!--  默认底图  -->
                    <Border
                        Grid.Row="0"
                        Width="449"
                        Height="253">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="pack://application:,,,/Fonts/#iconfont"
                            FontSize="150"
                            Foreground="DimGray"
                            IsEnabled="False"
                            Text="&#xe8da;"
                            Visibility="{Binding IsShow, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Border>
                    <!--  画面  -->
                    <Image
                        Grid.Row="0"
                        Width="449"
                        Height="253"
                        RenderOptions.BitmapScalingMode="LowQuality"
                        Source="{Binding VideoFrame, UpdateSourceTrigger=PropertyChanged}"
                        Stretch="Uniform"
                        Visibility="{Binding IsShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!--  右下角通道  -->
                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="SpringGreen"
                        Text="{Binding ChannelId, StringFormat='通道{0}'}" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>