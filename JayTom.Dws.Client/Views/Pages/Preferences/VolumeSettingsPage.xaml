<!--  体积设置  -->
<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.VolumeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataTemplateSelectors="clr-namespace:JayTom.Dws.Client.DataTemplateSelectors"
    xmlns:imageSettingModels="clr-namespace:JayTom.Dws.Client.Models.ImageSettingModels"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="VolumeSettingsView"
    Title="VolumeSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <settingsConverter:TcpConnectionModeToBooleanConverter x:Key="TcpConnectionModeToBooleanConverter" />
        <settingsConverter:VolumeRequesterTypeToBooleanConverter x:Key="VolumeRequesterTypeToBooleanConverter" />
        <settingsConverter:ShortcutMacroConverter x:Key="ShortcutMacroConverter" />
        <DataTemplate x:Key="ImageSettingButtonTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="DodgerBlue"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSettingsView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content, Converter={StaticResource ShortcutMacroConverter}}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type imageSettingModels:ItemBaseTemplateModel}">
            <Button
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                materialDesign:ButtonAssist.CornerRadius="12"
                Background="BlueViolet"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveTemplateItemCommand, ElementName=VolumeSettingsView}"
                CommandParameter="{Binding}"
                Focusable="False"
                Foreground="White"
                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="{Binding Content}" />
            </Button>
        </DataTemplate>
        <dataTemplateSelectors:ImageSettingItemDataTemplateSelectors
            x:Key="VolumeDataTemplateSelectors"
            ButtonTemplate="{StaticResource ImageSettingButtonTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </Page.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="VolumeSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="ResultOutputSettingsDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  最外层设置参数  -->
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <!--  输入模板  -->
                <StackPanel
                    Margin="5,0"
                    VerticalAlignment="Top"
                    Orientation="Vertical">
                    <!--  输入模板  -->
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe738;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="输入模板:" />
                    </StackPanel>
                    <StackPanel Margin="50,10,0,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="输出数据:" />
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOutputItemCommand}"
                                CommandParameter="'{Length}'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="长" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOutputItemCommand}"
                                CommandParameter="'{Width}'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="宽" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOutputItemCommand}"
                                CommandParameter="'{Height}'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="高" />
                            </Button>
                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOutputItemCommand}"
                                CommandParameter="'{Volume}'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="体积" />
                            </Button>
                            <Border Background="BlueViolet" CornerRadius="15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox
                                        Width="40"
                                        Height="30"
                                        MaxWidth="40"
                                        Margin="15,0,0,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding VolumeSettingsInfo.Separator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        TextAlignment="Center" />
                                    <Border
                                        Width="1"
                                        Height="20"
                                        BorderBrush="White"
                                        BorderThickness="1" />
                                    <Button
                                        Width="70"
                                        Height="30"
                                        Margin="0,0"
                                        Padding="0"
                                        materialDesign:ButtonAssist.CornerRadius="0,15,15,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding AddSeparatorItemCommand}"
                                        CommandParameter="{Binding VolumeSettingsInfo.Separator}"
                                        Focusable="False"
                                        Foreground="White"
                                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                        <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="分隔符" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button
                                Height="30"
                                Margin="5,0"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="DarkGray"
                                BorderThickness="0"
                                Command="{Binding AddOutputItemCommand}"
                                CommandParameter="'{null}'"
                                Focusable="False"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                <TextBlock FontFamily="{StaticResource CustomFontFamily}" Text="补位变量" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Margin="50,10,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <Grid>
                            <Border
                                Width="40"
                                Margin="2"
                                HorizontalAlignment="Left"
                                Background="DarkGray"
                                CornerRadius="5">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CustomFontFamily}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#2E2E2E"
                                    Text="内容" />
                            </Border>
                            <ListView
                                Width="710"
                                Height="30"
                                MaxWidth="900"
                                Margin="50,0,0,0"
                                Focusable="False"
                                ItemTemplateSelector="{StaticResource VolumeDataTemplateSelectors}"
                                ItemsSource="{Binding VolumeSettingsInfo.DataTemplate, UpdateSourceTrigger=PropertyChanged}"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                SelectionMode="Extended">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border
                                                        x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Background="Transparent" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
                <!--  Tcp输入  -->
                <StackPanel
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe62f;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="Tcp输入:" />
                        <ToggleButton
                            Name="TcpToggleButton"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Focusable="False"
                            IsChecked="{Binding VolumeSettingsInfo.IsUseTcpInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel
                        Margin="50,5,0,0"
                        IsEnabled="{Binding ElementName=TcpToggleButton, Path=IsChecked}"
                        Orientation="Horizontal"
                        Visibility="{Binding ElementName=TcpToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel Orientation="Vertical">
                            <!--  使用Tcp服务端  -->
                            <RadioButton
                                Content="使用Tcp服务端"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding VolumeSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Server}"
                                Style="{StaticResource MaterialDesignRadioButton}" />
                            <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="IP地址:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            IsReadOnly="True"
                                            Text="{Binding VolumeSettingsInfo.TcpSettingsInfo.ServerConfig.IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="端口:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding VolumeSettingsInfo.TcpSettingsInfo.ServerConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <!--  使用Tcp客户端  -->
                            <RadioButton
                                Content="使用Tcp客户端"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding VolumeSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Client}"
                                Style="{StaticResource MaterialDesignRadioButton}" />
                            <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="IP地址:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False">
                                            <TextBox.Text>
                                                <Binding
                                                    Mode="TwoWay"
                                                    Path="VolumeSettingsInfo.TcpSettingsInfo.ClientConfig.IpAddress"
                                                    UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="端口:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="80"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding VolumeSettingsInfo.TcpSettingsInfo.ClientConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!--  是否主动触发体积获取  -->
                <StackPanel
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe808;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="是否主动触发体积获取:" />
                        <ToggleButton
                            Name="IsTriggerVolumeRequestToggleButton"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Focusable="False"
                            IsChecked="{Binding VolumeSettingsInfo.IsTriggerVolumeRequest, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel
                        Margin="50,5,0,0"
                        IsEnabled="{Binding ElementName=IsTriggerVolumeRequestToggleButton, Path=IsChecked}"
                        Orientation="Vertical"
                        Visibility="{Binding ElementName=IsTriggerVolumeRequestToggleButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!--  触发位置  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="触发位置:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="140"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    DisplayMemberPath="Name"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding VolumeTriggerPositionItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectTriggerPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  发送延迟  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="发送延迟:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="130"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.SendDelay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                        <!--  发送内容  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="发送内容:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="130"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.SendContent, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                        <!--  发送类型  -->
                        <StackPanel>
                            <!--  Tcp触发  -->
                            <RadioButton
                                Name="IsUseTcpSendRadioButton"
                                Margin="0,5"
                                Content="使用Tcp触发"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.VolumeRequesterType, Converter={StaticResource VolumeRequesterTypeToBooleanConverter}, ConverterParameter=Tcp, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignRadioButton}" />
                            <StackPanel
                                Margin="50,5,0,0"
                                IsEnabled="{Binding ElementName=IsUseTcpSendRadioButton, Path=IsChecked}"
                                Orientation="Horizontal"
                                Visibility="{Binding ElementName=IsUseTcpSendRadioButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <StackPanel Orientation="Vertical">
                                    <!--  使用Tcp服务端  -->
                                    <RadioButton
                                        Content="使用Tcp服务端"
                                        Focusable="False"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        IsChecked="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Server}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                    <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="IP地址:" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="80"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    IsReadOnly="True"
                                                    Text="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.TcpSettingsInfo.ServerConfig.IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="端口:" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="80"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.TcpSettingsInfo.ServerConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <!--  使用Tcp客户端  -->
                                    <RadioButton
                                        Content="使用Tcp客户端"
                                        Focusable="False"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        IsChecked="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Client}"
                                        Style="{StaticResource MaterialDesignRadioButton}" />
                                    <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="IP地址:" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="80"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False">
                                                    <TextBox.Text>
                                                        <Binding
                                                            Mode="TwoWay"
                                                            Path="VolumeSettingsInfo.VolumeInformationRequesterInfo.TcpSettingsInfo.ClientConfig.IpAddress"
                                                            UpdateSourceTrigger="PropertyChanged">
                                                            <Binding.ValidationRules>
                                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!--  图标  -->
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="DarkGray"
                                                Text="端口:" />
                                            <Border
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1A696969"
                                                CornerRadius="5">
                                                <TextBox
                                                    Width="80"
                                                    Height="30"
                                                    MaxWidth="500"
                                                    Margin="5,0"
                                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.TcpSettingsInfo.ClientConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <!--  串口触发  -->
                            <RadioButton
                                Name="IsUseSerialPortSendRadioButton"
                                Margin="0,5"
                                Content="使用串口触发"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                IsChecked="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.VolumeRequesterType, Converter={StaticResource VolumeRequesterTypeToBooleanConverter}, ConverterParameter=SerialPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignRadioButton}" />
                            <StackPanel
                                Margin="50,5,0,0"
                                IsEnabled="{Binding ElementName=IsUseSerialPortSendRadioButton, Path=IsChecked}"
                                Orientation="Vertical"
                                Visibility="{Binding ElementName=IsUseSerialPortSendRadioButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <!--  串口名、刷新按钮  -->
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="串口名:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <ComboBox
                                            Height="30"
                                            MinWidth="130"
                                            Padding="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            materialDesign:ColorZoneAssist.Mode="Dark"
                                            BorderThickness="0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            ItemsSource="{Binding PortItems, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.SerialPortSettingsInfo.PortName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            Style="{StaticResource MaterialDesignComboBox}" />
                                    </Border>
                                    <Button
                                        Width="50"
                                        MinHeight="30"
                                        Margin="5,0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        materialDesign:ButtonAssist.CornerRadius="5"
                                        Background="#2E2E2E"
                                        BorderThickness="0"
                                        Command="{Binding PortUpdateCommand}"
                                        FocusVisualStyle="{x:Null}"
                                        Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource IconFontFamily}"
                                                FontSize="18"
                                                Foreground="DarkGray"
                                                Text="&#xe69a;" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!--  波特率  -->
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="波特率:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <ComboBox
                                            Height="30"
                                            MinWidth="190"
                                            Padding="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            materialDesign:ColorZoneAssist.Mode="Dark"
                                            BorderThickness="0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            ItemsSource="{Binding BaudRateItems, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.SerialPortSettingsInfo.BaudRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            Style="{StaticResource MaterialDesignComboBox}" />
                                    </Border>
                                </StackPanel>
                                <!--  数据位  -->
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="数据位:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <ComboBox
                                            Height="30"
                                            MinWidth="190"
                                            Padding="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            materialDesign:ColorZoneAssist.Mode="Dark"
                                            BorderThickness="0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            ItemsSource="{Binding DataBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding VolumeSettingsInfo.VolumeInformationRequesterInfo.SerialPortSettingsInfo.DataBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            Style="{StaticResource MaterialDesignComboBox}" />
                                    </Border>
                                </StackPanel>
                                <!--  效验位  -->
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="效验位:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <ComboBox
                                            Height="30"
                                            MinWidth="190"
                                            Padding="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            materialDesign:ColorZoneAssist.Mode="Dark"
                                            BorderThickness="0"
                                            DisplayMemberPath="Name"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            ItemsSource="{Binding ParityItems, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding SelectParity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource MaterialDesignComboBox}" />
                                    </Border>
                                </StackPanel>
                                <!--  停止位  -->
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="停止位:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <ComboBox
                                            Height="30"
                                            MinWidth="190"
                                            Padding="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            materialDesign:ColorZoneAssist.Mode="Dark"
                                            BorderThickness="0"
                                            DisplayMemberPath="Name"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            ItemsSource="{Binding StopBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding SelectStopBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource MaterialDesignComboBox}" />
                                    </Border>
                                </StackPanel>
                                <!--  数据格式  -->
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="格  式:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <ComboBox
                                            Height="30"
                                            MinWidth="190"
                                            Padding="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            materialDesign:ColorZoneAssist.Mode="Dark"
                                            BorderThickness="0"
                                            DisplayMemberPath="Name"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            ItemsSource="{Binding DataFormatTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedItem="{Binding SelectDataFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource MaterialDesignComboBox}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <!--  保存按钮  -->
            <Button
                Grid.Row="2"
                Grid.Column="0"
                Width="110"
                Height="Auto"
                MinHeight="30"
                Margin="30,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding SaveSettingsCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe66e;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="保存设置" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                    <ProgressBar
                        Name="StatusProgressBar"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Value="0">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Button>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding VolumeSettingsMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>