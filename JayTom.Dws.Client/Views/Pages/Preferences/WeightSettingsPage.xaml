<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.WeightSettingPages"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attributeConverters="clr-namespace:JayTom.Dws.Client.Converters.AttributeConverters"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:JayTom.Dws.Client.Extensions"
    xmlns:languages="clr-namespace:JayTom.Dws.Client.Languages"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    xmlns:validationRules="clr-namespace:JayTom.Dws.Client.ValidationRules"
    Name="WeightSettingsView"
    Title="WeightSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    Template="{StaticResource SettingsPageTemplate}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Page.Resources>
        <settingsConverter:WeightModeToVisibilityConverter x:Key="WeightModeToVisibilityConverter" />
        <settingsConverter:WeightAccessToVisibilityConverter x:Key="WeightAccessToVisibilityConverter" />
        <attributeConverters:EnumAttributeConverter x:Key="EnumAttributeConverter" />
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <settingsConverter:TcpConnectionModeToBooleanConverter x:Key="TcpConnectionModeToBooleanConverter" />
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <!--  左边  -->
        <Border Grid.Column="0">
            <StackPanel
                Margin="5,0"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe6e7;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.WeighingMode}" />
                </StackPanel>
                <!--  称重模式  -->
                <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                    <!--  图标  -->
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.WeighingMode}" />
                    <Border
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <ComboBox
                            Height="30"
                            MinWidth="160"
                            Padding="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="15"
                            materialDesign:ColorZoneAssist.Mode="Dark"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            ItemsSource="{Binding WeightModeItems, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectWeightMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Value"
                            Style="{StaticResource MaterialDesignComboBox}" />
                    </Border>
                </StackPanel>
                <!--  连接参数  -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe75e;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.StandardConnectionParameters}" />
                </StackPanel>

                <StackPanel
                    Margin="50,5,0,0"
                    Orientation="Vertical"
                    Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                    <!--  连接模式  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="通讯类型:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#2E2E2E"
                            CornerRadius="5">
                            <ComboBox
                                Name="CommunicationsTypeComboBox"
                                Height="30"
                                MinWidth="160"
                                Padding="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                materialDesign:ColorZoneAssist.Mode="Dark"
                                BorderThickness="0"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                ItemsSource="{Binding ScaleCommunicationModeItem, UpdateSourceTrigger=PropertyChanged}"
                                SelectedItem="{Binding WeightSettingsInfo.ScaleCommunicationMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignComboBox}" />
                        </Border>
                    </StackPanel>

                    <!--  串口  -->
                    <StackPanel Orientation="Vertical" Visibility="{Binding WeightSettingsInfo.ScaleCommunicationMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SerialPort}">
                        <!--  串口名、刷新按钮  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.SerialPortName}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="130"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding PortItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.PortName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                            <Button
                                Width="50"
                                MinHeight="30"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Background="#2E2E2E"
                                BorderThickness="0"
                                Command="{Binding PortUpdateCommand}"
                                FocusVisualStyle="{x:Null}"
                                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="DarkGray"
                                        Text="&#xe69a;" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!--  波特率  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.BaudRate}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding BaudRateItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.BaudRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  数据位  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.DataBits}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding DataBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.DataBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  效验位  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.ParityBit}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding ParityItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.Parity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  停止位  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.StopBits}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding StopBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.StopBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  数据格式  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.DataFormat}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding DataFormatTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.DataFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  TCP  -->
                    <StackPanel Orientation="Vertical" Visibility="{Binding WeightSettingsInfo.ScaleCommunicationMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TCP}">
                        <!--  使用Tcp服务端  -->
                        <RadioButton
                            Name="IsUseServerRadioButton"
                            Content="{x:Static languages:Language.IsUseTCPServer}"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            IsChecked="{Binding WeightSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Server}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <StackPanel
                            Margin="50,0,0,0"
                            IsEnabled="{Binding ElementName=IsUseServerRadioButton, Path=IsChecked}"
                            Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.IPAddress}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#2E2E2E"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="100"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        IsReadOnly="True"
                                        Text="{Binding WeightSettingsInfo.TcpSettingsInfo.ServerConfig.IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.Port}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#2E2E2E"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="80"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.TcpSettingsInfo.ServerConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <!--  使用Tcp客户端  -->
                        <RadioButton
                            Name="IsUseClientRadioButton"
                            Content="{x:Static languages:Language.IsUseTCPClient}"
                            Focusable="False"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            IsChecked="{Binding WeightSettingsInfo.TcpSettingsInfo.ConnectionMode, Converter={StaticResource TcpConnectionModeToBooleanConverter}, ConverterParameter=Client}"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <StackPanel
                            Margin="50,0,0,0"
                            IsEnabled="{Binding ElementName=IsUseClientRadioButton, Path=IsChecked}"
                            Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.IPAddress}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#2E2E2E"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="100"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False">
                                        <TextBox.Text>
                                            <Binding
                                                Mode="TwoWay"
                                                Path="WeightSettingsInfo.TcpSettingsInfo.ClientConfig.IpAddress"
                                                UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <validationRules:RegexValidationRule ErrorMessage="请输入有效的 IP 地址" Pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="{x:Static languages:Language.Port}" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#2E2E2E"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="80"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.TcpSettingsInfo.ClientConfig.Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <!--  数据格式  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.DataFormat}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#2E2E2E"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding DataFormatTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding CommunicationConnectionItem.TcpConnectionConfigInfo.DataFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <!--  连接参数  -->
                </StackPanel>

                <Rectangle
                    Height="1"
                    Margin="30,5"
                    Opacity="0.15"
                    Stroke="DimGray"
                    StrokeDashArray="10 10"
                    StrokeThickness="1"
                    Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}" />
                <!--  重量设置参数  -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe645;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.WeightSettingParameters}" />
                </StackPanel>
                <!--  最小最大重量  -->
                <StackPanel
                    Margin="50,5,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.MinUsableWeight}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False">
                                    <TextBox.Text>
                                        <Binding
                                            Mode="TwoWay"
                                            Path="WeightSettingsInfo.CommonWeight.MinWeight"
                                            UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的浮点数" Pattern="^\d+(\.\d+)?$" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.MaxUsableWeight}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="78"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False">
                                    <TextBox.Text>
                                        <Binding
                                            Mode="TwoWay"
                                            Path="WeightSettingsInfo.CommonWeight.MaxWeight"
                                            UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的浮点数" Pattern="^\d+(\.\d+)?$" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Border>
