<Page
    x:Class="JayTom.Dws.Client.Views.Pages.Preferences.WeightSettingPages"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views.Pages.Preferences"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:settingsConverter="clr-namespace:JayTom.Dws.Client.Converters.SettingsConverter"
    Name="WeightSettingsView"
    Title="WeightSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="WeightSettingsView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Page.Resources>
        <settingsConverter:WeightModeToVisibilityConverter x:Key="WeightModeToVisibilityConverter" />
        <settingsConverter:WeightAccessToVisibilityConverter x:Key="WeightAccessToVisibilityConverter" />
    </Page.Resources>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="ResultOutputSettingsDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>
            <!--  左边  -->
            <Border Grid.Column="0">
                <StackPanel
                    Margin="5,0"
                    VerticalAlignment="Top"
                    Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe6e7;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="称重模式:" />
                    </StackPanel>
                    <!--  称重模式  -->
                    <StackPanel Margin="50,5,0,0" Orientation="Horizontal">
                        <!--  图标  -->
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="称重模式:" />
                        <Border
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A696969"
                            CornerRadius="5">
                            <ComboBox
                                Height="30"
                                MinWidth="160"
                                Padding="5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                materialDesign:ColorZoneAssist.Mode="Dark"
                                BorderThickness="0"
                                DisplayMemberPath="Name"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                ItemsSource="{Binding WeightModeItems, UpdateSourceTrigger=PropertyChanged}"
                                SelectedItem="{Binding SelectWeightMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                SelectedValuePath="Value"
                                Style="{StaticResource MaterialDesignComboBox}" />
                        </Border>
                    </StackPanel>
                    <!--  连接参数  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe75e;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="常规连接参数:" />
                    </StackPanel>
                    <StackPanel
                        Margin="50,5,0,0"
                        Orientation="Vertical"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">

                        <!--  串口名、刷新按钮  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="串口名:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="130"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding PortItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.PortName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                            <Button
                                Width="50"
                                MinHeight="30"
                                Margin="5,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Background="#2E2E2E"
                                BorderThickness="0"
                                Command="{Binding PortUpdateCommand}"
                                FocusVisualStyle="{x:Null}"
                                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="DarkGray"
                                        Text="&#xe69a;" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!--  波特率  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="波特率:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding BaudRateItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.BaudRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  数据位  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="数据位:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding DataBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding WeightSettingsInfo.Connection.DataBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  效验位  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="效验位:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    DisplayMemberPath="Name"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding ParityItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectParity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  停止位  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="停止位:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    DisplayMemberPath="Name"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding StopBitsItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectStopBits, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                        <!--  数据格式  -->
                        <StackPanel Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="格  式:" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <ComboBox
                                    Height="30"
                                    MinWidth="190"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="15"
                                    materialDesign:ColorZoneAssist.Mode="Dark"
                                    BorderThickness="0"
                                    DisplayMemberPath="Name"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    ItemsSource="{Binding DataFormatTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectDataFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource MaterialDesignComboBox}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle
                        Height="1"
                        Margin="30,5"
                        Opacity="0.15"
                        Stroke="DimGray"
                        StrokeDashArray="10 10"
                        StrokeThickness="1"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}" />
                    <!--  重量设置参数  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe645;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="重量设置参数:" />
                    </StackPanel>
                    <!--  最小最大重量  -->
                    <StackPanel
                        Margin="50,5,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="最小可用重量:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="80"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.CommonWeight.MinWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="最大可用重量:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="78"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.CommonWeight.MaxWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!--  动态容器  -->
                    <ScrollViewer
                        MaxHeight="170"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                        <StackPanel>
                            <!--  静态称重参数  -->
                            <StackPanel
                                Margin="50,5,0,0"
                                Orientation="Vertical"
                                Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static}">
                                <!--  反转、字符长度  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="是否反转:" />
                                        <ToggleButton
                                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                            Focusable="False"
                                            IsChecked="{Binding WeightSettingsInfo.StaticWeight.IsReversed, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                    </StackPanel>
                                    <StackPanel Margin="92,0,0,0" Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="字符长度:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="90"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.CharacterLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!--  采样频率、获取方式  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="采样频率:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="105"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.DataInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="获取方式:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <ComboBox
                                                Height="30"
                                                MinWidth="115"
                                                Padding="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                materialDesign:ButtonAssist.CornerRadius="15"
                                                materialDesign:ColorZoneAssist.Mode="Dark"
                                                BorderThickness="0"
                                                DisplayMemberPath="Name"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                ItemsSource="{Binding WeightAccessItems, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedItem="{Binding SelectedWeightAccess, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                SelectedValuePath="Value"
                                                Style="{StaticResource MaterialDesignComboBox}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!--  稳定个数、稳定精度  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="稳定个数:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="105"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.BalanceCount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="稳定精度:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="105"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.BalanceQty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!--  标识符、标识符位置  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="标 识 符:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="105"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.Identifier, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="标识符位置:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="92"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.IdentifierPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!--  整数起始位置、整数结束位置  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="整数起始位置:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="80"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.IntegerStartPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="整数结束位置:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="78"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.IntegerEndPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!--  小数起始位置、小数结束位置  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="小数起始位置:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="80"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.DecimalStartPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="小数结束位置:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="78"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.DecimalEndPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!--  发送内容、发送格式(问答式才可见)  -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedWeightAccess, Converter={StaticResource WeightAccessToVisibilityConverter}, ConverterParameter=QuestionAnswer}">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="发送内容:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <TextBox
                                                Width="105"
                                                Height="30"
                                                MaxWidth="500"
                                                Margin="5,0"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:TextFieldAssist.HasFilledTextField="True"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                InputMethod.IsInputMethodEnabled="False"
                                                Text="{Binding WeightSettingsInfo.StaticWeight.SendingContent, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  图标  -->
                                        <TextBlock
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="DarkGray"
                                            Text="发送格式:" />
                                        <Border
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#1A696969"
                                            CornerRadius="5">
                                            <ComboBox
                                                Height="30"
                                                MinWidth="115"
                                                Padding="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                materialDesign:ButtonAssist.CornerRadius="15"
                                                materialDesign:ColorZoneAssist.Mode="Dark"
                                                BorderThickness="0"
                                                DisplayMemberPath="Name"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                ItemsSource="{Binding DataFormatTypeItems, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedItem="{Binding SendDataFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                SelectedValuePath="Value"
                                                Style="{StaticResource MaterialDesignComboBox}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <!--  动态称重参数  -->
                            <StackPanel
                                Margin="50,5,0,0"
                                Orientation="Vertical"
                                Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Dynamic}">
                                <StackPanel Orientation="Horizontal">
                                    <!--  图标  -->
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="小数保留位数:" />
                                    <Border
                                        Margin="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#1A696969"
                                        CornerRadius="5">
                                        <TextBox
                                            Width="105"
                                            Height="30"
                                            MaxWidth="500"
                                            Margin="5,0"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasFilledTextField="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Text="{Binding WeightSettingsInfo.DynamicWeight.DecimalPrecision, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <!--  重量附加属性  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe729;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="附加重量属性:" />
                    </StackPanel>
                    <StackPanel
                        Margin="50,5,0,0"
                        Orientation="Vertical"
                        Visibility="{Binding SelectWeightMode, Converter={StaticResource WeightModeToVisibilityConverter}, ConverterParameter=Static|Dynamic}">
                        <!--  重量转换  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="是否使用实际重量转换率:" />
                                <ToggleButton
                                    Name="IsUseActualWeightConversionRateToggleButton"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                    Focusable="False"
                                    IsChecked="{Binding WeightSettingsInfo.AdditionalWeight.IsUseActualWeightConversionRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseActualWeightConversionRateToggleButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="重量转换率:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="50"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.AdditionalWeight.WeightConversionRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="%" />
                            </StackPanel>
                        </StackPanel>
                        <!--  追加重量  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="是否使用追加重量:" />
                                <ToggleButton
                                    Name="IsUseAppendedWeightToggleButton"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                    Focusable="False"
                                    IsChecked="{Binding WeightSettingsInfo.AdditionalWeight.IsUseAppendedWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </StackPanel>
                            <StackPanel
                                Margin="20,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseAppendedWeightToggleButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="追加重量值:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="90"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.AdditionalWeight.AppendedWeightValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <!--  固定重量  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="是否使用固定重量:" />
                                <ToggleButton
                                    Name="IsUseFixedWeightToggleButton"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                    Focusable="False"
                                    IsChecked="{Binding WeightSettingsInfo.AdditionalWeight.IsUseFixedWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </StackPanel>
                            <StackPanel
                                Margin="20,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseFixedWeightToggleButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="固定重量值:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="90"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.AdditionalWeight.FixedWeightValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <!--  是否使用融合重量超时  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="是否使用融合重量超时:" />
                                <ToggleButton
                                    Name="IsUseMergedWeightTimeoutToggleButton"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                    materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                    Focusable="False"
                                    IsChecked="{Binding WeightSettingsInfo.AdditionalWeight.IsUseMergedWeightTimeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </StackPanel>
                            <StackPanel
                                Margin="10,0,0,0"
                                IsEnabled="{Binding ElementName=IsUseMergedWeightTimeoutToggleButton, Path=IsChecked}"
                                Orientation="Horizontal">
                                <!--  图标  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="DarkGray"
                                    Text="超时时间(ms):" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1A696969"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="60"
                                        Height="30"
                                        MaxWidth="500"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        InputMethod.IsInputMethodEnabled="False"
                                        Text="{Binding WeightSettingsInfo.AdditionalWeight.MergedWeightTimeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--  右边  -->
            <Border Grid.Column="1">

                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <!--  实时重量  -->
                    <Grid MaxWidth="300">
                        <Rectangle
                            Height="Auto"
                            MinWidth="230"
                            MinHeight="60"
                            Opacity="0.15"
                            Stroke="DimGray"
                            StrokeDashArray="5 5"
                            StrokeThickness="2" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="40"
                            FontWeight="Bold"
                            Foreground="Gray"
                            Opacity="0.7">
                            <Run Text="{Binding RealtimeWeight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" /><Run
                                FontSize="16"
                                FontWeight="Bold"
                                Text="kg" />
                        </TextBlock>
                    </Grid>
                    <!--  实时内容输出框  -->
                    <Border
                        Width="600"
                        MinWidth="500"
                        MinHeight="680"
                        Margin="5,20,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1A696969"
                        CornerRadius="5">
                        <TextBox
                            Width="590"
                            MinWidth="500"
                            MinHeight="80"
                            MaxHeight="700"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            IsReadOnly="True"
                            Opacity="0.8"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding ReceivedData, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <!--  实时开关  -->
                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="20"
                            Foreground="DarkGray"
                            Text="&#xe711;" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="实时内容:" />
                        <ToggleButton
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                            Command="{Binding IsRealtimeDataEnabledChangedCommand}"
                            Focusable="False"
                            IsChecked="{Binding IsRealtimeDataEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--  保存设置  -->
            <Button
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="110"
                Height="Auto"
                MinHeight="30"
                Margin="30,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                materialDesign:ButtonAssist.CornerRadius="5"
                Background="#2E2E2E"
                BorderThickness="0"
                Command="{Binding SaveSettingsCommand}"
                FocusVisualStyle="{x:Null}"
                Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="18"
                            Foreground="DarkGray"
                            Text="&#xe66e;" />
                        <TextBlock
                            Margin="2,1,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CustomFontFamily}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="保存设置" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                    <ProgressBar
                        Name="StatusProgressBar"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Value="0">
                        <ProgressBar.Style>
                            <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Button>
            <!--  提示框  -->
            <materialDesign:Snackbar
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="Auto"
                Height="Auto"
                VerticalAlignment="Bottom"
                Background="BlueViolet"
                FontFamily="LoadFiraCode"
                FontWeight="Bold"
                MessageQueue="{Binding WeightSettingsMessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</Page>