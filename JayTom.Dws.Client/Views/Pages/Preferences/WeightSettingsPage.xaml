                                IsChecked="{Binding WeightSettingsInfo.AdditionalWeight.IsUseAppendedWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                        <StackPanel
                            Margin="20,0,0,0"
                            IsEnabled="{Binding ElementName=IsUseAppendedWeightToggleButton, Path=IsChecked}"
                            Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.ValueOfAdditionalWeight}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="90"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False">
                                    <TextBox.Text>
                                        <Binding
                                            Mode="TwoWay"
                                            Path="WeightSettingsInfo.AdditionalWeight.AppendedWeightValue"
                                            UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的浮点数" Pattern="^-?\d+(\.\d+)?$" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Border>
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="kg" />
                        </StackPanel>
                    </StackPanel>
                    <!--  固定重量  -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.IsUseFixedWeight}" />
                            <ToggleButton
                                Name="IsUseFixedWeightToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
                                IsChecked="{Binding WeightSettingsInfo.AdditionalWeight.IsUseFixedWeight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                        <StackPanel
                            Margin="20,0,0,0"
                            IsEnabled="{Binding ElementName=IsUseFixedWeightToggleButton, Path=IsChecked}"
                            Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.ValueOfFixedWeight}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="90"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False">
                                    <TextBox.Text>
                                        <Binding
                                            Mode="TwoWay"
                                            Path="WeightSettingsInfo.AdditionalWeight.FixedWeightValue"
                                            UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <validationRules:RegexValidationRule ErrorMessage="请输入有效的浮点数" Pattern="^\d+(\.\d+)?$" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Border>
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="kg" />
                        </StackPanel>
                    </StackPanel>
                    <!--  是否使用融合重量超时  -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.IsUseFusedWeightTimeout}" />
                            <ToggleButton
                                Name="IsUseMergedWeightTimeoutToggleButton"
                                materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                                materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                                Focusable="False"
                                IsChecked="{Binding WeightSettingsInfo.AdditionalWeight.IsUseMergedWeightTimeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        </StackPanel>
                        <StackPanel
                            Margin="10,0,0,0"
                            IsEnabled="{Binding ElementName=IsUseMergedWeightTimeoutToggleButton, Path=IsChecked}"
                            Orientation="Horizontal">
                            <!--  图标  -->
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="{x:Static languages:Language.Timeout}" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="60"
                                    Height="30"
                                    MaxWidth="500"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    InputMethod.IsInputMethodEnabled="False"
                                    Text="{Binding WeightSettingsInfo.AdditionalWeight.MergedWeightTimeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <!--  右边  -->
        <Border Grid.Column="1">

            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                <!--  实时重量  -->
                <Grid MaxWidth="300">
                    <Rectangle
                        Height="Auto"
                        MinWidth="230"
                        MinHeight="60"
                        Opacity="0.15"
                        Stroke="DimGray"
                        StrokeDashArray="5 5"
                        StrokeThickness="2" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="40"
                        FontWeight="Bold"
                        Foreground="Gray"
                        Opacity="0.7">
                        <Run Text="{Binding RealtimeWeight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" /><Run
                            FontSize="16"
                            FontWeight="Bold"
                            Text="kg" />
                    </TextBlock>
                </Grid>
                <!--  实时内容输出框  -->
                <Border
                    Width="600"
                    MinWidth="500"
                    MinHeight="680"
                    Margin="5,20,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A696969"
                    CornerRadius="5">
                    <TextBox
                        Width="590"
                        MinWidth="500"
                        MinHeight="80"
                        MaxHeight="700"
                        Margin="5,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        IsReadOnly="True"
                        Opacity="0.8"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding ReceivedData, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
                <!--  实时开关  -->
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DarkGray"
                        Text="&#xe711;" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DarkGray"
                        Text="{x:Static languages:Language.RealTimeWeightData}" />
                    <ToggleButton
                        materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="DarkGray"
                        materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="DodgerBlue"
                        Command="{Binding IsRealtimeDataEnabledChangedCommand}"
                        Focusable="False"
                        IsChecked="{Binding IsRealtimeDataEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>