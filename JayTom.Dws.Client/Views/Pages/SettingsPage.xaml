<Page
    x:Class="JayTom.Dws.Client.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="SettingPage"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="SettingPage">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding ElementName=RegionFrame}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="SettingDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  菜单列表  -->
            <Grid Grid.Column="0" Width="210">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListBox
                    Grid.Row="0"
                    MinHeight="100"
                    MaxHeight="{Binding ListBoxMaxHeight, UpdateSourceTrigger=PropertyChanged}"
                    ItemTemplate="{StaticResource MenuTemplate}"
                    ItemsSource="{Binding MenuItems, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource CustomListBoxStyle}" />
                <Grid
                    Grid.Row="1"
                    MinWidth="1000"
                    Background="#2E2E2E" />
            </Grid>

            <!--  区域内容  -->
            <!--<ScrollViewer
            Grid.Column="1"
            Focusable="False"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
        </ScrollViewer>-->
            <Frame
                Name="RegionFrame"
                Grid.Column="1"
                mvvm:RegionManager.RegionName="ContentRegion"
                Focusable="False"
                NavigationUIVisibility="Hidden" />
            <TextBlock
                Grid.Column="1"
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="13"
                FontWeight="Bold"
                Foreground="White"
                Opacity="0.1"
                Visibility="Visible">
                Hisoka
            </TextBlock>
        </Grid>
    </materialDesign:DialogHost>
</Page>