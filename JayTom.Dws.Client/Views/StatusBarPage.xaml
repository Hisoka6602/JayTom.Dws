<Page
    x:Class="JayTom.Dws.Client.Views.StatusBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JayTom.Dws.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Title="StatusBarPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:ListBackgroundVisibleConverter x:Key="ListBackgroundVisibleConverter" />
        <converters:ExceptionFlagColorConverter x:Key="ExceptionFlagColorConverter" />
    </Page.Resources>
    <Grid
        Margin="10,5"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center">
        <StackPanel
            MinWidth="1700"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  状态  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DimGray"
                        Text="&#xe6f9;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="异常" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="{Binding ExceptionItems.Count, Converter={StaticResource ExceptionFlagColorConverter}}"
                        Text="&#xe7a6;" />
                </StackPanel>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="True">
                            <ContentPresenter />
                            <Popup
                                x:Name="ExceptionPopup"
                                Placement="Top"
                                PopupAnimation="Scroll"
                                StaysOpen="False">
                                <!--  在这里定义 Popup 的内容  -->
                                <Grid
                                    Width="250"
                                    Height="300"
                                    Background="#303030"
                                    ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>
                                    <!--  异常信息列表  -->
                                    <ListBox
                                        x:Name="ExceptionListBox"
                                        Grid.Row="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="White"
                                        ItemTemplate="{StaticResource ExceptionItemTemplate}"
                                        ItemsSource="{Binding ExceptionItems, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource CustomListBoxStyle}" />
                                    <!--  清除按钮  -->
                                    <Button
                                        Grid.Row="1"
                                        Width="100"
                                        Height="30"
                                        Margin="5"
                                        VerticalAlignment="Bottom"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        Background="RoyalBlue"
                                        BorderBrush="RoyalBlue"
                                        BorderThickness="0"
                                        Command="{Binding ClearExceptionCommand}"
                                        Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                        <TextBlock
                                            FontFamily="{StaticResource CustomFontFamily}"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="清空异常" />
                                    </Button>
                                    <!--  空数据底图  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Background="#303030"
                                        Visibility="{Binding Items.Count, ElementName=ExceptionListBox, Converter={StaticResource ListBackgroundVisibleConverter}}">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource IconFontFamily}"
                                                FontSize="50"
                                                Text="&#xe63d;" />
                                            <TextBlock
                                                Margin="0,10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CustomFontFamily}"
                                                FontSize="16"
                                                Text="没有数据" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ExceptionPopup" Property="IsOpen" Value="True" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExceptionPopup" Property="IsOpen" Value="True" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!--  相机  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DimGray"
                        Text="&#xe63a;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="相机" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="#31C731"
                        Text="&#xe7a6;" />
                </StackPanel>
            </Button>
            <!--  串口信息  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DimGray"
                        Text="&#xe62c;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="串口" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="#31C731"
                        Text="&#xe7a6;" />
                </StackPanel>
            </Button>
            <!--  电脑信息  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DimGray"
                        Text="&#xe67b;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="电脑" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="#31C731"
                        Text="&#xe7a6;" />
                </StackPanel>
            </Button>
            <!--  输出插件  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        Foreground="DimGray"
                        Text="&#xe641;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="输出插件" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="#31C731"
                        Text="&#xe7a6;" />
                </StackPanel>
            </Button>
            <!--  过滤插件  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="&#xe672;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="过滤插件" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="#31C731"
                        Text="&#xe7a6;" />
                </StackPanel>
            </Button>
            <!--  Api插件  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="&#xe664;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="Api接口" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="#31C731"
                        Text="&#xe7a6;" />
                </StackPanel>
            </Button>
            <!--  运行逻辑模块  -->
            <Button
                Margin="2,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="&#xe63e;" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CustomFontFamily}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="运行逻辑" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="30"
                        Foreground="#31C731"
                        Text="&#xe7a6;" />
                </StackPanel>
            </Button>
        </StackPanel>
        <!--  运行时间  -->
        <StackPanel
            Margin="10,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="20"
                Foreground="DimGray"
                Text="&#xe635;" />
            <TextBlock
                Margin="5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource CustomFontFamily}"
                FontSize="14"
                FontWeight="Bold"
                Foreground="DimGray"
                Text="0天-00:00:00" />
        </StackPanel>
    </Grid>
</Page>