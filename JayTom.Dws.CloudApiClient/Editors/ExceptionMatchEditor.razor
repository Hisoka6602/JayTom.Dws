@using JayTom.Dws.CloudApiClient.Data.Models.ConfigModels
@using MudBlazor.Utilities
<div class="d-flex">
    <MudPaper Elevation="3" Style=" width:400px;height:auto; position: relative; border-radius: 15px; display: flex; flex-direction: column; align-items: center;">

        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <div style="padding:50px;width: 100%;display: flex; flex-direction: column; align-items: center;">
                @*包含关键字*@

                <MudTextField Variant="Variant.Text" @bind-Value="@Model.Keywords" Style="min-width:300px;margin-bottom:30px" T="string" Label="包含关键字" For="@(() => Model.Keywords)" />

                @*自定义正则*@
                <MudTextField Variant="Variant.Text" @bind-Value="@Model.CustomRegex" Style="min-width:300px;margin-bottom:30px" T="string" Label="自定义正则" For="@(() => Model.CustomRegex)" />
                @*数据源(下拉)*@
                <MudSelect Style="min-width:300px;margin-bottom:30px" @bind-Value="Model.DataSource" Label="判断数据源" Class="ml-4">
                    <MudSelectItem Value="DataSourceType.Barcode">条码</MudSelectItem>
                    <MudSelectItem Value="DataSourceType.RequestContent">接口请求内容</MudSelectItem>
                    <MudSelectItem Value="DataSourceType.ResponseContent">接口响应内容</MudSelectItem>
                </MudSelect>
                @*异常类型(下拉)*@
                <MudSelect Style="min-width:300px;margin-bottom:30px" @bind-Value="Model.ExceptionTypeId" Label="异常类型" Dense="true" Class="ml-4">

                    @foreach (var info in ExceptionInfoItems) {
                        <MudSelectItem Value="@info.Id">@info.ExceptionName</MudSelectItem>
                    }

                </MudSelect>
                @*判断优先级(下拉)*@
                <MudSelect Style="min-width:300px;margin-bottom:30px" @bind-Value="Model.Priority" Label="判断优先级" Dense="true" Class="ml-4">
                    @foreach (var priority in PriorityOptions) {
                        <MudSelectItem Value="@priority">@priority</MudSelectItem>
                    }
                </MudSelect>
                <div style="margin-top:20px; display: flex; justify-content: center;">
                    <MudButton OnClick="Confirm" Style="background-color:dodgerblue; color:white; margin-left:5px;margin-right:5px;width:130px; border-radius: 30px;" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Inherit">保存</MudButton>
                    <MudButton OnClick="Cancel" Style="margin-left:5px;margin-right:5px; width:130px; border-radius: 30px;" ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Error">取消</MudButton>
                </div>
            </div>

        </div>
    </MudPaper>
</div>
@code {
    [Parameter]
    public EventCallback<ExceptionMatchItemModel> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]

    public ExceptionMatchItemModel Model { get; set; } = new();
    [Parameter]
    public List<ExceptionInfoItemModel> ExceptionInfoItems { get; set; } = new();


    private async void Confirm() {

        await OnConfirm.InvokeAsync(Model);
    }

    public async void Cancel() {
        await OnCancel.InvokeAsync(null);
    }
    private List<int> PriorityOptions { get; set; } = Enumerable.Range(0, 11).ToList();




}
