@using JayTom.Dws.CloudApiClient.Data.Models
@page "/data-charthome"
@using JayTom.Dws.CloudApiClient.Template;
@using JayTom.Dws.CloudApiClient.Data.Models
@using Color = System.Drawing.Color
@using System.Drawing
@using ApexCharts
<div class="grid-container">
    @foreach (var story in SimpleDataItems) {
        <div class="grid-item">
            <SimpleDataTemplate Icon="@story.Icon" Description="@story.Description" Value="@story.Value" Unit="@story.Unit" IconColor="@ColorTranslator.ToHtml(story.IconColor)" TrayColor="@ToHtmlColor(story.TrayColor)" />
        </div>
    }
</div>

<div style="display: flex; margin:10px;">
    <div style="flex: 40%;">
        <MudCard Style="width:550px;height:350px; position: relative; border-radius:15px;">

            <div style="display:flex; flex-direction: column;  ">
                <div style="margin-bottom:2px; display: flex; height:40px; align-items: center; background-color: dodgerblue; border-top-left-radius: 15px; border-top-right-radius: 15px; padding: 10px;">
                    <span class="iconfont icon-tianchongxing-" style="color: white; font-size: 26px; margin-right: 10px;"></span>
                    <span style="font-weight: bold; font-size: 15px; margin-left: 30px; color: white;">异常数据分布</span>
                </div>

                <ApexChart Width="500" Height="300" TItem="DonutItemModel">

                    <ApexPointSeries TItem="DonutItemModel"
                                     Items="DonutItems"
                                     ShowDataLabels="true"
                                     Name="异常分布"
                                     PointColor="e => e.Color"
                                     SeriesType="SeriesType.Donut"
                                     XValue="e => e.Name"
                                     YValue="e => e.Value" />

                </ApexChart>
            </div>


        </MudCard>
        @*异常统计图*@

    </div>
    <div style="flex: 60%;">
        <MudCard Style="height:350px; position: relative; border-radius:15px;">
            <div style="display:flex; flex-direction: column; ">
                <div style="margin-bottom:2px; display: flex; height:40px; align-items: center; background-color: #594AE2; border-top-left-radius: 15px; border-top-right-radius: 15px; padding: 10px;">
                    <span class="iconfont icon-tianchongxing-" style="color: white; font-size: 26px; margin-right: 10px;"></span>
                    <span style="font-weight: bold; font-size: 15px; margin-left: 30px; color: white;">格口数据分布</span>
                </div>
                <MudDivider DividerType="DividerType.Middle" Style="height:2px:margin:2px" />
                <MudDataGrid HeaderClass="custom-header" Height="310px" FixedHeader="true" Elevation="1" Class="custom-datagrid" Filterable="false" SortMode="@SortMode.None" Groupable="false" Items="@ExitDistributionItems">
                    <Columns>
                        <PropertyColumn Property="x => x.Num" Title="" />
                        <PropertyColumn Property="x => x.ExitName" Title="格口名称" />
                        <PropertyColumn Property="x => x.Quantity" Title="数量" />
                        <PropertyColumn Property="x => x.Ratio" Title="占比" Format="P2" />
                        <TemplateColumn Title="">
                            <CellTemplate>
                                <MudProgressLinear Style="height:10px;width:90px" Color="@MudBlazor.Color.Primary" Rounded="true" Size="@MudBlazor.Size.Small" Value="context.Item.Ratio" Max="1" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>

            </div>
        </MudCard>
        @*格口分布图*@
    </div>
</div>

@*实时图*@

<div style="max-height:500px">
    <ApexChart Height="320" TItem="RealTimeDataItemModel" Options="@_options" Debug="true">

        <ApexPointSeries TItem="RealTimeDataItemModel"
                         Items="TodayRealTimeDataItems"
                         ShowDataLabels="true"
                         Name="今天数据"
                         Stroke="@(new ApexCharts.SeriesStroke { Color ="DodgerBlue", DashSpace = 0, Width = 3 })"
                         SeriesType="SeriesType.Area"
                         XValue="e => e.Timestamp"
                         YValue="e => e.Quantity">

        </ApexPointSeries>
        <ApexPointSeries TItem="RealTimeDataItemModel"
                         Items="YesterdayRealTimeDataItems"
                         ShowDataLabels="true"
                         Name="昨天数据"
                         Stroke="@(new ApexCharts.SeriesStroke { Color ="gray", DashSpace = 0, Width = 3 })"
                         SeriesType="SeriesType.Area"
                         XValue="e => e.Timestamp"
                         YValue="e => e.Quantity">
        </ApexPointSeries>
    </ApexChart>

</div>



<style>
    .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10%, 1fr));
        grid-gap: 10px;
    }

    .grid-item {
        padding: 5px;
    }

    .custom-header {
        color: black;
        font-size: 15px;
    }

    .custom-datagrid .mud-table-row {
        height: 10px;
    }
</style>
