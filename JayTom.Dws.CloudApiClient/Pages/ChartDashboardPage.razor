    private List<DonutItemModel> DonutItems { get; set; } = new()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
        new DonutItemModel(){Name ="无物理格口",Value = 25,Color ="#1E90FF" },
        new DonutItemModel(){Name ="网络超时",Value = 77,Color ="#687DE8"},
        new DonutItemModel(){Name ="条码未识别",Value = 28,Color ="#876BCE"},
        new DonutItemModel(){Name ="其他异常",Value = 5,Color =ColorTranslator.ToHtml(Color.Gray)},
    };

    protected override void OnInitialized() {
        base.OnInitialized();
        Random random = new Random();
        DateTime startTime = DateTime.Now;
        for (var i = 0; i < 60; i++) {
            var time = startTime.AddMinutes(i);

            TodayRealTimeDataItems.Add(new RealTimeDataItemModel {
                    Timestamp = time.ToUnixTimeMilliseconds(),
                    Quantity = random.Next(1, 100),
                    Color = "blue"
                });
            YesterdayRealTimeDataItems.Add(new RealTimeDataItemModel {
                    Timestamp = time.ToUnixTimeMilliseconds(),
                    Quantity = random.Next(1, 100),
                    Color = "gray"
                });
        }

        _options.Debug = true;
        _options.Tooltip = new ApexCharts.Tooltip { X = new TooltipX { Format = @"yy-MM-dd HH:mm:ss" } };
        _options.Xaxis = new XAxis {
                Type = XAxisType.Datetime,
                Title = new AxisTitle {
                    OffsetY = 5,
                    Text = "分钟",
                    Style = new AxisTitleStyle { FontSize = "14px", Color = "lightgrey" }
                },
                AxisBorder = new AxisBorder {
                    Height = 2
                },

            };
        _options.Yaxis = new List<YAxis>();
        _options.Yaxis.Add(new YAxis {
                DecimalsInFloat = 0,
                Labels = new YAxisLabels { Rotate = -45, Style = new AxisLabelStyle { FontSize = "10px" } },
                Title = new AxisTitle { Text = "数量", Style = new AxisTitleStyle { FontSize = "14px", Color = "lightgrey" } }
            });

    }


    string ToHtmlColor(Color color) {
        return $"rgba({color.R}, {color.G}, {color.B}, {color.A / 255.0})";
    }
