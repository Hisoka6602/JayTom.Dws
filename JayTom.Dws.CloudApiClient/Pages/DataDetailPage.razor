@page "/data-detail"
@using JayTom.Dws.CloudApiClient.Data.Models
@using JayTom.Dws.CloudApiClient.Editors
@using JayTom.Dws.CloudApiClient.Api
@using JayTom.Dws.CloudApiClient.Data.Models.ExcelModels
@using JayTom.Dws.CloudApiClient.Plugin.Excel
@using System.Reflection.Metadata
@using Newtonsoft.Json
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject ICloudApiRequest CloudApiRequest
@inject IExcelService ExcelService
@inject IJSRuntime JSRuntime


@*搜索条件框*@
<MudCard Style="height:50px; margin-bottom:10px;border-radius:25px">
    <div style="height: 50px; display: flex; align-items: center;">
        <div style="margin-right: auto;">
            <div style=" display: flex; align-items: center;background-color:#3D7AEF; margin-right:5px; height: 50px;border-top-left-radius: 25px;border-bottom-left-radius: 25px;">
                <span style="margin-left:10px;margin-right:10px; color:white; font-weight:bold; font-size: 13px;">面单条码/物流单号</span>
            </div>

        </div>
        <div style="flex-grow:1">
            <MudInput Clearable="true" AdornmentColor="Color.Error" DisableUnderLine="true" Style="border-block-width:0px; border-color:#3D7AEF; height: 50px;display: flex; " @bind-Value="searchBarcode" Variant="Variant.Text" />
            @*<MudTextField Clearable="true" DisableUnderLine="false" Style="border-block-color:#3D7AEF; margin-bottom:18px;height: 48px;display: flex; " @bind-Value="searchBarcode" Variant="Variant.Text" />*@
        </div>
        <div style="margin-left: auto; display: flex; align-items: center;">


            <div class="d-flex">
                <MudButton OnClick="SwitchExpanded" Style="background-color:#3D7AEF; margin-left:5px; margin-right:5px; min-width: 80px; height: 40px;border-radius: 20px;" Size="@Size.Small" Variant="@Variant.Filled">
                    <span style="color:white; font-weight:bold; font-size: 13px;">@SwitchExpandedTitle</span>
                </MudButton>
                <MudPopover Open="isExpanded" OverflowBehavior="OverflowBehavior.FlipAlways" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Paper="false">
                    <MudPaper Outlined="true" Class="px-4 py-8" Style="width:330px">
                        @*展开*@
                        <div>
                            <div class="grid-container">
                                @*开始时间-结束时间*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">开始时间:</span>
                                    <DateTimeEditors @bind-DateTime="StartDateTime"></DateTimeEditors>
                                </div>

                                <div class="grid-item" style="display: flex; justify-content: center; align-items: center;">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">结束时间:</span>
                                    <DateTimeEditors @bind-DateTime="EndDateTime"></DateTimeEditors>
                                </div>
                                @*最大最小重量*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">重量:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:110px; height: 30px;display: flex; " Variant="Variant.Text" />
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">~</span>
                                    <MudInput @bind-Value="MaxWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:110px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @*相机序列号*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">相机序列号:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @*上传状态*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">上传状态:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @* 物理格口 *@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">物理格口:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @*发送的指令*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">发送的指令:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @*物流名称*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">物流名称:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @*三段码*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">三段码:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @*节点名称*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">节点名称:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>
                                @*设备名称*@
                                <div class="grid-item">
                                    <span style="margin-left:3px;margin-right:5px; color:gray;  font-size: 13px;">设备名称:</span>
                                    <MudInput @bind-Value="MinWeight" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:180px; height: 30px;display: flex; " Variant="Variant.Text" />
                                </div>

                            </div>

                        </div>
                    </MudPaper>
                </MudPopover>
            </div>

            <MudIconButton OnClick="OnSearchClicked" Style="margin-right:1px;background-color:#3D7AEF;color: white; height: 40px; width: 60px; border-top-right-radius: 0px;border-bottom-right-radius: 0px; border-top-left-radius: 20px;border-bottom-left-radius: 20px;" Variant="Variant.Filled" Size="Size.Small">
                <span class="iconfont icon-sousuo" style="font-size: 20px;"></span>
            </MudIconButton>
            <MudIconButton OnClick="DownloadExcel" Style="margin-right:5px; background-color:darkviolet;color: white; height: 40px; width: 60px;  border-top-right-radius: 20px;border-bottom-right-radius: 20px; border-top-left-radius: 0px;border-bottom-left-radius: 0px;" Variant="Variant.Filled" Size="Size.Small">
                <span class="iconfont icon-xiazai1" style="font-size: 20px;"></span>
            </MudIconButton>
        </div>

    </div>
</MudCard>
@*列表*@
<div style="display:flex; flex-direction: column; height:89vh;border-radius:10px">
    @*列表*@
    @if (!_dataLoaded) {
        for (int i = 0; i < 15; i++) {
            <MudSkeleton Animation="Animation.Wave" Width="100%" Height="110px;" />
        }
    }
    else {
        <MudDataGrid Height="100%" Style="min-height:95%; width:100%; border-radius:10px" DragDropColumnReordering="true" FixedHeader="true" ColumnResizeMode="ResizeMode.Column" HeaderClass="custom-header" Filterable="false" SortMode="@SortMode.None" Groupable="false" Items="@DetailInfoItems">
            <Columns>
                <PropertyColumn Property="x => x.Num" Title="" />
                <PropertyColumn Property="x => x.BarCodeInfo.ScanTime" Title="扫码时间" Format="yyyy-MM-dd HH:mm:ss.fff" />
                <PropertyColumn Property="x => x.BarCodeInfo.Barcode" Title="条码" />
                <PropertyColumn Property="x => x.WeightInfo.FormattedWeight" Title="重量" Format="F3" />
                <PropertyColumn Property="x => x.VolumeInfo.FormattedLength" Title="长度" Format="F3" />
                <PropertyColumn Property="x => x.VolumeInfo.FormattedWidth" Title="宽度" Format="F3" />
                <PropertyColumn Property="x => x.VolumeInfo.FormattedHeight" Title="高度" Format="F3" />
                <PropertyColumn Property="x => x.VolumeInfo.FormattedVolume" Title="体积" Format="F3" />
                <PropertyColumn Property="x => x.UploadInfo.RequestStatus" Title="Api上传状态" />
                <PropertyColumn Property="x => x.ExitInfo.PhysicalExit" Title="物理格口" />
                <PropertyColumn Property="x => x.DeviceInfos.DeviceName" Title="设备" />
                <TemplateColumn Title="扫码图">
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.ScanImageInfo.ImageUrl)) {
                            <MudIconButton OnClick="@(() => OpenImageLink(context.Item.ScanImageInfo.ImageUrl))" Style="width:30px;height:30px;">
                                <span class="iconfont icon-8tupian-2" style="font-size: 20px;color:#008DFF"></span>
                            </MudIconButton>
                        }

                    </CellTemplate>

                </TemplateColumn>
                <TemplateColumn Title="全景图">
                    <CellTemplate>
                        @foreach (var image in context.Item.PanoramaImageInfos) {
                            <MudIconButton OnClick="@(() => OpenImageLink(image.ImageUrl))" Style="width:30px;height:30px;">
                                <span class="iconfont icon-8tupian-2" style="font-size: 20px;color:#4A4453"></span>
                            </MudIconButton>
                        }
                    </CellTemplate>

                </TemplateColumn>
                <TemplateColumn Title="详细信息">
                    <CellTemplate>
                        <MudButton Style="background-color:#3D7AEF;color: white; border-radius: 15px;" Size="@Size.Small" Variant="@Variant.Filled">详细信息</MudButton>
                    </CellTemplate>

                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }

    @*翻页*@
    <div style="height: 50px; display: flex; align-items: center; justify-content: center; margin-top:15px;">

        @if (!_dataLoaded) {
            <MudSkeleton Style="width:300px;height:50px; border-radius:25px;" SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" />

        }
        else {

            <MudIconButton OnClick="OnGoToFirstPage" Style="background-color:#3D7AEF;color: white; height: 40px; width: 60px; border-top-right-radius: 0px;border-bottom-right-radius: 0px; border-top-left-radius: 20px;border-bottom-left-radius: 20px;" Variant="Variant.Filled" Size="Size.Small">
                <span class="iconfont icon-weiye-copy-copy" style="font-size: 20px;"></span>
            </MudIconButton>
            <MudIconButton OnClick="OnGoToPreviousPage" Style="background-color:#3D7AEF;color: white; height: 40px; width: 60px; border-radius:0px" Variant="Variant.Filled" Size="Size.Small">
                <span class="iconfont icon-shangyiyeshi" style="font-size: 20px;"></span>
            </MudIconButton>


            <div style=" display: flex; align-items: center; justify-content: center; margin-left:10px;margin-right:10px;">
                <MudInput ElementReference="@inputRef" @bind-Value="PageIndex" @onkeyup="OnGoToPage" DisableUnderLine="false" Style="color:gray; font-weight:bold; font-size: 13px; width:25px; border-color:#3D7AEF;display: flex;" Variant="Variant.Text" />
                <span style=" color:gray; font-weight:bold; font-size: 13px;">/</span>
                <span style=" color:gray; font-weight:bold; font-size: 13px;">@PageCount</span>
            </div>


            <MudIconButton OnClick="OnGoToNextPage" Style="background-color:#3D7AEF;color: white; height: 40px; width: 60px; border-radius:0px;" Variant="Variant.Filled" Size="Size.Small">
                <span class="iconfont icon-xiayiyeshi" style="font-size: 20px;"></span>
            </MudIconButton>
            <MudIconButton OnClick="OnGoToLastPage" Style="background-color:#3D7AEF;color: white; height: 40px; width: 60px;  border-top-right-radius: 20px;border-bottom-right-radius: 20px; border-top-left-radius: 0px;border-bottom-left-radius: 0px;" Variant="Variant.Filled" Size="Size.Small">
                <span class="iconfont icon-weiye" style="font-size: 20px;"></span>
            </MudIconButton>
        }

    </div>
</div>

<style>
    .grid-container {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        grid-auto-rows: 1fr;
        gap: 10px;
        justify-items: start;
    }

    .grid-item {
        height: 40px;
        padding: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: transparent;
    }

    .custom-header {
        color: black;
        font-size: 15px;
    }

    .custom-datagrid .mud-table-row {
        height: 10px;
    }

</style>

@code {
    [Inject] private IDialogService DialogService { get; set; }
    public int PageIndex { get; set; } = 1;
    public int PageSize { get; set; } = 500;
    public int PageCount { get; set; } = 0;
    public bool isExpanded { get; set; }
    public string SwitchExpandedTitle { get; set; } = "展开更多搜索条件";
    public string searchBarcode { get; set; } = string.Empty;
    public List<DetailInfoItemModel> DetailInfoItems { get; set; } = new();
    public static string? BaseUrl { get; set; }
    public DateTime? StartDateTime { get; set; }
    public DateTime? EndDateTime { get; set; }
    public string? Barcode { get; set; }
    public float? MinWeight { get; set; }
    public float? MaxWeight { get; set; }
    private bool _dataLoaded = true;
    private ElementReference inputRef;
    protected override void OnInitialized() {
        base.OnInitialized();

        for (int i = 0; i < 100; i++) {
            var model = new DetailInfoItemModel() {
                    Num = i + 1,
                    BarCodeInfo = new BarCodeInfoModel() {
                        Barcode = "SF123456789",
                        ScanTime = DateTime.Now,
                    },
                    WeightInfo = new WeightInfoModel() {
                        FormattedWeight = 0.22f
                    },
                    VolumeInfo = new VolumeInfoModel() {
                        FormattedLength = 10.2f,
                        FormattedWidth = 10.3f,
                        FormattedHeight = 10.4f,
                        FormattedVolume = 1000.36f
                    },
                    UploadInfo = new UploadInfoModel() {
                        RequestStatus = 1,
                    },
                    ExitInfo = new ExitInfoModel() {
                        PhysicalExit = "格口1"
                    },
                    ScanImageInfo = new ImageInfoModel() {
                        ImageUrl = "https://img2.baidu.com/it/u=621048240,333776885&fm=253&fmt=auto&app=138&f=GIF?w=1024&h=435"
                    },
                    PanoramaImageInfos = new List<ImageInfoModel>()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
                    new ImageInfoModel()
                    {
                        ImageUrl = "https://n.sinaimg.cn/translate/366/w700h466/20191130/54fa-ikcaceq7124230.jpg",

                    },
                    new ImageInfoModel()
                    {
                        ImageUrl = "https://www.zyouwl.cn/wp-content/uploads/2024/01/image-97-800x486.png",

                    },
                },
                    DeviceInfos = new DeviceInfoModel() {
                        DeviceName = "扫码设备1"
                    },

                };
            DetailInfoItems.Add(model);
        }
        BaseUrl ??= Configuration.GetValue<string>("BaseUrl");
        OnSearchClicked();
    }

    public void SwitchExpanded() {
        isExpanded = !isExpanded;
        SwitchExpandedTitle = $"{(isExpanded ? "隐藏其他" : "展开更多")}搜索条件";
    }
    public void OnSearchClicked() {
        PageIndex = 1;
        GetPackages();

    }
    public void OnGoToFirstPage() {
        PageIndex = 1;
        GetPackages();

    }
    public void OnGoToPreviousPage() {
        if (PageIndex > 1 && PageIndex <= PageCount) {

            PageIndex -= 1;
            GetPackages();

        }


    }
    private void OnGoToNextPage() {
        if (PageIndex > 0 && PageIndex < PageCount) {

            PageIndex += 1;
            GetPackages();

        }
    }
    private void OnGoToLastPage() {
        PageIndex = PageCount;
        GetPackages();
    }
    private async Task OnGoToPage(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            await inputRef.MudBlurAsync();
            StateHasChanged();
            GetPackages();
        }

    }


    private async Task OpenImageLink(string link) {
        if (!string.IsNullOrEmpty(link)) {
            await JSRuntime.InvokeVoidAsync("window.open", link, "_blank");

        }

    }
    public async void GetPackages() {
        if (_dataLoaded) {
            _dataLoaded = false;
            DetailInfoItems.Clear();
            PageCount = 0;
            CloudApiRequest.SetBaseUrl(BaseUrl ?? string.Empty);
            var (key, value) = await CloudApiRequest.GetPackages(Barcode, StartDateTime, EndDateTime,
                null, null, null, null, null,
                null, null, null, null, null,
                PageIndex - 1, PageSize);
            if (key && value is ApiResult result) {
                PageCount = result.Total / PageSize + (result.Total % PageSize > 0 ? 1 : 0);
                try {
                    var detailInfoItemModels = JsonConvert.DeserializeObject<List<DetailInfoItemModel>>(result.Data?.ToString() ?? string.Empty);
                    if (detailInfoItemModels is not null) {

                        for (var i = 0; i < detailInfoItemModels.Count; i++) {
                            detailInfoItemModels[i].Num = i + 1;
                        }

                        DetailInfoItems.AddRange(detailInfoItemModels);
                    }

                }
                catch (Exception e) {

                    await DialogService.ShowMessageBox(
                        "数据解析错误",
                        e.Message);
                }

            }

            else if (key && value is ApiResult apiResult) {

                await DialogService.ShowMessageBox(
                    "Api后端接口",
                    apiResult.Msg);
            }
            else {
                await DialogService.ShowMessageBox(
                    "Api后端接口",
                    value.ToString());

            }





            _dataLoaded = true;
            StateHasChanged();
        }

    }

    public async void DownloadExcel() {
        var excelDetailInfoModels = DetailInfoItems.Select(s => new ExcelDetailInfoModel {
                Num = s.Num,
                Barcode = s.BarCodeInfo.Barcode,
                ScanTime = s.BarCodeInfo.ScanTime,
                Weight = s.WeightInfo.FormattedWeight,
                Length = s.VolumeInfo.FormattedLength,
                Width = s.VolumeInfo.FormattedWidth,
                Height = s.VolumeInfo.FormattedHeight,
                Volume = s.VolumeInfo.FormattedVolume,
                RequestStatus = s.UploadInfo.RequestStatus switch {
                    0 => "未上传",
                    1 => "成功",
                    _ => "失败"
                },
                TheoreticalExit = s.ExitInfo.TheoreticalExit,
                PhysicalExit = s.ExitInfo.PhysicalExit,
                DeviceName = s.DeviceInfos.DeviceName
            })?.ToList();


        //ExcelDetailInfoModel

        var (key, value) = await ExcelService.Export("数据列表", "数据列表", excelDetailInfoModels,
            new List<string>() { },
            p => {

            }, async ex => {
                await DialogService.ShowMessageBox(
                    "导出异常",
                    ex.Message);
            });
        if (key && value is not null) {
            var fileName = "数据列表.xlsx";

            await JSRuntime.InvokeVoidAsync("saveAsFile",
                fileName, Convert.ToBase64String(value),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }

    }
}

