@page "/data-detail"
@using JayTom.Dws.CloudApiClient.Data.Models


@*搜索条件框*@

@*列表*@
<div style="display:flex; flex-direction: column; height:95vh;">
    <span style="border-radius:15px; font-weight:bold; font-size: 15px; margin-top:20px; margin-left:30px;color:gray">格口数据分布</span>
    <MudDivider DividerType="DividerType.Middle" Style="height:2px:margin:2px" />
    <MudDataGrid Height="100%" Style="max-height:92%; width:100%; border-radius:10px" DragDropColumnReordering="true" FixedHeader="true" ColumnResizeMode="ResizeMode.Column" HeaderClass="custom-header" Filterable="false" SortMode="@SortMode.None" Groupable="false" Items="@DetailInfoItems">
        <Columns>
            <PropertyColumn Property="x => x.Num" Title="" />
            <PropertyColumn Property="x => x.BarCodeInfo.ScanTime" Title="扫码时间" Format="yyyy-MM-dd HH:mm:ss.fff" />
            <PropertyColumn Property="x => x.BarCodeInfo.Barcode" Title="条码" />
            <PropertyColumn Property="x => x.WeightInfo.FormattedWeight" Title="重量" Format="F3" />
            <PropertyColumn Property="x => x.VolumeInfo.FormattedLength" Title="长度" Format="F3" />
            <PropertyColumn Property="x => x.VolumeInfo.FormattedWidth" Title="宽度" Format="F3" />
            <PropertyColumn Property="x => x.VolumeInfo.FormattedHeight" Title="高度" Format="F3" />
            <PropertyColumn Property="x => x.VolumeInfo.FormattedVolume" Title="体积" Format="F3" />
            <PropertyColumn Property="x => x.UploadInfo.RequestStatus" Title="Api上传状态" />
            <PropertyColumn Property="x => x.ExitInfo.PhysicalExit" Title="物理格口" />
            <PropertyColumn Property="x => x.DeviceInfos.DeviceName" Title="设备" />
            <TemplateColumn Title="扫码图">
                <CellTemplate>
                    <MudIconButton Style="width:30px;height:30px;">
                        <span class="iconfont icon-8tupian-2" style="font-size: 20px;color:#008DFF"></span>
                    </MudIconButton>
                </CellTemplate>

            </TemplateColumn>
            <TemplateColumn Title="全景图">
                <CellTemplate>
                    @foreach (var image in context.Item.PanoramaImageInfos) {
                        <MudIconButton Style="width:30px;height:30px;">
                            <span class="iconfont icon-8tupian-2" style="font-size: 20px;color:#4A4453"></span>
                        </MudIconButton>
                    }
                </CellTemplate>

            </TemplateColumn>
            <TemplateColumn Title="详细信息">
                <CellTemplate>
                    <MudButton Style="border-radius: 15px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">详细信息</MudButton>
                </CellTemplate>

            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    @*翻页*@
    <span style="border-radius:15px; font-weight:bold; font-size: 15px; margin-top:20px; margin-left:30px;color:gray">格口数据分布</span>
</div>

<style>
    .custom-header {
        color: black;
        font-size: 15px;
    }

    .custom-datagrid .mud-table-row {
        height: 10px;
    }
</style>
@code {

    public List<DetailInfoItemModel> DetailInfoItems { get; set; } = new();

    protected override void OnInitialized() {
        base.OnInitialized();

        for (int i = 0; i < 100; i++) {
            var model = new DetailInfoItemModel() {
                    Num = i + 1,
                    BarCodeInfo = new BarCodeInfoModel() {
                        Barcode = "SF123456789",
                        ScanTime = DateTime.Now,
                    },
                    WeightInfo = new WeightInfoModel() {
                        FormattedWeight = 0.22f
                    },
                    VolumeInfo = new VolumeInfoModel() {
                        FormattedLength = 10.2f,
                        FormattedWidth = 10.3f,
                        FormattedHeight = 10.4f,
                        FormattedVolume = 1000.36f
                    },
                    UploadInfo = new UploadInfoModel() {
                        RequestStatus = 1,
                    },
                    ExitInfo = new ExitInfoModel() {
                        PhysicalExit = "格口1"
                    },
                    ScanImageInfo = new ImageInfoModel() {
                        ImageUrl = "https://img2.baidu.com/it/u=621048240,333776885&fm=253&fmt=auto&app=138&f=GIF?w=1024&h=435"
                    },
                    PanoramaImageInfos = new List<ImageInfoModel>()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                    new ImageInfoModel()
                    {
                        ImageUrl = "https://n.sinaimg.cn/translate/366/w700h466/20191130/54fa-ikcaceq7124230.jpg",

                    },
                    new ImageInfoModel()
                    {
                        ImageUrl = "https://www.zyouwl.cn/wp-content/uploads/2024/01/image-97-800x486.png",

                    },
                },
                    DeviceInfos = new DeviceInfoModel() {
                        DeviceName = "扫码设备1"
                    },

                };
            DetailInfoItems.Add(model);
        }

    }

}
