@page "/config-exceptionCategoryConfig"
@using JayTom.Dws.CloudApiClient.Api
@using JayTom.Dws.CloudApiClient.Data.Models.ConfigModels
@using JayTom.Dws.CloudApiClient.Editors
@using Newtonsoft.Json
@inject ICloudApiRequest CloudApiRequest
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
<MudPaper Elevation="0" Style="display: flex; height:95vh;">
    @*弹出框*@
    <MudOverlay Visible="_exceptionEditorIsVisible" DarkBackground="true">

        <ExceptionEditor OnConfirm="EditExceptionTypeHandleConfirm" Model="SelectExceptionInfo" OnCancel="() => { _exceptionEditorIsVisible=false;}" />

    </MudOverlay>
    <MudOverlay Visible="_exceptionMatchEditorIsVisible" DarkBackground="true">

        <ExceptionMatchEditor OnConfirm="EditExceptionMatchHandleConfirm" Model="SelectExceptionMatchInfo" ExceptionInfoItems="ExceptionInfoItems" OnCancel="() => { _exceptionMatchEditorIsVisible=false;}" />

    </MudOverlay>
    <!-- 左侧异常表分类表 -->
    <div style="width: 35%; padding: 20px; border-right: 1px solid #ddd;  display: flex; flex-direction: column; gap: 10px;">
        <MudButton Style="min-height:40px; height:40px; width:100px; border-radius: 15px; margin-left:3px; background-color:#3763E8;color:white" Size="@Size.Small" Variant="@Variant.Filled"
                   Color="@Color.Surface" OnClick="()=>{_isEdit = false;_exceptionEditorIsVisible=true; SelectExceptionInfo=new();}">添加分类</MudButton>

        <MudDataGrid Height="100%" Style="min-height:95%; width:100%; border-radius:10px" DragDropColumnReordering="true"
                     FixedHeader="true" ColumnResizeMode="ResizeMode.Column"
                     HeaderClass="custom-header" Filterable="false"
                     SortMode="@SortMode.None" Groupable="false" Items="ExceptionInfoItems">
            <Columns>
                <PropertyColumn Property="x => x.Num" Title="" />
                <PropertyColumn Property="x => x.ExceptionName" Title="异常分类" />
                <PropertyColumn Property="x => x.ExceptionColor" Title="异常颜色">
                    <CellTemplate>
                        @{
                            var color = !string.IsNullOrEmpty(context.Item.ExceptionColor) ? context.Item.ExceptionColor : "darkred";
                        }
                        <div style="width:60px; display: flex; justify-content: center; align-items: center; height: 100%;">
                            <div style="background-color:@color; width: 20px; height: 20px; border-radius: 5px;"></div>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudStack Row>
                            <MudButton OnClick="@(e => { _isEdit = true; _exceptionEditorIsVisible=true; SelectExceptionInfo = context.Item;})" Style="background-color:#3763E8; color:white; border-radius:10px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Inherit">编辑</MudButton>
                            <MudButton OnClick="()=>{DeleteExceptionType(context.Item);}" Style="background-color:firebrick;color:white;border-radius:10px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Inherit">删除</MudButton>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

        </MudDataGrid>
    </div>
    <!-- 右侧匹配表 -->
    <div style="width: 65%; padding: 20px;  display: flex; flex-direction: column; gap: 10px;">
        <MudButton Style="min-height:40px; height:40px; width:100px; border-radius: 15px; margin-left:3px; background-color:#3763E8;color:white"
                   Size="@Size.Small" Variant="@Variant.Filled"
                   Color="@Color.Surface" OnClick="()=>{_isEdit = false;_exceptionMatchEditorIsVisible=true; SelectExceptionMatchInfo=new();}">添加匹配</MudButton>
        <MudDataGrid Height="100%" Style="min-width:800px; min-height:95%; width:100%; border-radius:10px" DragDropColumnReordering="true"
                     FixedHeader="true" ColumnResizeMode="ResizeMode.Column"
                     HeaderClass="custom-header" Filterable="false"
                     SortMode="@SortMode.None" Groupable="false" Items="ExceptionMatchItems">
            <Columns>
                <PropertyColumn Property="x => x.Num" Title="" />
                <PropertyColumn Property="x => x.Keywords" Title="包含关键字" />
                <PropertyColumn Property="x => x.CustomRegex" Title="自定义正则" />
                <PropertyColumn Property="x => x.DataSource" Title="数据源" />
                <PropertyColumn Property="x => x.ExceptionTypeName" Title="异常类型" />
                <PropertyColumn Property="x => x.Priority" Title="判断优先级" />
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudStack Row>
                            <MudButton OnClick="@(e => { _isEdit = true; _exceptionMatchEditorIsVisible=true; SelectExceptionMatchInfo = context.Item;})" Style="background-color:#3763E8; color:white; border-radius:10px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Inherit">编辑</MudButton>
                            <MudButton OnClick="()=>{DeleteExceptionMatch(context.Item);}" Style="background-color:firebrick;color:white;border-radius:10px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Inherit">删除</MudButton>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

        </MudDataGrid>
    </div>
</MudPaper>
<style>
    .custom-row {
        height: 20px; /* 设置你想要的行高 */
        max-height: 20px;
    }
</style>
@code {
    [Inject] private IDialogService DialogService { get; set; }
    public static string? BaseUrl { get; set; }
    private bool _exceptionEditorIsVisible = false;
    private bool _exceptionMatchEditorIsVisible = false;
    private bool _exceptionTypeLoaded = true;
    private bool _exceptionMatchLoaded = true;
    private bool _isEdit = false;
    public ExceptionInfoItemModel SelectExceptionInfo = new();
    public ExceptionMatchItemModel SelectExceptionMatchInfo = new();
    public List<ExceptionInfoItemModel> ExceptionInfoItems = new();
    public List<ExceptionMatchItemModel> ExceptionMatchItems = new() {
        new ExceptionMatchItemModel()
        {
            Num = 1,

            Keywords = "关键字示例",
            CustomRegex = @"\d{3}-\d{2}-\d{4}",
            DataSource = DataSourceType.ResponseContent,
            ExceptionTypeName = "示例异常类型",

        }
    };
    protected override void OnInitialized() {
        base.OnInitialized();
        BaseUrl ??= Configuration.GetValue<string>("BaseUrl");
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        GetExceptionTypes();
        GetExceptionMatchItems();
    }

    private async void GetExceptionTypes() {
        if (_exceptionTypeLoaded) {
            _exceptionTypeLoaded = false;
            CloudApiRequest.SetBaseUrl(BaseUrl ?? string.Empty);
            ExceptionInfoItems.Clear();
            var (key, value) = await CloudApiRequest.ExceptionTypes();
            if (key && value is ApiResult result) {
                try {
                    var itemModels = JsonConvert.DeserializeObject<List<ExceptionInfoItemModel>>(result.Data?.ToString() ?? string.Empty);
                    if (itemModels is not null) {

                        for (var i = 0; i < itemModels.Count; i++) {
                            itemModels[i].Num = i + 1;
                        }

                        ExceptionInfoItems.AddRange(itemModels);
                    }
                }
                catch (Exception e) {



                    Snackbar.Add(e.Message, Severity.Error);
                }

            }
            else if (value is ApiResult apiResult) {



                Snackbar.Add(apiResult.Msg, Severity.Error);
            }
            else {
                Snackbar.Add(value.ToString(), Severity.Error);
            }
            _exceptionTypeLoaded = true;
            StateHasChanged();
        }
    }


    private async void EditExceptionTypeHandleConfirm(ExceptionInfoItemModel obj) {

        if (string.IsNullOrEmpty(obj.ExceptionName) ||
            string.IsNullOrEmpty(obj.ExceptionColor)) {
            Snackbar.Clear();
            Snackbar.Add("名称和颜色皆不能为空", Severity.Error);
            return;

        }
        _exceptionEditorIsVisible = false;
        if (_isEdit) {
            //修改
            var (key, value) = await CloudApiRequest.UpdateExceptionType(obj.Id,
                obj.ExceptionName,
                obj.ExceptionColor);
            if (key && value is ApiResult result) {
                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            }
            else if (value is ApiResult apiResult) {

                Snackbar.Add(apiResult.Msg, Severity.Error);
            }
            else {

                Snackbar.Add(value.ToString(), Severity.Error);
            }
        }
        else {
            //新增
            var (key, value) = await CloudApiRequest.AddExceptionType(
                obj.ExceptionName,
                obj.ExceptionColor);
            if (key && value is ApiResult result) {

                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            }
            else if (value is ApiResult apiResult) {


                Snackbar.Add(apiResult.Msg, Severity.Error);
            }
            else {
                Snackbar.Add(value.ToString(), Severity.Error);



            }
        }
        GetExceptionTypes();

    }

    public async void DeleteExceptionType(ExceptionInfoItemModel obj) {
        var (key, value) = await CloudApiRequest.DeleteExceptionType(obj.Id);
        if (key && value is ApiResult result) {

            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (result.Result) {

                GetExceptionTypes();
            }
        }
        else if (value is ApiResult apiResult) {

            Snackbar.Add(apiResult.Msg, Severity.Error);
        }
        else {

            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

    private async void GetExceptionMatchItems() {
        if (_exceptionMatchLoaded) {
            _exceptionTypeLoaded = false;
            CloudApiRequest.SetBaseUrl(BaseUrl ?? string.Empty);
            ExceptionMatchItems.Clear();
            var (key, value) = await CloudApiRequest.ExceptionRule();
            if (key && value is ApiResult result) {
                try {
                    var itemModels = JsonConvert.DeserializeObject<List<ExceptionMatchItemModel>>(result.Data?.ToString() ?? string.Empty);
                    if (itemModels is not null) {
                        var exceptionMatchItemModels = itemModels.Select((s, i) => new ExceptionMatchItemModel {
                                Num = i + 1,
                                CustomRegex = s.CustomRegex,
                                ExceptionTypeId = s.ExceptionTypeId,
                                DataSource = s.DataSource,
                                Keywords = s.Keywords,
                                Id = s.Id,
                                Priority = s.Priority,
                                ExceptionTypeName = ExceptionInfoItems.FirstOrDefault(f => f.Id.Equals(s.ExceptionTypeId))?.ExceptionName ?? string.Empty,
                            }).ToList();


                        ExceptionMatchItems.AddRange(exceptionMatchItemModels);
                    }
                }
                catch (Exception e) {



                    Snackbar.Add(e.Message, Severity.Error);
                }
            }
            else if (value is ApiResult apiResult) {



                Snackbar.Add(apiResult.Msg, Severity.Error);
            }
            else {
                Snackbar.Add(value.ToString(), Severity.Error);
            }
            _exceptionMatchLoaded = true;
            StateHasChanged();
        }
    }

    public async void EditExceptionMatchHandleConfirm(ExceptionMatchItemModel obj) {
        if (string.IsNullOrEmpty(obj.CustomRegex) &&
            string.IsNullOrEmpty(obj.Keywords)) {
            Snackbar.Clear();
            Snackbar.Add("正则表达式和关键字不能同时为空", Severity.Error);
            return;

        }
        if (obj.ExceptionTypeId <= 0) {
            Snackbar.Clear();
            Snackbar.Add("异常类型不能为空", Severity.Error);
            return;
        }
        _exceptionMatchEditorIsVisible = false;
        if (_isEdit) {
            //修改
            var (key, value) = await CloudApiRequest.UpdateExceptionRule(obj.Id,
                obj.Keywords, obj.CustomRegex,
                (int)obj.DataSource, obj.ExceptionTypeName,
                obj.ExceptionTypeId, obj.Priority);
            if (key && value is ApiResult result) {
                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            }
            else if (value is ApiResult apiResult) {

                Snackbar.Add(apiResult.Msg, Severity.Error);
            }
            else {

                Snackbar.Add(value.ToString(), Severity.Error);
            }
        }
        else {
            //新增

            var (key, value) = await CloudApiRequest.AddExceptionRule(
                obj.Keywords, obj.CustomRegex,
                (int)obj.DataSource, obj.ExceptionTypeName,
                obj.ExceptionTypeId, obj.Priority);
            if (key && value is ApiResult result) {
                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            }
            else if (value is ApiResult apiResult) {

                Snackbar.Add(apiResult.Msg, Severity.Error);
            }
            else {

                Snackbar.Add(value.ToString(), Severity.Error);
            }
        }
        GetExceptionMatchItems();
    }

    public async void DeleteExceptionMatch(ExceptionMatchItemModel obj) {
        var (key, value) = await CloudApiRequest.DeleteExceptionRule(obj.Id);
        if (key && value is ApiResult result) {

            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (result.Result) {

                GetExceptionMatchItems();
            }
        }
        else if (value is ApiResult apiResult) {

            Snackbar.Add(apiResult.Msg, Severity.Error);
        }
        else {

            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

}
