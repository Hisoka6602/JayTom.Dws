@page "/video-player-test"

@using System.Diagnostics
@using System.Runtime.InteropServices
@using JayTom.Dws.Camera.Cameras.SecurityCamera.DaHuatech.NVR
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@inject IJSRuntime JSRuntime

<h3>视频播放器测试</h3>

<div>
    <video @ref="videoPlayer" width="640" controls>
        <source src="https://v3.cdnpk.net/videvo_files/video/free/2014-12/large_preview/Raindrops_Videvo.mp4" type="video/mp4">
        您的浏览器不支持 HTML5 视频标签。
    </video>
</div>
<div>
    <SKCanvasView @ref="canvasView" OnPaintSurface="OnPaintSurface" />
</div>

<div>
    <button @onclick="PlayVideo">播放</button>
    <button @onclick="PauseVideo">暂停</button>
    <button @onclick="StopVideo">停止</button>
</div>

@code {
    private SKBitmap _videoFrame;
    private SKCanvasView canvasView;
    private DaHuatechNVR _daHuatechNvr = DaHuatechNVR.Instance;

    protected override async Task OnInitializedAsync() {
        await _daHuatechNvr.LogIn("192.168.31.111", 37777, "admin", "a12345678");
        await base.OnInitializedAsync();

    }


    private async void PlayVideo() {

        await _daHuatechNvr.StartRealTimePreview("192.168.31.111", 1, async info => {
            try {
                // 将 RGB 数据转换为 RGBA 数据
                var rgbaData = ConvertRgbToRgba(info.RgbData, info.Width, info.Height);

                var stopwatch = new System.Diagnostics.Stopwatch();
                stopwatch.Start();

                // 更新 SKCanvasView 的内容
                await InvokeAsync(() => UpdateCanvas(rgbaData, info.Width, info.Height));

                stopwatch.Stop();
                var elapsedTime = stopwatch.ElapsedMilliseconds;
                Debug.WriteLine($"C# Total time: {elapsedTime} ms");
            }
            catch (Exception ex) {
                Console.WriteLine($"Error during video playback: {ex.Message}");
            }

        });


    }

    private void PauseVideo() {
        // 使用JS调用暂停方法

    }


    private void StopVideo() {
        // 使用JS调用停止方法


    }

    private void UpdateCanvas(byte[] rgbaData, int width, int height) {
        // 创建一个 SKColor 数组来存储 RGBA 数据
        var colorData = new SKColor[width * height];

        for (int i = 0; i < colorData.Length; i++) {
            byte r = rgbaData[i * 4];
            byte g = rgbaData[i * 4 + 1];
            byte b = rgbaData[i * 4 + 2];
            byte a = rgbaData[i * 4 + 3];
            colorData[i] = new SKColor(r, g, b, a);
        }

        // 创建 SKBitmap 并设置像素数据
        _videoFrame = new SKBitmap(width, height, SKColorType.Rgba8888, SKAlphaType.Premul);
        _videoFrame.SetPixels(colorData);

        // 标记组件需要重新渲染
        StateHasChanged();
    }


    private static byte[] ConvertRgbToRgba(byte[] rgbData, int width, int height) {
        var rgbaData = new byte[width * height * 4];
        Parallel.For(0, height, y => {
            int srcIndex = y * width * 3;
            int dstIndex = y * width * 4;
            for (int x = 0; x < width; x++) {
                rgbaData[dstIndex] = rgbData[srcIndex]; // R
                rgbaData[dstIndex + 1] = rgbData[srcIndex + 1]; // G
                rgbaData[dstIndex + 2] = rgbData[srcIndex + 2]; // B
                rgbaData[dstIndex + 3] = 255; // A
                srcIndex += 3;
                dstIndex += 4;
            }
        });
        return rgbaData;
    }

}