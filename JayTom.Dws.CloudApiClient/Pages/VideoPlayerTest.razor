    private byte[] ConvertRgbToRgba(byte[] rgbData, int width, int height) {
        var pixelCount = width * height;
        var rgbaData = new byte[pixelCount * 4];

        // 使用 Parallel.For 并行处理每个像素
        Parallel.For(0, pixelCount, i => {
            var rgbIndex = i * 3;  // RGB数据的索引
            var rgbaIndex = i * 4; // RGBA数据的索引

            rgbaData[rgbaIndex] = rgbData[rgbIndex];       // R
            rgbaData[rgbaIndex + 1] = rgbData[rgbIndex + 1]; // G
            rgbaData[rgbaIndex + 2] = rgbData[rgbIndex + 2]; // B
            rgbaData[rgbaIndex + 3] = 255;                  // A (完全不透明)
        });

        return rgbaData;
    }

