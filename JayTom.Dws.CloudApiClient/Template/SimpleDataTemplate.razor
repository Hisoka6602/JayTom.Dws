@using System.Diagnostics.CodeAnalysis
@using System.Drawing
<link href="Font/iconfont.css" rel="stylesheet" />
<div>
    <MudCard Style="width:200px;height:180px; position: relative; border-radius:15px;">
        <MudCardContent>
            <div style="display: flex; flex-direction: column; justify-content: center; align-items: center;">

                <div style="margin:5px; display: flex; align-items: center; justify-content: center;position: relative; width:70px;height:70px;background-color: @TrayColor; border-radius: 50%;x">
                    <span class=@Icon style="color: @IconColor; font-size: 35px; "></span>
                </div>
                <div style="margin-bottom:5px;display: flex; justify-content: center;">
                    <span style="font-weight:bold; font-size: 30px;  margin-right:3px;">@Value</span>
                    <span style="color:gray;font-size: 12px;align-self: flex-end; margin-bottom:7px;">@Unit</span>
                </div>


                <span style="color:gray;font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@Description</span>
            </div>


        </MudCardContent>
    </MudCard>
</div>
@code {
    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]

    public string IconColor { get; set; } = "red";
    [Parameter]
    public string Value { get; set; } = "0";

    [Parameter]
    public string Description { get; set; } = string.Empty;
    [Parameter]
    public string Unit { get; set; } = string.Empty;
    [Parameter]
    public string TrayColor { get; set; } = string.Empty;

}