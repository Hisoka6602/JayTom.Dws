@using JayTom.Dws.LicenseApiClient.Api
@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Plugin.Excel
@using JayTom.Dws.LicenseApiClient.Editors
@inject IExcelService ExcelService
@inject ILicenseApiRequest LicenseApiRequest
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
<MudDialog Style="width:1600px;height:800px; border-radius:5px;">
    <DialogContent>
        <MudOverlay Visible="AuthCodeEditorIsVisible" DarkBackground="true">

            <AuthCodeEditor IsSuperAdministrator="true" TenantItems="TenantItems" AuthCodeInfo="AuthCodeInfo" IsEdit="AuthCodeIsEdit" AppTemplateItemItems="AppTemplateItemItems" OnConfirm="HandleConfirm" OnCancel="() => { AuthCodeEditorIsVisible = false; }" />

        </MudOverlay>
        <MudOverlay Visible="LicenseRenewalEditorIsVisible" DarkBackground="true">

            <LicenseRenewalEditor Info="@SelectInfoModel" OnConfirm="HandleLicenseRenewalConfirm" OnCancel="() => { LicenseRenewalEditorIsVisible = false; }" />

        </MudOverlay>
        <MudOverlay Visible="MachineCodeEditorsIsVisible" DarkBackground="true">

            <MachineCodeEditors LicenseCodeItemInfo="@SelectInfoModel" OnConfirm="MachineCodeConfirm" />

        </MudOverlay>
        <MudOverlay Visible="LicenseFileEditorIsVisible" DarkBackground="true">

            <LicenseFileEditor OnConfirm="LicenseFileConfirm" OnCancel="() => { LicenseFileEditorIsVisible = false; }" />

        </MudOverlay>
        @if (_loading) {
            <MudProgressCircular Indeterminate="true"></MudProgressCircular>
        }
        else {
            <MudDataGrid T="LicenseCodeItemInfoModel" Height="700px" FixedHeader="true"
                         Elevation="1" Class="custom-datagrid" Filterable="false"
                         SortMode="@SortMode.None" QuickFilter="@Filter" Hover="true"
                         GroupExpanded="false" Groupable="@IsGrouping"
                         Items="@_items" ColumnResizeMode="ResizeMode.Column">
                <ToolBarContent>

                    <MudToggleGroup Rounded="true" T="bool" Style=" height:35px;margin:10px;" SelectionMode="SelectionMode.ToggleSelection" @bind-Value="IsGrouping" Color="Color.Primary" On>
                        <MudToggleItem Value="@(false)" Text="列表显示" />
                        <MudToggleItem Value="@(true)" Text="分组显示" />
                    </MudToggleGroup>

                    <MudBadge Bordered="true" Content="@_items.Count()" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
                        <MudButton OnClick="() => { Filter = _quickFilter; }" Style="background-color: #19A98C;color:white" Color="Color.Surface">全部</MudButton>
                    </MudBadge>
                    <MudBadge Bordered="true" Content="@_items.Count(s => DateTime.Now.CompareTo(s.ExpirationDate) >= 0)" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
                        <MudButton OnClick="() => { Filter = x => { return DateTime.Now.CompareTo(x.ExpirationDate) >= 0; }; }" Style="background-color: red;color:white" Color="Color.Surface">已过期</MudButton>
                    </MudBadge>
                    <MudBadge Bordered="true" Content="@_items.Count(s => DateTime.Now.CompareTo(s.ExpirationDate) < 0 && DateTime.Now.AddDays(3).CompareTo(s.ExpirationDate) >= 0)" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
                        <MudButton OnClick="() => { Filter = x => { return DateTime.Now.CompareTo(x.ExpirationDate) < 0 && DateTime.Now.AddDays(3).CompareTo(x.ExpirationDate) >= 0; }; }" Style="background-color: orangered;color:white" Color="Color.Surface">近3天到期</MudButton>
                    </MudBadge>
                    <MudBadge Bordered="true" Content="@_items.Count(s => DateTime.Now.AddDays(3).CompareTo(s.ExpirationDate) < 0 && DateTime.Now.AddDays(7).CompareTo(s.ExpirationDate) >= 0)" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
                        <MudButton OnClick="() => { Filter = x => { return DateTime.Now.AddDays(3).CompareTo(x.ExpirationDate) < 0 && DateTime.Now.AddDays(7).CompareTo(x.ExpirationDate) >= 0; }; }" Style="background-color: orange;color:white" Color="Color.Surface">近7天到期</MudButton>
                    </MudBadge>
                    <MudBadge Bordered="true" Content="@_items.Count(s => DateTime.Now.AddDays(10).CompareTo(s.ExpirationDate) < 0 && DateTime.Now.AddMonths(1).CompareTo(s.ExpirationDate) >= 0)" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
                        <MudButton OnClick="() => { Filter = x => { return DateTime.Now.AddDays(10).CompareTo(x.ExpirationDate) < 0 && DateTime.Now.AddMonths(1).CompareTo(x.ExpirationDate) >= 0; }; }" Style="background-color: mediumorchid;color:white" Color="Color.Surface">近一个月到期</MudButton>
                    </MudBadge>

                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="模糊搜索" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>

                <Columns>
                    <PropertyColumn Property="x => x.Num" Title="" />
                    <PropertyColumn Property="x => x.LicenseCode" Title="授权码" />
                    <PropertyColumn Style="width:50px" Property="x => x.MaxClientCount" Title="上限数量" />
                    <PropertyColumn Style="width:50px" Property="x => x.ActivatedClientCount" Title="已激活数量" />
                    <PropertyColumn Style="width:50px" Property="x => (x.MaxBindingScannerCount*x.MaxClientCount)" Title="扫码器上限" />
                    <PropertyColumn Property="x => x.ExpirationDate" Title="到期时间" />
                    <PropertyColumn Property="x => x.ClientName" Title="客户" />
                    @if (@IsGrouping) {
                        <PropertyColumn Property="x => x.GroupName" GroupBy="@_groupBy" Grouping="@IsGrouping" Hidden="IsGrouping">
                            <GroupTemplate>
                                <span style="font-weight:bold" @key="IsGrouping">
                                    客户名: @context.Grouping.Key
                                    <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                                        数量 @context.Grouping.Count()
                                    </MudChip>
                                    <MudButton Style="border-radius: 15px; margin-left:3px;font-weight:600" Size="@Size.Small" Variant="Variant.Outlined" Color="@Color.Primary"
                                               OnClick="@(args => ExportGroupDetailedInfo(context.Grouping.Key.ToString()))">导出Excel</MudButton>
                                </span>

                            </GroupTemplate>
                        </PropertyColumn>
                    }
                    else {
                        @*<PropertyColumn Property="x => x.ClientName" Title="客户" />*@
                    }
                    <TemplateColumn Title="是否可用">
                        <CellTemplate>
                            <MudStack Row Style="text-align:center;width:40px">
                                <MudCheckBox Checked="@(context.Item.IsAvailable && DateTime.Now.CompareTo(context.Item.ExpirationDate) < 0)" Disabled="true" />

                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn>
                        <CellTemplate>
                            <MudStack Row Style="text-align:center;width:450px">
                                <MudButton Style="border-radius: 15px; margin-left:3px; background-color:dodgerblue;color:white" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Surface" OnClick="@(e => { AuthCodeEditorIsVisible = true; AuthCodeIsEdit = true; AuthCodeInfo = new AuthCodeInfoModel() {
                            ClientName = context.Item.ClientName,
                            ExpirationDate = context.Item.ExpirationDate,
                            UserCode=context.Item.UserCode,
                            TemplateInfoId=AppTemplateItemItems.FirstOrDefault(f=>f.TemplateName.Equals(context.Item.TemplateName))?.Id??0,
                            MaxClientCount = context.Item.MaxClientCount};
                            SelectInfoModel = context.Item; })">编辑</MudButton>
                                <MudButton Style="border-radius: 15px; margin-left:3px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Tertiary" OnClick="() => {SelectInfoModel = context.Item; MachineCodeEditorsIsVisible = true; }">详细信息</MudButton>
                                <MudButton Style="border-radius: 15px; margin-left:3px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Success" OnClick="() => {SelectInfoModel = context.Item; LicenseRenewalEditorIsVisible = true; }">续期</MudButton>
                                <MudButton OnClick="() => { FreezeLicenseCode(context.Item); }" Style="border-radius: 15px; margin-left:3px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@ConvertStatusButtonColor(context.Item.IsAvailable)">@ConvertStatusButtonText(context.Item.IsAvailable)</MudButton>
                                <MudButton Style="border-radius: 15px; margin-left:3px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Dark" OnClick="() =>{LicenseFileEditorIsVisible = true;SelectInfoModel = context.Item;}">生成授权文件</MudButton>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>


            </MudDataGrid>
        }

    </DialogContent>
</MudDialog>
@code {
    [Inject] private IDialogService DialogService { get; set; }

    [Parameter]
    public string UserCode { get; set; } = string.Empty;
    [Parameter]
    public string TemplateName { get; set; }

    public bool AuthCodeEditorIsVisible { get; set; }
    public bool LicenseRenewalEditorIsVisible { get; set; }
    public bool MachineCodeEditorsIsVisible { get; set; }
    public bool LicenseFileEditorIsVisible { get; set; }
    public bool AuthCodeIsEdit { get; set; }

    private bool _loading;
    public List<UserInfo> TenantItems { get; set; } = new();
    public AuthCodeInfoModel AuthCodeInfo { get; set; } = new();
    public LicenseCodeItemInfoModel SelectInfoModel { get; set; } = new();
    public List<AppTemplateItemInfoModel> AppTemplateItemItems { get; set; } = new();
    private List<LicenseCodeItemInfoModel> _items = new();
    private bool _isGrouping;
    private bool IsGrouping {
        get => _isGrouping;
        set {
            if (_isGrouping != value) {
                _isGrouping = value;
                _groupBy = x => x.ClientName;
                StateHasChanged();
            }
        }
    }
    private string _searchString = string.Empty;
    Func<LicenseCodeItemInfoModel, object> _groupBy = x => x.GroupName;
    public Func<LicenseCodeItemInfoModel, bool>? Filter { get; set; }
    private Func<LicenseCodeItemInfoModel, bool> _quickFilter => x => {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.ClientName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.LicenseCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.UserName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return x.MachineCodeItem?.Any(f => f.MachineCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) == true;
    };
    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        _loading = true;
        await GetLicenseInfos();
        _loading = false;
    }


    public async void ExportGroupDetailedInfo(string groupName) {
        var licenseCodeItemInfoModels = _items.Where(w => w.ClientName.Equals(groupName)).ToList();


        var (key, value) = await ExcelService.Export(groupName, "授权码分组信息", licenseCodeItemInfoModels,
            new List<string>() { },
            p => {

            }, async ex => {
                await DialogService.ShowMessageBox(
                "导出异常",
                ex.Message);
            });
        if (key && value is not null) {
            var fileName = "授权码列表.xlsx";

            await JSRuntime.InvokeVoidAsync("saveAsFile",
                fileName, Convert.ToBase64String(value),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }

    }
    public async Task FreezeLicenseCode(LicenseCodeItemInfoModel info) {

        var (key, value) = await LicenseApiRequest.FreezeLicenseCode(info.LicenseCode, info.IsAvailable);
        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {
                await GetLicenseInfos();
                StateHasChanged();
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }
    private async Task GetLicenseInfos() {
        var (key, value) = await LicenseApiRequest.LicenseCodeData();
        if (key && value is List<LicenseCodeItemInfoModel> items) {
            _items.Clear();
            var licenseCodeItemInfoModels = items?.OrderByDescending(o => o.CreateTime)
                ?.Where(w => w.UserCode.Equals(UserCode) && w.TemplateName.Equals(TemplateName))
                ?.Select((s, i) => new LicenseCodeItemInfoModel {
                        ActivatedClientCount = s.ActivatedClientCount,
                        TemplateName = s.TemplateName,
                        LicenseCode = s.LicenseCode,
                        MachineCodeItem = s.MachineCodeItem,
                        MaxClientCount = s.MaxClientCount,
                        IsAvailable = s.IsAvailable,
                        ExpirationDate = s.ExpirationDate,
                        ClientName = s.ClientName,
                        GroupName = s.GroupName,
                        UserName = s.UserName,
                        UserCode = s.UserCode,
                        MaxBindingScannerCount = s.MaxBindingScannerCount,
                        Num = i + 1
                    })?.ToList() ?? new List<LicenseCodeItemInfoModel>();
            _items.AddRange(licenseCodeItemInfoModels);


        }
        else if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }
    private async void HandleConfirm(AuthCodeInfoModel info) {
        AuthCodeEditorIsVisible = false;
        //提交到Api
        //AuthCodeInfoModel
        //效验数据是否为空
        if (info.TemplateInfoId <= 0) {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("模板不能为空", Severity.Error);
            return;

        }
        else if (info.MaxClientCount <= 0) {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("客户端上限数据必须大于0", Severity.Error);
            return;
        }
        else if (info.ExpirationDate is null) {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("到期时间不能为空", Severity.Error);
            return;
        }
        else if (string.IsNullOrEmpty(info.ClientName)) {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("客户名称不能为空", Severity.Error);
            return;
        }
        KeyValuePair<bool, object> keyValuePair;
        //判断是否批量
        if (info.IsGroupedBatchGeneration && !AuthCodeIsEdit) {

            keyValuePair = await LicenseApiRequest.BulkCreateLicenseCode(info.TemplateInfoId,
                info.ExpirationDate.Value,
                info.ClientName,
                info.AuthCodeGenerationCount,
                info.UserCode, info.MaxBindingScannerCount);
        }
        else {
            if (!AuthCodeIsEdit) {
                keyValuePair = await LicenseApiRequest.CreateLicenseCode(info.TemplateInfoId, info.MaxClientCount,
                    info.ExpirationDate.Value, info.ClientName, info.UserCode, info.MaxBindingScannerCount);
            }
            else {
                keyValuePair = await LicenseApiRequest.UpdateLicenseCode(info.TemplateInfoId, info.UserCode ?? string.Empty, SelectInfoModel.LicenseCode, info.MaxClientCount,
                    info.ExpirationDate.Value, info.ClientName, info.MaxBindingScannerCount);
            }
        }


        if (keyValuePair.Value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (keyValuePair.Key) {

                await GetLicenseInfos();
                StateHasChanged();
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(keyValuePair.Value.ToString(), Severity.Error);
        }
    }
    private async void HandleLicenseRenewalConfirm(RenewalLicenseCodeInfo info) {
        LicenseRenewalEditorIsVisible = false;
        var (key, value) = await LicenseApiRequest.ExtendLicenseCodeValidity(info.Info.LicenseCode,
            info.Info.ExpirationDate.AddDays(info.Days));
        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {
                await GetLicenseInfos();
                StateHasChanged();
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
        //提交到Api
        //AuthCodeInfoModel
    }
    private async void MachineCodeConfirm() {
        MachineCodeEditorsIsVisible = false;
        await GetLicenseInfos();
        StateHasChanged();
    }
    private async void LicenseFileConfirm(MachineCodeItemInfo machineCodeInfo) {
        if (!string.IsNullOrEmpty(machineCodeInfo.MachineCode)) {

            var (key, value) = await LicenseApiRequest.DownloadLicenseFile(SelectInfoModel.LicenseCode, machineCodeInfo.MachineCode, machineCodeInfo.Remarks);
            if (value is ApiResult result) {

                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
                if (key) {
                    await JSRuntime.InvokeVoidAsync("window.open", result.Data.ToString(), "_blank");
                }
            }
            else {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(value.ToString(), Severity.Error);
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("机器码不能为空", Severity.Error);
        }
        LicenseFileEditorIsVisible = false;
    }
    private Color ConvertStatusButtonColor(bool status) {
        if (status) {

            return Color.Error;
        }
        else {
            return Color.Primary;
        }
    }
    private string ConvertStatusButtonText(bool status) {
        if (status) {

            return "冻结";
        }
        else {
            return "激活";
        }
    }
}
