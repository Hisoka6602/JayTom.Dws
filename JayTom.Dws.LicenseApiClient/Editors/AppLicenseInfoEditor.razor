@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Api
@inject ILicenseApiRequest LicenseApiRequest
@inject ISnackbar Snackbar
<MudPaper Elevation="0">

    <MudOverlay Visible="_updateTenantLicenseMaxCountEditorIsVisible" DarkBackground="true">

        <UpdateTenantLicenseMaxCountEditor MaxCount="@_maxLicenseCodeCount" OnCancel="() => { _updateTenantLicenseMaxCountEditorIsVisible=false;}" OnConfirm="HandleUpdateConfirm" />

    </MudOverlay>
    <MudCard Style="width:1000px;height:730px; border-radius:5px;">
        <MudCardContent Class="center">

            <div style="display: flex;margin-top:10px;margin-bottom:20px;display: flex; align-items: center;">
                <img src="@UserInfo.UserIcon" alt="用户头像" style="width: 30px; height: 30px; border-radius: 50%;" />
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">@UserInfo.UserName</span>
            </div>
            <div style="display: flex;margin-top:10px;margin-bottom:20px;display: flex; align-items: center;">
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">@UserInfo.CompanyName</span>
            </div>
            @*列表*@
            <div>
                <MudTable Height="540px" Breakpoint="Breakpoint.Sm" FixedHeader="true" Style="width:970px;min-height:360px;max-height:540px;" Items="@UserInfo.AppLicenseInfos"
                          Dense="false" Hover="true" CanCancelEdit="true">


                    <HeaderContent>
                        <MudTh>程序模板名称</MudTh>
                        <MudTh>授权码上限</MudTh>
                        <MudTh>创建数量</MudTh>
                        <MudTh>激活数量</MudTh>
                        <MudTh>管理</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="程序模板名称">@ConvertTemplateName(context.LicensePermissionTemplateInfoId ?? 0)</MudTd>
                            <MudTd DataLabel="授权码上限">@context.MaxLicenseCodeCount</MudTd>
                            <MudTd DataLabel="创建数量">@ConvertLicenseCodeCount(context.LicensePermissionTemplateInfoId ?? 0)</MudTd>
                            <MudTd DataLabel="激活数量">@ConvertLicenseCodeUsedCount(context.LicensePermissionTemplateInfoId ?? 0)</MudTd>
                            <MudTd>
                                @*解绑*@
                                <MudButton OnClick="() => { UpdateTenantLicenseMaxCount(UserInfo.UserCode, context.LicensePermissionTemplateInfoId??0,context.MaxLicenseCodeCount); }" Style="border-radius: 15px; margin-left:3px; background-color:slateblue;color:white" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Surface">设置授权码上限</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

            </MudCardContent>
            <MudCardActions Class="card-actions-right">
                <MudButton Style="margin-right:10px" Variant="Variant.Filled" OnClick="Confirm" Color="Color.Primary">确定</MudButton>
            </MudCardActions>
        </MudCard>
    </MudPaper>

    <style>
        .card-actions-right {
            margin-right: 10px;
            display: flex;
            justify-content: flex-end;
            align-items: flex-end;
        @*height: 95%; width: 99%;*@
        }
    </style>

    @code {
    [Parameter]
    public TenantItemInfoModel UserInfo { get; set; } = new();
    [Parameter]
    public List<AppTemplateItemInfoModel> AppTemplateItems { get; set; } = new();
    [Parameter]
    public EventCallback<AuthCodeInfoModel> OnConfirm { get; set; }
    [Parameter]
    public List<LicenseCodeItemInfoModel> LicenseCodeItems { get; set; } = new();

    private long _selectTemplateInfoId;
    private string _userCode = string.Empty;
    private int _maxLicenseCodeCount;
    private bool _updateTenantLicenseMaxCountEditorIsVisible = false;
    private async void Confirm() {

        await OnConfirm.InvokeAsync();
    }

    private string ConvertTemplateName(long licensePermissionTemplateInfoId) {
        var appTemplateItemInfoModel = AppTemplateItems.FirstOrDefault(f => f.Id.Equals(licensePermissionTemplateInfoId));
        return appTemplateItemInfoModel is null ? "未知" : appTemplateItemInfoModel.TemplateName;
    }
    private int ConvertLicenseCodeCount(long licensePermissionTemplateInfoId) {
        var appTemplateItemInfoModel = AppTemplateItems.FirstOrDefault(f => f.Id.Equals(licensePermissionTemplateInfoId));

        if (appTemplateItemInfoModel is null) {
            return 0;

        }
        return LicenseCodeItems.Where(w => w.TemplateName.Equals(appTemplateItemInfoModel.TemplateName) && w.UserCode.Equals(UserInfo.UserCode))?
            .Sum(s => s.MaxClientCount) ?? 0;

    }
    private int ConvertLicenseCodeUsedCount(long licensePermissionTemplateInfoId) {
        var appTemplateItemInfoModel = AppTemplateItems.FirstOrDefault(f => f.LicenseApplicationInfoId.Equals(licensePermissionTemplateInfoId));
        if (appTemplateItemInfoModel is null) {
            return 0;

        }

        return LicenseCodeItems.Where(w => w.TemplateName.Equals(appTemplateItemInfoModel.TemplateName) && w.UserCode.Equals(UserInfo.UserCode))?
            .Sum(s => s.ActivatedClientCount) ?? 0;
    }
    private void UpdateTenantLicenseMaxCount(string userCode, long licensePermissionTemplateInfoId, int maxLicenseCodeCount) {

        //弹出上限设置
        _selectTemplateInfoId = licensePermissionTemplateInfoId;
        _userCode = userCode;
        _maxLicenseCodeCount = maxLicenseCodeCount;
        _updateTenantLicenseMaxCountEditorIsVisible = true;


    }

    private async void HandleUpdateConfirm(int count) {
        _updateTenantLicenseMaxCountEditorIsVisible = false;
        var (key, value) = await LicenseApiRequest.UpdateTenantLicenseMaxCount(_userCode, _selectTemplateInfoId, count);

        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {

                await GetTenantInfo(_userCode);
                StateHasChanged();
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }

    }
    private async Task GetTenantInfo(string userCode) {
        var (key, value) = await LicenseApiRequest.TenantInfos();

        if (key && value is List<JayTom.Dws.LicenseApiClient.Data.Models.UserInfo> items) {
            UserInfo = items.Select((s, i) => new TenantItemInfoModel {
                    LicenseCodeCount = s.LicenseCodeInfos?.Count ?? 0,
                    UserCode = s.UserCode,
                    UserIcon = s.UserIcon,
                    UserName = s.UserName,
                    Phone = s.Phone,
                    Status = s.Status,
                    RegisterTime = s.RegisterTime,
                    MaxLicenseCodeCount = s.AppLicenseInfos.Sum(s1 => s1.MaxLicenseCodeCount),
                    LicenseCodeInfos = s.LicenseCodeInfos ?? new List<LicenseCodeItemInfoModel>(),
                    AppLicenseInfos = s.AppLicenseInfos ?? new List<LicenseAppLicenseInfoModel>(),
                    Num = i + 1
                })?.FirstOrDefault(f => f.UserCode.Equals(userCode)) ?? new TenantItemInfoModel();
        }
        else if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }
    }
