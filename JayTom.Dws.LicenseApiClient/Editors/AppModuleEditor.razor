@using JayTom.Dws.LicenseApiClient.Data.Models
<div>

    <MudCard Style="width:600px;height:730px; border-radius:20px;">
        <MudCardContent Class="center">

            <div style="width:260px; margin:auto; width:100%;">
                @*图标*@
                <div class="center">
                    <MudFileUpload T="IBrowserFile"
                                   Accept=".png, .jpg"
                                   OnFilesChanged="OnInputFileChanged"
                                   Hidden="@false"
                                   InputStyle="opacity:0"
                                   @ref="_mudFileUpload">
                        <ButtonTemplate>
                            <MudButton HtmlTag="label"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       for="@context.Id">
                                <MudImage Style="width: 70px; height: 70px;" Src="@ImagePath" Elevation="2" Class="rounded-lg"></MudImage>
                            </MudButton>
                        </ButtonTemplate>
                    </MudFileUpload>
                </div>

                <MudTextField FullWidth="true" @bind-Value="CurrentApplicationInfo.ApplicationName" Label="应用程序名称" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>


            </div>

        </MudCardContent>
        <MudTextField Lines="3" FullWidth="true" Style="margin-left:20px; margin-right:20px; height:80px" @bind-Value="CurrentApplicationInfo.Description" Label="程序描述" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
        @*列表*@
        <div>
            <MudTable @ref="_table" Height="360px" Breakpoint="Breakpoint.Sm" FixedHeader="true" Style="width:600px;min-height:360px;max-height:360px;" Items="@CurrentApplicationInfo.LicenseFeatureInfos"
                      Dense="false" Hover="true" CanCancelEdit="true"
                      SelectOnRowClick="true"
                      RowEditPreview="BackupItem" RowEditCancel="ResetItemToOriginalValues"
                      IsEditRowSwitchingBlocked="true"
                      ApplyButtonPosition="@applyButtonPosition"
                      EditButtonPosition="@editButtonPosition"
                      EditTrigger="@editTrigger">
                <HeaderContent>
                    <MudTh>序号</MudTh>
                    <MudTh>模块名称</MudTh>
                    <MudTh>模块Guid</MudTh>
                    <MudTh>说明</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="序号">@context.Num</MudTd>
                        <MudTd DataLabel="模块名称">@context.FeatureName</MudTd>
                        <MudTd DataLabel="模块Guid">@context.FeatureGuid</MudTd>
                        <MudTd DataLabel="说明">@context.Description</MudTd>
                    </RowTemplate>
                    <RowEditingTemplate>
                        <MudTd DataLabel="序号">
                            <MudTextField @bind-Value="@context.Num" Required ReadOnly="true" />
                     </MudTd>
                     <MudTd DataLabel="模块名称">
                         <MudTextField @bind-Value="@context.FeatureName" Required />
                     </MudTd>
                     <MudTd DataLabel="模块Guid">
                         <MudTextField @bind-Value="@context.FeatureGuid" Required />
                     </MudTd>
                     <MudTd DataLabel="说明">
                         <MudTextField @bind-Value="@context.Description" Required />
                     </MudTd>
                 </RowEditingTemplate>
             </MudTable>
         </div>

         <MudCardActions Class="card-actions-right">
             <MudButton Style="margin-right:10px" Variant="Variant.Filled" OnClick="AddItem" Color="Color.Primary">添加模块</MudButton>
             <MudButton Style="margin-right:10px" Variant="Variant.Filled" OnClick="Confirm" Color="Color.Primary">确认保存</MudButton>
             <MudButton Variant="Variant.Filled" OnClick="Cancel" Color="Color.Error">取消</MudButton>
         </MudCardActions>
     </MudCard>

 </div>
 <style>
     .card-actions-right {
         margin-right: 10px;
         display: flex;
         justify-content: flex-end;
         align-items: flex-end;
     @*height: 95%; width: 99%;*@
     }

     .center {
         margin: auto;
         width: 50%;
     }
 </style>
 @code {



    [Parameter]
    public ApplicationItemInfoModel? ApplicationInfo { get; set; }
    [Parameter]
    public EventCallback<ApplicationItemInfoModel> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
    public string ImagePath { get; set; } = string.Empty;
    public ApplicationItemInfoModel CurrentApplicationInfo { get; set; } = new();
    private MudTable<FeatureItemModel>? _table;
    private MudFileUpload<IBrowserFile>? _mudFileUpload;
    public FeatureItemModel? FeatureInfoBeforeEdit;
    private TableApplyButtonPosition applyButtonPosition = TableApplyButtonPosition.End;
    private TableEditButtonPosition editButtonPosition = TableEditButtonPosition.End;
    private TableEditTrigger editTrigger = TableEditTrigger.RowClick;
    private readonly List<string> _fileNames = new();
    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        CurrentApplicationInfo.LicenseFeatureInfos.Clear();
        if (ApplicationInfo is not null) {
            CurrentApplicationInfo = new ApplicationItemInfoModel() {
                    Id = ApplicationInfo.Id,
                    ApplicationName = ApplicationInfo.ApplicationName,
                    Description = ApplicationInfo.Description,
                    LicenseFeatureInfos = ApplicationInfo.LicenseFeatureInfos?.Select((s, i) => new FeatureItemModel {
                        Description = s.Description,
                        FeatureGuid = s.FeatureGuid,
                        FeatureName = s.FeatureName,
                        IsActive = s.IsActive,
                        Num = i + 1
                    })?.ToList() ?? new List<FeatureItemModel>()
                };
            if (ApplicationInfo.Image is not null) {

                using var memoryStream = new MemoryStream();
                await ApplicationInfo.Image.CopyToAsync(memoryStream);

                var base64String = Convert.ToBase64String(memoryStream.ToArray());

                ImagePath = $"data:image/jpg;base64,{base64String}";
            }

        }

    }

    // 异步方法处理文件改变事件
    private async Task OnInputFileChanged(InputFileChangeEventArgs e) {
        var file = e.File;
        if (file != null) {
            using var stream = file.OpenReadStream();
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var base64String = Convert.ToBase64String(memoryStream.ToArray());

            ImagePath = $"data:image/{file.ContentType};base64,{base64String}";
            StateHasChanged();
        }
    }
    private void BackupItem(object element) {
        Console.WriteLine(element);
        /*FeatureInfoBeforeEdit = new() {

            Sign = ((Element)element).Sign,
            Name = ((Element)element).Name,
            Molar = ((Element)element).Molar,
            Position = ((Element)element).Position
        };
        AddEditionEvent($"RowEditPreview event: made a backup of Element {((Element)element).Name}");*/
    }
    private void ResetItemToOriginalValues(object element) {
        Console.WriteLine(element);
        /*((Element)element).Sign = elementBeforeEdit.Sign;
        ((Element)element).Name = elementBeforeEdit.Name;
        ((Element)element).Molar = elementBeforeEdit.Molar;
        ((Element)element).Position = elementBeforeEdit.Position;
        AddEditionEvent($"RowEditCancel event: Editing of Element {((Element)element).Name} canceled");*/
    }

    private void AddItem() {

        var featureItemModel = new FeatureItemModel() {
                Num = CurrentApplicationInfo.LicenseFeatureInfos.Count + 1
            };
        CurrentApplicationInfo.LicenseFeatureInfos.Add(featureItemModel);
    }

    private async void Confirm() {
        ApplicationInfo = new ApplicationItemInfoModel() {
                Id = CurrentApplicationInfo.Id,
                ApplicationName = CurrentApplicationInfo.ApplicationName,
                Description = CurrentApplicationInfo.Description,
                LicenseFeatureInfos = CurrentApplicationInfo.LicenseFeatureInfos?.Select((s, i) => new FeatureItemModel {
                    Description = s.Description,
                    FeatureGuid = s.FeatureGuid,
                    FeatureName = s.FeatureName,
                    IsActive = s.IsActive,
                    Num = i + 1
                })?.ToList() ?? new List<FeatureItemModel>()
            };
        var openReadStream = _mudFileUpload?.Files?.OpenReadStream();
        if (openReadStream is not null) {
            ApplicationInfo.Image = openReadStream;
        }
        await OnConfirm.InvokeAsync(ApplicationInfo);
    }

    public async void Cancel() {
        await OnCancel.InvokeAsync(null);
    }
}
