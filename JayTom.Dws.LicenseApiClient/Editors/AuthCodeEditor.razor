@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Api
@inject ILicenseApiRequest LicenseApiRequest
<div>
    <MudCard Style="margin-left:10px;margin-right:10px; width:680px;height:auto; border-radius:5px;">
        <MudCardContent Class="center">

            @*应用模板*@
            <MudSelect FullWidth="false" @bind-SelectedValues="SelectAppTemplateItems" ReadOnly="IsEdit" Style="margin-top:10px;margin-bottom:10px;" ToStringFunc="@ConvertAppTemplateInfo" Margin="Margin.Dense" T="AppTemplateItemInfoModel" Label="应用模板" Variant="Variant.Outlined">

                @foreach (var info in AppTemplateItemItems) {
                    <MudSelectItem Value="@info" />
                }

            </MudSelect>
            @*租户*@
            @if (IsSuperAdministrator && !IsEdit) {
                <MudSelect FullWidth="false" @bind-SelectedValues="SelectTenantItems" ReadOnly="IsEdit" Style="margin-top:20px;margin-bottom:10px;" ToStringFunc="@ConvertTenantInfo" Margin="Margin.Dense" T="UserInfo" Label="租户" Variant="Variant.Outlined">
                    @foreach (var info in TenantItems) {
                        <MudSelectItem Value="@info" />
                    }

                </MudSelect>
            }
            @if (!AuthCodeInfo.IsGroupedBatchGeneration) {
                @*客户端上限数量*@
                <div style=" display: flex;margin-top:10px;display: flex; align-items: center;">
                    <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">客户端上限数量:</span>
                    <MudNumericField Style="margin-left:10px; margin-bottom:30px;" @bind-Value="AuthCodeInfo.MaxClientCount" Variant="Variant.Text" Min="1" />
                </div>
            }
            else {
                AuthCodeInfo.MaxClientCount = 1;
            }


            @*到期时间*@
            <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">到期时间:</span>
                <DateTimeEditor Style="width: 170px;" @bind-DateTime="AuthCodeInfo.ExpirationDate"></DateTimeEditor>
                <MudButton OnClick="() => {SetQuickTime(1,TimeUnit.Week);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">1周</MudButton>
                <MudButton OnClick="() => {SetQuickTime(1,TimeUnit.Month);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">1个月</MudButton>
                <MudButton OnClick="() => {SetQuickTime(3,TimeUnit.Month);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">3个月</MudButton>
                <MudButton OnClick="() => {SetQuickTime(1,TimeUnit.Year);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">1年</MudButton>
                <MudButton OnClick="() => {SetQuickTime(2,TimeUnit.Year);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">2年</MudButton>

            </div>

            @*客户*@
            <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">客户:</span>
                <MudTextField Style="margin-left:10px;margin-bottom:30px;" @bind-Value="AuthCodeInfo.ClientName" Variant="Variant.Text"></MudTextField>
            </div>
            @*分组批量生成*@
            @if (!IsEdit) {
                <MudSwitch @bind-Value="AuthCodeInfo.IsGroupedBatchGeneration" Label="分组批量生成" Color="Color.Primary" />
                <MudCollapse Expanded="AuthCodeInfo.IsGroupedBatchGeneration">
                    <div style=" display: flex;margin-top:10px;display: flex; align-items: center;">
                        <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">授权码生成数量:</span>
                        <MudNumericField Style="margin-left:10px; margin-bottom:30px;" @bind-Value="AuthCodeInfo.AuthCodeGenerationCount" Variant="Variant.Text" Min="1" />
                    </div>
                </MudCollapse>

            }

        </MudCardContent>
        <MudCardActions Class="card-actions-right">
            <MudButton Style="margin-right:10px" Variant="Variant.Filled" OnClick="Confirm" Color="Color.Primary">保存</MudButton>
            <MudButton Variant="Variant.Filled" OnClick="Cancel" Color="Color.Error">取消</MudButton>
        </MudCardActions>

        @*添加、取消按钮*@
    </MudCard>

</div>
<style>
    .card-actions-right {
        margin-right: 10px;
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
    @*height: 95%; width: 99%;*@
    }
</style>
@code {
    [Parameter]
    public AuthCodeInfoModel AuthCodeInfo { get; set; } = new();
    [Parameter]
    public List<AppTemplateItemInfoModel> AppTemplateItemItems { get; set; } = new();
    [Parameter]
    public EventCallback<AuthCodeInfoModel> OnConfirm { get; set; }
    [Parameter]
    public EventCallback OnCancel { get; set; }
    [Parameter]
    public bool IsEdit { get; set; }
    [Parameter]
    public bool IsSuperAdministrator { get; set; }
    [Parameter]
    public List<UserInfo> TenantItems { get; set; } = new();

    public IEnumerable<AppTemplateItemInfoModel>? SelectAppTemplateItems { get; set; }

    public IEnumerable<UserInfo>? SelectTenantItems { get; set; }
    protected override void OnInitialized() {

        if (IsEdit) {
            SelectAppTemplateItems = new[]
            {
                AppTemplateItemItems?.FirstOrDefault(f=>f.Id.Equals(AuthCodeInfo.TemplateInfoId)) ?? new AppTemplateItemInfoModel()
            };
        }
        else {
            SelectAppTemplateItems ??= new[]
            {
                AppTemplateItemItems?.FirstOrDefault() ?? new AppTemplateItemInfoModel()
            };
            if (IsSuperAdministrator && TenantItems?.Any() == true) {

                SelectTenantItems ??= new[]
                {
                    TenantItems?.FirstOrDefault() ?? new UserInfo()
                };
            }

        }

        base.OnInitialized();
    }

    private async void Confirm() {
        var itemInfoModel = SelectAppTemplateItems?.FirstOrDefault() ?? new AppTemplateItemInfoModel();
        AuthCodeInfo.TemplateInfoId = itemInfoModel.Id;
        AuthCodeInfo.UserCode ??= SelectTenantItems?.FirstOrDefault()?.UserCode;

        await OnConfirm.InvokeAsync(AuthCodeInfo);
    }

    public async void Cancel() {
        await OnCancel.InvokeAsync(null);
    }
    public string ConvertAppTemplateInfo(AppTemplateItemInfoModel? info) {
        return info is not null ? info.TemplateName : string.Empty;
    }

    public string ConvertTenantInfo(UserInfo? info) {
        return info is not null ? info.UserName : string.Empty;
    }
    public void AppTemplateItemInfoSelectedValuesChanged(AppTemplateItemInfoModel info) {
        SelectAppTemplateItems = new[]
        {
           info
        };
        AuthCodeInfo.TemplateInfoId = info.Id;
    }

    public void SetQuickTime(int value, TimeUnit unit) {
        switch (unit) {
            case TimeUnit.Week:
                AuthCodeInfo.ExpirationDate = DateTime.Today.AddDays(value * 7);
                break;
            case TimeUnit.Month:
                AuthCodeInfo.ExpirationDate = DateTime.Today.AddMonths(value);
                break;
            case TimeUnit.Year:
                AuthCodeInfo.ExpirationDate = DateTime.Today.AddYears(value);
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(unit), unit, null);
        }

        StateHasChanged();
    }

    // 时间单位枚举类型
    public enum TimeUnit {
        Week,
        Month,
        Year
    }
}
