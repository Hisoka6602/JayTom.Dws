@using System.Globalization

<div class="d-flex">
    <div style="height:30px; display: flex; justify-content: flex-end;align-items: center;">

        <MudInput ReadOnly="true" DisableUnderLine="false" Style="border-block-width:0px; border-color:#3D7AEF; width:470px; max-width:860px;  height: 30px;display: flex; " @bind-Value="DisplayDateTime" Variant="Variant.Text" />
        <MudIconButton OnClick="@ToggleOpen" Size="@Size.Small"
                       Icon="@Icons.Material.Filled.DateRange" Style="color:gray;width:30px;height:30px;">
        </MudIconButton>
    </div>
    <MudPopover Open="_isOpen" OverflowBehavior="OverflowBehavior.FlipAlways" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopRight" Paper="false">

        <MudCard Style="margin:0px;border-radius:15px;padding:0px">
            <MudCardContent Style="margin:0px;border-radius:15px;padding:0px">
                <div style=" display: flex; align-items: center; justify-content: center;border-radius:15px;overflow: hidden;">
                    <MudDatePicker @ref="_picker" MaxDate="_maxDate" PickerVariant="PickerVariant.Static" Label="Chinese" @bind-Date="@Date" Culture="@CultureInfo.GetCultureInfo("zh-Hans")" TitleDateFormat="dddd, dd MMMM" />
                    <MudTimePicker Color="Color.Primary" Style=" margin-bottom:3px" PickerVariant="PickerVariant.Static" Label="Normal" @bind-Time="@Time" Culture="@CultureInfo.GetCultureInfo("zh-Hans")" TimeEditMode="TimeEditMode.Normal" />
                </div>
            </MudCardContent>
            <MudCardActions style="display: flex; justify-content: flex-end;">
                <MudButton OnClick="@GetToday" Style="font-weight: bold" Variant="Variant.Text" Color="Color.Primary">今天</MudButton>
                <MudButton OnClick="@GetCurrent" Style="font-weight: bold" Variant="Variant.Text" Color="Color.Primary">当前</MudButton>
                <MudButton OnClick="@Confirm" Style="font-weight: bold" Variant="Variant.Text" Color="Color.Primary">确定</MudButton>
                <MudButton OnClick="@Cancel" Style="font-weight: bold" Variant="Variant.Text" Color="Color.Primary">取消</MudButton>
            </MudCardActions>
        </MudCard>
    </MudPopover>
</div>

@code {
    [Parameter]
    public DateTime? DateTime { get; set; }

    [Parameter]
    public EventCallback<DateTime?> DateTimeChanged { get; set; }

    [Parameter]
    public int Width { get; set; } = 160;
    private string DisplayDateTime { get; set; } = string.Empty;
    private DateTime? _maxDate = System.DateTime.MaxValue;
    private DateTime? _date;
    private TimeSpan? _time;
    private bool _isOpen = false;
    MudDatePicker? _picker;
    public DateTime? Date {
        get => _date;
        set {
            _date = value;
            TimeChanged();
        }
    }

    public TimeSpan? Time {
        get => _time;
        set {
            _time = value;
            TimeChanged();
        }
    }

    protected override void OnInitialized() {
        base.OnInitialized();
        if (DateTime != null) {
            DisplayDateTime = $"{DateTime.Value:yyyy-MM-dd HH:mm:ss}";
            Date = DateTime.Value;
            Time = DateTime.Value.TimeOfDay;
        }
    }

    private Task TimeChanged() {
        if (Date != null && Time != null) {
            DateTime = new DateTime(Date.Value.Year, Date.Value.Month, Date.Value.Day, Time.Value.Hours, Time.Value.Minutes, Time.Value.Seconds);
            DisplayDateTime = $"{Date.Value:yyyy-MM-dd} {Time.Value:hh\\:mm\\:ss}";

        }
        else if (Date != null && Time == null) {
            Time = new TimeSpan(0, 0, 0);
            DateTime = new DateTime(Date.Value.Year, Date.Value.Month, Date.Value.Day, Time.Value.Hours, Time.Value.Minutes, Time.Value.Seconds);
            DisplayDateTime = $"{Date.Value:yyyy-MM-dd} {Time.Value:hh\\:mm\\:ss}";
        }
        else {
            DateTime = null;
            DisplayDateTime = string.Empty;
        }
        return DateTimeChanged.InvokeAsync(DateTime);
    }


    public async void ToggleOpen() {
        _isOpen = !_isOpen;
        if (_isOpen && Date is not null &&
            _picker is not null) {
            await Task.Yield();
            await _picker.GoToDate(Date.Value);
        }

    }

    public void GetToday() {
        Date = System.DateTime.Today;
        Time = new TimeSpan(0, 0, 0, 0);
        ToggleOpen();
    }

    public void GetCurrent() {
        Date = System.DateTime.Now;
        Time = new TimeSpan(System.DateTime.Now.Hour, System.DateTime.Now.Minute, 0);
        ToggleOpen();
    }

    public void Confirm() {
        ToggleOpen();
    }

    public void Cancel() {
        Date = null;
        Time = null;
        ToggleOpen();
    }
}
