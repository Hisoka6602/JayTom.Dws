@using JayTom.Dws.LicenseApiClient.Data.Models

<MudCard Style="width:600px;height:220px; border-radius:20px;">
    <MudCardContent Class="center">

        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span style="margin-top:20px; font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">机器码:</span>
            <MudTextField Style="margin-left:10px;margin-bottom:5px;width:500px" @bind-Value="MachineCodeInfo.MachineCode" Variant="Variant.Text"></MudTextField>
        </div>
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span style="margin-top:20px; font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">备  注:</span>
            <MudTextField Style="margin-left:10px;margin-bottom:5px;width:500px" @bind-Value="MachineCodeInfo.Remarks" Variant="Variant.Text"></MudTextField>
        </div>
    </MudCardContent>
    <MudCardActions Class="card-actions-right">
        <MudButton Style="margin-right:10px" Variant="Variant.Filled" OnClick="Confirm" Color="Color.Primary">生成</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="Cancel" Color="Color.Error">取消</MudButton>
    </MudCardActions>
</MudCard>
<style>
    .card-actions-right {
        margin-right: 10px;
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
    @*height: 95%; width: 99%;*@
    }
</style>
@code {
    public MachineCodeItemInfo MachineCodeInfo { get; set; } = new();

    [Parameter]
    public EventCallback<MachineCodeItemInfo> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }


    private async void Confirm() {

        await OnConfirm.InvokeAsync(MachineCodeInfo);
    }

    public async void Cancel() {
        await OnCancel.InvokeAsync(null);
    }
}
