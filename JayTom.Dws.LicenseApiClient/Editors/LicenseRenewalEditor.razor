@using JayTom.Dws.LicenseApiClient.Data.Models
@using System.Reflection.Metadata
<div>
    <MudCard Style="width:620px;height:320px; border-radius:20px;">
        <MudCardContent Class="center">
            <div style="display: flex;margin-top:10px;margin-bottom:20px;display: flex; align-items: center;">
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">授权码:</span>
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">@Info.LicenseCode</span>
            </div>
            <div style="display: flex;margin-top:10px;margin-bottom:20px;display: flex; align-items: center;">
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">到期时间:</span>
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">@Info.ExpirationDate</span>
            </div>
            <div style="display: flex;margin-top:10px;margin-bottom:20px;display: flex; align-items: center;">
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">客户:</span>
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">@Info.ClientName</span>
            </div>
            @*客户端上限数量*@
            <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
                <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">增加天数:</span>
                <MudNumericField Style="margin-left:10px; margin-bottom:30px;width:140px" @bind-Value="RenewalDays" Variant="Variant.Text" Min="1" Max="100" />

                <MudButton OnClick="() => {SetQuickTime(1,AuthCodeEditor.TimeUnit.Week);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">1周</MudButton>
                <MudButton OnClick="() => {SetQuickTime(1,AuthCodeEditor.TimeUnit.Month);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">1个月</MudButton>
                <MudButton OnClick="() => {SetQuickTime(3,AuthCodeEditor.TimeUnit.Month);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">3个月</MudButton>
                <MudButton OnClick="() => {SetQuickTime(1,AuthCodeEditor.TimeUnit.Year);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">1年</MudButton>
                <MudButton OnClick="() => {SetQuickTime(2,AuthCodeEditor.TimeUnit.Year);}" Style="border-radius: 15px; margin-left:8px;color:white" Variant="Variant.Filled" Color="Color.Primary">2年</MudButton>
            </div>


        </MudCardContent>
        <MudCardActions Class="card-actions-right">
            <MudButton Style="margin-right:10px" Variant="Variant.Filled" OnClick="Confirm" Color="Color.Primary">续期</MudButton>
            <MudButton Variant="Variant.Filled" OnClick="Cancel" Color="Color.Error">取消</MudButton>
        </MudCardActions>

    </MudCard>

</div>
<style>
    .card-actions-right {
        margin-right: 10px;
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
    @*height: 95%; width: 99%;*@
    }
</style>
@code {
    public int RenewalDays { get; set; }

    [Parameter]
    public LicenseCodeItemInfoModel Info { get; set; } = new();
    [Parameter]
    public EventCallback<RenewalLicenseCodeInfo> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }


    private async void Confirm() {

        await OnConfirm.InvokeAsync(new RenewalLicenseCodeInfo {
                Days = RenewalDays,
                Info = Info
            });
    }

    public async void Cancel() {
        await OnCancel.InvokeAsync(null);
    }
    public void SetQuickTime(int value, AuthCodeEditor.TimeUnit unit) {
        switch (unit) {
            case AuthCodeEditor.TimeUnit.Week:
                RenewalDays = (int)Info.ExpirationDate.AddDays(value * 7).Subtract(Info.ExpirationDate).TotalDays;
                break;
            case AuthCodeEditor.TimeUnit.Month:
                RenewalDays = (int)Info.ExpirationDate.AddMonths(value).Subtract(Info.ExpirationDate).TotalDays;
                break;
            case AuthCodeEditor.TimeUnit.Year:
                RenewalDays = (int)Info.ExpirationDate.AddYears(value).Subtract(Info.ExpirationDate).TotalDays;
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(unit), unit, null);
        }

        StateHasChanged();
    }
}
