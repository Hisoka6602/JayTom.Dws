@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Api
@inject ILicenseApiRequest LicenseApiRequest
@inject ISnackbar Snackbar
<MudCard Style="width:1000px;height:730px; border-radius:5px;">
    <MudCardContent Class="center">

        <div style="display: flex;margin-top:10px;margin-bottom:20px;display: flex; align-items: center;">
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">应用模板:</span>
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">@LicenseCodeItemInfo.TemplateName</span>
        </div>
        <div style="display: flex;margin-top:10px;margin-bottom:20px;display: flex; align-items: center;">
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">授权码:</span>
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 16px;">@LicenseCodeItemInfo.LicenseCode</span>
        </div>
        @*列表*@
        <div>
            <MudTable Height="540px" Breakpoint="Breakpoint.Sm" FixedHeader="true" Style="width:970px;min-height:360px;max-height:540px;" Items="@LicenseCodeItemInfo.MachineCodeItem"
                      Dense="false" Hover="true" CanCancelEdit="true" Filter="_quickFilter">

                <ToolBarContent>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="模糊搜索" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>机器码</MudTh>
                    <MudTh>首次激活时间</MudTh>
                    <MudTh>最后效验时间</MudTh>
                    <MudTh>备注</MudTh>
                    <MudTh>管理</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="机器码">@context.MachineCode</MudTd>
                        <MudTd DataLabel="首次激活时间">@context.FirstActivatedDate</MudTd>
                        <MudTd DataLabel="最后效验时间">@context.LastVerifiedDate</MudTd>
                        <MudTd DataLabel="备注">@context.Remarks</MudTd>
                        <MudTd>
                            @*解绑*@
                            <MudButton OnClick="() => { UnbindMachineCode(LicenseCodeItemInfo.LicenseCode, context.MachineCode); }" Style="border-radius: 15px; margin-left:3px; background-color:red;color:white" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Surface">解绑</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

        </MudCardContent>
        <MudCardActions Class="card-actions-right">
            <MudButton Style="margin-right:10px" Variant="Variant.Filled" OnClick="Confirm" Color="Color.Primary">确定</MudButton>
        </MudCardActions>
    </MudCard>
    <style>
        .card-actions-right {
            margin-right: 10px;
            display: flex;
            justify-content: flex-end;
            align-items: flex-end;
        @*height: 95%; width: 99%;*@
        }
    </style>
    @code {

    [Parameter]
    public LicenseCodeItemInfoModel LicenseCodeItemInfo { get; set; } = new();
    [Parameter]
    public EventCallback<AuthCodeInfoModel> OnConfirm { get; set; }
    private async void Confirm() {

        await OnConfirm.InvokeAsync();
    }

    private string _searchString = string.Empty;
    private Func<MachineCodeItemInfoModel, bool> _quickFilter => x => {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.MachineCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.Remarks.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    };
    private async void UnbindMachineCode(string licenseCode, string machineCode) {
        var (key, value) = await LicenseApiRequest.UnbindMachineCode(licenseCode, machineCode, CancellationToken.None);
        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {

                LicenseCodeItemInfo.MachineCodeItem.RemoveAll(r => r.MachineCode.Equals(machineCode));
                StateHasChanged();
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }
}
