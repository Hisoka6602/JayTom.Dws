@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Api
@using System.Text
@inject ILicenseApiRequest LicenseApiRequest
@inject ISnackbar Snackbar

<EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
    <ValidationSummary />
    <MudPaper Elevation="3" Style="width:400px;height:auto; position: relative; border-radius: 15px; display: flex; flex-direction: column; align-items: center;">
        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <div style="padding:50px;width: 100%;">
                <div style="display: flex; justify-content: center;">
                    <MudTextField Variant="Variant.Text" @bind-Value="@_model.UserCode" Style="margin-bottom:30px" T="string" Label="账号" For="@(() => _model.UserCode)" />
                    <MudIconButton OnClick="()=>{_model.UserCode=GenerateRandomUserCode();}" style="width: 50px;height:50px;display: flex; justify-content: center;" Color="Color.Dark" Size="Size.Small">
                        <span class="iconfont icon-suiji" style="color:slateblue;font-size: 25px;"></span>
                    </MudIconButton>

                </div>
                <div style="display: flex; justify-content: center;">
                    <MudTextField Variant="Variant.Text" @bind-Value="@_model.UserName" Style="margin-bottom:30px" T="string" Label="用户名" For="@(() => _model.UserName)" />
                    <MudIconButton OnClick="()=>{_model.UserName=GenerateRandomName();}" style="width: 50px;height:50px;display: flex; justify-content: center;" Color="Color.Dark" Size="Size.Small">
                        <span class="iconfont icon-suiji" style="color:slateblue; font-size: 25px;"></span>
                    </MudIconButton>
                </div>
                <div style="display: flex; justify-content: center;">
                    <MudTextField @bind-Value="@_model.PassWord" Variant="Variant.Text" Style="margin-bottom:30px" T="string" Label="登录密码" For="@(() => _model.PassWord)" />
                    <MudIconButton OnClick="()=>{_model.PassWord=GenerateRandomPassword();}" style="width: 50px;height:50px;display: flex; justify-content: center;" Color="Color.Dark" Size="Size.Small">
                        <span class="iconfont icon-suiji" style="color:slateblue;font-size: 25px;"></span>
                    </MudIconButton>
                </div>

                <MudTextField @bind-Value="@_model.Phone" Variant="Variant.Text" Style="margin-bottom:30px" T="string" Label="手机号码" For="@(() => _model.Phone)" />

                <MudTextField @bind-Value="@_model.CompanyName" Variant="Variant.Text" Style="margin-bottom:30px" T="string" Label="公司名称" />

                <div style="display: flex; justify-content: center;">
                    <MudButton Style="margin-left:5px;margin-right:5px;width:130px; border-radius: 30px;" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">注册</MudButton>
                    <MudButton OnClick="Cancel" Style="margin-left:5px;margin-right:5px; width:130px; border-radius: 30px;" ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Error">取消</MudButton>
                </div>
            </div>


        </div>
    </MudPaper>
</EditForm>


<style>
    .card-actions-right {
        margin-right: 10px;
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
    @*height: 95%; width: 99%;*@
    }
</style>
@code {
    [Parameter]
    public bool IsEdit { get; set; }
    [Parameter]
    public TenantItemInfoModel TenantItemInfo { get; set; } = new();

    [Parameter]
    public EventCallback<TenantItemInfoModel> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }


    private async void Confirm() {

        await OnConfirm.InvokeAsync(TenantItemInfo);
    }

    public async void Cancel() {
        await OnCancel.InvokeAsync(null);
    }
    RegisterAccountForm _model = new();
    bool success;
    private async void OnValidSubmit(EditContext context) {
        success = true;
        StateHasChanged();

        var (key, value) = await LicenseApiRequest.Register(_model.UserCode, _model.UserName, _model.PassWord, _model.Phone, _model.CompanyName);
        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {

                await OnConfirm.InvokeAsync(TenantItemInfo);
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

    public string GenerateRandomUserCode() {
        string userCode = "User" + DateTimeOffset.Now.ToUnixTimeMilliseconds().ToString().Substring(3, 10);
        return userCode;
    }
    // 生成随机名称
    public string GenerateRandomName() {
        var random = new Random();
        string[] surnames = { "赵", "钱", "孙", "李", "周", "吴", "郑", "王", "冯", "陈", "褚", "卫", "蒋", "沈", "韩", "杨", "朱", "秦", "尤", "许", "何", "吕", "施", "张", "孔", "曹", "严", "华", "金", "魏", "陶", "姜", "戚", "谢", "邹", "喻", "柏", "水", "窦", "章", "云", "苏", "潘", "葛", "奚", "范", "彭", "郎", "鲁", "韦" /* 这里可以继续添加更多的姓氏 */ };
        string[] givenNames = { "小", "明", "红", "刚", "芳", "强", "丽", "华", "军", "亮", "雪", "风", "露", "倩", "伟", "娜", "杰", "霞", "涛", "丹", "辉", "静", "宇", "萍", "勇", "娟", "涵", "鹏", "琴", "恒", "琳", "杨", "洁", "利", "宁", "浩", "欣", "娥", "琼", "鑫", "伶", "海", "洋", "颖", "健", "婷", "旭", "建", "琪", "春", "丽", "宝", "莉", "磊", "敏", "龙", "雯", "梅", "燕", /* 这里可以继续添加更多的名字 */ };
        var surnameIndex = random.Next(surnames.Length);
        var givenNameIndex = random.Next(givenNames.Length);

        return surnames[surnameIndex] + givenNames[givenNameIndex];
    }
    public string GenerateRandomPassword() {
        const string validChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"; // 有效字符集合
        const string symbols = "!@#$%^&*()_+"; // 符号集合
        const int minLength = 8;
        const int maxLength = 15;

        var random = new Random();
        var passwordLength = random.Next(minLength, maxLength + 1); // 随机生成密码长度

        var passwordBuilder = new StringBuilder();

        for (int i = 0; i < passwordLength; i++) {
            passwordBuilder.Append(validChars[random.Next(validChars.Length)]);
        }

        var password = passwordBuilder.ToString();

        if (password.Any(c => char.IsDigit(c) || !symbols.Contains(c))) // 检查是否包含数字或符号字符
        {
            password = string.Join("", password.Where(c => !char.IsDigit(c) && !symbols.Contains(c))); // 移除数字和符号字符
            password += symbols[random.Next(symbols.Length)]; // 添加一个随机符号字符到尾部
        }

        return password;
    }

}
