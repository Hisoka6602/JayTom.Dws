@page "/application-management"

@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Editors
@using JayTom.Dws.LicenseApiClient.Api
@using JayTom.Dws.LicenseApiClient.Notification
@inject ILicenseApiRequest LicenseApiRequest
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@*应用程序编辑器*@
<MudOverlay Visible="AppModuleEditorIsVisible" DarkBackground="true">

    <AppModuleEditor ApplicationInfo="@ApplicationItemInfo" OnCancel="() => { AppModuleEditorIsVisible = false; ApplicationItemInfo=null; }" OnConfirm="HandleConfirm" />

</MudOverlay>
<MudOverlay Visible="AppTemplateEditorIsVisible" DarkBackground="true">

    <AppTemplateEditor ApplicationInfoItems="@ApplicationItems" AppTemplateInfo="@AppTemplateItemInfo" OnCancel="() => { AppTemplateEditorIsVisible = false; AppTemplateItemInfo=null; }" OnConfirm="HandleTemplateConfirm" />

</MudOverlay>
<PageTitleTemplate Title="应用管理" Description="应用管理" IconClass="iconfont icon-app"></PageTitleTemplate>
<div style="margin:10px">
    <MudTooltip Text="添加程序" Arrow="true" Placement="Placement.Bottom">
        <MudFab OnClick="@(e => { AppModuleEditorIsVisible = true;})" Icon="@Icons.Material.Filled.Apps" Color="Color.Primary" />
    </MudTooltip>
</div>
<div class="row">
    <div class="col-12" style="max-height: 300px; overflow-y: scroll;">
        <div class="d-flex flex-wrap">
            @foreach (var story in ApplicationItems) {
                <div class="col-md-2 mb-4 mx-1">
                    <ApplicationCardTemplate ApplicationInfo="story" OnEdit="HandleAppEdit" OnDelete="HandleAppDelete" />
                </div>
            }
        </div>
    </div>
</div>
<MudDivider DividerType="DividerType.Middle" Style="height:2px" Class="my-9" />
<div style="margin:10px">
    <MudTooltip Text="添加模板" Arrow="true" Placement="Placement.Bottom">
        <MudFab OnClick="@(e => { AppTemplateEditorIsVisible = true;})" Icon="@Icons.Material.Filled.AddCard" Color="Color.Primary" />
    </MudTooltip>
</div>
<div class="row">
    <div class="col-12" style="max-height: 300px; overflow-y: scroll;">
        <div class="d-flex flex-wrap">
            @foreach (var story in AppTemplateItemItems) {
                <div class="col-md-2 mb-4 mx-1">
                    <AuthorizationCardTemplate AppTemplateItemInfo="@story" OnEdit="HandleTemplateEdit" OnDelete="HandleTemplateDelete" />
                </div>
            }
        </div>
    </div>
</div>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    public List<ApplicationItemInfoModel> ApplicationItems { get; set; } = new();

    public List<AppTemplateItemInfoModel> AppTemplateItemItems = new();

    public ApplicationItemInfoModel? ApplicationItemInfo { get; set; }

    public AppTemplateItemInfoModel? AppTemplateItemInfo { get; set; }


    public bool AppModuleEditorIsVisible = false;
    public bool AppTemplateEditorIsVisible = false;
    private async void HandleConfirm(ApplicationItemInfoModel info) {
        AppModuleEditorIsVisible = false;
        if (info.Id != 0) {
            //编辑
            //更新到Api
        }
        else {
            //新增

            //添加到Api
            //添加到本地(从新刷新)

            var (key, value) = await LicenseApiRequest.CreateApplication(info.ApplicationName, info.Description,
                info.LicenseFeatureInfos);
            if (value is ApiResult result) {

                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
                if (key) {

                    Navigation.NavigateTo("/application-management", true);
                }
            }
            else {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(value.ToString(), Severity.Error);
            }

        }
    }
    private async void HandleTemplateConfirm(AppTemplateItemInfoModel info) {
        AppTemplateEditorIsVisible = false;
        if (info.Id != 0) {
            //编辑
            //更新到Api
            var (key, value) = await LicenseApiRequest.SetTemplatePermissions(info.Id, info.LicenseApplicationInfo.LicenseFeatureInfos);
            if (value is ApiResult result) {

                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
                if (key) {

                    Navigation.NavigateTo("/application-management", true);
                }
            }
            else {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(value.ToString(), Severity.Error);
            }
        }
        else {
            //添加到本地(从新刷新)
            var (key, value) = await LicenseApiRequest.CreateApplicationTemplate(info.LicenseApplicationInfoId, info.TemplateName);
            if (value is ApiResult result) {

                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
                if (key) {

                    Navigation.NavigateTo("/application-management", true);
                }
            }
            else {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(value.ToString(), Severity.Error);
            }
        }
    }
    private void HandleAppEdit(ApplicationItemInfoModel info) {
        AppModuleEditorIsVisible = true;
        ApplicationItemInfo = info;
    }
    private async void HandleAppDelete(ApplicationItemInfoModel info) {


        var (key, value) = await LicenseApiRequest.DeleteApplication(info.Id);
        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {

                await GetApplicationData();
                await GetApplicationTemplate();
                StateHasChanged();
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

    private void HandleTemplateEdit(AppTemplateItemInfoModel info) {
        AppTemplateEditorIsVisible = true;
        AppTemplateItemInfo = info;
        ApplicationItems = ApplicationItems;
    }
    private async void HandleTemplateDelete(AppTemplateItemInfoModel info) {

        var (key, value) = await LicenseApiRequest.DeleteTemplate(info.Id);
        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {

                Navigation.NavigateTo("/application-management", true);
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {


        if (!await LicenseApiRequest.IsLoggedIn()) {
            Navigation.NavigateTo("/login");
            return;
        }

        if (firstRender) {


            await GetApplicationData();
            await GetApplicationTemplate();
            StateHasChanged();
            await base.OnAfterRenderAsync(firstRender);
        }


    }

    public async Task GetApplicationData() {
        var (key, value) = await LicenseApiRequest.ApplicationData();
        if (key && value is List<ApplicationItemInfoModel> items) {

            ApplicationItems = items;
        }
        else if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

    public async Task GetApplicationTemplate() {
        var (key, value) = await LicenseApiRequest.TemplateData();
        if (key && value is List<AppTemplateItemInfoModel> items) {

            AppTemplateItemItems = items;
        }
        else if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }
}
