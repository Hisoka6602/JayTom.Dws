@page "/application-management"
@using JayTom.Dws.LicenseApiClient.Template;
@using JayTom.Dws.LicenseApiClient.Data.Models

<MudCard style="border-radius:60px; width:400px;height:120px">
    <MudCardContent>
        <div style="display: flex; align-items: center;">
            <div style=" display: flex; align-items: center; justify-content: center;position: relative; width:90px;height:90px; background-color: rgba(30, 144, 255, 0.1); border-radius: 50%;margin-right:10px">
                <span class="iconfont icon-app" style="position: relative;color:dodgerblue; font-size: 60px;"></span>
            </div>
            <div style=" display: flex;flex-direction: column">
                <span style="font-size:18px;font-weight:bold">应用管理</span>
                <span style="color:darkgrey">应用管理</span>
            </div>

        </div>
    </MudCardContent>

</MudCard>
<div style="margin:10px">
    <MudTooltip Text="Add" Arrow="true" Placement="Placement.Bottom">
        <MudFab Icon="@Icons.Material.Filled.Apps" Color="Color.Primary" />
    </MudTooltip>
</div>


<div class="row">
    @foreach (var story in ApplicationItems) {
        <div class="col-md-2 mb-4 mx-1">
            <ApplicationCardTemplate Title="@story.Title" Description="@story.Description" ButtonText="@story.ButtonText" />
        </div>
    }
</div>
<MudDivider DividerType="DividerType.Middle" Style="height:2px" Class="my-9" />
<div style="margin:10px">
    <MudTooltip Text="Add" Arrow="true" Placement="Placement.Bottom">
        <MudFab Icon="@Icons.Material.Filled.AddCard" Color="Color.Primary" />
    </MudTooltip>
</div>
<div class="row">
    @foreach (var story in ApplicationItems) {
        <div class="col-md-2 mb-4 mx-1">
            <AuthorizationCardTemplate Title="@story.Title" Description="@story.Description" ButtonText="@story.ButtonText" />
        </div>
    }
</div>
@code {

    public List<ApplicationItemInfoModel> ApplicationItems { get; set; } = new()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {
        new ApplicationItemInfoModel()
        {
            Title = "DWS",
            Description = "DWS分拣系统"
        },
        new ApplicationItemInfoModel(){
            Title = "云端视频",
            Description = "DWS配套云端视频追溯系统"
        },
        new ApplicationItemInfoModel()
        {
            Title = "数据云端",
            Description = "DWS数据云端"
        },
        new ApplicationItemInfoModel(),
    };

}
