@page "/application-management"

@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Editors
<MudPaper Elevation="0" Style="height:95.7vh">
    @*应用程序编辑器*@
    <MudOverlay Visible="AppModuleEditorIsVisible" DarkBackground="true" Absolute="true">

        <AppModuleEditor ApplicationInfo="@ApplicationItemInfo" OnCancel="() => { AppModuleEditorIsVisible = false; ApplicationItemInfo=null; }" OnConfirm="HandleConfirm" />

    </MudOverlay>
    <MudOverlay Visible="AppTemplateEditorIsVisible" DarkBackground="true" Absolute="true">

        <AppTemplateEditor ApplicationInfoItems="@ApplicationItems" AppTemplateInfo="@AppTemplateItemInfo" OnCancel="() => { AppTemplateEditorIsVisible = false; AppTemplateItemInfo=null; }" OnConfirm="HandleTemplateConfirm" />

    </MudOverlay>
    <PageTitleTemplate Title="应用管理" Description="应用管理" IconClass="iconfont icon-app"></PageTitleTemplate>
    <div style="margin:10px">
        <MudTooltip Text="添加程序" Arrow="true" Placement="Placement.Bottom">
            <MudFab OnClick="@(e => { AppModuleEditorIsVisible = true;})" Icon="@Icons.Material.Filled.Apps" Color="Color.Primary" />
        </MudTooltip>
    </div>
    <div class="row">
        <div class="col-12" style="max-height: 300px; overflow-y: scroll;">
            <div class="d-flex flex-wrap">
                @foreach (var story in ApplicationItems) {
                    <div class="col-md-2 mb-4 mx-1">
                        <ApplicationCardTemplate ApplicationInfo="story" OnEdit="HandleAppEdit" OnDelete="HandleAppDelete" />
                    </div>
                }
            </div>
        </div>
    </div>
    <MudDivider DividerType="DividerType.Middle" Style="height:2px" Class="my-9" />
    <div style="margin:10px">
        <MudTooltip Text="添加模板" Arrow="true" Placement="Placement.Bottom">
            <MudFab OnClick="@(e => { AppTemplateEditorIsVisible = true;})" Icon="@Icons.Material.Filled.AddCard" Color="Color.Primary" />
        </MudTooltip>
    </div>
    <div class="row">
        <div class="col-12" style="max-height: 300px; overflow-y: scroll;">
            <div class="d-flex flex-wrap">
                @foreach (var story in ApplicationItems) {
                    <div class="col-md-2 mb-4 mx-1" style="width: calc(100% / 6)">
                        <AuthorizationCardTemplate Title="@story.Title" Description="@story.Description" ButtonText="@story.ButtonText" />
                    </div>
                }
            </div>
        </div>
    </div>



</MudPaper>

@code {

    public List<ApplicationItemInfoModel> ApplicationItems { get; set; } = new()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
        new ApplicationItemInfoModel()
        {
            Id = 1,
            Title = "DWS",
            Description = "DWS分拣系统",
            FeatureItems = new List<FeatureItemModel>()
            {
                new FeatureItemModel()
                {
                    Description = "测试说明",
                    FeatureGuid = Guid.NewGuid().ToString(),
                    FeatureName = "测试功能",
                    IsActive = true,
                    Num = 1
                }
            }
        },
        new ApplicationItemInfoModel(){
            Id = 2,
            Title = "云端视频",
            Description = "DWS配套云端视频追溯系统"
        },
        new ApplicationItemInfoModel()
        {
            Id = 3,
            Title = "数据云端",
            Description = "DWS数据云端"
        },
        new ApplicationItemInfoModel(),
    };

    public List<AppTemplateItemInfoModel> AppTemplateItemItems = new();

    public ApplicationItemInfoModel? ApplicationItemInfo { get; set; }

    public AppTemplateItemInfoModel? AppTemplateItemInfo { get; set; }


    public bool AppModuleEditorIsVisible = false;
    public bool AppTemplateEditorIsVisible = false;
    private void HandleConfirm(ApplicationItemInfoModel info) {
        AppModuleEditorIsVisible = false;
        if (info.Id != 0) {
            //编辑
            //更新到Api
        }
        else {
            //新增

            //添加到Api
            //添加到本地(从新刷新)
            ApplicationItems.Add(info);
        }
    }

    private void HandleTemplateConfirm(AppTemplateItemInfoModel info) {
        AppTemplateEditorIsVisible = false;
        if (info.Id != 0) {
            //编辑
            //更新到Api
        }
        else {
            //新增

            //添加到Api
            //添加到本地(从新刷新)
            AppTemplateItemItems.Add(info);
        }
    }
    private void HandleAppEdit(ApplicationItemInfoModel info) {
        AppModuleEditorIsVisible = true;
        ApplicationItemInfo = info;
    }
    private void HandleAppDelete(ApplicationItemInfoModel info) {
        //从Api删除
        //从本地删除
        ApplicationItems.Remove(info);
    }
}
