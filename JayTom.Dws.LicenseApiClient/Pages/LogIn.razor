@page "/login"
@using JayTom.Dws.LicenseApiClient.Data.Models
@using System.ComponentModel.DataAnnotations
<EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
    <ValidationSummary />
    <div style="min-width:700px; display: flex; justify-content: center; align-items: center; height: 100vh;overflow: hidden;">
        <img src="images/12345.png" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.9;" />
        <MudPaper Elevation="3" Style="width:663px;height:360px; position: relative; border-radius: 15px; display: flex; flex-direction: column; align-items: center;">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <div style="padding:50px;width: 46%;">
                    <MudTextField Variant="Variant.Text" @bind-Value="@_model.UserName" Style="margin-bottom:30px" T="string" Label="用户名/手机号码" For="@(() => _model.UserName)" />
                    <MudTextField @bind-Value="@_model.Password" Variant="Variant.Text" Style="margin-bottom:30px" T="string" Label="登录密码" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ButtonTestclick" AdornmentAriaLabel="Show Password" For="@(() => _model.Password)" />
                    <div style="display: flex; justify-content: center;">
                        <MudButton Style="width:130px; border-radius: 30px;" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">登录</MudButton>
                    </div>
                </div>

                <div Style="background-color: rgba(62, 44, 221, 0.1); width: 55%;overflow: hidden;border-top-right-radius: 15px;border-bottom-right-radius: 15px;">
                    <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                        <img src="images/loginIcon.png" alt="" style="max-width: 100%; max-height: 100%;">
                    </div>
                </div>

            </div>
        </MudPaper>
    </div>
</EditForm>



@code {
    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ButtonTestclick() {
        @if (isShow) {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
    LogInAccountForm _model = new();
    bool success;
    private void OnValidSubmit(EditContext context) {
        success = true;
        StateHasChanged();
        //登录跳转
    }

}
