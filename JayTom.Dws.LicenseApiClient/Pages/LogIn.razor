@page "/login"
@using JayTom.Dws.LicenseApiClient.Data.Models
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using JayTom.Dws.LicenseApiClient.Api
@using JayTom.Dws.LicenseApiClient.Notification
@using Newtonsoft.Json
@inject ILicenseApiRequest LicenseApiRequest
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NotificationService NotificationService
<EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
    <ValidationSummary />
    <div style="min-width:700px; display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; overflow: hidden;position: relative;">

        @*在右上角链接*@
        <div style="position: absolute; top: 20px; right: 20px;">
            <a style="color: white;" href="https://www.wxck.top/" target="_blank">官网主页</a>
        </div>
        <img src="images/12345.png" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.9;" />
        <div style="padding: 130px; display: flex; flex-direction: column; align-items: center; text-align: center; flex-grow: 1;justify-content: center;">



            <img alt="Logo" src="images/bottom-logo.png" width="300" height="80" />
            <MudPaper Elevation="3" Style="width:663px;height:360px; position: relative; border-radius: 15px; display: flex; flex-direction: column; align-items: center;">
                <div style="display: flex; justify-content: column; align-items: center; width: 100%;">
                    <div style="padding:50px;width: 46%;">
                        <MudTextField Variant="Variant.Text" @bind-Value="@_model.UserName" Style="margin-bottom:30px" T="string" Label="用户名/手机号码" For="@(() => _model.UserName)" />
                        <MudTextField @bind-Value="@_model.Password" Variant="Variant.Text" Style="margin-bottom:30px" T="string" Label="登录密码" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ButtonTestclick" AdornmentAriaLabel="Show Password" For="@(() => _model.Password)" />
                        <div style="display: flex; justify-content: center;">
                            <MudButton Style="width:130px; border-radius: 30px;" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">登录</MudButton>
                        </div>
                    </div>

                    <div Style="background-color: rgba(62, 44, 221, 0.1); width: 55%;overflow: hidden;border-top-right-radius: 15px;border-bottom-right-radius: 15px;">
                        <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                            <img src="images/loginIcon.png" alt="" style="max-width: 100%; max-height: 100%;">
                        </div>
                    </div>

                </div>
            </MudPaper>

        </div>


        <div style="display: flex; justify-content: space-between; padding: 20px;flex-direction: column; align-items: center;">
            <div style="color:white">Copyright © 2019-2024 wxck.All Rights Reserved.粤ICP备2023129139号</div>
            <div style="adding-top:6px; color:white">版权所有 广东无限创科信息技术科技有限公司</div>
        </div>

    </div>
</EditForm>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ButtonTestclick() {
        @if (isShow) {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
    LogInAccountForm _model = new();
    bool success;
    private async void OnValidSubmit(EditContext context) {
        success = true;
        StateHasChanged();
        //登录跳转
        var (key, value) = await LicenseApiRequest.Login(_model.UserName, _model.Password);
        if (key) {
            //跳转到个人信息页
            /*if (AuthenticationState is not null) {
             *

                var identity = new ClaimsIdentity(new[]
                {

                    new Claim(ClaimTypes.Authentication, value?.ToString()??string.Empty),

                }, "apiauth_type");

                var principal = new ClaimsPrincipal(identity);
                AuthenticationState = Task.FromResult(new AuthenticationState(principal));

            }*/
            var (b, o) = await LicenseApiRequest.Info();
            if (b && o is JayTom.Dws.LicenseApiClient.Data.Models.UserInfo info) {
                NotificationService.Notify(info);
                Navigation.NavigateTo("/authorization-management");
            }

        }
        else if (value is ApiResult result) {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, Severity.Error);


        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

}
