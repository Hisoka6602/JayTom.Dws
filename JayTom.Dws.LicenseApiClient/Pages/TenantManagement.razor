@page "/tenant-management"
@using JayTom.Dws.LicenseApiClient.Data.Models

<MudCard style="border-radius:60px; width:400px;height:120px;margin-bottom:10px;">
    <MudCardContent>
        <div style="display: flex; align-items: center;">
            <div style=" display: flex; align-items: center; justify-content: center;position: relative; width:90px;height:90px; background-color: rgba(30, 144, 255, 0.1); border-radius: 50%;margin-right:10px">
                <span class="iconfont icon-yonghu" style="position: relative;color:dodgerblue; font-size: 60px;"></span>
            </div>
            <div style=" display: flex;flex-direction: column">
                <span style="font-size:18px;font-weight:bold">租户管理</span>
                <span style="color:darkgrey">租户管理</span>
            </div>

        </div>
    </MudCardContent>

</MudCard>

<MudDataGrid Elevation="1" Class="custom-datagrid" Filterable="false" SortMode="@SortMode.None" Groupable="false" Items="@_elements">
    <Columns>
        <PropertyColumn Property="x => x.Num" Title="" />
        <TemplateColumn>
            <CellTemplate>
                <img src="@context.Item?.UserIcon" alt="用户头像" style="width: 30px; height: 30px; border-radius: 50%;" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.UserCode" Title="租户代码" />
        <PropertyColumn Property="x => x.UserName" Title="租户名称" />
        <PropertyColumn Property="x => x.Phone" Title="租户手机号" />
        <TemplateColumn Title="租户状态">
            <CellTemplate>
                <MudStack Row Style="text-align:center">
                     <MudChip Size="@Size.Small" Variant="Variant.Filled" Style="@(GetUserStatusChipStyle(context.Item.Status))">
                         @GetUserStatusDisplay(context.Item.Status)
                    </MudChip>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.LicenseCodeCount" Title="租户授权码数量" />
        <PropertyColumn Style="text-align:center" Property="x => x.RegisterTime" Title="注册时间" />
        <TemplateColumn>
            <CellTemplate>
                <MudStack Row Style="text-align:center">
                     @*<MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">取消授权</MudButton>*@
                     <MudButton Style="border-radius: 15px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Error">冻结租户</MudButton>
                 </MudStack>
             </CellTemplate>
         </TemplateColumn>
     </Columns>
     <PagerContent>
         <MudDataGridPager T="TenantItemInfoModel" DisableRowsPerPage="true" />
     </PagerContent>
 </MudDataGrid>
 <style>
     .custom-datagrid .mud-table-row {
         height: 10px;
     }

 </style>

 @code {
    private List<TenantItemInfoModel> _elements = new() {

    };
    protected override void OnInitialized() {
        base.OnInitialized();
        var tenantItemInfoModels = Enumerable.Range(0, 20).Select(s => new TenantItemInfoModel {
                Num = s + 1,
                UserCode = $"用户代码{s}",
                UserName = $"测试用户名{s + 1}",
                Phone = "1" + new string(Enumerable.Range(0, 10).Select(_ => new Random().Next(10).ToString()[0]).ToArray()),
                LicenseCodeCount = new Random().Next(100),
                RegisterTime = DateTime.Now,
                Status = (UserStatus)new Random().Next(2),
                UserIcon = "https://ts1.cn.mm.bing.net/th/id/R-C.d3b5ea640ea75bd349f945dc679bbafa?rik=GUiZLEviHRjyeQ&riu=http%3a%2f%2fqimg.hxnews.com%2f2019%2f0614%2f1560501688985.jpg&ehk=Dxo5WvpKJ%2fZiJd5jLhzByDw%2fVD1VTHOlhU9YYQ%2fZp3I%3d&risl=&pid=ImgRaw&r=0"
            }).ToList();
        _elements.AddRange(tenantItemInfoModels);
    }

    private string GetUserStatusChipStyle(UserStatus status) {
        return status switch {
            UserStatus.Active => "background-color: rgba(0, 255, 0, 0.2)",
            UserStatus.Frozen => "background-color: rgba(255, 0, 0, 0.2)",
            UserStatus.Invalid => "background-color: rgba(128, 128, 128, 0.2)",
            _ => "background-color: transparent"
        };
    }

    private string GetUserStatusDisplay(UserStatus status) {
        return status switch {
            UserStatus.Active => "正常",
            UserStatus.Frozen => "冻结",
            UserStatus.Invalid => "失效",
            _ => "未知"
        };
    }

}

