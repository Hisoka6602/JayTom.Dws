@page "/tenant-management"
@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Notification
@using JayTom.Dws.LicenseApiClient.Api
@using JayTom.Dws.LicenseApiClient.Editors
@inject ILicenseApiRequest LicenseApiRequest
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NotificationService NotificationService
<MudPaper Elevation="0" Style="height:95.2vh">
    <MudOverlay Visible="_tenantEditorIsVisible" DarkBackground="true">

        <TenantEditor OnCancel="() => { _tenantEditorIsVisible=false;}" OnConfirm="HandleConfirm" />

    </MudOverlay>
    <MudOverlay Visible="_appLicenseInfoEditorIsVisible" DarkBackground="true">

        <AppLicenseInfoEditor LicenseCodeItems="@LicenseCodeItem" AppTemplateItems="@AppTemplateItems" UserInfo="@SelectTenantInfo" OnConfirm="HandleUpdateConfirm" />

    </MudOverlay>
    <PageTitleTemplate Title="租户管理" Description="租户管理" IconClass="iconfont icon-yonghu"></PageTitleTemplate>
    <MudDataGrid Elevation="1" Class="custom-datagrid" Filterable="false" SortMode="@SortMode.None" Groupable="false" Items="@_elements" QuickFilter="@_quickFilter"
                 Hover="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="模糊搜索" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Num" Title="" />
            <TemplateColumn>
                <CellTemplate>
                    <img src="@context.Item?.UserIcon" alt="用户头像" style="width: 30px; height: 30px; border-radius: 50%;" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.UserCode" Title="租户代码" />
            <PropertyColumn Property="x => x.UserName" Title="租户名称" />
            <PropertyColumn Property="x => x.Phone" Title="租户手机号" />
            <PropertyColumn Property="x => x.CompanyName" Title="公司名" />
            <TemplateColumn Title="租户状态">
                <CellTemplate>
                    <MudStack Row Style="text-align:center">
                        <MudChip Size="@Size.Small" Variant="Variant.Filled" Style="@(GetUserStatusChipStyle(context.Item.Status))">
                            @GetUserStatusDisplay(context.Item.Status)
                        </MudChip>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.MaxLicenseCodeCount" Title="授权码上限" />
            <PropertyColumn Property="x => x.LicenseCodeCount" Title="已创建数量" />
            <PropertyColumn Style="text-align:center" Property="x => x.RegisterTime" Title="注册时间" />
            <TemplateColumn>
                <CellTemplate>
                    <MudStack Row Style="text-align:center">
                        @*<MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">取消授权</MudButton>*@
                        <MudButton OnClick="() => { SelectTenantInfo=context.Item;_appLicenseInfoEditorIsVisible=true; }" Style="border-radius: 15px;" Size="@Size.Small" Variant="@Variant.Filled" Color="Color.Primary">授权信息</MudButton>
                        <MudButton OnClick="() => { FreezeUser(context.Item); }" Style="border-radius: 15px;" Size="@Size.Small" Variant="@Variant.Filled" Color="@ConvertStatusButtonColor(context.Item.Status)">@ConvertStatusButtonText(context.Item.Status)</MudButton>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudStack Row Justify="Justify.Center" Style="text-align:center">
                <div style="flex-grow: 2; flex-basis: 0; text-align: right;">
                    <MudFab OnClick="()=>{_tenantEditorIsVisible=true;}" Icon="@Icons.Material.Filled.Add" Color="Color.Primary" />
                </div>
                <div style="flex-grow: 1; text-align: right;">
                    <MudDataGridPager T="TenantItemInfoModel" DisableRowsPerPage="true" />
                </div>
            </MudStack>
        </PagerContent>
    </MudDataGrid>
</MudPaper>
<style>
    .custom-datagrid .mud-table-row {
        height: 10px;
    }

</style>

@code {
    private List<TenantItemInfoModel> _elements = new() {

    };

    private bool _tenantEditorIsVisible = false;
    private bool _appLicenseInfoEditorIsVisible = false;
    private string _searchString = string.Empty;
    private TenantItemInfoModel SelectTenantInfo { get; set; } = new();
    private List<AppTemplateItemInfoModel> AppTemplateItems { get; set; } = new();
    private List<LicenseCodeItemInfoModel> LicenseCodeItem { get; set; } = new();
    protected override async Task OnAfterRenderAsync(bool firstRender) {


        await base.OnAfterRenderAsync(firstRender);


        if (!await LicenseApiRequest.IsLoggedIn()) {
            Navigation.NavigateTo("/login");
            return;
        }
        if (firstRender) {

            await base.OnAfterRenderAsync(firstRender);
            await GetTenantInfos();
            await GetAppTemplateItems();
            await GetLicenseInfos();
            StateHasChanged();
        }

    }

    private Func<TenantItemInfoModel, bool> _quickFilter => x => {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.UserName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.UserCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
    private string GetUserStatusChipStyle(UserStatus status) {
        return status switch {
            UserStatus.Active => "background-color: rgba(0, 255, 0, 0.2)",
            UserStatus.Frozen => "background-color: rgba(255, 0, 0, 0.2)",
            UserStatus.Invalid => "background-color: rgba(128, 128, 128, 0.2)",
            _ => "background-color: transparent"
        };
    }

    private string GetUserStatusDisplay(UserStatus status) {
        return status switch {
            UserStatus.Active => "正常",
            UserStatus.Frozen => "冻结",
            UserStatus.Invalid => "失效",
            _ => "未知"
        };
    }

    private async Task GetTenantInfos() {
        var (key, value) = await LicenseApiRequest.TenantInfos();

        if (key && value is List<JayTom.Dws.LicenseApiClient.Data.Models.UserInfo> items) {
            _elements.Clear();
            _elements.AddRange(items.Select((s, i) => new TenantItemInfoModel {
                    LicenseCodeCount = s.LicenseCodeInfos?.Sum(s2 => s2.MaxClientCount) ?? 0,
                    UserCode = s.UserCode,
                    UserIcon = s.UserIcon,
                    UserName = s.UserName,
                    Phone = s.Phone,
                    Status = s.Status,
                    RegisterTime = s.RegisterTime,
                    MaxLicenseCodeCount = s.AppLicenseInfos.Sum(s1 => s1.MaxLicenseCodeCount),
                    LicenseCodeInfos = s.LicenseCodeInfos ?? new List<LicenseCodeItemInfoModel>(),
                    AppLicenseInfos = s.AppLicenseInfos ?? new List<LicenseAppLicenseInfoModel>(),
                    Num = i + 1
                })?.ToList() ?? new List<TenantItemInfoModel>());
        }
        else if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

    private async Task GetLicenseInfos() {
        var (key, value) = await LicenseApiRequest.LicenseCodeData();
        if (key && value is List<LicenseCodeItemInfoModel> items) {

            LicenseCodeItem = items.Select((s, i) => new LicenseCodeItemInfoModel {
                    ActivatedClientCount = s.ActivatedClientCount,
                    TemplateName = s.TemplateName,
                    LicenseCode = s.LicenseCode,
                    MachineCodeItem = s.MachineCodeItem,
                    MaxClientCount = s.MaxClientCount,
                    IsAvailable = s.IsAvailable,
                    ExpirationDate = s.ExpirationDate,
                    ClientName = s.ClientName,
                    UserName = s.UserName,
                    UserCode = s.UserCode,
                    Num = i + 1
                })?.ToList() ?? new List<LicenseCodeItemInfoModel>();

        }

    }

    private async Task GetAppTemplateItems() {
        var (key, value) = await LicenseApiRequest.TemplateData();
        if (key && value is List<AppTemplateItemInfoModel> infos) {

            AppTemplateItems = infos;
        }
    }
    private string ConvertStatusButtonText(UserStatus status) {
        if (status == UserStatus.Active) {

            return "冻结租户";
        }
        else {
            return "解冻租户";
        }
    }

    private Color ConvertStatusButtonColor(UserStatus status) {
        if (status == UserStatus.Active) {

            return Color.Error;
        }
        else {
            return Color.Primary;
        }
    }

    public async void FreezeUser(TenantItemInfoModel info) {


        var (key, value) = await LicenseApiRequest.FreezeUser(info.UserCode, info.Status == UserStatus.Active);
        if (value is ApiResult result) {

            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(result.Msg, result.Result ? Severity.Success : Severity.Error);
            if (key) {

                await GetTenantInfos();
                StateHasChanged();
            }
        }
        else {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add(value.ToString(), Severity.Error);
        }
    }

    private async void HandleConfirm(TenantItemInfoModel obj) {
        _tenantEditorIsVisible = false;
        await GetTenantInfos();
        StateHasChanged();
    }
    private async void HandleUpdateConfirm() {
        _appLicenseInfoEditorIsVisible = false;
        await GetTenantInfos();
        StateHasChanged();
    }
}

