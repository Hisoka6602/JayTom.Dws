@page "/userInfo"

<div style="display: flex;">
    <MudCard Style="margin-right: 30px;width:500px;height:800px; display: flex;flex-direction: column; justify-content: flex-start; align-items: center;">
        <MudImage Elevation="2" Style="margin-top:10px; border-radius:100px" Width="200" Height="200" Src="images/defaultImage.jpg">
        </MudImage>
        @*名字*@
        <div style="display: flex;margin-top:10px;">
            <MudText Style="font-weight:bold; margin-left:8px; color:dimgray" Typo="Typo.h5">Hisoka</MudText>
            <span class="iconfont icon-vips" style="color:gold; font-size: 20px; margin-bottom:5px; margin-left:5px;"></span>
        </div>
        @*用户代码*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span class="iconfont icon-renyuanjianguan" style="color:#A9A9A9; font-size: 30px; margin-bottom:5px; margin-left:5px;"></span>
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">用户代码AAA</span>
        </div>
        @*手机号*@
        @*用户代码*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span class="iconfont icon-shouji" style="color:#A9A9A9; font-size: 30px; margin-bottom:5px; margin-left:5px;"></span>
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">158****6602</span>
        </div>
        @*角色*@
        @*用户代码*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span class="iconfont icon-jiaosequanxianguanli" style="color:#A9A9A9; font-size: 30px; margin-bottom:5px; margin-left:5px;"></span>
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">租户</span>
        </div>
        @*用户状态*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span class="iconfont icon-zhuangtai1" style="color:#A9A9A9; font-size: 30px; margin-bottom:5px; margin-left:5px;"></span>
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">正常使用</span>
        </div>
        @*修改密码*@
        <div>
            <MudCard Elevation="2" Style="width:400px;height:200px">
                <MudCardContent>
                    <div>
                        <MudTextField Variant="Variant.Outlined" T="string" Label="新密码" InputType="InputType.Password" Adornment="Adornment.End" AdornmentAriaLabel="Show Password" />
                        <MudTextField Variant="Variant.Outlined" T="string" Label="重复密码" InputType="InputType.Password" Adornment="Adornment.End" AdornmentAriaLabel="Show Password" />
                        <MudButton Style="padding:0px; flex; align-items: center;margin-top:10px; width:130px; border-radius: 10px;" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                            <span class="iconfont icon-mima" style="color:white; font-size: 20px; margin-bottom:5px; margin-right:5px;"></span>
                            修改密码
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        </div>
    </MudCard>
    <MudCard Style="width:500px;height:800px; display: flex;flex-direction: column; justify-content: flex-start; align-items: center;">
        @*公司名称*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">公司名称:</span>
            <MudTextField Variant="Variant.Text" Style="width:300px;margin-left:10px; margin-bottom:30px" T="string" />
        </div>
        @*公司地址*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">公司地址:</span>
            <MudTextField Variant="Variant.Text" Style="width:300px;margin-left:10px; margin-bottom:30px" T="string" />
        </div>
        @*联系邮箱*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">联系邮箱:</span>
            <MudTextField Variant="Variant.Text" Style="width:300px;margin-left:10px; margin-bottom:30px" T="string" />
        </div>
        @*描述*@
        <div style="display: flex;margin-top:10px;display: flex; align-items: center;">
            <span style="font-weight:bold; margin-left:8px; color:#A9A9A9; font-size: 13px;">信息描述:</span>
            <MudTextField Variant="Variant.Text" Style="width:300px;margin-left:10px; margin-bottom:30px" T="string" />
        </div>
        <MudButton Style="flex; align-items: center;margin-top:10px; width:130px; border-radius: 10px;" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
            信息变更
        </MudButton>
    </MudCard>
</div>
<style>
    .badge_class: {
        width: 20px;
        height: 20px;
    }
</style>
