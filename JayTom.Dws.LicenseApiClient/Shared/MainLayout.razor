
<link href="Font/iconfont.css" rel="stylesheet" />
@using System.Diagnostics
@using JayTom.Dws.LicenseApiClient.Data.Models
@using JayTom.Dws.LicenseApiClient.Notification
@using Newtonsoft.Json
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@*这里判断页面名称是否调用以下内容*@
<MudLayout>
    @{
        string[] allowedUrls = {
    $"{Navigation.BaseUri}application-management",
    $"{Navigation.BaseUri}authorization-management",
    $"{Navigation.BaseUri}tenant-management",
    $"{Navigation.BaseUri}systemSettings-management",
    $"{Navigation.BaseUri}userInfo"
    };
    }
    @if (allowedUrls.Any(url => Navigation.Uri.ToLower().Equals(url.ToLower()))) {

        <MudDrawer Open="true" Elevation="2" Style="background-color:#594AE2;color:transparent;">
            <MudDrawerHeader>
                <div style="display:flex; align-items:center;">

                    <button onclick="@GoToUserInfo">
                        <MudAvatar>
                            <MudImage Src="@Info.UserIcon">
                            </MudImage>
                        </MudAvatar>
                    </button>

                    <MudText Style="font-weight:bold; margin-left:8px; color:white" Typo="Typo.h6">@Info.UserName</MudText>
                        @if (Info.Role == 1) {
                        <span class="iconfont icon-vips" style="color:gold; font-size: 20px; margin-bottom:5px; margin-left:5px;"></span>
                    }
                </div>
            </MudDrawerHeader>
            <NavMenu />
        </MudDrawer>
        <MudMainContent Style="padding: 20px;">
            @*三个表*@
            @*租户信息*@
            @*授权码信息*@
            @*系统设置*@
            @*个人信息*@
            @*修改密码*@
            @Body
        </MudMainContent>
    }
    else {

        @Body
    }

</MudLayout>

@code
{
    [Inject]
    private IJSRuntime JSRuntime { get; set; }
    public UserInfo Info = new();
    protected override void OnInitialized() {
        NotificationService.Subscribe<UserInfo>(HandleUserInfoNotification);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            var invokeAsync = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "info");
            if (!string.IsNullOrEmpty(invokeAsync)) {
                try {
                    Info = JsonConvert.DeserializeObject<UserInfo>(invokeAsync) ?? new UserInfo();
                }
                catch (Exception e) {
                    Info = new UserInfo();

                }


            }
            StateHasChanged();
        }


    }

    private async void HandleUserInfoNotification(UserInfo obj) {
        Info = obj;
        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "info", JsonConvert.SerializeObject(Info));
        StateHasChanged();
    }
    public void Dispose() {
        NotificationService.Unsubscribe<UserInfo>(HandleUserInfoNotification);
    }
    public void GoToUserInfo() {
        Navigation.NavigateTo("/userInfo");
    }
}

