
<link href="Font/iconfont.css" rel="stylesheet" />
@inherits LayoutComponentBase
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudDrawer Open="true" Elevation="2" Style="background-color:#594AE2;color:transparent;">
        <MudDrawerHeader>
            <div style="display:flex; align-items:center;">
                <MudAvatar>
                    <MudImage Src="images/defaultImage.jpg"></MudImage>
                </MudAvatar>
                <MudText Style="font-weight:bold; margin-left:8px; color:white" Typo="Typo.h6">Hisoka</MudText>
                <span class="iconfont icon-vips" style="color:gold; font-size: 20px; margin-bottom:5px; margin-left:5px;"></span>
            </div>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent Style="padding: 20px;">
        @*三个表*@
        @*租户信息*@
        @*授权码信息*@
        @*系统设置*@
        @*个人信息*@
        @*修改密码*@

        @Body
    </MudMainContent>
</MudLayout>


