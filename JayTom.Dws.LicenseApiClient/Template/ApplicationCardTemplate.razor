@using System.Diagnostics.CodeAnalysis
@using JayTom.Dws.LicenseApiClient.Data.Models
<div>
    <MudCard Style="width:180px;height:180px; position: relative;">
        <MudCardContent>
            <MudText Style="font-weight: bold;">@ApplicationInfo.ApplicationName</MudText>
                <MudText Typo="Typo.body2" Class="text-truncate" Style="color:gray;font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@ApplicationInfo.Description</MudText>

                <MudImage Style="width: 70px; height: 70px;" Src="images/defaultImage.jpg" Elevation="2" Class="rounded-lg"></MudImage>
            </MudCardContent>
            <MudCardActions>

                <div style="width:20px; position: absolute; left: 20px; bottom: 0; margin: 4px; ">
                    <MudTooltip Arrow="true" Placement="Placement.Bottom" Text="修改">
                        <MudFab OnClick="EditHandler" Size="Size.Small" Class="position-absolute" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Style="left: -20px; bottom: 0; " />
                    </MudTooltip>
                </div>
                <div style="width:20px; position: absolute; right: 0; bottom: 0; margin: 4px;">
                    <MudTooltip Arrow="true" Placement="Placement.Bottom" Text="删除">
                        <MudFab OnClick="DeleteHandler" Size="Size.Small" Class="position-absolute" Icon="@Icons.Material.Filled.Delete" Color="Color.Dark" Style="right: 0; bottom: 0; " />
                    </MudTooltip>
                </div>

            </MudCardActions>
        </MudCard>
    </div>
    @code {

    [Parameter]
    public ApplicationItemInfoModel ApplicationInfo { get; set; } = new();
    [Parameter]
    public EventCallback<ApplicationItemInfoModel> OnEdit { get; set; }

    [Parameter]
    public EventCallback<ApplicationItemInfoModel> OnDelete { get; set; }

    private async Task EditHandler() {

        await OnEdit.InvokeAsync(ApplicationInfo);
    }


    private async Task DeleteHandler() {

        await OnDelete.InvokeAsync(ApplicationInfo);
    }
}
