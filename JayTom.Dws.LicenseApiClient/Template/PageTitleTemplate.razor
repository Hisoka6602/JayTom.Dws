<div style="margin-left:0px; display: flex; align-items: center;justify-content: start;margin-bottom:5px;">
    <div style=" display: flex; align-items: center; justify-content: center;position: relative; width:45px;height:45px; background-color: rgba(30, 144, 255, 0.1); border-radius: 50%;margin-right:10px">
        <span class="@IconClass" style="position: relative;color:dodgerblue; font-size: 30px;"></span>
    </div>
    <div style=" display: flex;flex-direction: column">
        <span style="font-size:16px;font-weight:bold">@Title</span>
        <span style="color:darkgrey">@Description</span>
    </div>

</div>
@code {
    [Parameter]
    public string IconClass { get; set; } = string.Empty;
    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public string Description { get; set; } = string.Empty;
}
