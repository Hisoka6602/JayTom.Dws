<link href="Font/iconfont.css" rel="stylesheet" />
@inherits LayoutComponentBase
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudDrawer Open="true" Elevation="2" Style="background-color:#594AE2;color:transparent;">
        <MudDrawerHeader>
            <div style="display:flex; align-items:center;">
                <MudAvatar>
                    <MudImage Src="images/defaultImage.jpg"></MudImage>
                </MudAvatar>
                <MudText Style="font-weight:bold; margin-left:8px; color:white" Typo="Typo.h6">Hisoka</MudText>
                <span class="iconfont icon-vips" style="color:gold; font-size: 20px; margin-bottom:5px; margin-left:5px;"></span>
            </div>
        </MudDrawerHeader>
        <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Surface" Style=" color:white;background-color:transparent">
            <MudNavLink Class="MudNavLink-active" Match="NavLinkMatch.Prefix">
                <div style="display:flex; align-items:center;">
                    <span class="iconfont icon-app" style="font-size: 20px; margin-bottom:5px; margin-right:10px;"></span>
                    <span>应用管理</span>
                </div>
            </MudNavLink>
            <MudNavLink Class="MudNavLink-active" Match="NavLinkMatch.Prefix">
                <div style="display:flex; align-items:center;">
                    <span class="iconfont icon-yonghu" style="font-size: 20px; margin-bottom:5px; margin-right:10px;"></span>
                    <span>租户管理</span>
                </div>
            </MudNavLink>
            <MudNavLink Class="MudNavLink-active" Match="NavLinkMatch.Prefix">
                <div style="display:flex; align-items:center;">
                    <span class="iconfont icon-lingpaiguanli" style="font-size: 20px; margin-bottom:5px; margin-right:10px;"></span>
                    <span>授权管理</span>
                </div>
            </MudNavLink>
            <MudNavLink Class="MudNavLink-active" Match="NavLinkMatch.Prefix">
                <div style="display:flex; align-items:center;">
                    <span class="iconfont icon-shezhi" style="font-size: 20px; margin-bottom:5px; margin-right:10px;"></span>
                    <span>系统设置</span>
                </div>
            </MudNavLink>

        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Style="padding: 20px;">
        @*三个表*@
        @*租户信息*@
        @*授权码信息*@
        @*系统设置*@
        @*个人信息*@
        @*修改密码*@

        <MudDataGrid Elevation="1" Filterable="false" SortMode="@SortMode.None" Groupable="false" Items="@_elements">
            <Columns>
                <PropertyColumn Property="x =>string.Empty" Title="头像" />
                <PropertyColumn Property="x => x.UserCode" Title="租户代码" />
                <PropertyColumn Property="x => x.UserName" Title="租户名称" />
                <PropertyColumn Property="x => x.Phone" Title="租户手机号" />
                <PropertyColumn Property="x => x.Pid" Title="租户授权码数量" />
                <PropertyColumn Property="x => x.Status" Title="租户状态" />
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudStack Row>
                            <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">取消授权</MudButton>
                            <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">冻结租户</MudButton>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="LicenseUserInfo" RowsPerPageString="每页行数" />
            </PagerContent>
        </MudDataGrid>
    </MudMainContent>
</MudLayout>
<style>
    .MudNavLink-active .mud-nav-link.active:not(.mud-nav-link-disabled) {
        color: white;
        font-size: 15px;
    }
</style>

