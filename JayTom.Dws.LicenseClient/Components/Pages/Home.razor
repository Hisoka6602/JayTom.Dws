@page "/"

<MudDataGrid Elevation="1" Filterable="false" SortMode="@SortMode.None" Groupable="false" Items="@_elements">
    <Columns>
        <PropertyColumn Property="x =>string.Empty" Title="头像" />
        <PropertyColumn Property="x => x.UserCode" Title="租户代码" />
        <PropertyColumn Property="x => x.UserName" Title="租户名称" />
        <PropertyColumn Property="x => x.Phone" Title="租户手机号" />
        <PropertyColumn Property="x => x.Pid" Title="租户授权码数量" />
        <PropertyColumn Property="x => x.Status" Title="租户状态" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudStack Row>
                    <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">取消授权</MudButton>
                    <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">冻结租户</MudButton>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="LicenseUserInfo" RowsPerPageString="每页行数" />
    </PagerContent>
</MudDataGrid>
