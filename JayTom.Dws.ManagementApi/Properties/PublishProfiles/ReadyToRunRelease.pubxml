<?xml version="1.0" encoding="utf-8"?>
<!--
This publish profile demonstrates ReadyToRun (R2R) configuration.

ReadyToRun is the RECOMMENDED approach for this project as it:
- Improves startup performance
- Is fully compatible with WPF, EF Core, and reflection
- Requires no code changes
- Has no compatibility risks

The trade-off is larger deployment size compared to trimming.

Usage:
  dotnet publish -p:PublishProfile=ReadyToRunRelease
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <ProjectGuid>32766ea9-739c-4843-b9cb-7f825e015899</ProjectGuid>
    <publishUrl>bin\Release\net6.0\publish\r2r\</publishUrl>
    <DeleteExistingFiles>False</DeleteExistingFiles>
    <TargetFramework>net6.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    
    <!-- Enable ReadyToRun compilation -->
    <PublishReadyToRun>true</PublishReadyToRun>
    
    <!-- Optional: Also create composite R2R images for better startup (larger size) -->
    <!-- <PublishReadyToRunComposite>true</PublishReadyToRunComposite> -->
    
    <!-- Optional: Enable single file publishing -->
    <!-- Note: Single file + R2R = larger file but single executable -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    
    <!-- Optional: Include symbols for better debugging -->
    <!-- <PublishReadyToRunEmitSymbols>true</PublishReadyToRunEmitSymbols> -->
  </PropertyGroup>
</Project>
