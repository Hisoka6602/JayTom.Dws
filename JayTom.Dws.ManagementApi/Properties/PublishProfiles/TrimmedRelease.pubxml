<?xml version="1.0" encoding="utf-8"?>
<!--
This publish profile demonstrates IL Trimming configuration for the ManagementApi project.

IMPORTANT: This is an EXPERIMENTAL configuration. 
Before using in production, thoroughly test all functionality.

Usage:
  dotnet publish -p:PublishProfile=TrimmedRelease

To test trimming warnings without publishing:
  dotnet build /p:PublishTrimmed=true /p:EnableTrimAnalyzer=true
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <ProjectGuid>32766ea9-739c-4843-b9cb-7f825e015899</ProjectGuid>
    <publishUrl>bin\Release\net6.0\publish\trimmed\</publishUrl>
    <DeleteExistingFiles>False</DeleteExistingFiles>
    <TargetFramework>net6.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    
    <!-- Trimming Configuration -->
    <PublishTrimmed>true</PublishTrimmed>
    
    <!-- Use 'partial' mode for better compatibility (recommended for first attempt) -->
    <!-- This trims only framework assemblies, not application assemblies -->
    <TrimMode>partial</TrimMode>
    
    <!-- Alternative: 'link' mode for more aggressive trimming (reduces size more but higher risk) -->
    <!-- Uncomment to use link mode after testing partial mode -->
    <!-- <TrimMode>link</TrimMode> -->
    
    <!-- Enable trim analyzer to show warnings during build -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    
    <!-- Set to false to see all trim warnings (recommended for testing) -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    
    <!-- Optional: Enable single file publishing -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    
    <!-- Optional: Enable ReadyToRun for faster startup (increases size) -->
    <!-- <PublishReadyToRun>true</PublishReadyToRun> -->
  </PropertyGroup>
</Project>
