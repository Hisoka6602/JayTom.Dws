<Project Sdk="Microsoft.NET.Sdk">
  <!-- 插件核心契约保持跨平台，仅依赖共享抽象，不引入桌面 UI 或宿主容器。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JayTom.Dws.Plugin.Contracts</AssemblyName>
    <RootNamespace>JayTom.Dws.Plugin.Contracts</RootNamespace>
    <Description>跨平台插件契约、生命周期与兼容性模型。</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JayTom.Dws.Abstractions\JayTom.Dws.Abstractions.csproj" />
  </ItemGroup>
</Project>
