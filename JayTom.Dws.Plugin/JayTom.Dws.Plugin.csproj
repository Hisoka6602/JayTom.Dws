<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>JayTom.Dws.DeviceAdapters</AssemblyName>
    <Description>串口、网络、称重、PLC、语音及 FTP 等设备适配器。</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Sound\fail.wav" />
    <None Remove="Sound\success.wav" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sound\fail.wav" />
    <EmbeddedResource Include="Sound\success.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="HidSharpCore" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NLog" />
    <PackageReference Include="RawInput.Sharp" />
    <PackageReference Include="S7netplus" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Speech" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="System.Windows.Extensions" />
    <PackageReference Include="TouchSocket" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JayTom.Dws.Abstractions\JayTom.Dws.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Machine\" />
    <Folder Include="Speech\Container\" />
  </ItemGroup>

</Project>
