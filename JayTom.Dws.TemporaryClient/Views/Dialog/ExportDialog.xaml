<UserControl
    x:Class="JayTom.Dws.TemporaryClient.Views.Dialog.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Width="800"
    Height="150"
    d:DesignHeight="150"
    d:DesignWidth="1000"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Focusable="False"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded" SourceName="ExportView">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <materialDesign:Card
        MinWidth="250"
        MinHeight="30"
        MaxWidth="800"
        Margin="2"
        Padding="20,5"
        Background="#202020"
        Focusable="False"
        UniformCornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <!--  下载信息  -->
            <StackPanel
                Grid.Row="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                    FontSize="23"
                    FontWeight="Light"
                    Foreground="DarkGray"
                    Text="&#xe77f;" />
                <TextBlock
                    Width="800"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <!--  进度条、取消按钮  -->
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Grid>
                    <ProgressBar
                        Width="650"
                        Height="40"
                        Padding="0"
                        materialDesign:TransitionAssist.DisableTransitions="True"
                        Background="#096e3dff"
                        Foreground="BlueViolet"
                        Maximum="{Binding MaxProgress}"
                        Opacity="0.8"
                        Style="{StaticResource CustomProgressBarStyle}"
                        Value="{Binding Progress}" />
                    <!--  百分比  -->
                    <TextBlock
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="DimGray"
                        Text="{Binding ProgressText}" />
                </Grid>
            </StackPanel>
            <!--  文件路径  -->
            <StackPanel
                Grid.Row="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  图标  -->
                <TextBlock
                    Margin="5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                    FontSize="23"
                    FontWeight="Light"
                    Foreground="DarkGray"
                    Text="&#xe645;" />

                <!--  信息  -->
                <TextBlock
                    Width="800"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="DarkGray"
                    Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>