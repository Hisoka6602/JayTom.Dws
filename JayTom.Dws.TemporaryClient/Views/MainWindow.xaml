<Window
    x:Class="JayTom.Dws.TemporaryClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.TemporaryClient"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="MainWin"
    Title="江腾Dws"
    Width="1200"
    Height="900"
    MinWidth="800"
    MinHeight="600"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <!--<b:EventTrigger EventName="Loaded" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" />
        </b:EventTrigger>-->
        <b:EventTrigger EventName="SizeChanged" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding SizeChangedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="70"
            CornerRadius="10"
            GlassFrameThickness="-1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <!--  外层提示框/更新提示框  -->
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="MainDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <materialDesign:Card
            Margin="0"
            materialDesign:ElevationAssist.Elevation="Dp2"
            materialDesign:ShadowAssist.Darken="True"
            materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
            Background="#202020"
            UniformCornerRadius="{Binding UniformCornerRadius, UpdateSourceTrigger=PropertyChanged}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>
                <!--  系统按钮  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CornerRadius="5,5,0,0">
                    <!--  系统按钮  -->
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  软件名  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="江腾Dws0" />
                        <!--  最小化  -->
                        <Button
                            Command="{Binding MinWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="最小化">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe626;" />
                        </Button>
                        <!--  最大化  -->
                        <Button
                            x:Name="MaxButton"
                            Command="{Binding MaxWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="{Binding MaxBtnToolTip, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                x:Name="MaxBlock"
                                Foreground="White"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="{Binding MaxBtnIcon, UpdateSourceTrigger=PropertyChanged}" />
                        </Button>
                        <!--  关闭  -->
                        <Button
                            Command="{Binding CloseWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource CustomCloseButtonStyle}"
                            ToolTip="关闭">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe601;" />
                        </Button>
                    </StackPanel>
                </Border>
                <!--  页面内容  -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  显示实时长宽高  -->
                    <!--  显示列表内容  -->
                </Grid>
            </Grid>
        </materialDesign:Card>
    </materialDesign:DialogHost>
</Window>