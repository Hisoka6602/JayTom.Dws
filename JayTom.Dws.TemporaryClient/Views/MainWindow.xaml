<Window
    x:Class="JayTom.Dws.TemporaryClient.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.TemporaryClient"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="MainWin"
    Title="JayTom.Dws"
    Width="1024"
    Height="768"
    MinWidth="800"
    MinHeight="600"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <!--<b:EventTrigger EventName="Loaded" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" />
        </b:EventTrigger>-->
        <b:EventTrigger EventName="SizeChanged" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding SizeChangedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="70"
            CornerRadius="10"
            GlassFrameThickness="-1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <!--  外层提示框/更新提示框  -->
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="MainDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <materialDesign:Card
            Margin="0"
            materialDesign:ElevationAssist.Elevation="Dp2"
            materialDesign:ShadowAssist.Darken="True"
            materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
            Background="#202020"
            UniformCornerRadius="{Binding UniformCornerRadius, UpdateSourceTrigger=PropertyChanged}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>
                <!--  系统按钮  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CornerRadius="5,5,0,0">
                    <!--  系统按钮  -->
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  软件名  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="JayTom.Dws" />
                        <!--  最小化  -->
                        <Button
                            Command="{Binding MinWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="Minimize">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe626;" />
                        </Button>
                        <!--  最大化  -->
                        <Button
                            x:Name="MaxButton"
                            Command="{Binding MaxWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="{Binding MaxBtnToolTip, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                x:Name="MaxBlock"
                                Foreground="White"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="{Binding MaxBtnIcon, UpdateSourceTrigger=PropertyChanged}" />
                        </Button>
                        <!--  关闭  -->
                        <Button
                            Command="{Binding CloseWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource CustomCloseButtonStyle}"
                            ToolTip="Close">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe601;" />
                        </Button>
                    </StackPanel>
                </Border>
                <!--  页面内容  -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                    <!--  显示实时长宽高  -->
                    <Border Grid.Row="0" HorizontalAlignment="Center">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <!--  长  -->
                                <TextBlock
                                    MinWidth="130"
                                    Margin="20,0"
                                    VerticalAlignment="Center"
                                    FontFamily="微软雅黑"
                                    Foreground="White"
                                    TextAlignment="Center">
                                    <Run
                                        FontSize="35"
                                        FontWeight="ExtraBold"
                                        Text="Length:" />
                                    <Run
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="25"
                                        FontWeight="Light"
                                        Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                                </TextBlock>
                                <!--  宽  -->
                                <TextBlock
                                    MinWidth="130"
                                    Margin="20,0"
                                    VerticalAlignment="Center"
                                    FontFamily="微软雅黑"
                                    Foreground="White"
                                    TextAlignment="Center">
                                    <Run
                                        FontSize="35"
                                        FontWeight="ExtraBold"
                                        Text="Width:" />
                                    <Run
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="25"
                                        FontWeight="Light"
                                        Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                                </TextBlock>
                                <!--  高  -->
                                <TextBlock
                                    MinWidth="130"
                                    Margin="20,0"
                                    VerticalAlignment="Center"
                                    FontFamily="微软雅黑"
                                    Foreground="White"
                                    TextAlignment="Center">
                                    <Run
                                        FontSize="35"
                                        FontWeight="ExtraBold"
                                        Text="Height:" />
                                    <Run
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="25"
                                        FontWeight="Light"
                                        Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                                </TextBlock>
                            </StackPanel>
                            <!--  显示实时状态  -->
                            <Separator MinWidth="1000" />
                            <TextBlock
                                Margin="0,10"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Light"
                                Foreground="White"
                                TextAlignment="Center">
                                <Run Text="Barcode:" /><Run
                                    FontSize="25"
                                    FontWeight="Bold"
                                    Text="{Binding DisplayBarcode, UpdateSourceTrigger=PropertyChanged}" />
                                <Run Text="RequestStatus:" /><Run
                                    FontSize="25"
                                    FontWeight="Bold"
                                    Text="{Binding RequestStatus, UpdateSourceTrigger=PropertyChanged}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!--  工具栏  -->
                    <Border
                        Grid.Row="1"
                        Margin="20,0"
                        HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="WhiteSmoke"
                                Text="ScanTime:" />
                            <!--  时间选择器  -->
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox
                                        Width="120"
                                        MaxWidth="170"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        BorderThickness="0"
                                        Focusable="False"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsReadOnly="True"
                                        Text="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                    <Button
                                        Width="30"
                                        Margin="0,0,0,0"
                                        Padding="0"
                                        materialDesign:RippleAssist.Feedback="DodgerBlue"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Command="{Binding OpenDateTimeDialogCommand}"
                                        CommandParameter="StartTime"
                                        FocusVisualStyle="{x:Null}"
                                        Foreground="DodgerBlue"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="DimGray"
                                            Kind="CalendarClock" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="~" />
                            <!--  时间选择器  -->
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox
                                        Width="120"
                                        MaxWidth="170"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        BorderThickness="0"
                                        Focusable="False"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsReadOnly="True"
                                        Text="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                    <Button
                                        Width="30"
                                        Margin="0,0,0,0"
                                        Padding="0"
                                        materialDesign:RippleAssist.Feedback="DodgerBlue"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Command="{Binding OpenDateTimeDialogCommand}"
                                        CommandParameter="EndTime"
                                        FocusVisualStyle="{x:Null}"
                                        Foreground="DodgerBlue"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="DimGray"
                                            Kind="CalendarClock" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="WhiteSmoke"
                                Text="BarCode:" />
                            <!--  单号  -->
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="5">
                                <TextBox
                                    Width="150"
                                    Height="30"
                                    MaxWidth="170"
                                    Margin="5,0"
                                    materialDesign:TextFieldAssist.HasClearButton="False"
                                    materialDesign:TextFieldAssist.HasFilledTextField="True"
                                    BorderThickness="0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Border>
                            <!--  按钮  -->
                            <Border
                                Width="120"
                                Height="40"
                                Margin="10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A696969"
                                CornerRadius="20">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        Width="55"
                                        Height="40"
                                        Margin="0"
                                        Padding="0"
                                        materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                                        materialDesign:ShadowAssist.ShadowEdges="Right"
                                        Background="Transparent"
                                        Command="{Binding SearchCommand}"
                                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                                        ToolBar.OverflowMode="Never"
                                        ToolTip="Search">

                                        <TextBlock
                                            FontFamily="pack://application:,,,/Fonts/#IconFont"
                                            FontSize="20"
                                            FontWeight="Light"
                                            Foreground="GhostWhite"
                                            Text="&#xe60b;" />
                                    </Button>
                                    <Separator
                                        Margin="0,10"
                                        Background="DimGray"
                                        Foreground="DimGray">
                                        <Separator.LayoutTransform>
                                            <RotateTransform Angle="90" />
                                        </Separator.LayoutTransform>
                                    </Separator>
                                    <Button
                                        Width="55"
                                        Height="40"
                                        Margin="0"
                                        Padding="0"
                                        materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                                        materialDesign:ShadowAssist.ShadowEdges="Right"
                                        Background="Transparent"
                                        Command="{Binding ExportCommand}"
                                        Style="{StaticResource ButtonFocusEnlargeStyle}"
                                        ToolTip="Export">
                                        <TextBlock
                                            FontFamily="pack://application:,,,/Fonts/#IconFont"
                                            FontSize="20"
                                            FontWeight="Light"
                                            Foreground="GhostWhite"
                                            Text="&#xe77f;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!--  显示列表内容  -->
                    <DataGrid
                        Grid.Row="2"
                        Margin="20,10,20,0"
                        Padding="10,0"
                        materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                        materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                        AlternatingRowBackground="#101E90FF"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        CanUserAddRows="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                        ColumnHeaderStyle="{StaticResource CustomDataGridTextColumnStyle}"
                        FontFamily="{StaticResource CustomFontFamily}"
                        Foreground="White"
                        FrozenColumnCount="2"
                        GridLinesVisibility="None"
                        HorizontalScrollBarVisibility="Auto"
                        IsSelected="False"
                        ItemsSource="{Binding BarCodeItems, UpdateSourceTrigger=PropertyChanged}"
                        RowBackground="#061E90FF">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                                <Setter Property="Height" Value="30" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="45"
                                Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding TimestampedGuid, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe6c8;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="TimestampedGuid" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe6c8;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="Barcode" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe60e;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="Weight" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe60e;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="Length" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe60e;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="Width" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe60e;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="Height" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding ScanTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DataGridTextColumnIconStyle}" Text="&#xe60c;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="ScanTime" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding RequestStatus, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe60e;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="RequestStatus" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding RequestTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DataGridTextColumnIconStyle}" Text="&#xe60c;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="RequestTime" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                MaxWidth="600"
                                Binding="{Binding RequestContent, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe60e;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="RequestContent" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding ResponseTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DataGridTextColumnIconStyle}" Text="&#xe60c;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="ResponseTime" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                MaxWidth="600"
                                Binding="{Binding ResponseContent, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe60e;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="ResponseContent" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!--  翻页控件  -->
                    <Border
                        Grid.Row="3"
                        MinWidth="200"
                        MinHeight="40"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#2A808080"
                        CornerRadius="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" MinWidth="50" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <!--  首页  -->
                            <Button
                                Grid.Column="0"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#1A696969"
                                Command="{Binding FirstPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="FirstPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe68c;">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <!--  上一页  -->
                            <Button
                                Grid.Column="1"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#1A696969"
                                Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="PreviousPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe7a5;" />
                            </Button>
                            <!--  页码  -->
                            <StackPanel
                                Grid.Column="2"
                                Margin="10,0"
                                HorizontalAlignment="Stretch"
                                Orientation="Horizontal">
                                <TextBox
                                    MinWidth="20"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Foreground="DimGray"
                                    materialDesign:HintAssist.HintOpacity="0.4"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding JumpPageCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="White">
                                    <Run Text="/" /><Run Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" />
                                </TextBlock>
                            </StackPanel>
                            <!--  下一页  -->
                            <Button
                                Grid.Column="3"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#1A696969"
                                Command="{Binding NextPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="NextPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe798;" />
                            </Button>
                            <!--  尾页  -->
                            <Button
                                Grid.Column="4"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#1A696969"
                                Command="{Binding LastPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="LastPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe68c;" />
                            </Button>
                        </Grid>
                    </Border>
                    <!--  提示框  -->
                    <materialDesign:Snackbar
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Width="Auto"
                        Height="Auto"
                        VerticalAlignment="Bottom"
                        Background="BlueViolet"
                        FontFamily="LoadFiraCode"
                        FontWeight="Bold"
                        MessageQueue="{Binding MainMessageQueue}" />
                </Grid>
            </Grid>
        </materialDesign:Card>
    </materialDesign:DialogHost>
</Window>