<UserControl
    x:Class="JayTom.Dws.VideoApiClient.Views.Dialog.VideoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.VideoApiClient.Views.Dialog"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Width="1200"
    Height="900"
    d:DesignHeight="450"
    d:DesignWidth="648"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="{StaticResource CustomFontFamily}"
    mc:Ignorable="d">
    <mvvm:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="Width" Value="1200" />
            <Setter Property="Height" Value="900" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="50"
                        CornerRadius="10"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="True" />
                </Setter.Value>
            </Setter>
        </Style>
    </mvvm:Dialog.WindowStyle>
    <materialDesign:Card
        Name="VideoCard"
        Margin="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        materialDesign:ElevationAssist.Elevation="Dp2"
        materialDesign:ShadowAssist.Darken="True"
        materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
        Background="#F1F5F8"
        UniformCornerRadius="10">
        <materialDesign:DrawerHost
            x:Name="DrawerHost"
            Width="{Binding ElementName=VideoCard, Path=ActualWidth}"
            Height="{Binding ElementName=VideoCard, Path=ActualHeight}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            BottomDrawerBackground="{DynamicResource SecondaryHueLightBrush}"
            BottomDrawerCornerRadius="10 10 10 10"
            IsBottomDrawerOpen="True"
            IsRightDrawerOpen="True"
            OverlayBackground="Transparent"
            RightDrawerBackground="Transparent"
            RightDrawerCornerRadius="10 10 10 10">
            <materialDesign:DrawerHost.Style>
                <Style TargetType="materialDesign:DrawerHost">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=BackgroundToggle}" Value="True">
                            <Setter Property="OverlayBackground" Value="{DynamicResource PrimaryHueMidBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:DrawerHost.Style>

            <!--  下面进度条  -->
            <materialDesign:DrawerHost.BottomDrawerContent>
                <Grid Margin="10">
                    <!--  上下分  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  进度条  -->
                    <Slider
                        Grid.Row="0"
                        materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                        Foreground="RoyalBlue"
                        IsSelectionRangeEnabled="True"
                        Maximum="100"
                        Minimum="0"
                        SelectionEnd="90"
                        SelectionStart="70"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                        TickFrequency="{Binding DiscreteHorizontal.TickFrequency}"
                        Value="20" />
                    <Border Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>

                            <!--  播放按钮、时间  -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!--  播放按钮  -->
                                <Button
                                    Width="50"
                                    Height="50"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    materialDesign:ElevationAssist.Elevation="Dp6"
                                    materialDesign:RippleAssist.ClipToBounds="True"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    Style="{StaticResource MaterialDesignFloatingActionLightButton}">
                                    <TextBlock
                                        Margin="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Foreground="DarkGray"
                                        Text="&#xe8be;" />
                                </Button>
                                <!--  时间  -->
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray">
                                    <Run Text="00:09" /> <Run Text="/" /> <Run Text="11:48" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray">
                                    <Run Text="Channel(通道):" /><Run Text="1" />
                                </TextBlock>
                                <TextBlock
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray">
                                    <Run Text="Steram(码流):" /><Run Text="2" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:DrawerHost.BottomDrawerContent>
            <!--  右边设置  -->
            <materialDesign:DrawerHost.RightDrawerContent>
                <Border
                    Height="300"
                    Background="#2A808080"
                    CornerRadius="10,0,0,10">
                    <StackPanel Margin="10" Orientation="Vertical">
                        <!--  播放设置  -->
                        <TextBlock
                            Margin="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="DimGray"
                            Text="播放设置" />
                        <!--  Channel(通道)  -->
                        <StackPanel
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="DimGray"
                                Text="Channel(通道):" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A808080"
                                CornerRadius="5">
                                <ComboBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="100"
                                    Margin="5,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ThemeAssist.Theme="Inherit"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    ItemsSource="{Binding NodeList, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedNode, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                        </StackPanel>
                        <!--  Steram(码流)  -->
                        <StackPanel
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="DimGray"
                                Text="Steram(码流):" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A808080"
                                CornerRadius="5">
                                <ComboBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="100"
                                    Margin="5,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ThemeAssist.Theme="Inherit"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    ItemsSource="{Binding NodeList, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedNode, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                        </StackPanel>
                        <Separator Margin="0,15" />
                        <!--  下载设置  -->
                        <TextBlock
                            Margin="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="DimGray"
                            Text="下载设置" />
                        <!--  Channel(通道)  -->
                        <StackPanel
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="DimGray"
                                Text="Channel(通道):" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A808080"
                                CornerRadius="5">
                                <ComboBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="100"
                                    Margin="5,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ThemeAssist.Theme="Inherit"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    ItemsSource="{Binding NodeList, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedNode, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                        </StackPanel>
                        <!--  Steram(码流)  -->
                        <StackPanel
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="DimGray"
                                Text="Steram(码流):" />
                            <Border
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1A808080"
                                CornerRadius="5">
                                <ComboBox
                                    Width="80"
                                    Height="30"
                                    MaxWidth="100"
                                    Margin="5,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    materialDesign:ThemeAssist.Theme="Inherit"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    ItemsSource="{Binding NodeList, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedNode, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                        </StackPanel>
                        <!--  下载  -->
                        <Button
                            MinHeight="30"
                            Margin="30,10"
                            HorizontalAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="DodgerBlue"
                            BorderThickness="0"
                            Command="{Binding SaveSettingsCommand}"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource MaterialDesignFlatAccentBgButton}">

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="18"
                                        Foreground="White"
                                        Text="&#xe894;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CustomFontFamily}"
                                        FontSize="12"
                                        Foreground="White"
                                        Text="下载" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <ProgressBar
                                    Name="StatusProgressBar"
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True"
                                    Value="0">
                                    <ProgressBar.Style>
                                        <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSavingInProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </materialDesign:DrawerHost.RightDrawerContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  系统按钮  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CornerRadius="5,5,0,0">
                    <!--  系统按钮  -->
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  最大化  -->
                        <Button
                            x:Name="MaxButton"
                            Command="{Binding MaxWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="{Binding MaxBtnToolTip, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                x:Name="MaxBlock"
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="{Binding MaxBtnIcon, UpdateSourceTrigger=PropertyChanged}" />
                        </Button>
                        <!--  关闭  -->
                        <Button
                            Command="{Binding CloseWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource CustomCloseButtonStyle}"
                            ToolTip="关闭">
                            <TextBlock
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe601;" />
                        </Button>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    CornerRadius="0,0,10,10">
                    <Border
                        Margin="0,50,0,0"
                        Background="Black"
                        CornerRadius="0,0,10,10">
                        <Grid>

                            <!--  大画面  -->
                            <Image />
                            <!--  下面进度条  -->
                            <!--  右边设置  -->
                        </Grid>
                    </Border>
                </Border>
                <!--  内容  -->
                <!--  视频和展开的设置内容  -->
            </Grid>
        </materialDesign:DrawerHost>
    </materialDesign:Card>
</UserControl>