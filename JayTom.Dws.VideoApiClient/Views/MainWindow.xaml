<Window
    x:Class="JayTom.Dws.VideoApiClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.VideoApiClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModels="clr-namespace:JayTom.Dws.VideoApiClient.Models"
    xmlns:local="clr-namespace:JayTom.Dws.VideoApiClient"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="MainWin"
    Title="MainWindow"
    Width="1200"
    Height="900"
    MinWidth="800"
    MinHeight="600"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:FileExistsToVisibilityConverter x:Key="FileExistsToVisibilityConverter" />

        <!--  全景图模板  -->
        <DataTemplate x:Key="PanoramaImageTemplate" DataType="{x:Type dataModels:PanoramaImageItemModel}">
            <!--  横向列表，读全景图列数据  -->
            <!--  查看按钮  -->
            <Button
                Height="25"
                MinWidth="25"
                Padding="0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="Transparent"
                Command="{Binding ElementName=MainWin, Path=DataContext.PanoramaImageCommand}"
                CommandParameter="{Binding}"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatLightButton}"
                ToolTip="打开图片"
                Visibility="{Binding ImageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <!--<TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                        FontSize="12"
                        FontWeight="Light"
                        Foreground="DodgerBlue"
                        IsEnabled="True"
                        Text="查看图片"
                        TextAlignment="Justify" />-->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="18"
                        Foreground="DodgerBlue"
                        Text="&#xe6ad;" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <!--  视频模板  -->
        <DataTemplate x:Key="VideoTemplate" DataType="{x:Type dataModels:NvrCameraBindingItemInfo}">
            <!--  横向列表，读全景图列数据  -->
            <!--  查看按钮  -->
            <Button
                Height="25"
                MinWidth="25"
                Padding="0"
                materialDesign:ButtonAssist.CornerRadius="10"
                Background="Transparent"
                Command="{Binding ElementName=MainWin, Path=DataContext.VideoCommand}"
                CommandParameter="{Binding}"
                Focusable="False"
                Style="{StaticResource MaterialDesignFlatLightButton}"
                ToolTip="查看视频"
                Visibility="{Binding IsVideoLinkVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <!--<TextBlock
                Margin="5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                FontSize="12"
                FontWeight="Light"
                Foreground="DodgerBlue"
                IsEnabled="True"
                Text="查看图片"
                TextAlignment="Justify" />-->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="18"
                        Foreground="DodgerBlue"
                        Text="&#xe773;" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="SizeChanged" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding SizeChangedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Loaded" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding LoadedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="70"
            CornerRadius="10"
            GlassFrameThickness="-1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <!--  外层提示框/更新提示框  -->
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="MainDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <materialDesign:Card
            Margin="0"
            materialDesign:ElevationAssist.Elevation="Dp2"
            materialDesign:ShadowAssist.Darken="True"
            materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
            Background="White"
            UniformCornerRadius="{Binding UniformCornerRadius, UpdateSourceTrigger=PropertyChanged}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <!--  渐变背景  -->

                <!--  软件名  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#AD424242"
                    Text="无限创科视频追溯平台" />
                <!--  系统按钮  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CornerRadius="5,5,0,0">
                    <!--  系统按钮  -->
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  设置  -->
                        <Button
                            Command="{Binding SettingCommand}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="设置">
                            <TextBlock
                                FontSize="24"
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe713;" />
                        </Button>
                        <!--  最小化  -->
                        <Button
                            Command="{Binding MinWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="最小化">
                            <TextBlock
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe626;" />
                        </Button>
                        <!--  最大化  -->
                        <Button
                            x:Name="MaxButton"
                            Command="{Binding MaxWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="{Binding MaxBtnToolTip, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                x:Name="MaxBlock"
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="{Binding MaxBtnIcon, UpdateSourceTrigger=PropertyChanged}" />
                        </Button>
                        <!--  关闭  -->
                        <Button
                            Command="{Binding CloseWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource CustomCloseButtonStyle}"
                            ToolTip="关闭">
                            <TextBlock
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe601;" />
                        </Button>
                    </StackPanel>
                </Border>
                <!--  内容  -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>
                    <!--  统计数据  -->
                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  上月数据  -->
                        <Border
                            Width="200"
                            Height="100"
                            Margin="10"
                            Background="#F1F5F8"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <Border
                                    Width="60"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="SlateGray"
                                    CornerRadius="10,0,10,0"
                                    Opacity="0.7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="上月" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="50"
                                    FontWeight="Bold"
                                    Foreground="SlateGray"
                                    Opacity="0.7"
                                    Text="{Binding LastDayOfMonthCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                        <!--  本月数据  -->
                        <Border
                            Width="200"
                            Height="100"
                            Margin="10"
                            Background="#F1F5F8"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <Border
                                    Width="60"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="IndianRed"
                                    CornerRadius="10,0,10,0"
                                    Opacity="0.7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="本月" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="50"
                                    FontWeight="Bold"
                                    Foreground="IndianRed"
                                    Opacity="0.7"
                                    Text="{Binding FirstDayOfMonthCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                        <!--  昨天数据  -->
                        <Border
                            Width="200"
                            Height="100"
                            Margin="10"
                            Background="#F1F5F8"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <Border
                                    Width="60"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="DimGray"
                                    CornerRadius="10,0,10,0"
                                    Opacity="0.7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="昨天" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="50"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Opacity="0.7"
                                    Text="{Binding YesterdayBarcodeCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                        <!--  今天数据  -->
                        <Border
                            Width="200"
                            Height="100"
                            Margin="10"
                            Background="#F1F5F8"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <Border
                                    Width="60"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="DodgerBlue"
                                    CornerRadius="10,0,10,0"
                                    Opacity="0.7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="今天" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="50"
                                    FontWeight="Bold"
                                    Foreground="DodgerBlue"
                                    Text="{Binding TodayBarcodeCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!--  工具栏  -->
                    <Border
                        Grid.Row="1"
                        Padding="10,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F1F5F8"
                        CornerRadius="30">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <!--  扫码时间范围选择  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="节点时间:" />
                                <!--  时间选择器  -->
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox
                                            Width="120"
                                            MaxWidth="170"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            BorderThickness="0"
                                            Focusable="False"
                                            FontSize="12"
                                            Foreground="DimGray"
                                            IsReadOnly="True"
                                            Text="{Binding NodeStartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                        <Button
                                            Width="30"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            materialDesign:RippleAssist.Feedback="DodgerBlue"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Command="{Binding OpenDateTimeDialogCommand}"
                                            CommandParameter="StartTime"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="DodgerBlue"
                                            Style="{StaticResource MaterialDesignFlatButton}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FocusVisualStyle="{x:Null}"
                                                Foreground="DimGray"
                                                Kind="CalendarClock" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="DimGray"
                                    Text="~" />
                                <!--  时间选择器  -->
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox
                                            Width="120"
                                            MaxWidth="170"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            BorderThickness="0"
                                            Focusable="False"
                                            FontSize="12"
                                            Foreground="DimGray"
                                            IsReadOnly="True"
                                            Text="{Binding NodeEndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                        <Button
                                            Width="30"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            materialDesign:RippleAssist.Feedback="DodgerBlue"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Command="{Binding OpenDateTimeDialogCommand}"
                                            CommandParameter="EndTime"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="DodgerBlue"
                                            Style="{StaticResource MaterialDesignFlatButton}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FocusVisualStyle="{x:Null}"
                                                Foreground="DimGray"
                                                Kind="CalendarClock" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!--  节点  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="节点:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <ComboBox
                                        Width="80"
                                        Height="30"
                                        MaxWidth="100"
                                        Margin="5,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ThemeAssist.Theme="Light"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Foreground="DimGray"
                                        ItemsSource="{Binding NodeList, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedItem="{Binding SelectedNode, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                            </StackPanel>
                            <!--  条码  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="条码:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="150"
                                        Height="30"
                                        MaxWidth="170"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="DimGray"
                                        Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Border>
                            </StackPanel>
                            <!--  相机名称  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="相机名称:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="100"
                                        Height="30"
                                        MaxWidth="100"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="DimGray"
                                        Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <!--  按钮  -->
                            <StackPanel
                                Margin="5,0,-6,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <!--  清理按钮  -->
                                <Button
                                    Width="50"
                                    Height="40"
                                    Margin="0"
                                    Padding="0"
                                    materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                                    materialDesign:ShadowAssist.ShadowEdges="Right"
                                    Background="#FF914D"
                                    Command="{Binding ClearSearchCriteriaCommand}"
                                    Cursor="Hand"
                                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                                    ToolTip="清理条件">
                                    <TextBlock
                                        Margin="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                                        FontSize="20"
                                        FontWeight="UltraLight"
                                        Foreground="White"
                                        RenderTransformOrigin=".5,.5"
                                        Text="&#xe601;">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="180" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                                <!--  搜索按钮  -->
                                <Button
                                    Width="40"
                                    Height="40"
                                    Margin="0"
                                    Padding="0"
                                    materialDesign:ButtonAssist.CornerRadius="0"
                                    materialDesign:ShadowAssist.ShadowEdges="Right"
                                    Background="#3A8EFF"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                                    ToolTip="搜索">
                                    <TextBlock
                                        Margin="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                                        FontSize="20"
                                        FontWeight="UltraLight"
                                        Foreground="White"
                                        RenderTransformOrigin=".5,.5"
                                        Text="&#xe60b;" />
                                </Button>
                                <!--  分割线  -->
                                <!--<Border
                 Width="1"
                 Height="25"
                 VerticalAlignment="Stretch"
                 Background="DarkGray"
                 Opacity="0.3" />-->
                                <!--  导出按钮  -->
                                <Button
                                    Width="50"
                                    Height="40"
                                    Margin="0"
                                    Padding="0"
                                    materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                                    materialDesign:ShadowAssist.ShadowEdges="Right"
                                    Background="#7B98E9"
                                    Command="{Binding ExportDataCommand}"
                                    Cursor="Hand"
                                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                                    ToolTip="导出">
                                    <TextBlock
                                        Margin="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                                        FontSize="20"
                                        FontWeight="UltraLight"
                                        Foreground="White"
                                        RenderTransformOrigin=".5,.5"
                                        Text="&#xe77f;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!--  显示列表内容  -->
                    <DataGrid
                        Grid.Row="2"
                        Margin="20,10,20,0"
                        Padding="10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        materialDesign:DataGridAssist.ApplyMaterialDesignColumnStyles="False"
                        materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                        materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                        AlternatingRowBackground="#201E90FF"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        CanUserAddRows="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        FontFamily="{StaticResource CustomFontFamily}"
                        Foreground="DimGray"
                        FrozenColumnCount="2"
                        GridLinesVisibility="None"
                        HorizontalScrollBarVisibility="Auto"
                        IsSelected="False"
                        ItemsSource="{Binding BarCodeItems, UpdateSourceTrigger=PropertyChanged}"
                        RowBackground="#061E90FF">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                                <Setter Property="Height" Value="30" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!--  No.  -->
                            <materialDesign:DataGridTextColumn
                                Width="Auto"
                                MinWidth="45"
                                Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="No."
                                IsReadOnly="True" />
                            <!--  条码  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="180"
                                Binding="{Binding BarCode, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}"
                                Header="条码"
                                IsReadOnly="False" />
                            <!--  节点名称  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="100"
                                Binding="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="节点名称"
                                IsReadOnly="True" />
                            <!--  节点扫码时间  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="180"
                                Binding="{Binding ScanTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="扫码时间"
                                IsReadOnly="True" />
                            <!--  相机序列号  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="150"
                                Binding="{Binding CameraSerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="相机序列号"
                                IsReadOnly="True" />
                            <!--  相机自定义名称  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="150"
                                Binding="{Binding CameraCustomName, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="相机名称"
                                IsReadOnly="True" />
                            <!--  视频  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                MinWidth="60"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="视频">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  查看按钮  -->

                                        <ListView
                                            Focusable="False"
                                            ItemTemplate="{StaticResource VideoTemplate}"
                                            ItemsSource="{Binding NvrCameraBindingItemInfos, UpdateSourceTrigger=PropertyChanged}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                            SelectionMode="Extended">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border
                                                                    x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="1"
                                                                    SnapsToDevicePixels="True">
                                                                    <ContentPresenter
                                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                                        <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Background="Transparent" Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                        </ListView>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--  扫码图  -->
                            <DataGridTemplateColumn
                                Width="100"
                                MinWidth="60"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="扫码图">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  查看按钮  -->
                                        <Button
                                            Height="25"
                                            MinWidth="25"
                                            Padding="0"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            Background="Transparent"
                                            Command="{Binding ElementName=MainWin, Path=DataContext.ScanImageCommand}"
                                            CommandParameter="{Binding}"
                                            Focusable="False"
                                            Style="{StaticResource MaterialDesignFlatLightButton}"
                                            ToolTip="查看图片"
                                            Visibility="{Binding ScanImageVisible, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">

                                                <!--<TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                    FontSize="12"
                                                    FontWeight="Light"
                                                    Foreground="DodgerBlue"
                                                    IsEnabled="True"
                                                    Text="查看图片"
                                                    TextAlignment="Justify" />-->
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource IconFontFamily}"
                                                    FontSize="18"
                                                    Foreground="DodgerBlue"
                                                    Text="&#xe6ad;" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--  全景图片、绑定横向列表  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                MinWidth="130"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                Header="全景图">
                                <DataGridTemplateColumn.CellTemplate>
                                    <!--  横向列表  -->
                                    <DataTemplate>
                                        <ListView
                                            Focusable="False"
                                            ItemTemplate="{StaticResource PanoramaImageTemplate}"
                                            ItemsSource="{Binding PanoramaImageItems, UpdateSourceTrigger=PropertyChanged}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                            SelectionMode="Extended">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border
                                                                    x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="1"
                                                                    SnapsToDevicePixels="True">
                                                                    <ContentPresenter
                                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                                                        <Setter TargetName="Border" Property="BorderBrush" Value="Transparent" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Background="Transparent" Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                        </ListView>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!--  翻页控件  -->
                    <Border
                        Grid.Row="3"
                        MinWidth="200"
                        MinHeight="40"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F1F5F8"
                        CornerRadius="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" MinWidth="50" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <!--  首页  -->
                            <Button
                                Grid.Column="0"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding FirstPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="FirstPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe68c;">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <!--  上一页  -->
                            <Button
                                Grid.Column="1"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="PreviousPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe7a5;" />
                            </Button>
                            <!--  页码  -->
                            <StackPanel
                                Grid.Column="2"
                                Margin="10,0"
                                HorizontalAlignment="Stretch"
                                Orientation="Horizontal">
                                <TextBox
                                    MinWidth="20"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Foreground="DimGray"
                                    materialDesign:HintAssist.HintOpacity="0.4"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#AD424242"
                                    Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding JumpPageCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="DimGray">
                                    <Run Text="/" /><Run Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" />
                                </TextBlock>
                            </StackPanel>
                            <!--  下一页  -->
                            <Button
                                Grid.Column="3"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding NextPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="NextPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe798;" />
                            </Button>
                            <!--  尾页  -->
                            <Button
                                Grid.Column="4"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding LastPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="LastPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe68c;" />
                            </Button>
                        </Grid>
                    </Border>
                    <!--  提示框  -->
                    <materialDesign:Snackbar
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Width="Auto"
                        Height="Auto"
                        VerticalAlignment="Bottom"
                        Background="DodgerBlue"
                        FontFamily="LoadFiraCode"
                        FontWeight="Bold"
                        MessageQueue="{Binding MainMessageQueue}" />
                </Grid>
            </Grid>
        </materialDesign:Card>
    </materialDesign:DialogHost>
</Window>