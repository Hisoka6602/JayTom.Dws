<Window
    x:Class="JayTom.Dws.VideoApiClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:converters="clr-namespace:JayTom.Dws.VideoApiClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JayTom.Dws.VideoApiClient"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    Name="MainWin"
    Title="MainWindow"
    Width="1200"
    Height="900"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    FontFamily="{StaticResource CustomFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:FileExistsToVisibilityConverter x:Key="FileExistsToVisibilityConverter" />
    </Window.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="SizeChanged" SourceName="MainWin">
            <b:InvokeCommandAction Command="{Binding SizeChangedCommand, IsAsync=False}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="70"
            CornerRadius="10"
            GlassFrameThickness="-1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <!--  外层提示框/更新提示框  -->
    <materialDesign:DialogHost
        Background="Transparent"
        DialogBackground="Transparent"
        DialogMargin="5"
        FocusVisualStyle="{x:Null}"
        Focusable="False"
        Identifier="MainDialog"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <materialDesign:Card
            Margin="0"
            materialDesign:ElevationAssist.Elevation="Dp2"
            materialDesign:ShadowAssist.Darken="True"
            materialDesign:ShadowAssist.ShadowEdges="Bottom,Right,Top,Left"
            Background="White"
            UniformCornerRadius="{Binding UniformCornerRadius, UpdateSourceTrigger=PropertyChanged}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <!--  渐变背景  -->

                <!--  软件名  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#AD424242"
                    Text="视频追溯控制台" />
                <!--  系统按钮  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CornerRadius="5,5,0,0">
                    <!--  系统按钮  -->
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  最小化  -->
                        <Button Style="{StaticResource SystemButtonStyle}" ToolTip="设置">
                            <TextBlock
                                FontSize="24"
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe713;" />
                        </Button>
                        <!--  最小化  -->
                        <Button
                            Command="{Binding MinWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="最小化">
                            <TextBlock
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe626;" />
                        </Button>
                        <!--  最大化  -->
                        <Button
                            x:Name="MaxButton"
                            Command="{Binding MaxWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource SystemButtonStyle}"
                            ToolTip="{Binding MaxBtnToolTip, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                x:Name="MaxBlock"
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="{Binding MaxBtnIcon, UpdateSourceTrigger=PropertyChanged}" />
                        </Button>
                        <!--  关闭  -->
                        <Button
                            Command="{Binding CloseWinCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Style="{StaticResource CustomCloseButtonStyle}"
                            ToolTip="关闭">
                            <TextBlock
                                Foreground="#424242"
                                Style="{StaticResource SystemTextBlockStyle}"
                                Text="&#xe601;" />
                        </Button>
                    </StackPanel>
                </Border>
                <!--  内容  -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>
                    <!--  统计数据  -->
                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  昨天数据  -->
                        <Border
                            Width="200"
                            Height="100"
                            Margin="10"
                            Background="#F1F5F8"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <Border
                                    Width="60"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="DimGray"
                                    CornerRadius="10,0,10,0"
                                    Opacity="0.7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="昨天" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="50"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Opacity="0.7"
                                    Text="{Binding YesterdayBarcodeCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                        <!--  今天数据  -->
                        <Border
                            Width="200"
                            Height="100"
                            Margin="10"
                            Background="#F1F5F8"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <Border
                                    Width="60"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="DodgerBlue"
                                    CornerRadius="10,0,10,0"
                                    Opacity="0.7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="今天" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="50"
                                    FontWeight="Bold"
                                    Foreground="DodgerBlue"
                                    Text="{Binding TodayBarcodeCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!--  工具栏  -->
                    <Border
                        Grid.Row="1"
                        Padding="10,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F1F5F8"
                        CornerRadius="30">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <!--  扫码时间范围选择  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="节点时间:" />
                                <!--  时间选择器  -->
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox
                                            Width="120"
                                            MaxWidth="170"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            BorderThickness="0"
                                            Focusable="False"
                                            FontSize="12"
                                            Foreground="DimGray"
                                            IsReadOnly="True"
                                            Text="{Binding NodeStartTime , StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                        <Button
                                            Width="30"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            materialDesign:RippleAssist.Feedback="DodgerBlue"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Command="{Binding OpenDateTimeDialogCommand}"
                                            CommandParameter="StartTime"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="DodgerBlue"
                                            Style="{StaticResource MaterialDesignFlatButton}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FocusVisualStyle="{x:Null}"
                                                Foreground="DimGray"
                                                Kind="CalendarClock" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="DimGray"
                                    Text="~" />
                                <!--  时间选择器  -->
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox
                                            Width="120"
                                            MaxWidth="170"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            BorderThickness="0"
                                            Focusable="False"
                                            FontSize="12"
                                            Foreground="DimGray"
                                            IsReadOnly="True"
                                            Text="{Binding NodeEndTime , StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                        <Button
                                            Width="30"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            materialDesign:RippleAssist.Feedback="DodgerBlue"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Command="{Binding OpenDateTimeDialogCommand}"
                                            CommandParameter="EndTime"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="DodgerBlue"
                                            Style="{StaticResource MaterialDesignFlatButton}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FocusVisualStyle="{x:Null}"
                                                Foreground="DimGray"
                                                Kind="CalendarClock" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!--  节点  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="节点:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <ComboBox
                                        Width="80"
                                        Height="30"
                                        MaxWidth="100"
                                        Margin="5,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        materialDesign:ThemeAssist.Theme="Light"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        SelectedItem="{Binding SelectedNode ,UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding NodeList,UpdateSourceTrigger=PropertyChanged}"
                                        Foreground="DimGray" />
                                </Border>
                            </StackPanel>
                            <!--  条码  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="条码:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="150"
                                        Height="30"
                                        MaxWidth="170"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="DimGray"
                                        Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <!--  相机名称  -->
                            <StackPanel
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="DimGray"
                                    Text="相机名称:" />
                                <Border
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5">
                                    <TextBox
                                        Width="100"
                                        Height="30"
                                        MaxWidth="100"
                                        Margin="5,0"
                                        materialDesign:TextFieldAssist.HasClearButton="False"
                                        materialDesign:TextFieldAssist.HasFilledTextField="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="DimGray"
                                        Text="{Binding CameraName , UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </Border>
                            </StackPanel>
                            <!--  按钮  -->
                            <StackPanel
                                Margin="5,0,-6,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <!--  清理按钮  -->
                                <Button
                                    Width="50"
                                    Height="40"
                                    Margin="0"
                                    Padding="0"
                                    materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                                    materialDesign:ShadowAssist.ShadowEdges="Right"
                                    Background="#FF914D"
                                    Command="{Binding ClearSearchCriteriaCommand}"
                                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                                    ToolTip="清理条件">
                                    <TextBlock
                                        Margin="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                                        FontSize="20"
                                        FontWeight="UltraLight"
                                        Foreground="White"
                                        RenderTransformOrigin=".5,.5"
                                        Text="&#xe601;">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="180" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                                <!--  搜索按钮  -->
                                <Button
                                    Width="40"
                                    Height="40"
                                    Margin="0"
                                    Padding="0"
                                    materialDesign:ButtonAssist.CornerRadius="0"
                                    materialDesign:ShadowAssist.ShadowEdges="Right"
                                    Background="#3A8EFF"
                                    Command="{Binding SearchDataCommand}"
                                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                                    ToolTip="搜索">
                                    <TextBlock
                                        Margin="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                                        FontSize="20"
                                        FontWeight="UltraLight"
                                        Foreground="White"
                                        RenderTransformOrigin=".5,.5"
                                        Text="&#xe60b;" />
                                </Button>
                                <!--  分割线  -->
                                <!--<Border
                 Width="1"
                 Height="25"
                 VerticalAlignment="Stretch"
                 Background="DarkGray"
                 Opacity="0.3" />-->
                                <!--  导出按钮  -->
                                <Button
                                    Width="50"
                                    Height="40"
                                    Margin="0"
                                    Padding="0"
                                    materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                                    materialDesign:ShadowAssist.ShadowEdges="Right"
                                    Background="#7B98E9"
                                    Command="{Binding ExportDataCommand}"
                                    Cursor="Hand"
                                    Style="{StaticResource ButtonFocusEnlargeStyle}"
                                    ToolTip="导出">
                                    <TextBlock
                                        Margin="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="pack://application:,,,/Fonts/#IconFont"
                                        FontSize="20"
                                        FontWeight="UltraLight"
                                        Foreground="White"
                                        RenderTransformOrigin=".5,.5"
                                        Text="&#xe77f;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!--  显示列表内容  -->
                    <DataGrid
                        Grid.Row="2"
                        Margin="20,10,20,0"
                        Padding="10,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                        materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                        AlternatingRowBackground="#101E90FF"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        CanUserAddRows="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        FontFamily="{StaticResource CustomFontFamily}"
                        Foreground="DimGray"
                        FrozenColumnCount="2"
                        GridLinesVisibility="None"
                        HorizontalScrollBarVisibility="Auto"
                        IsSelected="False"
                        ItemsSource="{Binding BarCodeItems, UpdateSourceTrigger=PropertyChanged}"
                        RowBackground="Transparent">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                                <Setter Property="Height" Value="30" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!--  No.  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="45"
                                Binding="{Binding Num, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="No." />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!--  条码  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe6c8;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="条码" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!--  节点名称  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe6c8;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="节点名称" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!--  节点扫码时间  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Node1ScanTime, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}">
                                            <Run Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Node1Name, UpdateSourceTrigger=PropertyChanged}" /><Run Text="节点扫码时间" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!--  相机序列号  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe6c8;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="相机序列号" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!--  相机自定义名称  -->
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="40"
                                Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}"
                                EditingElementStyle="{StaticResource DataGridReadOnlyTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Light"
                                            Style="{StaticResource DataGridTextColumnIconStyle}"
                                            Text="&#xe6c8;" />
                                        <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}" Text="相机自定义名称" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!--  视频  -->
                            <DataGridTemplateColumn
                                Width="100"
                                MinWidth="40"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}">
                                        <Run Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Node1Name, UpdateSourceTrigger=PropertyChanged}" /><Run Text="视频" />
                                    </TextBlock>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  查看按钮  -->
                                        <Button
                                            Height="30"
                                            MinWidth="90"
                                            materialDesign:ButtonAssist.CornerRadius="2"
                                            Background="Transparent"
                                            Command="{Binding ElementName=MainWin, Path=DataContext.OpenNode1PanoramaImageCommand}"
                                            CommandParameter="{Binding}"
                                            Focusable="False"
                                            Style="{StaticResource MaterialDesignFlatLightButton}"
                                            ToolTip="查看视频"
                                            Visibility="{Binding Node1PanoramaImagePath, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FileExistsToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock
                                                    Margin="5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                    FontSize="13"
                                                    FontWeight="Light"
                                                    Foreground="White"
                                                    IsEnabled="True"
                                                    Text="查看视频"
                                                    TextAlignment="Justify" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--  扫码图  -->
                            <DataGridTemplateColumn
                                Width="100"
                                MinWidth="40"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}">
                                        <Run Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Node2Name, UpdateSourceTrigger=PropertyChanged}" /><Run Text="扫码图" />
                                    </TextBlock>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  查看按钮  -->
                                        <Button
                                            Height="30"
                                            MinWidth="90"
                                            materialDesign:ButtonAssist.CornerRadius="2"
                                            Background="Transparent"
                                            Command="{Binding ElementName=MainWin, Path=DataContext.OpenNode2ScanImageCommand}"
                                            CommandParameter="{Binding}"
                                            Focusable="False"
                                            Style="{StaticResource MaterialDesignFlatLightButton}"
                                            ToolTip="查看图片"
                                            Visibility="{Binding Node2ScanImagePath, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FileExistsToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock
                                                    Margin="5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                    FontSize="13"
                                                    FontWeight="Light"
                                                    Foreground="White"
                                                    IsEnabled="True"
                                                    Text="查看图片"
                                                    TextAlignment="Justify" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--  全景图  -->
                            <DataGridTemplateColumn
                                Width="100"
                                MinWidth="40"
                                CellStyle="{StaticResource CustomDataGridTextCellStyle}">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Style="{StaticResource DataGridTextColumnTitleStyle}">
                                        <Run Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Node2Name, UpdateSourceTrigger=PropertyChanged}" /><Run Text="全景图" />
                                    </TextBlock>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  查看按钮  -->
                                        <Button
                                            Height="30"
                                            MinWidth="90"
                                            materialDesign:ButtonAssist.CornerRadius="2"
                                            Background="Transparent"
                                            Command="{Binding ElementName=MainWin, Path=DataContext.OpenNode2PanoramaImageCommand}"
                                            CommandParameter="{Binding}"
                                            Focusable="False"
                                            Style="{StaticResource MaterialDesignFlatLightButton}"
                                            ToolTip="查看图片"
                                            Visibility="{Binding Node2PanoramaImagePath, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FileExistsToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock
                                                    Margin="5,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    FontFamily="pack://application:,,,/Fonts/#Sarasa Mono SC Nerd"
                                                    FontSize="13"
                                                    FontWeight="Light"
                                                    Foreground="White"
                                                    IsEnabled="True"
                                                    Text="查看图片"
                                                    TextAlignment="Justify" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!--  翻页控件  -->
                    <Border
                        Grid.Row="3"
                        MinWidth="200"
                        MinHeight="40"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F1F5F8"
                        CornerRadius="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" MinWidth="50" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <!--  首页  -->
                            <Button
                                Grid.Column="0"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="20,0,0,20"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding FirstPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="FirstPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe68c;">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <!--  上一页  -->
                            <Button
                                Grid.Column="1"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="PreviousPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe7a5;" />
                            </Button>
                            <!--  页码  -->
                            <StackPanel
                                Grid.Column="2"
                                Margin="10,0"
                                HorizontalAlignment="Stretch"
                                Orientation="Horizontal">
                                <TextBox
                                    MinWidth="20"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Foreground="DimGray"
                                    materialDesign:HintAssist.HintOpacity="0.4"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#AD424242"
                                    Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding JumpPageCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="DimGray">
                                    <Run Text="/" /><Run Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" />
                                </TextBlock>
                            </StackPanel>
                            <!--  下一页  -->
                            <Button
                                Grid.Column="3"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding NextPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="NextPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe798;" />
                            </Button>
                            <!--  尾页  -->
                            <Button
                                Grid.Column="4"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                materialDesign:ButtonAssist.CornerRadius="0,20,20,0"
                                materialDesign:ShadowAssist.ShadowEdges="Right"
                                Background="#3A8EFF"
                                Command="{Binding LastPageCommand}"
                                Style="{StaticResource ButtonFocusEnlargeStyle}"
                                ToolTip="LastPage">
                                <TextBlock
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="pack://application:,,,/Fonts/#IconFont"
                                    FontSize="20"
                                    FontWeight="UltraLight"
                                    Foreground="White"
                                    RenderTransformOrigin=".5,.5"
                                    Text="&#xe68c;" />
                            </Button>
                        </Grid>
                    </Border>
                    <!--  提示框  -->
                </Grid>
            </Grid>
        </materialDesign:Card>
    </materialDesign:DialogHost>
</Window>