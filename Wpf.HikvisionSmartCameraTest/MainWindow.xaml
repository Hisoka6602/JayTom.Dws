<Window
    x:Class="Wpf.HikvisionSmartCameraTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.HikvisionSmartCameraTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="800"
    mc:Ignorable="d" Loaded="MainWindow_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="500" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <!--  图像  -->
        <Image Name="DevImage" Grid.Row="0" />
        <!--  列表  -->
        <ListView Name="BarCodeListBox" Grid.Row="1" />
        <!--  按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="30,2"
            Orientation="Horizontal">

            <Button Name="OpenDevButton" Click="OpenDevButton_OnClick">打开设备</Button>
            <Button Name="CloseDevButton" Click="CloseDevButton_OnClick">停止设备</Button>
        </StackPanel>
    </Grid>
</Window>